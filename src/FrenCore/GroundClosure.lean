-- keep-sorted start
import FrenCore.FiniteActivation
import FrenCore.GroundMatching
-- keep-sorted end

/-!
# Ranked finite candidate construction and complete closure (#758)

Construction overapproximates potential instances, from the last subject to
the first. Activation then computes the least enabled subset of this finite
universe. Both operations consume resolved syntax, not front-end decisions.
-/

namespace Fren.Core.GroundClosure

open Lean (Name)
open Fren (FinSet)
open GroundMatching
open FiniteActivation (collect)

/-- Include closed quantified terms, but not escaping binder indices. -/
def subterms : TheoryTerm → List TheoryTerm
  | t@(.app f a) => t :: (subterms f ++ subterms a)
  | t@(.all _ b) | t@(.ex _ b) => t :: subterms b
  | t => [t]

/-- Matched parameters take typed images from the finite pool. Other mentioned
listed parameters use their full table; unlisted and unused ones stay quantified. -/
def assignOne (ctx : Fren.Core.GroundMatching.Context) (r : Rule) (pool : List TheoryTerm) (n : Name) (ty : Ty)
    (ss : List Substitution) : List Substitution :=
  let matched := (r.anchors ctx.items ++ r.sentence.calls.filter (outer ·)).any (mentions n)
  let values := if !r.terms.any (mentions n) then none else
    if matched then some pool else ctx.listed ty
  match values with
  | none => ss
  | some values => ss.flatMap (typedExtensions ctx n ty values)

def assignFrom (ctx : Fren.Core.GroundMatching.Context) (r : Rule) (pool : List TheoryTerm) :
    List (Name × Ty) → List Substitution → List Substitution
  | [], ss => ss
  | (n, ty) :: vs, ss => assignFrom ctx r pool vs (assignOne ctx r pool n ty ss)

def assignments (ctx : Fren.Core.GroundMatching.Context) (r : Rule) (pool : List TheoryTerm) : List Substitution :=
  assignFrom ctx r pool r.sentence.variables [[]]

structure Candidate where
  rule : Nat
  sentence : TheorySentence
  anchors : List TheoryTerm
  calls : List TheoryTerm
  subject : Option Name
  deriving Inhabited, BEq, DecidableEq, ReflBEq, LawfulBEq

/-- Retain provenance and the complete sentence, including its domain. -/
def makeCandidate (ctx : Fren.Core.GroundMatching.Context) (index : Nat) (r : Rule) (s : Substitution) : Option Candidate := do
  let sentence ← r.sentence.instantiate (fun n => s.lookup n)
  let sub := theorySubstitution r.sentence.variables (fun n => s.lookup n)
  let anchors := (r.anchors ctx.items).map (·.substitute sub)
  let calls := (r.sentence.calls.filter (outer ·)).map (·.substitute sub)
  if !(anchors ++ calls).all (·.ground) then none else
    some { rule := index, sentence, anchors, calls, subject := r.subject ctx.items }

def fromAssignments (ctx : Fren.Core.GroundMatching.Context) (index : Nat) (r : Rule) (ss : List Substitution) : List Candidate :=
  ss.filterMap (makeCandidate ctx index r)

def candidates (ctx : Fren.Core.GroundMatching.Context) (index : Nat) (r : Rule) (pool : List TheoryTerm) : List Candidate :=
  fromAssignments ctx index r (assignments ctx r pool)

/-- Only ground function applications become new query applications. Calls
are witnesses from the original query, never generated by a sentence. -/
def Candidate.applications (c : Candidate) (items : List Name) : List TheoryTerm :=
  (({ sentence := c.sentence } : Rule).applications items).filter (·.ground)

/-- Listed compound values contribute their proper subterms too: a later
sentence can expose those as images of an earlier subject's parameters. -/
def seedPool (ctx : Fren.Core.GroundMatching.Context) (rules : List Rule) (q : Query) : List TheoryTerm :=
  let closed := rules.flatMap (·.terms)
  let listed := rules.flatMap fun r => r.sentence.variables.flatMap fun (_, ty) =>
    (ctx.listed ty).getD []
  ((q.applications ++ q.calls ++ closed ++ listed).flatMap subterms).filter (·.ground) |>.eraseDups

/-- A rank is processed once. Same-subject nonanchors have only parameter
or closed arguments, so they cannot require new images at that rank. Terms
of earlier items are added to the pool before those items are processed. -/
def atRank (ctx : Fren.Core.GroundMatching.Context) (subject : Option Name) (pool : List TheoryTerm) :
    Nat → List Rule → List Candidate
  | _, [] => []
  | i, r :: rs =>
    (if r.subject ctx.items == subject && r.instantiable ctx then candidates ctx i r pool else []) ++
      atRank ctx subject pool (i + 1) rs

def ranks (ctx : Fren.Core.GroundMatching.Context) (rules : List Rule) :
    List (Option Name) → List TheoryTerm → List Candidate
  | [], _ => []
  | subject :: subjects, pool =>
    let added := atRank ctx subject pool 0 rules
    let pool := (pool ++ ((added.flatMap (·.applications ctx.items)).flatMap subterms).filter (·.ground)).eraseDups
    added ++ ranks ctx rules subjects pool

def candidateUniverse (ctx : Fren.Core.GroundMatching.Context) (rules : List Rule) (q : Query) : List Candidate :=
  (ranks ctx rules (none :: ctx.items.reverse.map some) (seedPool ctx rules q)).eraseDups

def queryTerms (items : List Name) (q : Query) (accepted : List Candidate) : List TheoryTerm :=
  q.applications ++ accepted.flatMap (·.applications items)

def subjectNames (items : List Name) (q : Query) (accepted : List Candidate) : List Name :=
  (queryTerms items q accepted ++ q.calls).filterMap headName

def applicationsOf (items : List Name) (q : Query) (accepted : FinSet Candidate) : FinSet TheoryTerm :=
  FinSet.ofList q.applications ∪ collect (·.applications items) accepted

theorem applicationsOf_ofList (items : List Name) (q : Query) (cs : List Candidate) :
    applicationsOf items q (FinSet.ofList cs) = FinSet.ofList (queryTerms items q cs) := rfl

def subjectsOf (items : List Name) (q : Query) (accepted : FinSet Candidate) : FinSet Name :=
  collect (fun t => (headName t).toList) (applicationsOf items q accepted ∪ FinSet.ofList q.calls)

/-- Every anchor and outer call must be present together. A subject without
function anchors still needs a use of that subject in the query. -/
def enabled (items : List Name) (q : Query) (c : Candidate) (accepted : FinSet Candidate) : Bool :=
  decide (FinSet.ofList c.anchors ⊆ applicationsOf items q accepted) &&
  decide (FinSet.ofList c.calls ⊆ FinSet.ofList q.calls) &&
  decide (FinSet.ofList c.subject.toList ⊆ subjectsOf items q accepted)

theorem applicationsOf_mono (h : a ⊆ b) : applicationsOf items q a ⊆ applicationsOf items q b := by
  intro t ht
  rcases FinSet.mem_union.mp ht with hq | ha
  · exact FinSet.mem_union.mpr (Or.inl hq)
  · exact FinSet.mem_union.mpr (Or.inr (FiniteActivation.collect_mono h t ha))

theorem enabled_mono (h : a ⊆ b) : enabled items q c a = true → enabled items q c b = true := by
  simp only [enabled, Bool.and_eq_true, decide_eq_true_eq]
  rintro ⟨⟨ha, hc⟩, hs⟩
  refine ⟨⟨fun t ht => applicationsOf_mono h t (ha t ht), hc⟩, ?_⟩
  intro n hn
  apply FiniteActivation.collect_mono (s := applicationsOf items q a ∪ FinSet.ofList q.calls)
    (t := applicationsOf items q b ∪ FinSet.ofList q.calls) ?_ n (hs n hn)
  intro t ht
  rcases FinSet.mem_union.mp ht with ha | hq
  · exact FinSet.mem_union.mpr (Or.inl (applicationsOf_mono h t ha))
  · exact FinSet.mem_union.mpr (Or.inr hq)

/-- Extraction and normalization precede both finite construction and activation. -/
def normalizedQuery (ctx : Fren.Core.GroundMatching.Context) (ds : List (TheoryTerm × TheoryTerm)) (q : Query) : Query :=
  let q := GroundMatching.prepareQuery ctx ds q
  { applications := q.applications.eraseDups
    calls := q.calls.eraseDups }

structure Prepared where
  context : Fren.Core.GroundMatching.Context
  query : Query
  candidates : List Candidate

/-- Normalize the complete input before ranked construction. -/
def prepare (ctx : Fren.Core.GroundMatching.Context) (rules : List Rule) (q : Query) : Prepared :=
  let ds := definitions ctx.definitions
  let ctx := ctx.normalizeListed ds
  let rules := rules.map (·.normalize ds)
  let q := normalizedQuery ctx ds q
  { context := ctx, query := q, candidates := candidateUniverse ctx rules q }

structure Closure where
  applicationList : List TheoryTerm
  instanceList : List Candidate

def Closure.applications (r : Closure) : FinSet TheoryTerm := FinSet.ofList r.applicationList
def Closure.instances (r : Closure) : FinSet Candidate := FinSet.ofList r.instanceList

/-- No caller-selected fuel or function-count bound. Each productive round
removes a nonempty part of the finite candidate universe. -/
def close (ctx : Fren.Core.GroundMatching.Context) (rules : List Rule) (q : Query) : Closure :=
  let p := prepare ctx rules q
  let result := FiniteActivation.run (enabled p.context.items p.query) p.candidates []
  { applicationList := (queryTerms p.context.items p.query result.members).eraseDups
    instanceList := result.members }

/-- The returned application set contains exactly the query seeds and the
applications of accepted instances. -/
theorem close_applications (ctx : Fren.Core.GroundMatching.Context) (rules : List Rule) (q : Query) :
    (close ctx rules q).applications = applicationsOf (prepare ctx rules q).context.items
      (prepare ctx rules q).query (close ctx rules q).instances := by
  simp only [close, Closure.applications, Closure.instances, applicationsOf_ofList]
  apply FinSet.ext
  intro t
  simp

/-- Every accepted instance has all its normalized anchors and calls. -/
theorem close_sound (ctx : Fren.Core.GroundMatching.Context) (rules : List Rule) (q : Query)
    (c : Candidate) (hc : c ∈ (close ctx rules q).instances) :
    enabled (prepare ctx rules q).context.items (prepare ctx rules q).query c (close ctx rules q).instances = true := by
  let p := prepare ctx rules q
  let result := FiniteActivation.run (enabled p.context.items p.query) p.candidates []
  rcases result.sound (fun _ _ _ h => enabled_mono h) c hc with he | he
  · exact False.elim (FinSet.not_mem_empty c he)
  · exact he

/-- No enabled candidate is omitted when closure returns. -/
theorem close_complete (ctx : Fren.Core.GroundMatching.Context) (rules : List Rule) (q : Query)
    (c : Candidate) (hc : c ∈ (prepare ctx rules q).candidates)
    (he : enabled (prepare ctx rules q).context.items (prepare ctx rules q).query c (close ctx rules q).instances = true) :
    c ∈ (close ctx rules q).instances :=
  (FiniteActivation.run (enabled (prepare ctx rules q).context.items (prepare ctx rules q).query)
    (prepare ctx rules q).candidates []).closed c hc he

/-- Every closed candidate set contains the engine's result. -/
theorem close_least (ctx : Fren.Core.GroundMatching.Context) (rules : List Rule) (q : Query)
    (target : FinSet Candidate)
    (hc : ∀ c ∈ (prepare ctx rules q).candidates,
      enabled (prepare ctx rules q).context.items (prepare ctx rules q).query c target = true → c ∈ target) :
    (close ctx rules q).instances ⊆ target := by
  apply (FiniteActivation.run (enabled (prepare ctx rules q).context.items (prepare ctx rules q).query)
    (prepare ctx rules q).candidates []).least target
  · intro c h; exact False.elim (FinSet.not_mem_empty c h)
  · intro c a h; exact enabled_mono h
  · exact hc

end Fren.Core.GroundClosure
