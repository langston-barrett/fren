-- keep-sorted start
import FrenCore.GroundClosure
-- keep-sorted end

-- fren-covers: lang::ground_assignment_step, lang::ground_applications_step, lang::ground_enabled_step
-- fren-covers: lang::ground_candidate_step, lang::ground_pool_step, lang::ground_universe_step
-- fren-covers: lang::ground_activation_step, lang::ground_close_step

namespace FrenTest.GroundClosure

open Fren.Core Fren.Core.GroundMatching Fren.Core.GroundClosure
open Fren (FinSet)

private def app (f : Lean.Name) (xs : List TheoryTerm) : TheoryTerm :=
  xs.foldl TheoryTerm.app (.item f)
private def x : TheoryTerm := .variable `x
private def y : TheoryTerm := .variable `y
private def a : TheoryTerm := .query `a
private def b : TheoryTerm := .query `b
private def ctx : Fren.Core.GroundMatching.Context := { items := [`g, `f], typeOf := fun _ => some .int }
private def rule (vs : List (Lean.Name × Ty)) (claims : List TheoryTerm)
    (calls : List TheoryTerm := []) : Rule :=
  { sentence := { role := .axiom, variables := vs, domain := .literal "true", calls, claims } }
private def shrink := rule [(`x, .int), (`y, .int)] [app `f [app `g [x], y], app `f [x, y]]
private def nest : Nat → TheoryTerm
  | 0 => a
  | n + 1 => app `g [nest n]

-- Eight productive rounds with only two signature items. Query subterms
-- already contain the g applications, but none of the smaller f applications.
private def chain := close ctx [shrink] { applications := [app `f [nest 8, b]] }
#guard app `f [a, b] ∈ chain.applications
#guard chain.instances.card == 8
#guard app `f [nest 9, b] ∉ chain.applications
#guard (close ctx [shrink] { applications := [app `f [a, b]] }).instances.card == 0
#guard (close ctx [] { applications := [app `f [a, b]] }).applications == FinSet.ofList [app `f [a, b]]

-- Higher subjects generate compound images before earlier subjects are built.
private def rankedCtx := { ctx with items := [`k, `g, `f, `h] }
private def high := rule [(`x, .int)] [app `h [x], app `f [app `k [x]]]
private def low := rule [(`x, .int)] [app `f [x], app `g [x]]
#guard app `g [app `k [a]] ∈ (close rankedCtx [low, high] { applications := [app `h [a]] }).applications
#guard app `g [a] ∉ (close rankedCtx [low, high] { applications := [app `h [a]] }).applications

private def one : TheoryTerm := .literal "1"
-- A listed parameter bound by an anchor takes the actual query term.
-- Only an unbound listed parameter is restricted to the listed table.
private def matchedListedCtx : Fren.Core.GroundMatching.Context :=
  { ctx with listed := fun ty => if ty == .int then some [one] else none }
private def matchedListed := rule [(`x, .int)] [app `f [x], app `g [x]]
#guard app `g [a] ∈ (close matchedListedCtx [matchedListed] { applications := [app `f [a]] }).applications
private def unboundListed := rule [(`x, .int), (`y, .int)] [app `f [app `g [x]], app `f [y]]
#guard app `f [one] ∈ (close matchedListedCtx [unboundListed] { applications := [app `f [app `g [a]]] }).applications
#guard app `f [a] ∉ (close matchedListedCtx [unboundListed] { applications := [app `f [app `g [a]]] }).applications
private def listedValue := app `ctor [one]
private def listedCtx : Fren.Core.GroundMatching.Context := {
  items := [`g, `ctor, `f]
  typeOf := fun t => if t == listedValue then some .bool else some .int
  listed := fun ty => if ty == .bool then some [listedValue] else none
}
private def fromListed := rule [(`x, .int), (`flag, .bool)]
  [app `f [.sort .int, app `g [x]], app `f [.sort .bool, .variable `flag]]
private def intoListed := rule [(`y, .int)] [app `f [.sort .bool, app `ctor [y]], app `g [y]]
#guard app `g [one] ∈ (close listedCtx [fromListed, intoListed]
  { applications := [app `f [.sort .int, app `g [a]]] }).applications
#guard one ∈ seedPool listedCtx [fromListed, intoListed] {}
#guard (close { listedCtx with listed := fun _ => some [] } [fromListed, intoListed]
  { applications := [app `f [.sort .int, app `g [a]]] }).instances.card == 0

-- Calls stay in their own channel and are never generated by an instance.
private def callCtx := { ctx with items := [`g, `f, `p] }
private def withCall := rule [(`x, .int)] [app `f [x]] [app `p [x, b]]
#guard app `f [a] ∈ (close callCtx [withCall] { calls := [app `p [a, b]] }).applications
#guard app `f [a] ∈ (close { matchedListedCtx with items := callCtx.items } [withCall]
  { calls := [app `p [a, b]] }).applications
#guard (close callCtx [withCall] { applications := [app `p [a, b]] }).instances.card == 0
#guard (close callCtx [withCall] { calls := [app `p [.bound 0, b]] }).instances.card == 0
#guard app `p [a, b] ∉ (close callCtx [withCall] { calls := [app `p [a, b]] }).applications

-- Normalization covers query witnesses, listed values and closed sentences.
private def aliases := { ctx with definitions := [(.query `alias, a)] }
#guard (close aliases [shrink] { applications := [app `f [app `g [.query `alias], b]] }).applications ==
  (close ctx [shrink] { applications := [app `f [app `g [a], b]] }).applications
#guard (close ctx [shrink] { applications := [app `f [nest 8, b], app `f [nest 8, b]] }).instances == chain.instances
#guard (close ctx [shrink, shrink] { applications := [app `f [nest 8, b]] }).instances.card == 16
#guard (close ctx [rule [] [.literal "fact"]] {}).instances.card == 1
#guard (close ctx [rule [(`outside, .int)] [.variable `outside]] {}).instances.card == 1
#guard (close ctx [rule [(`x, .int), (`y, .int)] [app `f [x], app `g [y]]]
  { applications := [app `f [a]] }).instances.card == 0

-- Uses beneath query binders establish the subject without supplying images.
private def inner := rule [] [.all .int (app `f [.bound 0])]
#guard (close ctx [inner] { applications := [.all .int (app `f [.bound 0])] }).instances.card == 1
#guard (close ctx [rule [(`x, .int)] [app `f [x]]]
  { applications := [.all .int (app `f [.bound 0])] }).instances.card == 0
#guard FiniteActivation.collect (fun c => [c.sentence.variables])
  (close ctx [rule [(`outside, .int)] [.variable `outside]] {}).instances ==
  FinSet.ofList [[(`outside, .int)]]

-- Cross-check the Cartesian candidate construction against structural matching
-- at the final query, rather than against another copy of its assignments.
private def closedUnderMatching (ctx : Fren.Core.GroundMatching.Context) (rs : List Rule) (q : Query) : Bool :=
  let p := prepare ctx rs q
  let result := close ctx rs q
  let apps := (p.query.applications ++ p.candidates.flatMap (·.applications ctx.items)).filter
    (fun t => decide (t ∈ result.applications))
  let sentences := FiniteActivation.collect (fun c => [c.sentence]) result.instances
  rs.all fun r => (GroundMatching.instances ctx r { applications := apps, calls := q.calls }).all
    (fun s => decide (s ∈ sentences))

#guard (List.range 10).all fun n => closedUnderMatching ctx [shrink] { applications := [app `f [nest n, b]] }
#guard closedUnderMatching rankedCtx [low, high] { applications := [app `h [a]] }
#guard closedUnderMatching listedCtx [fromListed, intoListed] { applications := [app `f [.sort .int, app `g [a]]] }
#guard closedUnderMatching ctx [inner] { applications := [.all .int (app `f [.bound 0])] }
#guard closedUnderMatching matchedListedCtx [matchedListed] { applications := [app `f [a]] }
#guard closedUnderMatching matchedListedCtx [unboundListed] { applications := [app `f [app `g [a]]] }

-- Independent activation probes include a dormant cycle, a reachable cycle,
-- duplicate candidates and a rule whose second anchor becomes available late.
private def candidate (i : Nat) (needs gives : List TheoryTerm) : Candidate :=
  { rule := i, sentence := (rule [] gives).sentence, anchors := needs, calls := [], subject := none }
private def c0 := candidate 0 [app `f [a]] [app `g [a]]
private def c1 := candidate 1 [app `g [a]] [app `f [a]]
private def c2 := candidate 2 [app `f [a], app `g [a]] [app `f [b]]
#guard (FiniteActivation.run (enabled ctx.items {}) [c0, c1] []).value == ∅
#guard (FiniteActivation.run (enabled ctx.items { applications := [app `f [a]] })
  [c2, c1, c0, c0] []).value == FinSet.ofList [c0, c1, c2]

end FrenTest.GroundClosure
