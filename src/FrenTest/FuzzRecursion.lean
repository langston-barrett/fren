import FrenCli.Search

/-! Singleton and mutual clients of the structural-group checker.
Deliberate errors have their own specs, so they cannot suppress another
spec's checks. -/

namespace FrenTest.FuzzRecursion

open FrenCli.Eval

private def pick (xs : Array α) [Inhabited α] : R α := do
  return xs[← below xs.size]!

/-- A generated spec and its expected termination verdict. -/
structure Case where
  text : String
  rejects : Bool

/-- Ordinary and generic recursions with one to four parameter positions,
mixed companion types, direct and nested patterns, expression and block
definitions, and result comparisons at primitive, collection, option,
abstract and recursive types.
Invalid specs isolate unchanged, constructed, aliased, closure and passed
uses, so each reaches the termination judgment. -/
def genCase : R Case := do
  let generic := (← below 2) == 0
  let kind ← below 9
  let extra ← below 4
  let n := if kind == 8 then 1 else extra + 1
  let pos ← below n
  let (ty, value) ← pick (#[ ("Int", "0"), ("Nat", "0"), ("Bool", "false"), ("String", "\"\""),
    ("Set<Int>", "{}"), ("Rel<Int, Int>", "{}"), ("Seq<Int>", "[]"), ("Option<Int>", "Option::None") ] ++
    (if generic then #[("T", "v")] else #[]))
  let tree := if generic then "Rg<T>" else "Rg"
  let (ty, value) := if (← below 10) == 0 then (tree, s!"x{pos}") else (ty, value)
  -- Function types cannot return Nat (`F0435`); the closure and passed
  -- cases must reach the termination check instead of that restriction.
  let (ty, value) := if 7 ≤ kind ∧ ty = "Nat" then ("Int", "0") else (ty, value)
  let tps := if generic then "<T>" else ""
  let parameters ← (List.range n).mapM fun i => do
    let (paramTy, arg) ← if i == pos then pure (tree, "Rg::Node(Rg::Leaf(0), Rg::Leaf(0))")
      else pick #[(tree, "Rg::Leaf(0)"), ("Int", "0"), ("Nat", "0"), ("Bool", "false"),
        ("String", "\"\""), ("Option<Int>", "Option::None"), ("Seq<Int>", "[]"),
        ("Set<Int>", "{}"), ("Rel<Int, Int>", "{}")]
    let name := s!"x{i}" ++ (if paramTy == "Bool" then "?" else "")
    pure (name, s!"{name}: {paramTy}", arg)
  let params := parameters.map (·.2.1)
  let args (child : String) := ", ".intercalate ((List.range n).map fun i => if i == pos then child else (parameters[i]!).1)
  let call (child : String) := s!"rg_step({args child})"
  let applyName := if ty == "Bool" then "rg_apply?" else "rg_apply"
  let nested := (← below 2) == 0
  let binder := if ty == "T" then "v" else "_"
  let leaf := s!"Rg::Leaf({binder}) => {value}"
  let body ← match kind with
    | 0 | 1 | 2 | 3 => pure (call "l")
    | 4 => pure (call s!"x{pos}")
    | 5 => pure (call "Rg::Node(l, l)")
    | 6 => pure s!"(let child := l in {call "child"})"
    | 7 => pure s!"{applyName}(|child| {call "child"}, l)"
    | _ => pure s!"{applyName}(rg_step, l)"
  let mut out := "set_option fren.lint.style \"allow\"\nset_option fren.lint.restriction \"allow\"\n" ++
    "set_option fren.lint.unused_variables \"allow\"\n" ++
    s!"pub enum Rg{tps} \{ Leaf({if generic then "T" else "Int"}), Node({tree}, {tree}) }\n"
  if kind ≥ 7 then
    out := out ++ s!"pub fn {applyName}{tps}(g: fn({tree}) -> {ty}, x: {tree}): {ty} := g(x)\n"
  let branch := if nested then s!"Rg::Node(Rg::Node(l, _), _) => {body}, Rg::Node(l, _) => {body}"
    else s!"Rg::Node(l, _) => {body}"
  let expression := s!"match x{pos} \{ {leaf}, {branch} }"
  let name := if ty == "Bool" then "rg_step?" else "rg_step"
  let expression := (expression.replace "rg_step(" s!"{name}(").replace "(rg_step," s!"({name},"
  let comparison ← if ty == "Int" || ty == "Nat" then pick #["=", "!=", "<", "<=", ">", ">="]
    else if ty == "Set<Int>" || ty == "Rel<Int, Int>" then pick #["=", "!=", "subset"] else pick #["=", "!="]
  let test := if kind < 4 then
      let base := if ty == "T" then "0" else if ty == tree then "Rg::Leaf(0)" else value
      s!"expect rg_value: {name}({", ".intercalate (parameters.map (·.2.2))}) {comparison} {base}\n"
    else ""
  let block ← below 2
  let text := if block == 0 then
      out ++ s!"pub fn {name}{tps}({", ".intercalate params}): {ty} := {expression}\n" ++ test
    else
      let result := if ty == "Bool" then "r?" else "r"
      out ++ s!"pub fn {name}{tps}({", ".intercalate params}): ({result}: {ty}) \{\n    out {result} := {expression}\n}\n" ++ test
  return { text, rejects := decide (4 ≤ kind) }

/-- The spec generated by `genCase`; its verdict is checked by the corpus. -/
def gen : R String := do return (← genCase).text

private def groupPrelude : String :=
  "set_option fren.lint.style \"allow\"\nset_option fren.lint.restriction \"allow\"\n" ++
  "set_option fren.lint.unused_variables \"allow\"\nset_option fren.lint.dead_code \"allow\"\n"

/-- An abstract result is carried through the cycle rather than constructed.
Comparisons occur in the bodies; abstract-result recursion queries have
pre-existing solver and enumeration differences, also for singletons (#493). -/
private def abstractGroup (count : Nat) : R Case := do
  let mut text := "-- group-verdict: accept\n" ++ groupPrelude ++
    "pub type Opaque\npub enum GTree { End, Next(GTree) }\nmutual {\n"
  for i in List.range count do
    let next := (i + 1) % count
    let params := if i % 2 == 0 then "t: GTree, value: Opaque" else "value: Opaque, t: GTree"
    let args := if next % 2 == 0 then "rest, value" else "value, rest"
    let visibility := if (← below 2) == 0 then "pub " else ""
    let call := s!"member{next}({args})"
    let branch := if (← below 2) == 0 then s!"if value = value then {call} else value"
      else s!"if value != value then value else {call}"
    let body := s!"match t \{ GTree::End => value, GTree::Next(rest) => {branch} }"
    text := text ++ if (← below 2) == 0 then s!"{visibility}fn member{i}({params}): Opaque := {body}\n"
      else s!"{visibility}fn member{i}({params}): (result: Opaque) \{ out result := {body} }\n"
  text := text ++ "}\n"
  return { text, rejects := false }

/-- Two or three simultaneous members, with independent parameter positions
and mixed companion types. Invalid uses are isolated in their own specs. -/
def genGroupCase : R Case := do
  let count := (← below 2) + 2
  if (← below 12) == 0 then return ← abstractGroup count
  let kind ← below 9
  let genericData := (← below 2) == 0
  let tree := if genericData then "GTree<Int>" else "GTree"
  let leaf := if genericData then "GTree::End(0)" else "GTree::End"
  let boxOrdered := (← below 2) == 0
  let numberOrdered := (← below 2) == 0
  let (rt, base) ← pick #[("Int", "0"), ("Nat", "0"), ("Bool", "false"), ("String", "\"\""),
    ("Set<Int>", "{}"), ("Rel<Int, Int>", "{}"), ("Seq<Int>", "[]"), ("Option<Int>", "Option::None"),
    ("GBox", "GBox { value := 0 }"), ("GNumber", "GNumber(0)"), (tree, leaf)]
  let (rt, base) := if kind ≥ 7 && rt == "Nat" then ("Int", "0") else (rt, base)
  let mixed := kind < 4 && (← below 2) == 0
  let results := (List.range count).map fun i => if mixed && i % 2 == 1 then
      (if rt == "Bool" then ("Int", "0") else ("Bool", "false")) else (rt, base)
  let names := (results.zipIdx).map fun ((ty, _), i) => s!"member{i}" ++ if ty == "Bool" then "?" else ""
  let signatures ← (List.range count).mapM fun _ => do
    let n := (← below 3) + 1
    let position ← below n
    let ps ← (List.range n).mapM fun i => do
      let (ty, value) ← if i == position then pure (tree, leaf)
        else pick #[("Int", "0"), ("Bool", "false"), ("String", "\"\""), ("Option<Int>", "Option::None"),
          ("Seq<Int>", "[]"), ("Set<Int>", "{}"), ("Rel<Int, Int>", "{}"), ("Nat", "0"),
          ("GBox", "GBox { value := 0 }"), ("GNumber", "GNumber(0)")]
      return (s!"x{i}" ++ (if ty == "Bool" then "?" else ""), ty, value)
    return (position, ps)
  let invalidMember ← below count
  let mut text := groupPrelude ++ s!"pub {if boxOrdered then "ordered " else ""}struct GBox \{ value: Int }\n" ++
    s!"pub {if numberOrdered then "ordered " else ""}struct GNumber(Int)\n" ++
    (if genericData then "pub enum GTree<T> { End(T), Next(GTree<T>) }\n"
      else "pub enum GTree { End, Next(GTree) }\n")
  let apply := if rt == "Bool" then "group_apply?" else "group_apply"
  let outsideHelper := kind == 2 && results.any (·.1 == "Int")
  if outsideHelper then
    text := text ++ "set_option fren.lint.undecidable \"allow\" in\npub fn outside_helper(n: Int): Int := if (forall (i: Int), when 0 <= i < n, i >= 0) then 0 else 1\n"
  if kind ≥ 7 then
    text := text ++ s!"pub fn {apply}(f: fn({tree}) -> {rt}, x: {tree}): {rt} := f(x)\n"
  text := text ++ "mutual {\n"
  for i in List.range count do
    let (memberRt, memberBase) := results[i]!
    let memberBase := if kind == 2 && memberRt == "Int" then "outside_helper(0)" else memberBase
    let (position, ps) := signatures[i]!
    let target := (i + 1) % count
    let (targetPosition, targetPs) := signatures[target]!
    let qualified ← below 2
    let callee := if qualified == 0 then names[target]! else s!"self::{names[target]!}"
    let call (child : String) :=
      let app := s!"{callee}({", ".intercalate (targetPs.zipIdx.map fun ((_, _, value), k) => if k == targetPosition then child else value)})"
      if memberRt == results[target]!.1 then app else
        let predicate := if results[target]!.1 == "Bool" then app else s!"({app} = {results[target]!.2})"
        if memberRt == "Bool" then predicate else s!"(if {predicate} then {memberBase} else {memberBase})"
    let bad := i == invalidMember && kind ≥ 4
    let body := if !bad then call "rest" else match kind with
      | 4 => call s!"x{position}"
      | 5 => call "GTree::Next(rest)"
      | 6 => s!"(let child := rest in {call "child"})"
      | 7 => s!"{apply}(|child| {call "child"}, rest)"
      | _ => s!"{apply}({names[target]!}, rest)"
    -- A passed member needs the helper's unary signature.
    let (position, ps, body) := if kind == 8 then
        (0, [("x0", tree, leaf)],
          if bad then s!"{apply}({names[target]!}, rest)" else s!"{names[target]!}(rest)")
      else (position, ps, body)
    let nested ← below 2
    let arms := if nested == 0 then s!"GTree::Next(GTree::Next(rest)) => {body}, GTree::Next(rest) => {body}"
      else s!"GTree::Next(rest) => {body}"
    let expression := s!"match x{position} \{ GTree::End{if genericData then "(_)" else ""} => {memberBase}, {arms} }"
    let expression ← if memberRt == "Bool" && kind == 1 then do
        if (← below 2) == 0 then pure s!"and \{ descent: {expression}, value: true }"
        else pure s!"({expression}) and true"
      else pure expression
    let params := ", ".intercalate (ps.map fun (n, ty, _) => s!"{n}: {ty}")
    let block ← below 3
    let visibility := if (← below 2) == 0 then "pub " else ""
    let matchable := ps.all fun (_, ty, _) => [tree, "Int", "Nat", "Bool", "String", "Option<Int>"].contains ty
    text := text ++ if block == 2 && kind < 4 && matchable then
        let row (pattern : String) := ", ".intercalate (ps.zipIdx.map fun (_, j) => if j == position then pattern else "_")
        let endRow := row (if genericData then "GTree::End(_)" else "GTree::End")
        let next := row "GTree::Next(rest)"
        let nestedRow := if nested == 0 then s!"{row "GTree::Next(GTree::Next(rest))"} => {body}, " else ""
        s!"{visibility}fn {names[i]!}({", ".intercalate (ps.map (·.2.1))}): {memberRt} := match \{ {endRow} => {memberBase}, {nestedRow}{next} => {body} }\n"
      else if block == 0 then s!"{visibility}fn {names[i]!}({params}): {memberRt} := {expression}\n"
      else s!"{visibility}fn {names[i]!}({params}): (result{if memberRt == "Bool" then "?" else ""}: {memberRt}) \{\n" ++
        (if kind == 3 then "use self::GTree\n" ++
          (if qualified == 0 then s!"use self::{names[target]!}\n" else "") else "") ++
        s!"out result{if memberRt == "Bool" then "?" else ""} := {expression}\n}\n"
  text := text ++ "}\n"
  -- Hosted enumeration of a noncomputable singleton already fails (#493).
  -- This variant checks group elaboration and propagation without a query.
  if kind < 4 && !outsideHelper then
    let (position, ps) := signatures[0]!
    let args := ", ".intercalate (ps.zipIdx.map fun ((_, _, value), i) => if i == position then
      s!"GTree::Next(GTree::Next(GTree::Next({leaf})))" else value)
    let ordered := rt == "Int" || rt == "Nat" || (rt == "GBox" && boxOrdered) || (rt == "GNumber" && numberOrdered)
    let comparison ← if ordered then pick #["=", "!=", "<", "<=", ">", ">="]
      else if rt == "Set<Int>" || rt == "Rel<Int, Int>" then pick #["=", "!=", "subset"] else pick #["=", "!="]
    text := text ++ s!"set_option fren.evidence \"enumerated\" in\nexpect group_value: {names[0]!}({args}) {comparison} {base}\n"
  return { text := s!"-- group-verdict: {if kind ≥ 4 then "reject" else "accept"}\n" ++ text
           rejects := decide (kind ≥ 4) }

def genGroup : R String := do return (← genGroupCase).text

end FrenTest.FuzzRecursion
