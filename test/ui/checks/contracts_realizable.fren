-- The realizability of an uninterpreted function's contract
-- (`Reqs/Check#contracts-of-uninterpreted-functions`): its postconditions
-- must be able to hold for all arguments that meet its preconditions,
-- whatever the other functions are, or every check that applies it would
-- pass.
set_option fren.lint.dead_code "allow"
set_option fren.lint.chainable_comparison "allow"

-- Postconditions that contradict each other.
fn bad(n: Int): (r: Int) {   --~ error: the postconditions of `bad` cannot all hold
    ensure a: r > 0
    ensure b: r < 0
}

-- A postcondition that says nothing of the value, and can be false.
fn other(n: Int): (r: Int) {   --~ error: no value of `other` satisfies `c`
    ensure c: n > 0
}

-- A precondition rules out the arguments where it would be false.
fn guarded(n: Int): (r: Int) {
    assume positive: n > 0
    ensure c: n > 0 and r > n
}

-- Contradictory preconditions.
fn never(n: Int): (result: Int) {   --~ error: the preconditions of `never` are unsatisfiable: `p`, `q` contradict each other
    assume p: n > 0
    assume q: n < 0
    ensure r: result = n
}

-- A postcondition over an earlier function, which is free: it can be false.
fn base(Int): Int
fn above(n: Int): (r: Int) {   --~ error: the postconditions of `above` cannot all hold
    ensure over: base(n) > 0 and r > base(n)
}

-- One that relates the value to an earlier function holds.
fn after(n: Int): (r: Int) { ensure over: r > base(n) }

-- A `Nat` value is at least 0.
fn count(n: Int): (r: Nat) { ensure small: r < 1 }
