pub fn indn(c?): Nat := if c? then 1 else 0
set_option fren.lint.undecidable "allow" in
set_option fren.evidence "enumerated" in
proc nat_fn(q: Seq<Int>) {  --~ info: 2 checks of `nat_fn` hold for every behaviour up to size 3
    --~^ info: the definedness checks of `nat_fn` are not run by enumeration
    expect e: indn(q[5] > 0) <= 1
}

set_option fren.lint.nonminimal_bool "allow" in
set_option fren.lint.undecidable "allow" in
set_option fren.evidence "enumerated" in
proc def_out_nat(q: Seq<Int>): (k: Nat) {  --~ info: 2 checks of `def_out_nat` hold for every behaviour up to size 3
    --~^ info: the definedness checks of `def_out_nat` are not run by enumeration
    out k := (if q[5] > 0 then 1 else 0) + 2
    expect e: not (k <= 1)
}

set_option fren.lint.undecidable "allow" in
set_option fren.evidence "enumerated" in
proc nat_def_single(q: Seq<Int>): (k: Nat) {  --~ info: 2 checks of `nat_def_single` hold for every behaviour up to size 3
    --~^ info: the definedness checks of `nat_def_single` are not run by enumeration
    out k := if q[5] > 0 then 1 else 0
    expect e: k <= 1
}

set_option fren.lint.constant_output "allow" in
set_option fren.lint.nonminimal_bool "allow" in
set_option fren.lint.undecidable "allow" in
set_option fren.evidence "enumerated" in
proc nat_let_addend(q: Seq<Int>) {  --~ info: 2 checks of `nat_let_addend` hold for every behaviour up to size 3
    --~^ info: the definedness checks of `nat_let_addend` are not run by enumeration
    let two: Nat := 2
    expect e: not ((if q[5] > 0 then 1 else 0) + two <= 1)
}

set_option fren.lint.undecidable "allow" in
set_option fren.evidence "enumerated" in
proc def_chain(q: Seq<Int>): (a: Int, b: Int, c: Int) {  --~ info: 2 checks of `def_chain` hold for every behaviour up to size 3
    --~^ info: the definedness checks of `def_chain` are not run by enumeration
    out a := if q[5] > 0 then 1 else 0
    out b := a
    out c := b
    expect e: c <= 1
}

-- A table of propositions without a row for every case reads its
-- unspecified value from a hidden slot of `Bool`s, which the Lean-hosted
-- front end used to keep as propositions, and could not decide.
set_option fren.evidence "enumerated" in
proc prop_table(n: Int) {  --~ error: `prop_table` is not realizable
    ensure q0: table {  --~ error: a table in `prop_table::q0` may have no row that holds
        | n = 1 => n > 2,
    }
}

-- A table of `Bool`s and one of propositions read the same unspecified
-- value, one hidden slot, as in the `fren` command: where neither has a
-- row that holds, `s` makes it true, and so `x?`.
set_option fren.evidence "enumerated" in
proc two_tables(b?): (x?) {  --~ error: `two_tables` is not realizable
    ensure r: x? = table {  --~ error: a table in `two_tables::r` may have no row that holds
        b? => true,
    }
    ensure s: table {  --~ error: a table in `two_tables::s` may have no row that holds
        b? => true,
    }
    expect e: when not b?, x?  --~ warning: `two_tables::e` rests on the realizability of `two_tables`, which did not pass
}

-- A count at a newtype over `Int` is read as its underlying values are:
-- through a function, inline, through a defined output and with an addend.
pub ordered struct Ms(Int)
pub fn indm(c?): Ms := if c? then Ms(1) else Ms(0)
set_option fren.lint.undecidable "allow" in
set_option fren.evidence "enumerated" in
proc ms_fn(q: Seq<Int>) {  --~ info: 2 checks of `ms_fn` hold for every behaviour up to size 3
    --~^ info: the definedness checks of `ms_fn` are not run by enumeration
    expect e: indm(q[5] > 0) <= Ms(1)
}

set_option fren.lint.undecidable "allow" in
set_option fren.evidence "enumerated" in
proc ms_inline(q: Seq<Int>) {  --~ info: 2 checks of `ms_inline` hold for every behaviour up to size 3
    --~^ info: the definedness checks of `ms_inline` are not run by enumeration
    expect e: (if q[5] > 0 then Ms(1) else Ms(0)) <= Ms(1)
}

set_option fren.lint.undecidable "allow" in
set_option fren.evidence "enumerated" in
proc ms_def(q: Seq<Int>): (k: Ms) {  --~ info: 2 checks of `ms_def` hold for every behaviour up to size 3
    --~^ info: the definedness checks of `ms_def` are not run by enumeration
    out k := if q[5] > 0 then Ms(1) else Ms(0)
    expect e: k <= Ms(1)
}

set_option fren.lint.nonminimal_bool "allow" in
set_option fren.lint.undecidable "allow" in
set_option fren.evidence "enumerated" in
proc ms_addend(q: Seq<Int>) {  --~ info: 2 checks of `ms_addend` hold for every behaviour up to size 3
    --~^ info: the definedness checks of `ms_addend` are not run by enumeration
    expect e: not ((if q[5] > 0 then Ms(1) else Ms(0)) + Ms(2) <= Ms(1))
}

-- `=` compares a newtype's values, and `<=` their fields, which are read
-- alike; and a newtype over `Nat` too.
pub ordered struct Cn(Nat)
set_option fren.lint.nonminimal_bool "allow" in
set_option fren.lint.undecidable "allow" in
set_option fren.evidence "enumerated" in
proc ms_eq(q: Seq<Int>): (k: Ms) {  --~ info: 2 checks of `ms_eq` hold for every behaviour up to size 3
    --~^ info: the definedness checks of `ms_eq` are not run by enumeration
    out k := Ms(2) + (if q[5] > 0 then Ms(1) else Ms(0))
    expect e: not (k = Ms(1))
}

set_option fren.lint.undecidable "allow" in
set_option fren.evidence "enumerated" in
proc cn_count(q: Seq<Int>) {  --~ info: 2 checks of `cn_count` hold for every behaviour up to size 3
    --~^ info: the definedness checks of `cn_count` are not run by enumeration
    expect e: (if q[5] > 0 then Cn(1) else Cn(0)) <= Cn(1)
}

-- A newtype of a newtype is read through to its underlying values, at any
-- depth: two and three deep.
pub ordered struct Mm(Ms)
pub ordered struct Mmm(Mm)
set_option fren.lint.undecidable "allow" in
set_option fren.evidence "enumerated" in
proc nested_inline(q: Seq<Int>) {  --~ info: 2 checks of `nested_inline` hold for every behaviour up to size 3
    --~^ info: the definedness checks of `nested_inline` are not run by enumeration
    expect e: (if q[5] > 0 then Mm(Ms(1)) else Mm(Ms(0))) <= Mm(Ms(1))
}

set_option fren.lint.undecidable "allow" in
set_option fren.evidence "enumerated" in
proc nested_def(q: Seq<Int>): (k: Mm) {  --~ info: 2 checks of `nested_def` hold for every behaviour up to size 3
    --~^ info: the definedness checks of `nested_def` are not run by enumeration
    out k := if q[5] > 0 then Mm(Ms(1)) else Mm(Ms(0))
    expect f: k <= Mm(Ms(1))
}

set_option fren.lint.nonminimal_bool "allow" in
set_option fren.lint.undecidable "allow" in
set_option fren.evidence "enumerated" in
proc nested_three(q: Seq<Int>): (k: Mmm) {  --~ info: 3 checks of `nested_three` hold for every behaviour up to size 3
    --~^ info: the definedness checks of `nested_three` are not run by enumeration
    out k := (if q[5] > 0 then Mmm(Mm(Ms(1))) else Mmm(Mm(Ms(0)))) + Mmm(Mm(Ms(2)))
    expect e: not (k = Mmm(Mm(Ms(1))))
    expect f: not (k <= Mmm(Mm(Ms(1))))
}

-- A `cover` that no behaviour up to the bound meets, beside a guarded
-- index: the search does not decide it.
set_option fren.evidence "enumerated" in
proc uncovered(q: Seq<Int>, n: Int): (ok?) {  --~ info: 1 check of `uncovered` holds for every behaviour up to size 3
    --~^ info: the definedness checks of `uncovered` are not run by enumeration
    ensure r: ok? iff (q != [] and q[0] > 0)
    -- The note, which says how the indexes were read, is what is tested.
    cover c: n > 100  --~ warning: note: enumeration searched every behaviour up to size 3, with each index out of range as `[][0]`, which does not decide it
}

--@ summary: 100 passed (81 by bounded enumeration), 20 failed, 8 inconclusive, 0 redundant
