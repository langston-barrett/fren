-- A spec that passes every check, using modules, imported variants, nesting
-- and arithmetic.
set_option fren.lint.chainable_comparison "allow"

mod climate

pub enum Mode { Off, Heat, Cool }
use self::Mode::{Cool, Heat, Off}

pub proc thermostat(temp: Int, target: Int): (mode: Mode, fan?) {
    assume sane: -50 <= temp and temp <= 150 and 50 <= target and target <= 90

    ensure heat: when temp < target - 2, mode = Heat
    ensure cool: when temp > target + 2, mode = Cool
    ensure idle: unless temp < target - 2 or temp > target + 2, mode = Off
    ensure fan: fan? iff mode != Off

    expect fan_when_cold: when temp < 0, fan?
    expect nested: when fan?, unless mode = Cool, temp < target
}

mod display
use climate::Mode
use climate::Mode::Heat

proc indicator(mode: Mode): (red?) {
    ensure red: red? iff mode = Heat
}

-- `if` is an operand without parentheses, including in a binding; its
-- `else` branch extends to the end.
proc brightness(mode: Mode, dim?): (level: Int) {
    ensure rule: level = if mode = Heat then 3 else if dim? then 1 else 2

    expect bounded: level >= 1 and level <= 3
}

-- `nonminimal_bool` would write the binding of `dim?` with `or`.
set_option fren.lint.nonminimal_bool "allow" in
proc panel(mode: Mode): (level: Int) {
    call b := brightness(mode, if mode = Mode::Off then true else mode = Mode::Cool)

    ensure same: level = b.level

    expect off_is_dim: when mode = Mode::Off, level = 1
}

