-- Checks decided by enumeration (`Reqs/Check#checking-by-enumeration`):
-- where every variable has finitely many values, within the size bound,
-- every behaviour is enumerated, and each verdict is the solver's, with
-- the smallest counterexample, in both front ends.
set_option fren.lint.redundant_bool_type "allow"

enum Mode { Off, Heat, Cool }
enum Level { Low, High }
struct Reading { level: Level, valid?: Bool }

set_option fren.evidence "enumerated" in
proc thermostat(mode: Mode, hot?): (det on?) {
    ensure r: on? iff (mode = Mode::Heat and not hot?)
    expect heats: when on?, mode = Mode::Heat
    expect cools: when mode = Mode::Cool, on?  --~ error: expectation `thermostat::cools` does not hold
    cover lit: on?  --~ info: witness: mode = Mode::Heat, hot? = false, on? = true
}

-- A record, a generic instance and a finite integer subset type.
type Trit = n: Int where invariant: n is 0..=2
set_option fren.evidence "enumerated" in
proc sensor(r: Reading, o: Option<Bool>, k: Trit): (det alarm?) {
    ensure a: alarm? iff (r.valid? and r.level = Level::High and k > 0)
    expect needs_valid: when alarm?, r.valid?
    expect missing: when k = 2, o != Option::None  --~ error: expectation `sensor::missing` does not hold
}

-- Not determined, vacuous, redundant and unrealizable, as the solver finds.
set_option fren.evidence "enumerated" in
proc loose(a?): (
    det b?,         --~ error: `loose::b?` is not determined by the inputs
) {
    ensure r: when a?, b?  --~ warning: `loose::r` is redundant
    ensure never: when a? and not a?, b?  --~ error: `loose::never` is vacuous
    ensure weaker: b? or not a?  --~ warning: `loose::weaker` is redundant
}

set_option fren.evidence "enumerated" in
proc stuck(a?): (b?) {  --~ error: `stuck` is not realizable
    ensure up: when a?, b?
    --~^ error: `stuck::up` is vacuous
    ensure down: when a?, not b?
    --~^ error: `stuck::down` is vacuous
}

-- An instance's assumption, and a table without `_` whose unspecified
-- value, a `Bool`, is enumerated too.
proc gate(m: Mode): (det open?: Bool) {
    assume on: m != Mode::Off
    out open? := table { | m = Mode::Heat => true, | m = Mode::Cool => false }
}

set_option fren.evidence "enumerated" in
proc user(m: Mode) {
    call g := gate(m)  --~ error: the assumption `on` of `gate` may not hold for call `user::g`
    expect follows: when m = Mode::Heat, g.open?
}

set_option fren.evidence "enumerated" in
expect same_input(
    x_mode: Mode,
    x_hot?,
    y_mode: Mode,
    y_hot?,
) {
    call x := thermostat(x_mode, x_hot?)
    call y := thermostat(y_mode, y_hot?)
    expect same_input: when x.mode = y.mode and x.hot? = y.hot?, x.on? = y.on?
}

-- A `det out` defined from an output that is not determined is not
-- determined either: its definition's slots are searched.
set_option fren.evidence "enumerated" in
proc nd(a?): (o?, det d?) {  --~ error: `nd::d?` is not determined by the inputs
    ensure r: when a?, o?
    out d? := o?
}

-- A quantifier over a listed type of many values, and a global
-- expectation, shown by its name.
type SixBit = n: Int where invariant: n is 0..=63
set_option fren.lint.assertions_on_constants "allow" in
set_option fren.evidence "enumerated" in
proc wide_quantifier(x?) {
    expect e: forall (k: SixBit), k < 63 or x?  --~ error: expectation `wide_quantifier::e` does not hold
}

type BoundedCount = n: Int where invariant: n is 0..=200
set_option fren.lint.assertions_on_constants "allow" in
set_option fren.evidence "enumerated" in
expect constant: forall (x: BoundedCount), x < 200  --~ error: expectation `constant` does not hold

--@ summary: 35 passed, 11 failed, 0 inconclusive, 2 redundant
