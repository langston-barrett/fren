-- Refinement with bindings whose indexes may be out of range, checked by
-- testing (`Reqs/Check#checking-by-testing`): testing runs no definedness
-- check, in both front ends, and reads the bindings' indexes where they are
-- in range. Only the `fren` command tests.
--@ only: cli

proc first_of(n: Int, x: Int): (y: Int) {
    assume pos: n > 0  --~[cli] warning: the assumption `pos` constrains only parameters that nothing uses
    ensure r: y = x
}

proc seqs(q: Seq<Int>): (s: Seq<Int>) { out s := q }

-- Not a definedness error, as it is with the solver
-- (`refinement_bindings.fren`): testing does not check definedness, and
-- says so (`F0654`).
set_option fren.evidence "random" in
expect unguarded(q: Seq<Int>) {  --~ info: the definedness checks of `unguarded` are not run by random testing
    assume spec_pos: (1) > 0  --~[cli] warning: this assumption mentions no variable
    call concrete := seqs(q)
    expect r: ((concrete.s)[0]) = ((q)[0])
}

-- Testing finds a sequence whose first element is not 0.
set_option fren.evidence "random" in
expect wrong(q: Seq<Int>) {  --~ info: the definedness checks of `wrong` are not run by random testing
    assume spec_pos: ((q).len) > 0  --~[cli] warning: say whether it is empty with `[]`, not `len`
    call concrete := seqs(q)
    expect r: (0) = (if (q) != [] then (q)[0] else 0)  --~[cli] error: expectation `wrong::r` does not hold
}

--@ summary: 7 passed (3 by random testing), 1 failed, 0 inconclusive, 0 redundant
