-- A size bound of enumeration above 64 is an error at the number, in both
-- front ends, and the default is used instead
-- (`Reqs/Check#checking-by-enumeration`).
type TwoBit = n: Int where invariant: n is 0..=3
set_option fren.enumeration.size 100 in  --~ error: enumeration size 100 is too large
set_option fren.evidence "enumerated" in
proc c(x: TwoBit): (det y: Int) {
    out y := x
    expect e: y >= 0
}

set_option fren.evidence "enumerated+guessed" in  --~ error: invalid evidence `enumerated+guessed`
proc d(x?): (det y?) { out y? := x? }

--@ exit: 2
