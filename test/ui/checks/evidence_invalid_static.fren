-- An invalid `fren.evidence` value is reported once, at the value, in both
-- front ends, and the items after it are elaborated as with "solver"
-- (`Reqs/Check#checking-by-testing`): `c` and `d` report nothing.

set_option fren.evidence "guess" in  --~ error: invalid evidence `guess`
proc a(x: Int): (y: Int) { ensure r: y = x }

proc b(x: Int): (
    set_option fren.evidence "guess" in y: Int,  --~ error: invalid evidence `guess`
) {
    ensure r: y = x
}

set_option fren.evidence "guess"  --~ error: invalid evidence `guess`

proc c(x: Int): (y: Int) { ensure r: y = x }

-- `a` was elaborated despite its setting.
proc d(x: Int): (y: Int) {
    call i := a(x)
    ensure r: y = i.y
}

--@ exit: 2
