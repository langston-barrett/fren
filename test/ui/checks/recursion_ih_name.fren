-- fren-covers: lang::recursive_facts
pub enum T { Z, S(T) }

pub fn size(t: T, recursive_ih: Int): (r: Int) {
    out r := match t {
        T::Z => 0,
        T::S(a) => 1 + size(a, recursive_ih),
    }
    ensure nonnegative: r >= 0
}

--@ summary: 1 passed, 0 failed, 0 inconclusive, 0 redundant
