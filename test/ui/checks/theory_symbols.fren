-- Names that are also symbols of the solver's theories, such as `abs`, and
-- an instance's `str.len`, are checked like any other names, in both front
-- ends (`Reqs/Cli#solver-queries`).

proc c(x: Int): (abs: Int, det exp: Int) {
    ensure r: abs = x
    ensure e: exp = x + 1

    expect same: abs - x = 0
    expect wrong: abs = exp  --~ error: expectation `c::wrong` does not hold
}

proc len_of(sqrt: Int): (det len: Int) {
    ensure r: len = sqrt.abs
}

proc through_instance(ite: Int): (det select: Int) {
    call str := len_of(ite)
    ensure r: select = str.len

    expect positive: select >= 0
}

pub struct Pair { a?, b? }

fn store(tuple: Pair): Int := if tuple.a? then 1 else 0

proc binders(sin: Int): (det xor?) {
    ensure r: xor? iff (forall (bag: Pair), store(bag) >= 0)
    expect always: xor?
    expect bound: let cos := sin + 1 in cos > sin
}

-- An abstract function, which the Lean front end declares as a local.
fn cos(Int): Int

proc abstract(x: Int): (det y: Int) {
    ensure r: y = cos(x)
    expect same: when x = 1, y = cos(1)
}

-- A counterexample names the variables as written, not as the solver
-- knows them.
proc shown(): (det abs: Int, det exp: Int) {
    ensure r: abs = 1 and exp = 2
    expect differ: abs = exp  --~ error: counterexample: abs = 1, exp = 2
}

