-- An application under an unbounded quantifier, whose arguments mention its
-- bound name, brings its facts for every value of the bound name: its
-- postconditions, and that a `Nat` result is at least 0. Without them, the
-- solver would find a counterexample to each expectation below. A fact over
-- every integer leaves cvc5 no finite model, so it gives up on whether the
-- guarantee is redundant, which needs one, in both front ends alike.

fn f(x: Int): (r: Int) {
    ensure pos: r > 0
}

fn h(Int): Nat

set_option fren.lint.undecidable "allow" in
proc posts(n: Int): (ok?) {
    ensure r: ok? iff (forall (i: Int), when 0 <= i < n, f(i) > 0)  --~ warning: could not decide whether `posts::r` is redundant

    expect holds: ok?
}

set_option fren.lint.undecidable "allow" in
proc nats(n: Int): (ok?) {
    ensure r: ok? iff (forall (i: Int), when 0 <= i < n, h(i) >= 0)  --~ warning: could not decide whether `nats::r` is redundant

    expect holds: ok?
}

-- A precondition is asked where the application is, for every value of the
-- bound name where its guard holds.
fn nth(q: Seq<Int>, i: Int): (r: Int) {
    assume in_range: 0 <= i < q.len
    out r := q[i]
}

set_option fren.lint.undecidable "allow" in
proc preconditions(q: Seq<Int>): (pos?) {
    ensure r: pos? iff (forall (i: Int), when 0 <= i < q.len, nth(q, i) > 0)
}
