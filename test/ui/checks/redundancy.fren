-- Redundant constraints are warnings, and are not checked where the
-- constraints are contradictory or the guarantee is vacuous (`check`).
-- fren-covers: check::minimal
set_option fren.lint.chainable_comparison "allow"

comp thermostat {
    in temp: Int
    in target: Int
    pub out heat?
    pub out cool?

    assume sane: target >= 5 and target <= 30
    assume warm: target >= 0             --~ warning: `thermostat::warm` is redundant: it follows from `sane`
    --~^ warning: `target` is never negative

    ensure heats: heat? iff temp < target - 2
    ensure cools: cool? iff temp > target + 2
    ensure exclusive: not (heat? and cool?)  --~ warning: `thermostat::exclusive` is redundant: it follows from `heats`, `cools`
    ensure trivial: heat? or not heat?      --~ warning: `thermostat::trivial` is redundant: it always holds
}

-- A vacuous guarantee is reported once, by the vacuity check.
comp vacuous {
    in x: Int
    pub out y: Int

    assume pos: x > 0

    ensure y_def: y = x
    ensure never: when x < 0, y = x         --~ error: `vacuous::never` is vacuous: its condition can never hold, given `pos`
}

-- Contradictory constraints entail everything: only realizability fails.
comp contradictory {  --~ error: note: no outputs satisfy `up` and `down`
    pub out y: Int

    ensure up: y > 0   --~ info: conflicts with `down`
    ensure down: y < 0   --~ info: conflicts with `up`
}

--@ summary: 7 passed, 2 failed, 0 inconclusive, 3 redundant
--@ exit: 1
