-- Opaque recursion with finite ground equations and contracts.
pub enum Expr { Val(Int), Add(Expr, Expr) }

-- Onto `Int`: `Val(n)` gives every value.
pub fn eval(e: Expr): Int := match e {
    Expr::Val(n) => n,
    Expr::Add(a, b) => eval(a) + eval(b),
}

pub fn fold(e: Expr): (r: Expr) {
    out r := match e {
        Expr::Val(n) => Expr::Val(n),
        Expr::Add(a, b) => match fold(a) {
            Expr::Val(x) => match fold(b) {
                Expr::Val(y) => Expr::Val(x + y),
                fb => Expr::Add(Expr::Val(x), fb),
            },
            fa => Expr::Add(fa, fold(b)),
        },
    }
    ensure keeps_value: eval(r) = eval(e)   --~ warning: could not decide whether the postcondition `keeps_value` of `fold` holds
    ensure off_by_one: eval(r) = eval(e) + 1   --~ error: the postcondition `off_by_one` of `fold` does not hold
}

proc values(e: Expr) {
    expect positive_add: when e is Expr::Add(Expr::Val(1), Expr::Val(2)), eval(e) = 3   --~ warning: could not decide whether `values::positive_add` holds
    expect not_five: when e is Expr::Val(_), eval(e) != 5   --~ error: expectation `values::not_five` does not hold
}
