-- Each check failing, with what it names (`check`).

comp exit {   --~ error: no outputs satisfy `failures` and `strict_inconc`
    in strict?
    in n_fail: Int
    in n_inconc: Int
    pub out code: Int
    out scratch: Int

    assume counts: n_fail >= 0 and n_inconc >= 0

    ensure failures: when n_fail > 0, code = 1                 --~ info: `failures` forces code = 1, but `strict_inconc` forces code = 2
    ensure strict_inconc: when strict? and n_inconc > 0, code = 2
    ensure clean: when n_fail = 0 and n_inconc = 0, code = 0
    ensure negative: when n_fail < 0, code = 3                 --~ error: `exit::negative` is vacuous: its condition can never hold, given `counts`
    ensure scratch_def: scratch = 2 * n_fail - (-1)  --~ warning: this negation can be the other operator

    expect inconc_passes: when n_fail = 0 and not strict?, code = 0
    --~^ error: expectation `exit::inconc_passes` does not hold
}

comp contradictory {  --~ error: the assumptions of `contradictory` are unsatisfiable: `big`, `small` contradict each other
    in x: Int
    in y: Int
    out ok?

    assume big: x > 10
    assume small: x < 5
    assume unrelated: y = 0

    ensure r: ok? iff x = y
}

--@ summary: 9 passed, 4 failed, 0 inconclusive, 0 redundant
--@ exit: 1
