-- A cover goal's query assumes what the natural numbers bring, as every
-- check's does: a `Nat` input is at least 0 in every witness.

proc counter(n: Nat): (empty?) {
    ensure r: empty? iff n = 0

    cover zero: n = 0 and empty?                   --~ info: cover goal `counter::zero` is met
    cover negative: n < 0                          --~ error: cover goal `counter::negative` cannot be met
}

--@ summary: 3 passed, 1 failed, 0 inconclusive, 0 redundant
