-- Both front ends pose a query alike, with cvc5's options and the
-- hypotheses in the same order, so that cvc5 decides it in both: here a
-- defined output in a relation's image, which cvc5 decides only with its
-- simplification, which lean-smt turns off by default (#173).
set_option fren.lint.assertions_on_constants "allow"
set_option fren.lint.constant_output "allow"

proc c(): (det g?) {  --~ warning: the determinism of `c::g?` rests on the realizability of `c`, which did not pass
    --~^ error: `c` is not realizable
    let s: Set<Int> := {1, 2}

    ensure r: {(0, 0), (1, 2)}.image(s inter {1}).card = 2
    cover goal: g?
    --~^ error: cover goal `c::goal` cannot be met: it is ruled out by `r`
}
