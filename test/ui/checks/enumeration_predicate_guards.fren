-- fren-covers: lang::named_node, lang::block_values
-- A guard below negation is checked as a whole expression. An inactive
-- predicate does not produce observations for its named members.
mod enumeration_predicate_guards
fn both?(a?, b?) := and { first: a?, second: b? }
set_option fren.evidence "enumerated" in
proc guarded(a?, b?, active?) {
    expect whole: not (when active?, both?(a?, b?))
    --~^ error: expectation `enumeration_predicate_guards::guarded::whole` does not hold
}

-- Solver evidence inside an enumerated procedure still observes natural
-- arguments at their declared type when reporting the predicate's members.
fn natural?(n: Nat) := and { first: n != 1, second: n = 0 }
--~^ info: `whole.enumeration_predicate_guards::natural?@1.first` is true
--~^^ info: `whole.enumeration_predicate_guards::natural?@1.second` is true
set_option fren.evidence "enumerated" in
proc natural(n: Nat) {
    --~^ info: 1 check of `enumeration_predicate_guards::natural` holds for every behaviour up to size 3
    set_option fren.evidence "solver" in
    expect whole: not natural?(n)
    --~^ error: expectation `enumeration_predicate_guards::natural::whole` does not hold
}
