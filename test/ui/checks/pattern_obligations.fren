-- The obligations of pattern types: each value given where one is
-- declared is checked to match its pattern, and fails where it may not.
-- fren-covers: check::subset_obligation, lang::subset_widening

type Byte = n: Int where invariant: n is 0..=255

enum Reading { Raw(Byte), Missing }
type RequiredTrue = value?: Bool where invariant: value?
struct Packet { length: Byte, ok?: RequiredTrue }
type Digit = n: Int where invariant: n is 0..=9
struct Level(Digit)

fn scale(b: Byte): Int := b * 2
fn size(Byte): Int

proc sub(b: Byte): (y: Int) {
    ensure r: y = b
}

proc values(x: Int): (y: Int, det d: Byte, det guarded: Byte) {
    assume newtype: Level(x) != Level(0)   --~ error: invariant `Digit::invariant` does not hold
    out d := x   --~ error: invariant `Byte::invariant` does not hold
    out guarded := if 0 <= x <= 255 then x else 0
    call w := sub(x)   --~ error: invariant `Byte::invariant` does not hold
    call v := sub(guarded)

    ensure args: y = scale(x) + size(x)   --~ error: invariant `Byte::invariant` does not hold
    --~^ error: invariant `Byte::invariant` does not hold
    expect guarded_args: when 0 <= x <= 255, scale(x) = 2 * x
    expect payload: Reading::Raw(x) != Reading::Missing   --~ error: invariant `Byte::invariant` does not hold
    expect field: Packet { length := 3, ok? := x > 0 }.length = 3   --~ error: invariant `RequiredTrue::invariant` does not hold
    expect update: { Packet { length := 3, ok? := true } with length := x }.ok?   --~ error: invariant `Byte::invariant` does not hold
    expect defined: (let b: Byte := x + 1 in b) > x   --~ error: invariant `Byte::invariant` does not hold
}

-- A refinement checks what the types of the abstract component's outputs
-- bring, as it checks its guarantees.
proc abstract_out(): (y: Byte) { ensure r: y != 7 }
proc concrete_out(): (y: Int) { ensure r: y = 300 }
expect wider() {
    call concrete := concrete_out()
    refines concrete abstract_out()  --~ error: expectation `wider::refines_1` does not hold
}
