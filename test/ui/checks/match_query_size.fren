pub enum Hir { C0(Hir), C1(Hir), C2(Hir), C3(Hir), C4(Hir), C5(Hir), C6(Hir), C7(Hir), C8(Hir), Unit }

pub proc query(e: Hir, q: Seq<Int>): (value: Int) {
    require nonempty: q != []
    require positive: q[0] >= 0
    out value := match e {
        Hir::C0(p) => match p {
            Hir::C0(_) => 1,
            Hir::C1(_) => 2,
            Hir::C2(_) => 3,
            Hir::C3(_) => 4,
            Hir::C4(_) => 5,
            Hir::C5(_) => 6,
            Hir::C6(_) => 7,
            Hir::C7(_) => 8,
            Hir::C8(_) => 9,
            Hir::Unit => q[0],
        },
        Hir::C1(p) => match p {
            Hir::C0(_) => 2,
            Hir::C1(_) => 3,
            Hir::C2(_) => 4,
            Hir::C3(_) => 5,
            Hir::C4(_) => 6,
            Hir::C5(_) => 7,
            Hir::C6(_) => 8,
            Hir::C7(_) => 9,
            Hir::C8(_) => 10,
            Hir::Unit => q[0] + 1,
        },
        Hir::C2(p) => match p {
            Hir::C0(_) => 3,
            Hir::C1(_) => 4,
            Hir::C2(_) => 5,
            Hir::C3(_) => 6,
            Hir::C4(_) => 7,
            Hir::C5(_) => 8,
            Hir::C6(_) => 9,
            Hir::C7(_) => 10,
            Hir::C8(_) => 11,
            Hir::Unit => q[0] + 2,
        },
        Hir::C3(p) => match p {
            Hir::C0(_) => 4,
            Hir::C1(_) => 5,
            Hir::C2(_) => 6,
            Hir::C3(_) => 7,
            Hir::C4(_) => 8,
            Hir::C5(_) => 9,
            Hir::C6(_) => 10,
            Hir::C7(_) => 11,
            Hir::C8(_) => 12,
            Hir::Unit => q[0] + 3,
        },
        Hir::C4(p) => match p {
            Hir::C0(_) => 5,
            Hir::C1(_) => 6,
            Hir::C2(_) => 7,
            Hir::C3(_) => 8,
            Hir::C4(_) => 9,
            Hir::C5(_) => 10,
            Hir::C6(_) => 11,
            Hir::C7(_) => 12,
            Hir::C8(_) => 13,
            Hir::Unit => q[0] + 4,
        },
        Hir::C5(p) => match p {
            Hir::C0(_) => 6,
            Hir::C1(_) => 7,
            Hir::C2(_) => 8,
            Hir::C3(_) => 9,
            Hir::C4(_) => 10,
            Hir::C5(_) => 11,
            Hir::C6(_) => 12,
            Hir::C7(_) => 13,
            Hir::C8(_) => 14,
            Hir::Unit => q[0] + 5,
        },
        Hir::C6(p) => match p {
            Hir::C0(_) => 7,
            Hir::C1(_) => 8,
            Hir::C2(_) => 9,
            Hir::C3(_) => 10,
            Hir::C4(_) => 11,
            Hir::C5(_) => 12,
            Hir::C6(_) => 13,
            Hir::C7(_) => 14,
            Hir::C8(_) => 15,
            Hir::Unit => q[0] + 6,
        },
        Hir::C7(p) => match p {
            Hir::C0(_) => 8,
            Hir::C1(_) => 9,
            Hir::C2(_) => 10,
            Hir::C3(_) => 11,
            Hir::C4(_) => 12,
            Hir::C5(_) => 13,
            Hir::C6(_) => 14,
            Hir::C7(_) => 15,
            Hir::C8(_) => 16,
            Hir::Unit => q[0] + 7,
        },
        Hir::C8(p) => match p {
            Hir::C0(_) => 9,
            Hir::C1(_) => 10,
            Hir::C2(_) => 11,
            Hir::C3(_) => 12,
            Hir::C4(_) => 13,
            Hir::C5(_) => 14,
            Hir::C6(_) => 15,
            Hir::C7(_) => 16,
            Hir::C8(_) => 17,
            Hir::Unit => q[0] + 8,
        },
        Hir::Unit => q[0],
    }
    expect bound: value >= 0
}
