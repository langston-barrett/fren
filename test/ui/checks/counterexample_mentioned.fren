-- A counterexample shows only the variables that the check's query
-- mentions (`Reqs/View#check-results`): `b` and `s` are in no formula.

set_option fren.lint.unused_variables "allow"
set_option fren.lint.unused_assumption "allow"

proc unmentioned(a: Int, b: Int, n: Nat, s: String): (p?) {
    assume pinned: a = -1
    assume small: n < 1
    ensure r: p? iff a > 0
    expect e: p?  --~ error: counterexample: a = -1, n = 0, p? = false
}

-- That a `Nat` is at least 0 is a formula of the query, so `n` is shown,
-- though nothing else mentions it.
proc nat_fact(a: Int, n: Nat) {
    assume pinned: a = -1
    expect e: a > 0  --~ error: counterexample: a = -1, n = 0
}

-- A variable that only an assumption mentions is shown.
proc assumed(a: Int, d: Int) {
    assume pinned: a = -1
    assume three: d = 3
    expect e: a > 0  --~ error: counterexample: a = -1, d = 3
}

--@ summary: 9 passed, 3 failed, 0 inconclusive, 0 redundant
--@ exit: 1
