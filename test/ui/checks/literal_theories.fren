-- Set and sequence literals, with no set or sequence type written anywhere
-- in the spec, still set the logic and options of the queries (`cli::logic`),
-- so that both front ends decide them.

proc small(x: Int): (p?) {
    ensure r: p? iff x in {1, 2}
    expect two: when x = 2, p?
}

proc single(x: Int): (p?) {
    ensure r: p? iff [x] = [1]
    expect one: when p?, x = 1
}

proc pair(x: Int): (p?) {
    ensure r: p? iff (x, 2) in {(1, 2), (3, 4)}
    expect one: when p?, x = 1
}
