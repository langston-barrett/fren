mod a

pub enum T { Leaf, Node(T) }

pub fn depth(t: T): (d: Int) {
    out d := match t {
        T::Leaf => 0,
        T::Node(u) => 1 + depth(u),
    }
    ensure nonneg: d >= 0
}

