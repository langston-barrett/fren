-- A string literal that looks like how an obligation might be marked is a
-- string, and its index's definedness is reported as an index's.
proc c(q: Seq<Int>, i: Int, x: String): (o?) {
    ensure e: o? iff (when x = "; fren-type 41-42", q[i] = 0)   --~ error: an index of `c::e` may be out of range
}
