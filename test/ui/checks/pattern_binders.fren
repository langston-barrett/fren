-- Guarantees whose conditions bind names are each one constraint, for
-- vacuity, redundancy and minimal sets (`Reqs/Lang/Expressions#binding-names`).
-- fren-covers: lang::pattern_binding

ordered struct Seconds(Nat)
enum Decision { GiveUp, RetryAfter(Seconds) }
const MAX_DELAY: Seconds := Seconds(30)

-- The README's retry policy, with its outcome as a `Decision`: the conflict
-- names the guarantees apart, though they read the same payload, and
-- `transient` forces the variant that the others rule out (`check::clash_notes`).
proc retry(transient?, retry_after: Seconds): (decision: Decision) {   --~ error: no outputs satisfy `transient`, `honor_server` and `latency_budget`
    ensure transient: decision != Decision::GiveUp iff transient?   --~ info: `transient` forces decision is Decision::RetryAfter(_), but `honor_server` and `latency_budget` force decision = Decision::GiveUp
    --~^? info: all hold: `transient.1` cannot hold, because `honor_server` and `latency_budget` forces it to be false
    --~^^? info: all hold: `transient.all` forces decision is Decision::RetryAfter(_), but `honor_server` and `latency_budget` force decision = Decision::GiveUp
    --~^^^? info: no branch of `transient` can hold
    --~^^^^? info: none hold is impossible under the fixed hypotheses
    --~^^^^^? info: none hold: `transient.2` must hold, because the fixed hypotheses forces it to be true
    ensure honor_server: when decision is Decision::RetryAfter(d), d >= retry_after   --~ info: conflicts with `transient` and `latency_budget`
    ensure latency_budget: when decision is Decision::RetryAfter(d), d <= MAX_DELAY   --~ info: conflicts with `transient` and `honor_server`
}

-- The trigger is the condition with `_` for the binder, and a nested
-- condition reads the payload.
proc vacuous(): (decision: Decision) {
    ensure gives_up: decision = Decision::GiveUp
    ensure never: when decision is Decision::RetryAfter(d), d >= Seconds(1)   --~ error: `vacuous::never` is vacuous: its condition can never hold, given `gives_up`
}

proc nested_vacuous(): (decision: Decision) {
    ensure short: when decision is Decision::RetryAfter(d), d <= Seconds(5)
    ensure never: when decision is Decision::RetryAfter(d) and d > Seconds(10), d = Seconds(11)   --~ error: `nested_vacuous::never` is vacuous: its condition can never hold, given `short`
}

-- One such guarantee follows from another.
proc redundant(): (decision: Decision) {
    ensure tight: when decision is Decision::RetryAfter(d), d <= Seconds(5)
    ensure loose: when decision is Decision::RetryAfter(d), d <= Seconds(10)   --~ warning: `redundant::loose` is redundant: it follows from `tight`
}

--@ summary: 14 passed, 3 failed, 0 inconclusive, 1 redundant
