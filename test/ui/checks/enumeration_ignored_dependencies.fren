-- Ignored operands remain source questions, not enumeration dependencies.
-- The source-site companion is ignored_argument_sites.fren.
set_option fren.evidence "enumerated"
set_option fren.lint.unused_variables "allow"
set_option fren.lint.assertions_on_constants "allow"
set_option fren.lint.let_and_return "allow"

pub fn unknown(Int): Int
pub fn generic<T>(T): T
fn ignore?<T>(value: T) := true
fn identity<T>(value: T): T := value

proc ordinary() { expect e: ignore?(unknown(0)) }

proc generic_argument() { expect e: ignore?(generic(true)) }

proc nested() { expect e: ignore?(identity(let n := unknown(0) in n)) }

proc defined(): (det result?) {
    out result? := ignore?(generic(true))
    expect e: result?
}

pub enum Step { Z, S(Step) }

fn walk?(s: Step, q: Seq<Int>) := match s {
    Step::Z => ignore?(if q != [] then q[0] else 0),
    Step::S(rest) => walk?(rest, q),
}

proc recursive_argument() { expect e: walk?(Step::S(Step::Z), [0]) }
