-- Procedures that enumeration does not check, in both front ends
-- (`Reqs/Check#checking-by-enumeration`): too many behaviours, a variable
-- with too many values, refused before they are listed. Each is an error
-- at the procedure, and its checks set to enumeration are not run; its
-- other checks are.
set_option fren.lint.undecidable "allow"

type FirstPercent = n: Int where invariant: n is 0..=99
type SecondPercent = n: Int where invariant: n is 0..=99
type ThirdPercent = n: Int where invariant: n is 0..=99
set_option fren.evidence "enumerated" in
proc wide(a: FirstPercent, b: SecondPercent, c: ThirdPercent): (det sum: Int) {  --~ error: `wide` has 1000000 behaviours up to size 3, too many to enumerate
    out sum := a + b + c
    expect e: sum >= 0
}

-- Sequences of sequences of integers: more than 65536 values of size at
-- most 3, so they are not listed.
set_option fren.evidence "enumerated" in
proc nested(rows: Seq<Seq<Int>>): (empty?) {  --~ error: `nested` has a slot whose type, without its invariants, has more than 65536 values up to size 3, too many to enumerate
    ensure r: empty? iff rows = []
}

-- A quantifier over a type with too many values up to the bound.
set_option fren.evidence "enumerated" in
proc big(): (t?) {  --~ error: `big` has a quantifier over a type with more than 65536 values up to size 3, too many to enumerate
    ensure r: t? iff (forall (q: Seq<Seq<Int>>), q != [[7]])
}

-- The unspecified value of a table's type that a definition reads is a
-- slot too, counted alike in both front ends.
type InputByte = n: Int where invariant: n is 0..=255
type OtherByte = n: Int where invariant: n is 0..=255
set_option fren.evidence "enumerated" in
proc hidden(x: InputByte, y: OtherByte): (det d: Int) {  --~ error: `hidden` has 458752 behaviours up to size 3, too many to enumerate
    out d := table {
        | x = 0 => 1,
    }
    expect e: x + y >= 0
}

-- Only its expectation is enumerated; the solver checks the rest.
proc partly(rows: Seq<Seq<Int>>): (empty?) {  --~ error: `partly` has a slot whose type, without its invariants, has more than 65536 values
    ensure r: empty? iff rows = []
    set_option fren.evidence "enumerated" in
    expect e: when empty?, rows = []
}

--@ summary: 7 passed, 0 failed, 0 inconclusive, 0 redundant
