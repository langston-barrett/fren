-- Quantifiers under enumeration, in both front ends
-- (`Reqs/Check#quantifiers-up-to-the-bound`): a bound name ranges over its
-- guard's domain, or else over its type's values up to the bound, and the
-- quantifier is true, false or unknown. An unknown one leaves its check
-- inconclusive at the bound, not passed.
set_option fren.lint.undecidable "allow"
-- The same expectation, checked by each method.
set_option fren.lint.duplicate_constraint "allow"

enum Mode { Off, On }
type Bit = b: Int where invariant: b is 0..=1

-- False within the bound: the counterexample is genuine.
set_option fren.evidence "enumerated" in
proc small_witness(k: Int): (all?) {  --~ info: 1 check of `small_witness` holds for every behaviour up to size 3
    ensure r: all? iff (forall (x: Int), x != k)
    expect wrong: all?  --~ error: counterexample: k = 0, all? = false
}

-- True up to the bound, but `Int` is not exhausted: unknown, not true.
set_option fren.evidence "enumerated" in
proc unknown_universal(): (all?) {  --~ warning: could not decide whether `unknown_universal` is realizable: a quantifier is undecided up to size 3
    ensure r: all? iff (forall (x: Int), x + 1 > x)  --~ warning: could not decide whether `unknown_universal::r` is redundant: a quantifier is undecided up to size 3
    expect holds: all?  --~ warning: could not decide whether `unknown_universal::holds` holds: a quantifier is undecided up to size 3
}

-- Over an exhausted type a quantifier is decided.
set_option fren.evidence "enumerated" in
proc finite_exists(m: Mode): (some?) {
    ensure r: some? iff (exists (n: Mode), n != m)
    expect holds: some?
}

-- An `exists` true within the bound is true.
set_option fren.evidence "enumerated" in
proc found(): (some?) {
    ensure r: some? iff (exists (x: Int), x > 2)
    expect holds: some?
}

-- Guards give domains: a set's members, a sequence's elements, and ranges.
set_option fren.evidence "enumerated" in
proc members(s: Set<Bool>): (all?) {
    ensure r: all? iff (forall (x?: Bool), when x? in s, x?)
    expect wrong: when all?, true in s  --~ error: counterexample: s = {}, all? = true
}

set_option fren.evidence "enumerated" in
proc elements(q: Seq<Bool>): (all?) {  --~ info: 1 check of `elements` holds for every behaviour up to size 3
    ensure r: all? iff (forall (x?: Bool), when x? in q, x?)
    expect wrong: all?  --~ error: counterexample: q = [false], all? = false
}

set_option fren.evidence "enumerated" in
proc ranges(k: Int): (below?) {  --~ info: 1 check of `ranges` holds for every behaviour up to size 3
    ensure r: below? iff (forall (i: Int), when 0 <= i < 3, i < k)
    expect wrong: below?  --~ error: counterexample: k = 0, below? = false
}

set_option fren.evidence "enumerated" in
proc naturals(k: Int): (below?) {  --~ info: 1 check of `naturals` holds for every behaviour up to size 3
    ensure r: below? iff (forall (n: Nat), when n < 2, n < k)
    expect wrong: not below?  --~ error: counterexample: k = 2, below? = true
}

-- A pattern type's values are those it matches.
set_option fren.evidence "enumerated" in
proc patterned(k: Int): (all?) {  --~ info: 1 check of `patterned` holds for every behaviour up to size 3
    ensure r: all? iff (forall (b: Bit), b <= k)
    expect wrong: all?  --~ error: counterexample: k = 0, all? = false
}

-- Nested quantifiers: the inner one is decided, the outer true within the
-- bound.
set_option fren.evidence "enumerated" in
proc nested(m: Mode): (some?) {
    ensure r: some? iff (exists (x: Int), forall (n: Mode), x > 0 or n = m)
    expect holds: some?
}

-- A quantifier in a value: `n` is known wherever the condition is.
set_option fren.evidence "enumerated" in
proc valued(k: Int): (det n: Int) {  --~ info: 3 checks of `valued` hold for every behaviour up to size 3
    out n := if (forall (x: Int), x != k) then 1 else 2
    expect two: n = 2
}

-- A defined output whose value is unknown: whether it is the same in two
-- behaviours is unknown too. Here it is not: `d?` is true where `y = 1`,
-- and false where `y = 0`, at `x = 10`, beyond the bound.
set_option fren.evidence "enumerated" in
proc defined_unknown(): (y: Int, det d?) {  --~ info: 1 check of `defined_unknown` holds for every behaviour up to size 3
    --~^ warning: could not decide whether `defined_unknown::d?` is determined by the inputs: a quantifier is undecided up to size 3
    ensure r: 0 <= y <= 1
    out d? := forall (x: Int), y = 1 or x != 10
}

-- With the solver: it proves what enumeration leaves unknown.
proc proved(): (all?) {
    ensure r: all? iff (forall (x: Int), x + 1 > x)
    expect by_solver: all?
    set_option fren.evidence "enumerated" in
    expect by_enumeration: all?  --~ warning: could not decide whether `proved::by_enumeration` holds: a quantifier is undecided up to size 3
}

-- Both refute what is false within the bound.
proc refuted(k: Int): (none?) {
    ensure r: none? iff (forall (x: Int), x != k)
    expect by_solver: none?  --~ error: counterexample: k = 0, none? = false
    set_option fren.evidence "enumerated" in
    expect by_enumeration: none?  --~ error: counterexample: k = 0, none? = false
}

--@ summary: 33 passed (9 by bounded enumeration), 8 failed, 5 inconclusive, 0 redundant
