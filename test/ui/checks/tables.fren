-- The completeness and disjointness of tables (`check::completeness`,
-- `check::disjointness`): where they fail, with a counterexample or a
-- witness, at the table or at the later row.
set_option fren.lint.dead_code "allow"

proc incomplete(x: Int): (y: Int) {
    ensure r: y = table { x > 0 => 1, x < 0 => -1 }   --~ error: a table in `incomplete::r` may have no row that holds
}

proc overlapping(x: Int): (y: Int) {
    ensure r: y = table {
        | x >= 0 => 1,
        | x <= 0 => -1,   --~ error: rows 1 and 2 of a table in `overlapping::r` may both hold
        | _ => 0,   --~ error: row 3 of a table in `overlapping::r` is never the first that holds
    }
}

-- Each pair of rows is its own check; rows with the same value still
-- overlap.
proc pairs(x: Int): (y: Int) {
    ensure r: y = table { x > 0 => 1, x > 1 => 1, x > 2 => 2, _ => 0 }
    --~^ error: rows 1 and 2 of a table in `pairs::r` may both hold
    --~^^ error: rows 1 and 3 of a table in `pairs::r` may both hold
    --~^^^ error: rows 2 and 3 of a table in `pairs::r` may both hold
    --~^^^^ error: row 2 of a table in `pairs::r` is never the first that holds
    --~^^^^^ error: row 3 of a table in `pairs::r` is never the first that holds
}

-- Rows overlap only where both conditions have values: `q[0] > 0` is
-- evaluated only where `q != []`, so it does not overlap the first row.
proc guarded_rows(q: Seq<Int>): (y: Int) {
    ensure r: y = table { q = [] => 0, q[0] > 0 => 1, _ => 2 }
}

-- The guard of a table is that of an index: here, only `x > 0`.
proc guarded(x: Int): (y: Int) {
    ensure r: when x > 0, y = table { x > 5 => 2, x < 3 => 1 }   --~ error: a table in `guarded::r` may have no row that holds
}

-- An assumption's table is checked under the other assumptions only.
proc assumed(x: Int, y: Int): (o: Int) {
    assume nonneg: y >= 0
    --~^ warning: `y` is never negative, so it can be a `Nat`
    assume r: table { y = 0 => x < 0, y > 0 => x >= 0 }
    assume s: table { x > 5 => y > 5 }   --~ error: a table in `assumed::s` may have no row that holds

    ensure uses: o = x + y
}

-- In a quantifier's body, a table is checked at each instance.
enum Side { Left, Right }

proc sides(x: Int): (y?) {
    ensure r: y? iff (forall (s: Side), table { s = Side::Left => x > 0 })   --~ error: a table in `sides::r` may have no row that holds
}

-- In a function's body, a table is checked for every argument.
fn half(x: Int): Int := table { x > 0 => x div 2 }   --~ error: a table in `half` may have no row that holds

const K: Int := table { 1 < 2 => 1, 2 < 3 => 2 }   --~ error: rows 1 and 2 of a table in `K` may both hold
--~^ error: row 2 of a table in `K` is never the first that holds

-- A constant whose value reads a table where no row holds, or an index
-- out of range, has the interpretation's value: the evaluator still reads
-- the spec, and confirms the models of the components that mention it.
const B: Bool := table { 1 > 2 => true }   --~ error: a table in `B` may have no row that holds
--~^ error: row 1 of a table in `B` is never the first that holds
const OUT: Int := [1, 2][5]

proc mentions_unknown(x: Int): (y?, z: Int) {
    ensure r: y? iff (B or x > 0)
    ensure s: z = OUT + x
}

-- A table of an abstract type, whose value where no row holds is its
-- `[][0]`, in Lean too.
type Name

fn same?(Name, Name)

proc pick(a: Name, b: Name): (w: Name) {
    out w := table { same?(a, b) => a }   --~ error: a table in `pick::w` may have no row that holds
}

-- In a global expectation, under its assumptions and calls.
proc counter(n: Int): (m: Int) {
    ensure r: m = n + 1
}

-- Where no row holds, the table's value is unknown, so the expectation
-- does not follow either.
expect positive(c_n: Int) {
    call c := counter(c_n)
    expect positive: table { c.m > 0 => true, c.n < -1 => true }  --~ warning: every row of this table has a value written the same
    --~^ error: a table in `positive::positive` may have no row that holds
    --~^^ error: expectation `positive::positive` does not hold
}

-- Disjointness leaves out the constraint that the table is in, as
-- reachability does: `r` rules out `y > 0`, where both rows hold, only
-- through the table's own value.
proc enclosing(): (y: Int) {
    ensure r: y = table {
        y > 0 => 0,
        y >= 0 => 0,   --~ error: rows 1 and 2 of a table in `enclosing::r` may both hold
        _ => -1,
    }
}

--@ summary: 57 passed, 20 failed, 0 inconclusive, 0 redundant
