-- `det out` and the determinism check (`check::determinism`).
set_option fren.lint.chainable_comparison "allow"

enum Mode { Off, Heat, Cool }

use Mode::{Cool, Heat, Off}

proc chooser(temp: Int): (
    det mode: Mode,
    fan?,                   -- not `det`: not checked
) {
    --~^ warning: unused variable `fan?`

    ensure heat: when temp < 18, mode = Heat
    ensure cool: when temp > 24, mode = Cool
    ensure off: when temp >= 18 and temp <= 24, mode = Off
}

proc loose(temp: Int): (
    det level: Int,         --~ error: `loose::level` is not determined by the inputs
) {
    det exists scratch: Int    -- private, but determined

    ensure above: level >= temp
    ensure below: level <= temp + 1
    ensure scratch_def: scratch = 2 * temp
}

-- Determined by the inputs only if the instance's output is.
proc wraps(temp: Int): (
    det mode: Mode,
    det level: Int,         --~ error: `wraps::level` is not determined by the inputs
) {
    call c := chooser(temp)
    call l := loose(temp)

    ensure mode_def: mode = c.mode
    ensure level_def: level = l.level
}

--@ summary: 17 passed, 2 failed, 0 inconclusive, 0 redundant
--@ exit: 1
