-- Refinement with bindings (`Reqs/Lang/Refinement#bindings`): both front
-- ends read the abstract component's variables through the bindings the
-- same way.

proc exit_status(ran?): (code: Int) {
    ensure not_run: code = 2 iff not ran?
    ensure documented: code is 0..=3
}

proc fmt_exit(all_parsed?, changed?): (code: Int) {
    ensure r: code = (if not all_parsed? then 2 else if changed? then 1 else 0)
}

proc bad_exit(all_parsed?): (code: Int) {
    ensure r: code = (if not all_parsed? then 2 else 4)
}

-- Holds only through the binding: `fmt_exit` has no `ran?`.
expect holds(all_parsed?, changed?) {
    call concrete := fmt_exit(all_parsed?, changed?)
    refines concrete exit_status((all_parsed?))
}
expect fails(all_parsed?) {
    call concrete := bad_exit(all_parsed?)
    refines concrete exit_status((all_parsed?))  --~ error: expectation `fails::refines_1` does not hold
}

enum Level { Allow, Warn, Forbid }

-- An abstraction function, and an output read through an expression.
proc forbidding(forbidden?): (stops?) {
    ensure r: stops? iff forbidden?
}

proc stops(level: Level): (failures: Int) {
    ensure f: failures = (if level = Level::Forbid then 1 else 0)
}

expect abstraction(level: Level) {
    use Level
    call concrete := stops(level)
    expect r: ((concrete.failures) > 0) iff ((level) = Level::Forbid)
}

-- The indexes of a binding are checked where it is read: an input's under
-- the assumptions, an output's under the assumptions and the instances.
proc first_of(n: Int, x: Int): (y: Int) {
    assume pos: n > 0  --~ warning: the assumption `pos` constrains only parameters that nothing uses
    ensure r: y = x
}

proc seqs(q: Seq<Int>): (s: Seq<Int>) {
    out s := q
}

expect guarded(q: Seq<Int>) {
    assume spec_pos: ((q).len) > 0  --~ warning: say whether it is empty with `[]`, not `len`
    call concrete := seqs(q)
    expect r: ((concrete.s)[0]) = (if (q) != [] then (q)[0] else 0)
}
expect unguarded(q: Seq<Int>) {
    assume spec_pos: (1) > 0  --~ warning: this assumption mentions no variable
    call concrete := seqs(q)
    expect r: ((concrete.s)[0]) = ((q)[0])  --~ error: an index of `unguarded::r` may be out of range
    --~^ error: an index of `unguarded::r` may be out of range
}

-- Swapped bindings: each input of `a` is read as the other input of `c`.
proc difference(x: Int, y: Int): (d: Int) { ensure r: d = x - y }
proc reversed(x: Int, y: Int): (d: Int) { ensure r: d = y - x }

expect swapped(x: Int, y: Int) {
    call concrete := reversed(x, y)
    refines concrete difference((y), (x))
}
expect unswapped(x: Int, y: Int) {
    call concrete := reversed(x, y)
    refines concrete difference(x, y)  --~ error: expectation `unswapped::refines_1` does not hold
}

--@ summary: 33 passed, 4 failed, 0 inconclusive, 0 redundant
