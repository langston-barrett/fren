-- The notes of an unrealizable component's guarantees that force an
-- output of an enumeration to values of different variants
-- (`check::clash_notes`), where a side forces only a variant.
-- fren-covers: check::clash_notes

enum Shape { Circle(Int), Square(Int), Rect(Int, Int), Empty }

-- Each guarantee forces only a variant, a different one.
proc variants(): (s: Shape) {   --~ error: no outputs satisfy `round` and `square`
    ensure round: s is Shape::Circle(_)   --~ info: `round` forces s is Shape::Circle(_), but `square` forces s is Shape::Square(_)
    ensure square: s is Shape::Square(_)
}

-- The payload depends on an input, but the variant relationship is general.
proc mixed(x: Int): (s: Shape) {   --~ error: no outputs satisfy `one` and `boxy`
    ensure one: s = Shape::Circle(x)   --~ info: `one` forces s is Shape::Circle(_), but `boxy` forces s is Shape::Rect(_, _)
    ensure boxy: s is Shape::Rect(_, _)
}

-- A variant without a payload has one value, which a side that forces
-- the variant forces.
proc empty(): (s: Shape) {   --~ error: no outputs satisfy `square` and `none`
    ensure square: s is Shape::Square(_)   --~ info: `square` forces s is Shape::Square(_), but `none` forces s = Shape::Empty
    ensure none: not (s is Shape::Circle(_) | Shape::Square(_) | Shape::Rect(_, _))
}

-- Of the same variant: `one` forces a value, `other` only the variant, so
-- they do not clash.
proc same_variant(x: Int): (s: Shape) {   --~ error: no outputs satisfy `one` and `other`
    ensure one: s = Shape::Circle(x)
    ensure other: s is Shape::Circle(_) and s != Shape::Circle(x)
}

-- A variable of an abstract type: the values would depend on its
-- interpretation, so no note.
type Token

proc abstract(t: Token, u: Token): (s: Shape) {   --~ error: no outputs satisfy `round` and `square`
    ensure round: s is Shape::Circle(_) and t = u
    ensure square: s is Shape::Square(_)
}

-- An output of a subset type over an enumeration.
type Roundish = shape: Shape where invariant: shape is Shape::Circle(_) | Shape::Rect(_, _)

proc patterned(): (s: Roundish) {   --~ error: no outputs satisfy `round` and `boxy`
    ensure round: s is Shape::Circle(_)   --~ info: `round` forces s is Shape::Circle(_), but `boxy` forces s is Shape::Rect(_, _)
    ensure boxy: s is Shape::Rect(_, _)
}
-- A generic enumeration: its constructors and selectors take the type's
-- arguments.
enum Opt<T> { Nothing, Just(T) }

proc generic(): (g: Opt<Int>) {   --~ error: no outputs satisfy `one` and `two`
    ensure one: g is Opt::Just(_)   --~ info: `one` forces g is Opt::Just(_), but `two` forces g = Opt::Nothing
    ensure two: not (g is Opt::Just(_))
}
--@ exit: 1
