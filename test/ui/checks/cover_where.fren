-- A cover goal may end with a `where` clause, as any other constraint.
proc heater(temp: Int): (alarm?) {
    ensure r: alarm? iff hot? where limit := 100, hot? := temp > limit   --~ info: Assuming the cover goal `silent`, `r` cannot hold.
    --~^ info: Both operands of `r` cannot be true:
    --~^^ info: Both operands of `r` cannot be false:

    cover overheat: hot? and alarm? where hot? := temp > 100
    --~^ info: witness: temp = 101, alarm? = true
    cover silent: hot? and not alarm? where hot? := temp > 100
    --~^ error: cover goal `heater::silent` cannot be met: it is ruled out by `r`
}

--@ summary: 3 passed, 1 failed, 0 inconclusive, 0 redundant
