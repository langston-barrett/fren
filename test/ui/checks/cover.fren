-- Cover goals (`Reqs/Check#cover-goals`): scenarios that a component must
-- allow, each met by a witness or ruled out by its constraints.

proc heater(temp: Int): (alarm?) {
    assume sane: temp < 1000
    exists margin: Int

    ensure r: alarm? iff temp > 100
    --~^? info: case "both operands are true" is impossible under the existing constraints
    --~^^? info: case "both operands are true": `r.1` must be true, but is false under the existing constraints
    --~^^^? info: no branch of `r` can hold
    --~^^^^? info: case "both operands are false" is impossible under the existing constraints
    --~^^^^^? info: case "both operands are false": `r.2` must be false, but is true under the existing constraints
    ensure m: margin = temp - 100

    cover overheat: temp > 100 and alarm?          --~ info: cover goal `heater::overheat` is met
    cover silent: temp > 100 and not alarm?        --~ error: cover goal `heater::silent` cannot be met: it is ruled out by `r`
    cover boiling: temp > 2000                     --~ error: cover goal `heater::boiling` cannot be met: it is ruled out by `sane`
    -- A goal may mention a private output, as an expectation may.
    cover small_margin: margin = 1                 --~ info: cover goal `heater::small_margin` is met
}

-- A goal is checked only in its own component: an instance of `heater`
-- does not check `silent` again. A goal over an instance's variables
-- checks the instance's guarantees in context.
proc panel(t: Int): (lit?) {
    assume sane: t < 1000

    call h := heater(t)

    ensure shows: lit? iff h.alarm?
    --~^? info: case "both operands are true": `shows.2` must be true, but must be false to satisfy `h`
    --~^^? info: case "both operands are true" requires h.alarm? = true, but `h` forces h.alarm? = false
    --~^^^? info: no branch of `shows` can hold
    --~^^^^? info: case "both operands are false" is impossible under the existing constraints
    --~^^^^^? info: case "both operands are false": `shows.1` must be false, but is true under the existing constraints

    cover lit_when_hot: lit? and t > 500           --~ info: cover goal `panel::lit_when_hot` is met
    cover lit_when_cold: lit? and t < 0            --~ error: cover goal `panel::lit_when_cold` cannot be met
}

-- Contradictory guarantees rule out every goal, as they fail realizability.
proc stuck(x: Int): (y: Int) {                                       --~ error: `stuck` is not realizable
    ensure a: y > x   --~ info: conflicts with `b`
    ensure b: y < x   --~ info: conflicts with `a`

    cover any: true                                --~ error: cover goal `stuck::any` cannot be met: it is ruled out by `a`, `b`
    --~^ warning: this cover goal mentions no variable
}

--@ summary: 11 passed, 5 failed, 0 inconclusive, 0 redundant
