-- A refinement's bindings are part of a component (`Reqs/Lang/Decidability#relations`):
-- counting in a binding, where `c` applies a relational operator, is
-- outside the decidable core, as in a component.

enum E { A, B }

proc related(r: Rel<E, E>, s: Set<E>): (t: Rel<E, E>, size: Int) {
    out t := r join r
    ensure c: size = 0 iff s = {}
}

proc counted(n: Int): (size: Int) { assume pos: n >= 0 ensure r: size = 0 or n > 0 }

refine counts: related refines counted { n := s.card }
--~^ error: the solver does not reliably combine counting with relational operators

-- Without counting, the same refinement is in the core.
proc membered(has_a?): (size: Int) { ensure r: when has_a?, size != 0 }

refine members: related refines membered { has_a? := E::A in s }

--@ exit: 2
