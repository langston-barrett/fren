-- A refinement without bindings is checked as a component, so the mix of
-- relational operators and counting is a component's
-- (`Reqs/Lang/Decidability#relations`): a counting `c` with a relational
-- `a`, or the reverse, is outside the decidable core.
set_option fren.lint.chainable_comparison "allow"

enum E { A, B }

proc counting(r: Rel<E, E>, s: Set<E>): (n: Int, has_aa?) {
    ensure c: n = s.card
    ensure h: has_aa? iff (E::A, E::A) in r
}

proc relating(r: Rel<E, E>, s: Set<E>): (n: Int) {
    ensure j: when (r join r) = r, n >= 0
    ensure k: when E::A in s, n >= 0
}

refine counts_relates: counting refines relating
--~^ error: the solver does not reliably combine counting with relational operators

proc bounded(s: Set<E>): (n: Int) { ensure c: n <= s.card }

proc joined(r: Rel<E, E>, s: Set<E>): (n: Int, closed?, has_a?) {
    ensure z: n < 1 and n > -1
    ensure j: closed? iff (r join r) = r
    ensure h: has_a? iff E::A in s
}

refine relates_counts: joined refines bounded
--~^ error: the solver does not reliably combine counting with relational operators

--@ exit: 2
