-- Quantifiers in the guards and values of a table over a scrutinee: their
-- definedness goals, and the table's own questions, hold for every value
-- of an unbounded bound name and in every instance of a listed one, with no
-- bound name left in a query.
enum Mode { Off, On }

set_option fren.lint.undecidable "allow" in
proc in_tables(m: Mode, q: Seq<Int>): (y: Int) {
    ensure r: y = table m {
        Mode::Off if (forall (i: Int), when 0 <= i < q.len, q[i] > 0) => 1,
        Mode::Off if not (forall (i: Int), when 0 <= i < q.len, q[i] > 0) => 2,
        Mode::On if (exists (k: Mode), k = m and q != []) => if (forall (b?: Bool), b? or not b?) then 3 else 4,
        Mode::On if q = [] => 5,
    }

    expect empty_off: when m = Mode::Off and q = [], y = 1
    expect on: when m = Mode::On and q != [], y = 3
}

-- An index out of range in a guard's quantifier, for some value of its
-- bound name.
set_option fren.lint.undecidable "allow" in
proc out_of_range(m: Mode, q: Seq<Int>): (y: Int) {
    ensure r: y = table m {
        Mode::Off if (forall (i: Int), when 0 <= i <= q.len, q[i] > 0) => 1,  --~ error: an index of `out_of_range::r` may be out of range
        _ => 2,
    }
}
