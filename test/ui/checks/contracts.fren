-- The precondition check at each application, and the postcondition
-- check of a defined function (`check::precondition`,
-- `check::postcondition`): where they fail, with a counterexample, at the
-- applied function's name or at the postcondition's.
set_option fren.lint.dead_code "allow"

fn nth(q: Seq<Int>, i: Int): (r: Int) {
    assume in_range: 0 <= i < q.len
    out r := q[i]
}

proc unguarded(q: Seq<Int>): (y: Int) {
    ensure r: y = nth(q, 0)  --~ error: the precondition `in_range` of `nth` may not hold at this application in `unguarded::r`
}

-- An assumption's application is checked under the other assumptions.
proc assumed(q: Seq<Int>, i: Int): (y: Int) {
    assume valid: 0 <= i < q.len
    assume positive: nth(q, i) > 0
    assume first: nth(q, 1) > 0  --~ error: the precondition `in_range` of `nth` may not hold at this application in `assumed::first`

    ensure r: y = nth(q, i)
}

-- Each application of a function with two preconditions is two checks.
fn ratio(a: Int, b: Int): (r: Int) {
    assume nonneg: a >= 0
    assume nonzero: b != 0
    out r := a + b
}

proc ratios(a: Int, b: Int): (y: Int) {
    assume a_nonneg: a >= 0  --~ warning: `a` is never negative
    ensure r: y = ratio(a, b)  --~ error: the precondition `nonzero` of `ratio` may not hold at this application in `ratios::r`
}

-- A postcondition that the body does not meet.
fn decrement(n: Int): (r: Int) {
    assume positive: n > 0
    out r := n - 1
    ensure natural: r >= 0
    ensure wrong: r > 0  --~ error: the postcondition `wrong` of `decrement` does not hold
}

-- An application in a function's body is checked under its preconditions,
-- and so is one in its postconditions.
fn head(q: Seq<Int>): (r: Int) {
    assume nonempty: q != []
    out r := nth(q, 0)
    ensure at_zero: r = nth(q, 0)
}

fn careless(q: Seq<Int>): Int := nth(q, 0)  --~ error: the precondition `in_range` of `nth` may not hold at this application in `careless`

-- A precondition's application is checked under the other preconditions.
fn second(q: Seq<Int>): (r: Int) {
    assume long: q.len > 1
    assume sorted: nth(q, 0) <= nth(q, 1)
    out r := q[1]
}

-- In a global expectation, and under quantifiers.
proc holder(q: Seq<Int>): (y: Int) {
    ensure r: when q.len > 2, y = nth(q, 2)
}

expect read(h_q: Seq<Int>) {
    call h := holder(h_q)
    expect read: when h.q.len > 2, h.y = h.q[2]
}

-- Under a quantifier, the question holds in every instance; under `let`
-- and `where`, an application in a definition is guarded where the name
-- is mentioned; in a table, by the earlier rows.
proc quantified(q: Seq<Int>): (ok?) {
    ensure r: ok? iff (forall (b?: Bool), nth(q, if b? then 0 else 1) > 0)  --~ error: the precondition `in_range` of `nth` may not hold at this application in `quantified::r`
}

proc named(q: Seq<Int>): (y: Int, z: Int) {
    ensure guarded: when q != [], y = x where x := nth(q, 0)
    ensure unguarded: z = x where x := nth(q, 1)  --~ error: the precondition `in_range` of `nth` may not hold at this application in `named::unguarded`
}

proc tabled(q: Seq<Int>): (y: Int) {
    ensure r: y = table {
        q = [] => 0,
        _ => nth(q, 0),
    }
}

-- An instance's bindings, and a constant's value.
proc reader(x: Int): (y: Int) {
    ensure r: y = x
}

proc reading(q: Seq<Int>): (y: Int) {
    call w := reader(nth(q, 0))  --~ error: the precondition `in_range` of `nth` may not hold at this application in `reading::w`

    ensure r: y = w.y
}

const FIRST: Int := nth([1, 2], 0)
const NONE: Int := nth([], 0)  --~ error: the precondition `in_range` of `nth` may not hold at this application in `NONE`

-- In a `match` arm, an application is guarded by the arm's pattern.
enum Pick { First, Last, Neither }

proc picked(p: Pick, q: Seq<Int>): (y: Int) {
    assume nonempty: q != []
    ensure r: y = match p {
        Pick::First => nth(q, 0),
        Pick::Last => nth(q, q.len - 1),
        Pick::Neither => nth(q, 1),  --~ error: the precondition `in_range` of `nth` may not hold at this application in `picked::r`
    }
}

-- In a refinement's binding, under the concrete component's assumptions.
proc abstract_reader(q: Seq<Int>): (y: Int) {
    ensure r: when q.len > 3, y = q[3]
}

proc concrete_reader(q: Seq<Int>): (y: Int) {
    ensure r: when q.len > 3, y = q[3]
}

expect reads_third(q: Seq<Int>) {
    call concrete := concrete_reader(q)
    expect r: when (q).len > 3, (nth((q), 3)) = (q)[3]
}

-- A failing precondition in a global expectation.
expect unguarded_read(h_q: Seq<Int>) {
    call h := holder(h_q)
    expect unguarded_read: h.y = nth(h.q, 2)  --~ error: expectation `unguarded_read::unguarded_read` does not hold
    --~^ error: the precondition `in_range` of `nth` may not hold at this application in `unguarded_read::unguarded_read`
}
