-- Refinement (`Reqs/Lang/Refinement`): both front ends check the
-- obligation the same way.

proc precise(x: Int): (y: Int) {
    ensure r: y = x + 1
}

proc rough(x: Int): (y: Int) {
    assume small: x < 100
    ensure above: y > x
}

proc picky(x: Int): (y: Int) {
    assume positive: x > 0
    ensure r: y = x + 1
}

proc wrong(x: Int): (y: Int) {
    ensure below: y < x
}

expect holds(x: Int) {
    assume spec_small: (x) < 100
    call concrete := precise(x)
    refines concrete rough(x)
}
expect fails(x: Int) {
    call concrete := precise(x)
    refines concrete wrong(x)  --~ error: expectation `fails::refines_1` does not hold
}
-- `picky` assumes more than `rough`, so it does not accept all of its inputs.
expect narrower(x: Int) {  --~ warning: the realizability of `narrower` rests on the assumption `picky::positive` of call `concrete`, which did not pass
    assume spec_small: (x) < 100
    call concrete := picky(x)  --~ error: the assumption `positive`
    refines concrete rough(x)  --~ warning: `narrower::refines_1` rests on the assumption `picky::positive` of call `concrete`, which did not pass
}

--@ summary: 13 passed, 2 failed, 2 inconclusive, 0 redundant
