-- A realizability failure whose guarantees depend on the input that the
-- solver's model gives (#99). Each front end's are minimal for its own
-- input, as `cli::agreement` allows, so its note may be at either
-- guarantee.

proc source(b?): (o: Int) {
    --~^ warning: unused variable `b?`
    ensure q: o = 0
}

proc both(s: String) {
    --~^ error: `both` is not realizable
    call w := source(s != "")
