-- Specs near differences that `fren_fuzz_frontends` found, on which the
-- front ends agree.

-- Methods chained after a literal, where the first takes arguments.
expect sliced: "ab".slice(0, 1).len = 1 and ("a").len = 1
--~^ warning: this expectation mentions no variable
--~^^ warning: this is a call of `at`
--~^^^ warning: this test of a literal is always `true`

-- `card` of a literal, with no set variable: the solver must still be
-- told of sets.
expect counted_literal: {1, 2}.card = 2
--~^ warning: this expectation mentions no variable

comp counted {
    in x: Int
    pub out y?
    req q: y? iff {x}.card = 1
}

-- A member of a set literal read from an instance.
comp source {
    in x: Int
    pub out y: Int
    req q: y = x
}

comp member {
    in x: Int
    inst w: source { x }
    pub out z?
    req q: z? iff x in {w.y, 0}
}

-- Methods without arguments chained after a literal or a parenthesized
-- receiver, whose names Lean lexes as one dotted identifier (#97).
expect chained_literal: {(1, 2)}.range.card = 1 and {(1, 2)}.inverse.image({2}) = {1}

enum Dir { Up, Down }

comp chained_paren {
    in r: Rel(Dir, Dir)
    pub out y?
    req q: y? iff Dir::Up in (r).inverse.range
    --~^ warning: this chain of methods has a shorter form
}

-- Parentheses never change how an operand is classified (#98).
comp parenthesized {
    in s: String
    in x: Int
    in t: Set(Int)
    pub out a?
    pub out b?
    pub out c?
    pub out d?
    req qa: a? iff (s.len) = (0)
    --~^ warning: say whether it is empty with `""`, not `len`
    req qb: b? iff x in ({1})
    --~^ warning: membership in a set of one member is equality
    req qc: c? iff s.matches?(("a"))
    --~^ warning: this pattern has no operator but `.*`
    req qd: d? iff t = ({}) or (x, x) in ({(1, 2)})
}
--@ summary: 16 passed, 0 failed, 0 inconclusive, 0 redundant
