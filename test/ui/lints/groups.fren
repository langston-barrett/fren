-- Groups of lints, in both front ends: a group's setting sets each of its
-- lints, in order with theirs, and a group's expectation is fulfilled by
-- any of them.
set_option fren.lint.pedantic "warn"
set_option fren.lint.definable_output "allow"

enum E { A, B, C }

comp chain {
    in e: E
    pub out p?

    ensure r: p? iff (e = E::A or e = E::B or e = E::C)  --~ warning: this is `e` in a set of 3
}

set_option fren.lint.pedantic "expect" in
comp expected {
    in e: E
    pub out p?

    ensure r: p? iff (e = E::A or e = E::B or e = E::C)
}

set_option fren.lint.style "deny" in
comp denied {
    in s: String
    pub out p?

    ensure r: p? iff (s.len = 0 or s = "a")  --~ error: say whether it is empty with `""`, not `len`
}

set_option fren.lint.unused "expect" in  --~ warning: this lint expectation is unfulfilled
comp unfulfilled {
    in x: Int
    pub out p?

    ensure r: p? iff x > 0
}

set_option fren.lint.membership_chain "forbid"
set_option fren.lint.pedantic "allow"  --~ error: `allow` for `pedantic` is incompatible with an earlier `forbid` of `membership_chain`
--@ exit: 2
