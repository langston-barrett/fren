-- `unnecessary_struct_initialization`, in both front ends: a record
-- literal that copies each field of a value of its record.

struct Point { x: Int, y: Int }
struct Pair { x: Int, y: Int }
struct Line { a: Point, b: Point }

pub comp src {
    pub out x: Int
    pub out y: Int
    ensure r: x = 1 and y = 2
}

comp copies {
    in p: Point
    in l: Line
    in c?
    pub out a: Pair
    pub out b: Point
    pub out d: Point
    pub out e: Point
    pub out f: Point
    pub out g: Point
    pub out h: Point
    inst w: src {}

    -- A conversion, and an instance, which is not a value.
    ensure ra: a = Pair { x := p.x, y := p.y }
    ensure rb: b = Point { x := w.x, y := w.y }
    ensure rd: d = Point { y := p.y, x := p.x }  --~ warning: this record literal is `p`
    ensure re: e = Point { x := l.a.x, y := l.a.y }  --~ warning: this record literal is `l.a`
    ensure rh: h = Point { x := (if c? then p else l.b).x, y := (if c? then p else l.b).y }
    --~^ warning: this record literal is `(if c? then p else l.b)`
    -- Fields of two values, or another field.
    ensure rf: f = Point { x := p.x, y := l.a.y }
    ensure rg: g = Point { x := p.y, y := p.x }
}
