-- Double parentheses and the arithmetic lints, and the forms that
-- `length_zero` and `membership_chain` fire on, in both front ends.
set_option fren.lint.membership_chain "warn"

fn f(Int): Int

proc arith(x: Int, y: Int, s: String, t: Set<Int>, q: Seq<Int>, r: Rel<Int, Int>): (
    a1?,
    a2?,
    a3?,
    a4?,
    a5?,
    a6?,
    a7?,
    a8?,
    a9?,
    b1: Int,
    b2: Int,
    c1: Int,
    d1?,
    d2?,
    d3?,
    e1?,
    e2?,
    e3?,
    m1?,
    m2?,
    m3?,
    m4?,
) {
    out a1? := ((x > 0))            --~ warning: parentheses directly around parentheses
    out a2? := (((x > 1)))          --~ warning: parentheses directly around parentheses
    out a3? := f((x)) = f(((y)))    --~ warning: parentheses directly around parentheses
    -- A comment between them: no lint.
    out a4? := (  -- the bound
        (x > 2))
    -- The parentheses of a pair, or around a receiver, are their own: no lint.
    out a5? := (1, (({1}).card)) in r and ((({1}).card), 1) in r
    out a6? := (1, -(({1}).card)) in r and (f((x)), y) in r
    out a7? := (x, ((y))) in r      --~ warning: parentheses directly around parentheses
    out a8? := (((x)), y) in r      --~ warning: parentheses directly around parentheses
    out a9? := (x, f(((y)))) in r   --~ warning: parentheses directly around parentheses
    out b1 := - -x             --~ warning: negating twice is the operand itself
    out b2 := -(-(x)) + f(-(-y))
    --~^ warning: negating twice is the operand itself
    --~^^ warning: negating twice is the operand itself
    out c1 := x * -1 + -1 * y + x * (-1)
    --~^ warning: multiplying by `-1` is negation
    --~^^ warning: multiplying by `-1` is negation
    --~^^^ warning: multiplying by `-1` is negation
    out d1? := x >= y + 1 and x >= 1 + y and x - 1 >= y
    --~^ warning: over integers, this is a strict comparison
    --~^^ warning: over integers, this is a strict comparison
    --~^^^ warning: over integers, this is a strict comparison
    out d2? := y + 1 <= x and 1 + y <= x and y <= x - 1
    --~^ warning: over integers, this is a strict comparison
    --~^^ warning: over integers, this is a strict comparison
    --~^^^ warning: over integers, this is a strict comparison
    -- Strict, or not off by one: no lint.
    out d3? := x > y - 1 and x + 1 >= y and x >= y - 1 and x <= y + 1 and x * -2 > 0
    --~^ warning: these comparisons can be chained
    out e1? := s.len != 0 and 0 < s.len and 1 <= q.len and t.card >= 1
    --~^ warning: say whether it is empty with `""`, not `len`
    --~^^ warning: say whether it is empty with `""`, not `len`
    --~^^^ warning: say whether it is empty with `[]`, not `len`
    --~^^^^ warning: say whether it is empty with `{}`, not `card`
    --~^^^^^ warning: these two comparisons are `0 < s.len`
    out e2? := q.len < 1 or 0 = s.len or 0 >= t.card or 1 > q.len
    --~^ warning: say whether it is empty with `[]`, not `len`
    --~^^ warning: say whether it is empty with `""`, not `len`
    --~^^^ warning: say whether it is empty with `{}`, not `card`
    --~^^^^ warning: say whether it is empty with `[]`, not `len`
    -- Not about emptiness: no lint, but always `true` is `absurd_extreme_comparisons`.
    out e3? := s.len >= 0 and 0 <= q.len and t.card != 2 and q.len <= 1
    --~^ warning: this comparison is always `true`
    --~^^ warning: this comparison is always `true`
    out m1? := x != 1 and x != 2 and x != 3 and x != y  --~ warning: this is `x` not in a set of 4
    out m2? := x = 1 or x = 2 or x = 3 or x = y         --~ warning: this is `x` in a set of 4
    -- A later value indexes a sequence: no lint.
    out m3? := when q != [], x != 1 and x != q[0] and x != 3
    out m4? := when q != [], q[0] != 1 and q[0] != 2 and q[0] != y
    --~^ warning: this is `q[0]` not in a set of 3
}
