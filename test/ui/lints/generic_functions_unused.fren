-- The lints of unused items and parameters, and `single_call_fn`, on
-- generic functions, whose applications count as any function's do. In a
-- module, since Lean has an `Option` of its own.
set_option fren.lint.single_call_fn "warn"

mod generic_functions_unused

fn unwrap_or<T>(o: Option<T>, d: T): T := match o { Option::Some(x) => x, Option::None => d }  --~ warning: function `unwrap_or` is applied only once
fn never<T>(o: Option<T>): Option<T> := o  --~ warning: function `never` is never used
fn first<T>(o: Option<T>, d: T): Option<T> := o  --~ warning: unused parameter `d`
--~^ warning: function `first` is applied only once
pub fn twice<T>(o: Option<T>): Option<T> := o

pub proc c(x: Option<Int>): (det y: Int, det z: Option<Int>, det w: Option<Int>) {
    out y := unwrap_or(x, 0)
    out z := twice(twice(x))
    out w := first(x, 1)
}
