-- An arm whose body is a dotted name, such as a constant's method or an
-- instance's variable, is a value, which the match lints read as one (#183).
enum E { V0, V1 }

const K1: String := "aaa"

comp sub { in n: Int pub out m: Int ensure r: m = n }

comp c {
    in s: E
    pub out y?
    pub out z: Int
    inst w: sub { n := 1 }

    ensure r: y? iff match s { E::V0 => K1.matches?("a*"), _ => true }
    ensure q: z = match s { E::V0 => w.m, _ => 0 }
}

--@ summary: 5 passed, 0 failed, 0 inconclusive, 0 redundant
