-- `zero_prefixed_literal`, in both front ends: a decimal literal with a
-- leading `0`, wherever an expression is, but not `0` or a literal with a
-- base.
-- fren-covers: lint::zero_prefixed_literal
fn shift(n: Int): Int := n + 01   --~ warning: `01` is 1

const LIMIT: Int := 0100   --~ warning: `0100` is 100; for octal write `0o100`

proc literals(x: Int, s: Set<Int>, q: Seq<Int>, n: Nat): (a?, b?, c?, e?, det d: Int) {
    out d := x * 010   --~ warning: `010` is 10; for octal write `0o10`

    ensure r1: a? iff x < 00_1 or x > 0x10 or x = 0 or x = 0o17 or x = 0b01   --~ warning: `00_1` is 1
    ensure r2: b? iff x in {7, 019}   --~ warning: `019` is 19
    ensure r3: c? iff q.len > 7 and q[007] = shift(-00) and LIMIT > 0 and x in s   --~ warning: `007` is 7
    --~^ warning: `00` is 0
    -- A `Nat` literal too.
    ensure r4: e? iff n > 05   --~ warning: `05` is 5
    expect ten: d = 10 * x
}

-- In patterns, as literals and as the bounds of ranges.
proc patterns(x: Int): (y: Int, q?) {
    ensure r1: y = match x {
        07 => 1,  --~ warning: `07` is 7
        -01 => 2,  --~ warning: `01` is 1
        _ => 0,
    }
    ensure r2: q? iff x is 0..=010   --~ warning: `010` is 10; for octal write `0o10`
}
