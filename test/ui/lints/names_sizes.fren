-- Lints on names and sizes, of the group `pedantic`, in both front ends:
-- `zero_sized_map_values`, `many_single_char_names`, `similar_names` and
-- `too_many_lines`. All are allowed by default.

comp quiet {
    in a: Int
    in b: Int
    in c: Int
    in d: Int
    in level: Int
    in levels: Int
    pub out p?

    req r: p? iff a + b + c + d + level + levels > 0
}

set_option fren.lint.pedantic "warn"
set_option fren.lint.definable_output "allow"

enum Mark { Marked }
enum Two { A, B }
enum Boxed { Box(Int) }

pub struct Marks {
    marks: Rel(Int, Mark),  --~ warning: `Rel(Int, Mark)` relates to `Mark`, which has one value
}

pub enum Holder { Holds(Rel(String, Mark)) }  --~ warning: `Rel(String, Mark)` relates to `Mark`, which has one value

const MARKED: Rel(Int, Mark) := {(1, Mark::Marked)}  --~ warning: `Rel(Int, Mark)` relates to `Mark`, which has one value

fn marked?(r: Rel(Int, Mark)) := (1, Mark::Marked) in r  --~ warning: `Rel(Int, Mark)` relates to `Mark`, which has one value

comp relations {
    in r: Rel(Int, Mark)          --~ warning: `Rel(Int, Mark)` relates to `Mark`, which has one value
    in nested: Set(Rel(Int, Mark))  --~ warning: `Rel(Int, Mark)` relates to `Mark`, which has one value
    in two: Rel(Int, Two)
    in boxed: Rel(Int, Boxed)
    in flipped: Rel(Mark, Int)
    pub out p?

    req q: p? iff (r = MARKED and r in nested and two = {} and boxed = {} and flipped = {} and marked?(r))
}

comp singles {  --~ warning: component `singles` declares 4 single-character names
    in a: Int
    in b: Int
    in c?
    in e: Two
    pub out total: Int

    req r: total = if c? then a + b else match e { Two::A => 0, Two::B => 1 }
}

comp three {
    in a: Int
    in b: Int
    pub out s: Int

    req r: s = a + b
}

-- A `match` binder counts.
comp with_binder {  --~ warning: component `with_binder` declares 4 single-character names
    in a: Int
    in b: Int
    in x: Boxed
    pub out total: Int

    req r: total = a + b + match x { Boxed::Box(n) => n }
}

pub fn sum(a: Int, b: Int, c: Int, d: Int): Int := a + b + c + d  --~ warning: function `sum` declares 4 single-character names

expect all_small: forall (a b c d: three), a.s + b.s + c.s + d.s = a.a + a.b + b.a + b.b + c.a + c.b + d.a + d.b  --~ warning: global expectation `all_small` declares 4 single-character names

comp similar {
    in level: Int
    in levels: Int    --~ warning: `levels` differs from `level` by one character
    in count: Int
    in counts: Int    --~ warning: `counts` differs from `count` by one character
    in user: Int
    in used: Int      --~ warning: `used` differs from `user` by one character
    in item: Boxed
    pub out p?

    req r: p? iff level + levels + count + counts + user + used > match item { Boxed::Box(items) => items }  --~ warning: `items` differs from `item` by one character
}

-- Not similar: shorter than 3 characters, differing in a digit, in a
-- character that is a word of its own, or only in a final `?`.
comp series {
    in ab: Int
    in ac: Int
    in x1: Int
    in x2: Int
    in level1: Int
    in level2: Int
    in a_len: Int
    in b_len: Int
    in len_a: Int
    in len_b: Int
    in ready: Int
    pub out ready?

    req r: ready? iff ab + ac + x1 + x2 + level1 + level2 + a_len + b_len + len_a + len_b + ready > 0
}

