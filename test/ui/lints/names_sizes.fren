    pub out y39: Int
    ensure r39: y39 = x + 40
    pub out y40: Int
    ensure r40: y40 = x + 41
    pub out y41: Int
    ensure r41: y41 = x + 42
    pub out y42: Int
    ensure r42: y42 = x + 43
    pub out y43: Int
