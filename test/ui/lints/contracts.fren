-- The lints of contract clauses, in both front ends:
-- `contract_mentions_nothing`, on a clause that mentions nothing of its
-- function's, and `assertions_on_constants`, on one that mentions nothing.
const LIMIT: Int := 10

pub fn limit(n: Int): (r: Int) { ensure positive: r > 0 }

pub fn known?(Int)

-- About another function.
pub fn scale(n: Int): (r: Int) {
    ensure grows: r >= n
    ensure positive: limit(0) > 0  --~ warning: the postcondition `positive` says nothing about `scale`
}

pub fn shift(n: Int): (r: Int) {
    require known: known?(0)  --~ warning: the precondition `known` says nothing about `shift`
    out r := n + 1
}

-- Through a `let` of the block, which mentions what its definition does.
pub fn twice(n: Int): (r: Int) {
    let base: Int := limit(1)
    ensure based: base > 0  --~ warning: the postcondition `based` says nothing about `twice`
    let own: Int := n + 1
    ensure owned: r > own or r <= own
}

-- Mentioning nothing.
pub fn clamp(n: Int): (r: Int) {
    require sane: LIMIT > 0  --~ warning: this precondition mentions no variable
    ensure trivially: true  --~ warning: this postcondition mentions no variable
    ensure bounded: r <= LIMIT
}

-- Always `false`: a precondition makes every application fail its
-- precondition check, and a postcondition of an uninterpreted function
-- makes its contract unrealizable.
pub fn never(n: Int): (r: Int) {
    require nope: false  --~ warning: so every application of the function fails its precondition check
    out r := n
}

pub fn impossible(n: Int): (r: Int) {  --~ error: the postconditions of `impossible` cannot all hold
    ensure grows: r >= n
    ensure nope: false  --~ warning: no value meets it, so the function's contract cannot hold
}

-- A labelled conjunction is split into its leaves, and only the leaf
-- that mentions nothing of the function's own is reported: `other`. Both
-- front ends report it at the conjunction, since the result's definition
-- wraps the whole clause before it is split, so the message names the leaf.
pub fn split(n: Int): (r: Int) {
    ensure both: and {  --~ warning: the postcondition `both.other` says nothing about `split`
        own: r >= n,
        other: limit(0) > 0,
    }
}

-- About two other functions, which the note lists in order.
pub fn both(n: Int): (r: Int) {
    ensure grows: r >= n
    ensure others: limit(0) > 0 or known?(1)  --~ warning: it mentions only the function `limit`, the function `known?`
}

-- Not fired: the clause mentions a parameter, the value, or the function.
pub fn steps(n: Int): (r: Int) {
    require small: n < LIMIT
    ensure applied: steps(n) >= 0
    ensure with_other: r > limit(n)
}

-- A field read from a parameter is the parameter's.
pub fn first(q: Seq<Int>): (r: Int) {
    require long: q.len > 1
    out r := q[1]
}

-- The value of a defined function is its application, which mentions its
-- parameters, even where its body does not.
pub fn seven(n: Int): (r: Int) {
    out r := 7
    ensure positive: r > 0
}

-- A function parameter is the function's too, whether read or applied.
pub fn apply(g: fn(Int) -> Int, n: Int): (r: Int) {
    require zero_ok: g(0) >= limit(0)
    out r := g(n)
}
