-- Lints around newtypes, in both front ends: `Ms(e)` and `x.0` are atoms,
-- so the simpler forms need no parentheses around them, and a private
-- newtype is used by building it as by naming its type.
struct Ms(Int)
struct Unused(Int)  --~ warning: record `Unused` is never used
struct Flag(Bool)

comp c {
    in a?
    in t: Ms
    in u: Ms
    pub out o?
    pub out p?
    pub out q?

    ensure r1: o? iff not not Flag(a?).0  --~ warning: write `Flag(a?).0`
    --~^ warning: this reads the field of a newtype just built
    ensure r2: p? iff not (t = u)  --~ warning: write `t != u`
    ensure r3: q? iff t < u or t = u  --~ warning: these two comparisons are `t <= u`
    expect same: t.0 = t.0  --~ warning: both operands of `=` are written the same
}
