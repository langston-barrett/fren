-- `nonminimal_bool` around a record update, in both front ends: an update
-- is an atom, so the simpler forms need no parentheses around it.
struct S { on?, n: Int }

comp c {
    in a?
    in s: S
    pub out o?
    pub out p?
    pub out q?

    req r1: o? iff not not { s with on? := a? }.on?  --~ warning: write `{ s with on? := a? }.on?`
    req r2: p? iff not ({ s with n := 1 } = s)  --~ warning: write `{ s with n := 1 } != s`
    req r3: q? iff { s with on? := a? }.on? = true  --~ warning: write `{ s with on? := a? }.on?`
}
