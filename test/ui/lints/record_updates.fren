-- `nonminimal_bool` around a record update, in both front ends: an update
-- is an atom, so the simpler forms need no parentheses around it.
struct S { on?, n: Int }

proc c(a?, s: S): (o?, p?, q?) {
    ensure r1: o? iff not not { s with on? := a? }.on?  --~ warning: write `{ s with on? := a? }.on?`
    ensure r2: p? iff not ({ s with n := 1 } = s)  --~ warning: write `{ s with n := 1 } != s`
    ensure r3: q? iff { s with on? := a? }.on? = true  --~ warning: write `{ s with on? := a? }.on?`
}
