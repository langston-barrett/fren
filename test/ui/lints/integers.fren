-- The lints of `Nat`, `div`, `mod`, `abs`, `min` and `max`, in both front
-- ends, and the forms they leave as they are.

const LIMIT: Int := 4

proc absolute(x: Int, y: Int, n: Nat): (
    a1: Int,
    a2: Int,
    a3: Int,
    a4: Int,
    a5: Int,
    a6: Int,
    a7: Int,
    a8: Int,
    a9: Int,
    b1: Int,
    b2: Int,
    b3: Int,
    b4: Int,
    b5: Int,
    b6: Int,
) {
    out a1 := if x < 0 then -x else x  --~ warning: this conditional is the absolute value
    out a2 := if 0 >= x then -x else x  --~ warning: this conditional is the absolute value
    out a3 := if x >= 0 then x else -x  --~ warning: this conditional is the absolute value
    out a4 := if 0 < x then x else -x  --~ warning: this conditional is the absolute value
    out a5 := if x - y < 0 then -(x - y) else x - y  --~ warning: this conditional is the absolute value
    out a6 := 2 * if n <= 0 then -n else n  --~ warning: this conditional is the absolute value
    out a7 := if x > y then x - y else y - x  --~ warning: this conditional is the absolute value of a difference
    out a8 := if x <= y then y - x else x - y  --~ warning: this conditional is the absolute value of a difference
    out a9 := if y < x then x - y else y - x  --~ warning: this conditional is the absolute value of a difference
    -- The negative branch where `x` is not negative, a bound other than
    -- `0`, or other operands: no lint.
    out b1 := if x < 0 then x else -x
    out b2 := if x < 1 then -x else x
    out b3 := if x < 0 then -y else x
    out b4 := if x > y then y - x else x - y
    out b5 := if x = 0 then -x else x
    out b6 := if x > y then x - y else x - y  --~ warning: both branches of `if` are written the same
}

proc lesser_greater(x: Int, y: Int, n: Nat, s: String): (
    m1: Int,
    m2: Int,
    m3: Int,
    m4: Int,
    m5: Nat,
    m6: Int,
    m7: Int,
    m8: Int,
    n1: Int,
    n2: Int,
    n3: Int,
    n4: String,
) {
    out m1 := if x < y then x else y  --~ warning: this conditional is `min`
    out m2 := if x <= y then y else x  --~ warning: this conditional is `max`
    out m3 := if x > y then y else x  --~ warning: this conditional is `min`
    out m4 := if x >= y then x else y  --~ warning: this conditional is `max`
    out m5 := if n > 3 then 3 else n  --~ warning: this conditional is `min`
    out m6 := if 0 < x then 0 else x  --~ warning: this conditional is `min`
    out m7 := if x + 1 < y then x + 1 else y  --~ warning: this conditional is `min`
    out m8 := if x < LIMIT then LIMIT else x  --~ warning: this conditional is `max`
    -- The lint suggests `min` and `max` of numbers only, not of `String`s,
    -- which have them too; literals on both sides would change type, and
    -- `=` or other branches are not `min` or `max`: no lint.
    out n1 := if x = y then x else y
    out n2 := if x < y then x else x + 1
    out n3 := if x + 1 < y + 1 then x + 1 else y + 1
    out n4 := if s < "m" then s else "m"
}

proc clamps(x: Int, n: Nat): (c1: Int, c2: Int, c3: Nat, c4: Int, d1: Int, d2: Int) {
    out c1 := if x < 0 then 0 else if x > 9 then 9 else x  --~ warning: this conditional keeps its operand between two bounds
    out c2 := if x >= 9 then 9 else if x <= -3 then -3 else x  --~ warning: this conditional keeps its operand between two bounds
    out c3 := if 9 < n then 9 else if 2 > n then 2 else n  --~ warning: this conditional keeps its operand between two bounds
    out c4 := if x < 3 then 3 else if x > 3 then 3 else x  --~ warning: this conditional keeps its operand between two bounds
    -- Bounds out of order, or not literals: only the inner `min` or `max`.
    out d1 := if x < 9 then 9 else if x > 0 then 0 else x  --~ warning: this conditional is `min`
    out d2 := if x < LIMIT then LIMIT else if x > 9 then 9 else x  --~ warning: this conditional is `min`
}

proc remainders(x: Int, n: Nat): (
    r1: Int,
    r2: Int,
    r3: Int,
    r4: Int,
    r5: Int,
    r6: Int,
    s1: Int,
    s2: Int,
    s3: Int,
) {
    out r1 := (x mod 7 + 7) mod 7  --~ warning: `mod` is never negative already
    out r2 := (-3 + x mod -3) mod -3  --~ warning: `mod` is never negative already
    out r3 := 2 * ((n mod LIMIT + LIMIT) mod LIMIT)  --~ warning: `mod` is never negative already
    out r4 := x mod 1  --~ warning: the remainder by `1` is always `0`
    out r5 := x mod -1 + x div 1  --~ warning: the remainder by `-1` is always `0`
    --~^ warning: this operation has no effect
    out r6 := x + 0 div 7 + 0 mod -3  --~ warning: this `div` is always `0`
    --~^ warning: this `mod` is always `0`
    -- Other divisors or addends: no lint.
    out s1 := (x mod 7 + 6) mod 7
    out s2 := (x mod 7 + 7) mod 5
    out s3 := x mod 2 + x div -1
}

proc bounds(x: Int): (b1: Int, b2: Int, b3: Int, b4: Int, c1: Int, c2: Int, c3: Int, c4: Int) {
    out b1 := x.min(0).max(9)  --~ warning: always give `9`
    out b2 := x.max(4).min(-1)  --~ warning: always give `-1`
    out b3 := x.min(x)  --~ warning: the receiver and the argument of `min` are written the same
    out b4 := (x + 1).max(x + 1)  --~ warning: the receiver and the argument of `max` are written the same
    -- Bounds in order, equal, or not literals: no lint.
    out c1 := x.max(0).min(9)
    out c2 := x.min(3).max(3)
    out c3 := x.min(LIMIT).max(9)
    out c4 := x.min(x + 1)
}

proc naturals(n: Int, k: Int, j: Int, i: Int, h: Int, c?): (m: Int, p: Int, q: Int) {
    assume counts: n >= 0 and k > n  --~ warning: these comparisons can be chained
    --~^ warning: `n` is never negative, so it can be a `Nat`
    assume order: (0 <= j)  --~ warning: `j` is never negative, so it can be a `Nat`
    --~^ warning: the assumption `order` constrains only parameters that nothing uses
    -- Under `when` or `or`, or not `0`: no lint.
    assume guarded: when c?, i >= 0
    assume either: i >= 0 or k = 1
    assume shifted: h >= 1  --~ warning: the assumption `shifted` constrains only parameters that nothing uses

    ensure r: m >= 0 and m <= n  --~ warning: these comparisons can be chained
    --~^ warning: `m` is never negative, so it can be a `Nat`
    ensure s: p = n + q
    -- A guarantee on an input: no lint.
    ensure u: q = 1 and k >= 0
    -- An expectation: no lint.
    expect e: when c?, q >= 0
}

-- An instance that binds an `Int`, or a refinement that reads one by name,
-- keeps the variable an `Int`: no lint there.
proc held(v: Int): (w: Int) { assume nonneg: v >= 0 ensure r: w = v }
proc binds(a: Int, b: Int): (c: Int) { assume order: a >= b call p := held(a - b) ensure r: c = p.w }
proc free(v: Int): (w: Int) { assume nonneg: v >= 0 ensure r: w = v }  --~ warning: `v` is never negative
proc binds_nat(a: Nat): (c: Int) { call p := free(a) ensure r: c = p.w }
proc concrete(v: Int): (w: Int) { assume nonneg: v >= 0 ensure r: w = v + 1 }
proc abstract(v: Int): (w: Int) { assume nonneg: v >= 0 ensure r: w > v }  --~ warning: `v` is never negative
expect reads(v: Int) {
    assume spec_nonneg: (v) >= 0  --~ warning: `v` is never negative
    call concrete_1 := concrete(v)
    refines concrete_1 abstract(v)
}

-- A newtype has no `abs`, and an ordered enumeration has `min` and `max`
-- only: the lints follow the type the condition compares. An ordered
-- newtype has `min` and `max` too, which the lints do not suggest yet.
pub ordered struct Ms(Int)
ordered enum Level { Low, Mid, High }

proc newtypes(a: Ms, b: Ms, l: Level, k: Level): (m: Ms, d: Ms, n: Level, o: Level) {
    out m := if a < b then a else b
    out d := if a > b then a - b else b - a
    out n := if l < k then l else k  --~ warning: this conditional is `min`
    out o := if l < k then l  -- the lower  --~ warning: this conditional is `min`
        else k
}

