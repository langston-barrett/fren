-- The lints of variant tests and bindings, in both front ends.
set_option fren.lint.pedantic "warn"
set_option fren.lint.definable_output "allow"
set_option fren.lint.many_single_char_names "allow"
-- Its chains of tests that are not variant tests are `manual_table`'s.
set_option fren.lint.manual_table "allow"

enum E { A, B, C, D }
enum S { Dot, Line(Int) }
struct P { x: Int, y: Int }

-- A set type, for the solver's logic.
pub const ALL: Set<E> := {E::A, E::B, E::C, E::D}

proc sub(x: Int): (o?) {
    ensure r: o? iff x > 0
}

proc chains(e: E, s: S, x: Int, c?): (y1: Int, y2: Int, p?) {
    use E::{A, B}
    call w := sub(x)       --~ warning: `x := x` is `x`
    call v := sub((x))

    ensure r1: y1 = if e = E::A then 1 else if e in {E::B, E::C} then 2 else 3  --~ warning: this chain of `if` tests which variant `e` is
    ensure r2: y2 = if e = A or e = B then 1 else (if e = E::C then 2 else if e = E::D then 4 else 5)
    --~^ warning: this chain of `if` tests which variant `e` is
    --~^^ warning: this says that `e` matches one of these patterns
    ensure r3: p? iff if e = E::A then c? else if e = E::B then (when x > 0, c?) else not c?
    --~^ warning: this chain of `if` tests which variant `e` is
    -- Not chains of variant tests.
    expect r4: (if e = E::A then 1 else if e = E::A then 2 else 3) > 0
    --~^ warning: `e = E::A` is already tested earlier in this chain
    expect r5: (if e = E::A then 1 else 3) > 0
    expect r6: (if e = E::A then 1 else if x > 0 then 2 else 3) > 0
    expect r7: (if s = S::Dot then 1 else if s = S::Line(1) then 2 else 3) > 0
    expect r8: (if e = E::A then 1 else if e = E::B or x > 0 then 2 else 3) > 0
    expect r9: P { x := x, y := 1 }.x = x  --~ warning: `x := x` is `x`
}

proc cases(e: E, x: Int): (y: Int, z: Int, p?) {
    ensure y_a: when e = E::A, y = 1
    ensure y_bc: when e in {E::B, E::C} or e = E::D, y = x  --~ warning: `y_a` and `y_bc` constrain `y` case by case on which variant `e` is
    -- `unless` is not counted.
    ensure z_a: when e = E::A, z = 1
    ensure z_b: unless e = E::A, z = 2
    ensure p_a: when e = E::A, p? iff x > 0
    ensure p_b: when e = E::B, p? iff x > 1  --~ warning: `p_a`, `p_b` and `p_c` constrain `p?` case by case on which variant `e` is
    ensure p_c: when e = E::C, p? = (x > 2)  --~ warning: equality of `Bool`s is `iff`
}

proc repeated(e: E): (y: Int) {
    ensure a: when e = E::A, y = 1  --~ warning: `repeated::a` is redundant
    ensure b: when e in {E::A, E::B}, y = 1
}
