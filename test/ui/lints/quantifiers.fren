-- The lints see a quantifier's body once, where it is written, and give a
-- quantifier the precedence of `when`.
enum Mode { Heat, Cool, Off }

proc c(m: Mode, p?): (o?, w?, v?) {
    ensure r1: o? iff not not (forall (k: Mode), k = m) and p?  --~ warning: this `Bool` expression can be simpler
    ensure r2: w? iff (exists (k: Mode), not not p? or k = m)   --~ warning: this `Bool` expression can be simpler
    ensure r3: v? iff (exists (k: Mode), ((k = m)))             --~ warning: parentheses directly around parentheses
}

--@ exit: 3
