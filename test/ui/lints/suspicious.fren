-- The suspicious lints, in both front ends: `eq_op`, `same_branches`,
-- `duplicate_elements`, `ifs_same_cond` and `empty_argument`.
set_option fren.lint.undecidable "allow"

proc ops(x: Int, y: Int, a?, t: Set<Int>, q: Seq<Int>): (
    p1?,
    p2?,
    p3?,
    p4?,
    n1: Int,
    n2: Int,
    p5?,
    p6?,
) {
    ensure r1: p1? iff (x = x or y < y)
    --~^ warning: both operands of `=` are written the same
    --~^^ warning: both operands of `<` are written the same
    ensure r2: n1 = (x + 1) - (x + 1)  --~ warning: both operands of `-` are written the same
    ensure r3: p2? iff a? and (a?)  --~ warning: both operands of `and` are written the same
    ensure r4: p5? iff t inter t = t  --~ warning: both operands of `inter` are written the same
    ensure r5: p3? iff t subset t  --~ warning: both operands of `subset` are written the same
    -- Meaningful, or not written the same.
    ensure r6: n2 = x + x + 2 * 2
    ensure r7: p6? iff q ++ q = q
    ensure r8: p4? iff x + 1 = 1 + x
}

enum E { A, B }

proc branches(x: Int, a?, b?, e: E): (n: Int, m: Int, p?, o?) {
    ensure r1: n = if a? then x + 1 else x + 1  --~ warning: both branches of `if` are written the same
    ensure r2: m = 2 * if a? then x else (x)  --~ warning: both branches of `if` are written the same
    ensure r3: p? iff b? and if a? then b? or x > 0 else b? or x > 0
    --~^ warning: both branches of `if` are written the same
    --~^^ warning: the `else` branch extends past the operator
    -- A `match` is left to other lints.
    ensure r4: o? iff match e { E::A => b?, E::B => b? }
}

proc elements(x: Int, y: Int, r: Rel<Int, Int>, q: Seq<Int>): (p?, o?, k?) {
    ensure r1: p? iff x in {1, y, 1, 2, y}  --~ warning: `1`, `y` are repeated in this literal
    ensure r2: o? iff (x, y) in {(1, 2), (1, 2)}  --~ warning: `(1, 2)` is repeated in this literal
    ensure r3: k? iff q = [x, x] and r != {}
}

fn inc(x: Int): Int := x + 1

-- The parentheses around a whole element, or a whole test, are not part
-- of it; those inside are.
proc parenthesized(x: Int, y: Int, b: Int): (p?, n: Int) {
    ensure r1: p? iff x in {(y), y, inc((x)), inc(x)}  --~ warning: `y` is repeated in this literal
    ensure r2: n = if b > 0 then 1 else if (b > 0) then 2 else 3  --~ warning: `b > 0` is already tested earlier in this chain
}

proc methods(s: String, q: Seq<Int>, i: Int): (p?, o?, n: Int, k?, l?) {
    ensure r1: p? iff s.starts_with?("") or s.ends_with?("") or s.contains?("")
    --~^ warning: every string starts with `""`
    --~^^ warning: every string ends with `""`
    --~^^^ warning: every string contains `""`
    ensure r2: k? iff s = s.replace("", "a") ++ s.replace_all("", "b")
    --~^ warning: replacing `""` puts the replacement before the string
    --~^^ warning: replacing each `""` leaves the string as it is
    ensure r3: n = s.index_of("", i) + q.index_of([], i)
    --~^ warning: `""` occurs at every position
    --~^^ warning: `[]` occurs at every position
    ensure r4: l? iff q = q.slice(i, 0) ++ q.replace([], [1])
    --~^ warning: a slice of length 0 is empty
    --~^^ warning: replacing `[]` puts the replacement before the sequence
    -- Not empty, or not where it decides the value.
    ensure r5: o? iff s.index_of("a", 0) = 0 and s.slice(0, 1) = "a" and q.starts_with?([0])
    --~^ warning: this is a call of `at`
    --~^^ warning: this is a call of `starts_with?`
}
