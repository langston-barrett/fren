-- The match lints, in both front ends.
set_option fren.lint.match_same_arms "warn"
set_option fren.lint.wildcard_single_variant "warn"

enum E { A, B, C, D }

enum Shape { Circle(Int), Rect(Int, Int), Dot }

proc same_arms(e: E, s: Shape, x: Int): (a: Int, b: Int, c?, d: Int, f: Int) {
    ensure r1: a = match e { E::A => x + 1, E::B => 2, E::C => x + 1, E::D => x + 1 }
    --~^ warning: this arm has the same body as the arm `E::A`
    ensure r2: b = match e { E::A => 1, E::B | E::C => 2, _ => 1 }
    --~^ warning: this arm has the same body as the `_` arm
    --~^^ warning: `_` matches only `E::D`
    ensure r3: c? = match e { E::A => x > 1 or x < 0, E::B | E::C => x > 1 or x < 0, _ => x > 1 or x < 0 }
    --~^ warning: replace the `match` with its body, `(x > 1 or x < 0)`
    --~^^ warning: `_` matches only `E::D`
    -- Binders: not the same arms, though written the same.
    ensure r4: d = match s { Shape::Circle(r) => r, Shape::Rect(r, _) => r, Shape::Dot => 0 }
    ensure r5: f = match s { Shape::Circle(r) => r, Shape::Rect(_, _) => 0, _ => 0 }
    --~^ warning: this arm has the same body as the `_` arm
    --~^^ warning: `_` matches only `Shape::Dot`
}

proc membership(e: E): (p?, q?, r?, t?) {
    use self::E::{A, B, C, D}

    ensure r1: p? iff match e { A => true, B => false, C => true, D => false }
    --~^ warning: this `match` only tests which of its patterns its scrutinee matches
    --~^^ warning: this arm has the same body as the arm `A`
    --~^^^ warning: this arm has the same body as the arm `B`
    ensure r2: q? = match e { A => false, _ => true }
    --~^ warning: this `match` only tests which of its patterns its scrutinee matches
    ensure r3: r? iff match e { A | B | C => true, D => false }
    --~^ warning: this `match` only tests which of its patterns its scrutinee matches
    -- Every arm is `true`: `match_same_arms`, not a membership.
    ensure r4: t? iff match e { A | B => true, _ => true }
    --~^ warning: this arm has the same body as the arm `A | B`
}

proc wildcard(e: E, s: Shape): (a: Int, b: Int, c: Int) {
    use self::E::{A, B, C}

    ensure r1: a = match e { A => 1, B => 2, C => 3, _ => 4 }  --~ warning: `_` matches only `E::D`
    ensure r2: b = match s { Shape::Circle(n) => n, Shape::Dot => 0, _ => 1 }
    --~^ warning: `_` matches only `Shape::Rect`
    ensure r3: c = match e { A => 1, B => 2, _ => 3 }
}
-- An arm with a guard may not be taken where its pattern matches: the
-- lints that merge or remove arms, or replace the `match`, leave a `match`
-- with a guard alone, and `_` matches the variants that only arms with
-- guards name (`Reqs/Lint/Pedantic/Matches#arms`).
set_option fren.lint.single_match_else "warn" in
proc guarded(e: E, x: Int): (a: Int, b?, c: Int, d: E, f: Int) {
    -- `_` matches `E::A` too, where `x <= 0`.
    ensure r1: a = match e { E::A if x > 0 => 1, E::B => 2, E::C => 3, _ => 4 }
    ensure r2: b? iff match e { E::A if x > 0 => true, _ => false }
    ensure r3: c = match e { E::A if x > 0 => 1, E::B => 1, _ => 2 }
    ensure r4: d = match e { E::A if x > 0 => E::A, _ => e }
    ensure r5: f = match e { E::A if x > 0 => 1, E::A => 2, E::B => 3, E::C => 4, _ => 5 }
    --~^ warning: `_` matches only `E::D`
}
--@ summary: 37 passed, 0 failed, 0 inconclusive, 0 redundant
--@ exit: 3
