-- The lints of the `restriction` group, in both front ends.
-- fren-covers: lint::min_ident_chars
set_option fren.lint.restriction "warn"

mod climate::climate_sensors  --~ warning: module `climate_sensors` contains the name of its module `climate`
mod climate::sensors

pub enum Probe { Inside, Outside }
pub struct Reading { value: Int }

mod climate

pub enum ClimateMode { Heating, Cooling }  --~ warning: enum `ClimateMode` contains the name of its module `climate`
pub enum Climate { Mild }
pub fn climate_reading(level: Int): Int := level + 1  --~ warning: function `climate_reading` contains the name of its module `climate`
pub enum Mode { Heat, Cool, Off, Auto }
pub const CLIMATE_LIMIT: Int := 3  --~ warning: constant `CLIMATE_LIMIT` contains the name of its module `climate`

-- A `use` is never reported, however long its path.
use self::sensors::Reading

proc wildcards(mode: Mode): (level: Int, other: Int) {
    ensure first: level = match mode {
        Mode::Heat => 1,
        _ => 2,  --~ warning: `_` matches `climate::Mode::Cool`, `climate::Mode::Off` and `climate::Mode::Auto`
    }
    ensure second: other = match mode {
        Mode::Heat => 1,
        Mode::Cool => 2,
        Mode::Off => 3,
        _ => 4,  --~ warning: `_` matches `climate::Mode::Auto`
    }
}

proc literals(text: String): (raw?, quoted?, accented?, astral?) {
    ensure raw_rule: raw? iff text.matches?(r"[a-z]+")  --~ warning: this raw string literal needs no escapes
    ensure quoted_rule: quoted? iff text.matches?(r#"a"[a-z]+"#)
    ensure accented_rule: accented? iff text = "café"  --~ warning: this string literal contains a non-ASCII character, `U+00E9`
    ensure astral_rule: astral? iff text = "a😀é"  --~ warning: this string literal contains non-ASCII characters: `U+1F600`, `U+00E9`
}

proc paths(probe: sensors::Probe): (inside?, side: Int) {
    ensure inside_rule: inside? iff probe = sensors::Probe::Inside  --~ warning: `sensors::Probe::Inside` is a path of 3 segments
    ensure side_rule: side = match probe {
        sensors::Probe::Outside => 1,  --~ warning: `sensors::Probe::Outside` is a path of 3 segments
        sensors::Probe::Inside => 2,  --~ warning: `sensors::Probe::Inside` is a path of 3 segments
    }
}

-- `self` is a segment.
proc more_paths(
    far: self::sensors::Probe,    --~ warning: `self::sensors::Probe` is a path of 3 segments
): (near: Reading, written: sensors::Reading, inside?, tested?) {
    ensure near_rule: near = Reading { value := 1 }
    ensure written_rule: written = self::sensors::Reading { value := 2 }  --~ warning: `self::sensors::Reading` is a path of 3 segments
    ensure far_rule: when far = sensors::Probe::Inside, inside?  --~ warning: `sensors::Probe::Inside` is a path of 3 segments
    ensure tested_rule: tested? iff far is sensors::Probe::Outside  --~ warning: `sensors::Probe::Outside` is a path of 3 segments
    --~^ warning: this pattern test is an equation
}

proc climate_check(level: Int): (high?) {  --~ warning: procedure `climate_check` contains the name of its module `climate`
    ensure high_rule: high? iff level > CLIMATE_LIMIT
}

expect climate_holds(check_level: Int) {  --~ warning: global expectation `climate_holds` contains the name of its module `climate`
    call check := climate_check(check_level)
    expect climate_holds: check.high? iff check.level > CLIMATE_LIMIT
}

proc short(
    x: Int,    --~ warning: variable `x` has a name of one character
    ready?,
): (
    y?,         --~ warning: variable `y?` has a name of one character
) {
    ensure r: y? iff (ready? and x > 0)  --~ warning: constraint `r` has a name of one character
}

proc grouping(
    first?,
    second?,
    third?,
    left: Set<Int>,
    right: Set<Int>,
    other: Set<Int>,
    pairs: Rel<Mode, Mode>,
    links: Rel<Mode, Mode>,
    extra: Rel<Mode, Mode>,
): (loose?, tight?, sets: Set<Int>, written: Set<Int>, joined: Set<Int>, chained: Rel<Mode, Mode>) {
    out sets := left minus right inter other  --~ warning: `inter` is an operand of `minus` without parentheses
    out written := left union (right inter other)
    out joined := left union right inter other  --~ warning: `inter` is an operand of `union` without parentheses
    out chained := pairs union links join extra  --~ warning: `join` is an operand of `union` without parentheses

    ensure loose_rule: loose? iff (first? or second? and third?)  --~ warning: `and` is an operand of `or` without parentheses
    ensure tight_rule: tight? iff (first? or (second? and third?))
}

set_option fren.lint.glob_imports "allow"  --~ warning: `glob_imports` is allowed rather than expected
--~^ warning: this lint setting is replaced before any item
set_option fren.lint.glob_imports "expect"  --~ warning: this lint expectation is unfulfilled
set_option fren.lint.restriction "allow"  --~ warning: `restriction` is allowed rather than expected
--~^ warning: this lint setting is in effect at no item
set_option fren.lint.glob_imports "allow"
