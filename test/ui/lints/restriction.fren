-- The lints of the `restriction` group, in both front ends.
-- fren-covers: lint::min_ident_chars
set_option fren.lint.restriction "warn"

mod climate::climate_sensors  --~ warning: module `climate_sensors` contains the name of its module `climate`
mod climate::sensors

pub enum Probe { Inside, Outside }

mod climate

pub enum ClimateMode { Heating, Cooling }  --~ warning: enum `ClimateMode` contains the name of its module `climate`
pub enum Climate { Mild }
pub fn climate_reading(level: Int): Int := level + 1  --~ warning: function `climate_reading` contains the name of its module `climate`
pub enum Mode { Heat, Cool, Off, Auto }

comp wildcards {
    in mode: Mode
    pub out level: Int
    pub out other: Int

    req first: level = match mode { Mode::Heat => 1, _ => 2 }  --~ warning: `_` matches `climate::Mode::Cool`, `climate::Mode::Off` and `climate::Mode::Auto`
    req second: other = match mode { Mode::Heat => 1, Mode::Cool => 2, Mode::Off => 3, _ => 4 }  --~ warning: `_` matches `climate::Mode::Auto`
}

comp literals {
    in text: String
    pub out raw?
    pub out quoted?
    pub out accented?
    pub out astral?

    req raw_rule: raw? iff text.matches?(r"[a-z]+")  --~ warning: this raw string literal needs no escapes
    req quoted_rule: quoted? iff text.matches?(r#"a"[a-z]+"#)
    req accented_rule: accented? iff text = "café"  --~ warning: this string literal contains a non-ASCII character, `U+00E9`
    req astral_rule: astral? iff text = "a😀é"  --~ warning: this string literal contains non-ASCII characters: `U+1F600`, `U+00E9`
}

comp paths {
    in probe: sensors::Probe
    pub out inside?
    pub out side: Int

    req inside_rule: inside? iff probe = sensors::Probe::Inside  --~ warning: `sensors::Probe::Inside` is a path of 3 segments
    req side_rule: side = match probe { sensors::Probe::Outside => 1, sensors::Probe::Inside => 2 }  --~ warning: `sensors::Probe::Outside` is a path of 3 segments
    --~^ warning: `sensors::Probe::Inside` is a path of 3 segments
}

comp short {
    in x: Int  --~ warning: variable `x` has a name of one character
    in ready?
    pub out y?  --~ warning: variable `y?` has a name of one character

    req r: y? iff (ready? and x > 0)  --~ warning: constraint `r` has a name of one character
}

comp grouping {
    in first?
    in second?
    in third?
    in left: Set(Int)
    in right: Set(Int)
    in other: Set(Int)
    pub out loose?
    pub out tight?
    pub out sets: Set(Int) := left minus right inter other  --~ warning: `inter` is an operand of `minus` without parentheses
    pub out written: Set(Int) := left union (right inter other)

    req loose_rule: loose? iff (first? or second? and third?)  --~ warning: `and` is an operand of `or` without parentheses
    req tight_rule: tight? iff (first? or (second? and third?))
}

set_option fren.lint.glob_imports "allow"  --~ warning: `glob_imports` is allowed rather than expected
set_option fren.lint.glob_imports "expect"  --~ warning: this lint expectation is unfulfilled
set_option fren.lint.restriction "allow"  --~ warning: `restriction` is allowed rather than expected
set_option fren.lint.glob_imports "allow"
