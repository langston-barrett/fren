-- A denied lint is a static error, so the `fren` command checks nothing,
-- but Lean still checks the item: only `undecidable`, denied, stops Lean's
-- checks of an item (see `Reqs/View`).
set_option fren.lint.non_snake_case "deny" in
comp denied {
    --~^[hosted] error: `denied` is not realizable
    in x: Int
    pub out BadName: Int  --~ error: variable `BadName` should have a snake case name
    req a: BadName = x  --~[hosted] info: conflicts with `b`
    req b: BadName = x + 1  --~[hosted] info: conflicts with `a`
}
--@ exit: 2
