-- The lints of nested, literal and range patterns, and of tables, in both
-- front ends.
-- fren-covers: lint::collapsible_match, lint::match_overlapping_arm, lint::wildcard_in_or_patterns, lint::manual_range_patterns, lint::unnested_or_patterns, lint::match_bool, lint::manual_table, lint::same_rows
set_option fren.lint.unnested_or_patterns "warn"
set_option fren.lint.match_bool "warn"
set_option fren.lint.manual_table "warn"

enum Shape { Circle(Int), Square(Int), Empty }
enum Reply { Ok(Shape), Err(Int) }
enum Pair { Two(Shape, Int), None }

-- `collapsible_match`.
proc collapsible(r: Reply, p: Pair, k: Int): (
    det a: Int,
    det b: Int,
    det c: Int,
    det d: Int,
    det e: Int,
    det f: Int,
    det g: Int,
    det i: Int,
    det j: Int,
    det h: Int,
) {
    out a := match r {
        Reply::Ok(s) => match s {
            Shape::Circle(_) => 1,
            Shape::Square(_) => 2,
            _ => 0,
        },
        --~^^^^^ warning: this `match` on `s` can be part of the arm's pattern
        _ => 0,
    }
    -- An inner pattern binds a name of its own.
    out b := match r {
        Reply::Ok(s) => match s {
            Shape::Circle(n) => n,
            _ => 0,
        },
        _ => 0,
    }
    --~^^^^^^ warning: this `match` on `s` can be part of the arm's pattern
    -- The binder is mentioned in a body.
    out c := match r {
        Reply::Ok(s) => match s {
            Shape::Circle(_) => 1,
            Shape::Square(_) => if s = Shape::Empty then 2 else 3,
            _ => 0,
        },
        _ => 0,
    }
    -- The `_` arms differ.
    out d := match r {
        Reply::Ok(s) => match s {
            Shape::Circle(_) => 1,
            _ => 2,
        },
        _ => 0,
    }
    -- No `_` arm after it: the outer `match` names the other variant.
    out e := match r {
        Reply::Ok(s) => match s {
            Shape::Circle(_) => 1,
            _ => 0,
        },
        Reply::Err(_) => 0,
    }
    -- Another binder of the payload, which the bodies may mention.
    out f := match p {
        Pair::Two(s, n) => match s {
            Shape::Empty => n,
            _ => 0,
        },
        --~^^^^ warning: this `match` on `s` can be part of the arm's pattern
        _ => 0,
    }
    -- The payload's other pattern is not `_` or a binder.
    out g := match p {
        Pair::Two(s, 0) => match s {
            Shape::Empty => 1,
            _ => 0,
        },
        _ => 0,
    }
    -- The inner `_` arm's body mentions a binder of the arm's pattern, which
    -- the outer `_` arm's body, written the same, does not.
    out i := match p {
        Pair::Two(s, k!) => match s {
            Shape::Empty => 1,
            _ => k,
        },
        _ => k,
    }
    -- A guard.
    out j := match r {
        Reply::Ok(s) => match s {
            Shape::Circle(_) if k > 0 => 1,
            _ => 0,
        },
        _ => 0,
    }
    -- An inner pattern binds a name that the arm's pattern binds.
    out h := match p {
        Pair::Two(s, n) => match s {
            Shape::Circle(n!) => n,
            _ => 0,
        },
        _ => 0,
    }
}

-- The lints of or-patterns.
proc or_patterns(n: Int, s: Shape, r: Reply): (
    det a: Int,
    det b: Int,
    det c: Int,
    det d: Int,
    det e: Int,
    det f: Int,
    det g?,
    det h?,
) {
    out a := match n {
        1 | 2 | 3 => 1,  --~ warning: this or-pattern matches the range `1..=3`
        _ => 0,
    }
    out b := match n {
        ..=0 | 1 | 2..5 => 1,  --~ warning: this or-pattern matches the range `..=4`
        5 => 2,
        _ => 3,
    }
    -- Two literals, and alternatives with a gap.
    out c := match n {
        1 | 2 => 1,
        4 | 6 | 7 => 2,
        _ => 0,
    }
    out d := match s {
        Shape::Circle(_) => 1,
        Shape::Square(_) | _ => 0,  --~ warning: this or-pattern has `_` as an alternative
    }
    out e := match s {
        Shape::Circle(1) | Shape::Circle(2) => 1,  --~ warning: these alternatives differ only in one value of the payload
        _ => 0,
    }
    -- Not next to each other.
    out f := match s {
        Shape::Circle(1) | Shape::Square(1) | Shape::Circle(2) => 1,
        _ => 0,
    }
    -- Nested, and in a pattern test.
    out g? := r is Reply::Ok(Shape::Circle(1) | Shape::Circle(2) | Shape::Circle(3))
    --~^ warning: these alternatives differ only in one value of the payload
    out h? := r is Reply::Err(7 | 8 | 9)
    --~^ warning: this or-pattern matches the range `7..=9`
}

-- `match_overlapping_arm`.
proc overlapping(n: Int): (det a: Int, det b: Int, det c: Int, det d: Int) {
    out a := match n {
        0..=10 => 1,
        5..=15 => 2,  --~ warning: this range overlaps `0..=10`, an earlier arm's pattern
        _ => 3,
    }
    -- An exception first, and ranges that meet only at a bound of neither.
    out b := match n {
        5 => 1,
        0..=10 => 2,
        11.. => 3,
        _ => 4,
    }
    out c := match n {
        ..=0 => 1,
        -5..=5 => 2,  --~ warning: this range overlaps `..=0`, an earlier arm's pattern
        _ => 3,
    }
    -- A guard.
    out d := match n {
        0..=10 if n > 3 => 1,
        5..=15 => 2,
        _ => 3,
    }
}

-- `match_bool`.
proc bools(b?, x: Int): (det a: Int, det c: Int, det d?, det e: Int, det f: Int) {
    out a := match b? {
        true => x,
        false => 0,
    }
    --~^^^^ warning: this `match` on a `Bool` is an `if`
    out c := 2 * match b? {
        false => x,
        _ => 1,
    }
    --~^^^^ warning: this `match` on a `Bool` is an `if`
    -- `match_like_membership`, and the same bodies.
    out d? := match b? {  --~ warning: this `match` only tests which of its patterns its scrutinee matches
        true => false,
        false => true,
    }
    out e := match b? {
        true => x,
        false => x,
    }
    -- A guard.
    out f := match b? {
        true if x > 0 => x,
        _ => 0,
    }
}

-- `manual_table`, and `same_branches` on tables.
enum Mode { Heat, Cool, Off }

proc tables(x: Int, m: Mode): (
    det a: Int,
    det b: Int,
    det c: Int,
    det d: Int,
    det e: Int,
    det f: Int,
    det g: Int,
) {
    out a := if x > 10 then 2 else if x < 0 then 1 else 0
    --~^ warning: this chain of `if` chooses a value by conditions, as a table does
    -- One test, and variant tests of one scrutinee.
    out b := if x > 10 then 2 else 0
    out c := if m = Mode::Heat then 1 else if m = Mode::Cool then 2 else 0
    out d := table {  --~ warning: every row of this table has a value written the same
        x > 0 => x + 1,
        _ => x + 1,
    }
    out e := table {  --~ warning: every row of this table has a value written the same
        x > 0 => 1,
        x <= 0 => 1,
    }
    out f := table {
        x > 0 => 1,
        _ => 2,
    }
    out g := table {  --~ warning: every row of this table has a value written the same
        _ => x,
    }
}
