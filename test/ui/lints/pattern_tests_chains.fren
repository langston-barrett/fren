-- The lints of pattern tests and chained comparisons, in both front ends.
set_option fren.lint.if_chain_match "warn"

enum Shade { Light, Dark, Tinted(Int) }
enum Single { Only }

comp tests {
    in s: Shade
    in o: Single
    pub out a?
    pub out b?
    pub out c?
    pub out d?
    pub out e?
    pub out f?
    pub out g?
    pub out h?
    pub out k: Int

    ensure r1: a? iff s is Shade::Light         --~ warning: this pattern test is an equation
    ensure r2: b? iff s is Shade::Light | Shade::Dark  --~ warning: this pattern test is a membership
    -- A payload stays a test.
    ensure r3: c? iff s is Shade::Tinted(_)
    ensure r4: d? iff s is Shade::Light | Shade::Tinted(_)
    ensure r5: e? iff s is _                    --~ warning: this pattern test is always `true`
    ensure r6: f? iff s is Shade::Light | Shade::Dark | Shade::Tinted(_)
    --~^ warning: this pattern test is always `true`
    ensure r7: g? iff not o is Single::Only        --~ warning: this pattern test is always `true`
    ensure r8: h? iff match s { Shade::Tinted(_) => true, _ => false }
    --~^ warning: this `match` only tests which of its patterns its scrutinee matches
    ensure r9: k = if s is Shade::Tinted(_) then 1 else if s is Shade::Light then 2 else 3
    --~^ warning: this chain of `if` tests which variant `s` is
    --~^^ warning: this pattern test is an equation
}

comp binders {
    in s: Shade
    pub out a?

    -- A pattern that binds a name is left as it is.
    ensure r1: a? iff match s { Shade::Tinted(r) => true, _ => false }
}

comp chains {
    in i: Int
    in n: Int
    in m: Int
    in p?
    pub out a?
    pub out b?
    pub out c?
    pub out d?
    pub out e?
    pub out f?
    pub out g?
    pub out h?
    pub out j?
    pub out k?
    pub out l?

    ensure r1: a? iff 0 <= i and i < n          --~ warning: these comparisons can be chained
    ensure r2: b? iff i >= 0 and i < n          --~ warning: these comparisons can be chained
    ensure r3: c? iff p? and 0 <= i and i < n and m > 0  --~ warning: these comparisons can be chained
    ensure r4: d? iff 0 < i and i < n and n < m  --~ warning: these comparisons can be chained
    ensure r5: e? iff 0 <= i < n and n <= m     --~ warning: these comparisons can be chained
    -- Not adjacent, not sharing an operand, in parentheses, or the other way round.
    ensure r6: f? iff 0 <= i and p? and i < n
    ensure r7: g? iff 0 <= i and n < m
    ensure r8: h? iff (0 <= i) and i < n
    ensure r9: j? iff 0 <= i and i <= 0         --~ warning: these two comparisons are
    ensure r10: k? iff 0 <= i <= n - 1          --~ warning: over integers, this is a strict comparison
    ensure r11: l? iff 0 <= i + 1 <= n
}

comp contradictions {
    in x: Int
    pub out a?
    pub out b?
    pub out c?

    ensure r1: a? iff 5 < x < 3                 --~ warning: these two comparisons cannot both hold
    ensure r2: b? iff 0 <= x <= 0
    ensure r3: c? iff 3 <= x <= 2 < 4           --~ warning: these two comparisons cannot both hold
}

-- Literal, range and nested patterns.
comp patterns {
    in s: Shade
    in n: Int
    in b?
    pub out a?
    pub out c?
    pub out d?
    pub out e?
    pub out f?
    pub out g?
    pub out h?
    pub out j?
    pub out k?
    pub out l?
    pub out m?
    pub out o?

    ensure r1: a? iff n is 0 | 1                --~ warning: this pattern test is a membership
    ensure r2: c? iff b? is true                --~ warning: this pattern test is an equation
    -- Ranges, a literal written otherwise than its value, and nested patterns stay tests.
    ensure r3: d? iff n is 0..=9
    ensure r4: e? iff n is 0x10
    ensure r5: f? iff s is Shade::Tinted(0)
    ensure r6: g? iff n is ..=0 | 1..           --~ warning: this pattern test is always `true`
    ensure r7: h? iff b? is true | false        --~ warning: this pattern test is always `true`
    -- A `match` of literals is a membership, and one of ranges or nested patterns a test.
    ensure r8: j? iff match n { 0 | 1 => true, _ => false }
    --~^ warning: this `match` only tests which of its patterns its scrutinee matches
    ensure r9: k? iff match n { 0..=9 => true, _ => false }
    --~^ warning: this `match` only tests which of its patterns its scrutinee matches
    ensure r10: l? iff match s { Shade::Tinted(0) => true, _ => false }
    --~^ warning: this `match` only tests which of its patterns its scrutinee matches
    -- An arm of the other body before an overlapping one: the order matters.
    ensure r11: m? iff match n { 0..=5 => false, 3..=9 => true, _ => false }
    ensure r12: o? iff match s { Shade::Tinted(0) => false, Shade::Tinted(_) => true, _ => false }
}

comp commented {
    in i: Int
    in n: Int
    pub out a?

    ensure r1: a? iff 0 <= i and /- the bound -/ i < n  --~ warning: these comparisons can be chained
}

-- Review cases: a nested alternative is not the whole variant, overlapping
-- arms keep their order, and literal, range and nested tests are not
-- variant tests.
set_option fren.lint.if_chain_match "warn" in
set_option fren.lint.case_split_guarantees "warn" in
comp review {
    in s: Shade
    in n: Int
    pub out a?
    pub out b?
    pub out k: Int
    pub out j: Int
    pub out y: Int

    ensure r1: a? iff s is Shade::Light | Shade::Dark | Shade::Tinted(0)
    ensure r2: b? iff match s { Shade::Tinted(0) => true, Shade::Tinted(_) => false, Shade::Light | Shade::Dark => true }
    ensure r3: k = if n is 0 then 1 else if n is 1..=5 then 2 else 3  --~ warning: this pattern test is an equation
    ensure r4: j = if s is Shade::Tinted(0) then 1 else if s is Shade::Tinted(_) then 2 else 3
    ensure r5: when s is Shade::Tinted(0), y = 1
    ensure r6: when s is Shade::Light, y = 2         --~ warning: this pattern test is an equation
}
