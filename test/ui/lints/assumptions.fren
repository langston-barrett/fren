-- `unused_assumption`, in both front ends: an assumption that mentions only
-- inputs that nothing else mentions.

proc left_over(x: Int, n: Int, t: Int): (y: Int) {
    assume pos: n > 0  --~ warning: the assumption `pos` constrains only inputs that nothing uses
    assume small: n < 10  --~ warning: the assumption `small` constrains only inputs that nothing uses
    -- `t` is used, and so `x` too.
    assume below: x < t
    ensure r: y = x + t
}

-- Another assumption ties `n` to `m`, which is used: without `a`, `pos`
-- would not hold.
proc linked(n: Int, m: Int): (y: Int) {
    assume a: n > 0
    assume b: m = 2 * n
    ensure r: y = m
    expect pos: y > 0
}

-- A chain of three: `k` to `n` to `m`, which is used.
proc chained(k: Int, n: Int, m: Int): (y: Int) {
    assume a: k > 0
    assume b: n = k + 1
    assume c: m = 2 * n
    ensure r: y = m
    expect pos: y > 2
}

-- A chain that reaches no used variable is reported link by link.
proc unlinked(k: Int, n: Int): (y: Int) {
    assume a: k > 0  --~ warning: the assumption `a` constrains only inputs that nothing uses
    assume b: n = k + 1  --~ warning: the assumption `b` constrains only inputs that nothing uses
    ensure r: y = 1
}

pub proc sub(x: Int): (y: Int) {
    assume pos: x > 0
    ensure r: y = x
}

-- The assumption feeds an instance's binding.
proc bound(x: Int): (y: Int) {
    assume pos: x > 0
    call w := sub(x)

    ensure r: y = w.y
}

-- A definition is something else.
proc defined(x: Int, k: Int): (y: Int) {
    assume pos: k > 0
    det let d: Int := k + 1
    ensure r: y = x + d
}

-- A global expectation in the file reads it.
proc read_globally(z: Int): (y: Int) {
    assume pos: z > 0
    ensure r: y = 1
}

expect g: forall (a: read_globally), a.z > 0

-- A refinement of it in the file reads its inputs, bound or by name, under
-- its assumptions, which here guard the binding of `x`.
proc first_of(n: Int, x: Int, m: Int): (y: Int) {
    assume pos: n > 0
    assume named: m > 0
    ensure r: y = x
}

proc heads(q: Seq<Int>, m: Int): (s: Seq<Int>, t: Int) {
    out s := q
    out t := m
}

refine guarded: heads refines first_of { n := q.len, x := q[0], y := s[0] }

-- An instance of it in the file binds its input, and the instance's
-- assumption check checks the assumption.
proc instanced(k: Int) {
    assume pos: k > 0
}

proc uses_instanced(): (y: Int) {
    call i := instanced(1)
    ensure r: y = 1
}

-- A global expectation's read reaches the other assumptions too.
proc read_through(k: Int, z: Int): (y: Int) {
    assume a: k > 0
    assume b: z = k + 1
    ensure r: y = 1
}

expect h: forall (a: read_through), a.z > 1

-- A function ties the assumption to the guarantee: `a` says that
-- `gain(3) > 0`.
pub fn gain(Int): Int

proc pinned(n: Int): (y: Int) {
    assume a: n = 3 and gain(n) > 0
    ensure r: y = gain(3)
    expect pos: y > 0
}

-- So does a function over a finite domain, with no constant.
pub enum Color { Red, Green }
pub fn f(Color): Int

proc rooted(n: Color): (y: Int) {
    assume a: f(n) = 0
    ensure r: y = 1
    expect root: f(Color::Red) = 0 or f(Color::Green) = 0
}

-- A constant's value is known, so it links nothing.
const THREE: Int := 3

proc constant(n: Int): (y: Int) {
    assume a: n = THREE  --~ warning: the assumption `a` constrains only inputs that nothing uses
    ensure r: y = THREE
}

-- A function that the assumption applies, and nothing else does, links
-- nothing.
pub fn loss(Int): Int

proc own_function(n: Int): (y: Int) {
    assume a: loss(n) > 0  --~ warning: the assumption `a` constrains only inputs that nothing uses
    ensure r: y = gain(1)
}

-- A variant is a value, not a function or a constant.
proc variant(n: Color): (y: Int) {
    assume a: n = Color::Red  --~ warning: the assumption `a` constrains only inputs that nothing uses
    ensure r: y = 1
}

-- An assumption that only bounds the size of an abstract type is unused:
-- a counterexample without it extends to one with it.
type Key

proc keyed(k1: Key, k2: Key, i: Key, j: Key): (same?) {
    assume distinct: k1 != k2  --~ warning: the assumption `distinct` constrains only inputs that nothing uses
    ensure r: same? iff i = j
    expect equal: when i = j, same?
}

-- A pair reported together: `a` guards the index in `b`, so `b` alone is not
-- defined, and each message names the other.
proc guarded_pair(n: Int, q: Seq<Int>): (y: Int) {
    assume a: n >= 0 and n < q.len  --~ warning: it is linked to `b`, reported too, which may need it: remove them together
    --~^ warning: these comparisons can be chained
    --~^^ warning: `n` is never negative, so it can be a `Nat`
    assume b: q[n] > 0  --~ warning: it is linked to `a`, reported too, which may need it: remove them together
    ensure r: y = 1
}

-- A cover goal is a use: whether it is reachable depends on the assumption.
proc covered(n: Int): (y: Int) {
    assume a: n > 0
    ensure r: y = 1
    cover g: n = 2  --~ info: cover goal `covered::g` is met
}

-- So is a guarantee with a `where` clause.
proc where_clause(n: Int): (y: Int) {
    assume a: n > 0
    ensure r: y = m where m := n
}
