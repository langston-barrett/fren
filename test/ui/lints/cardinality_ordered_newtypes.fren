-- The lints of cardinality operators, ordered enumerations and newtypes,
-- in both front ends.
set_option fren.lint.manual_ordering "warn"

pub ordered enum Severity { Silent, Info, Warning, Error }
pub ordered enum Single { Only }
pub enum Mode { Off, Heat, Cool }
pub ordered struct Ms(Int)
pub struct Bytes(Int)
pub ordered struct Grade(Severity)
pub struct Qs(Seq<Int>)
pub struct Ss(Set<Int>)

proc cardinality(a?, b?, c?, d?, q: Seq<Int>): (
    o1?,
    o2?,
    o3?,
    o4?,
    o5?,
    o6?,
    o6b?,
    o7?,
    o8?,
    o9?,
    o10?,
    o11?,
    o12?,
) {
    ensure r1: o1? iff not (a? and b?) and not (a? and c?) and not (b? and c?)
    --~^ warning: this is `at_most_one?` of 3 operands
    ensure r2: o2? iff (a? or b? or c?) and not (a? and b?) and not (b? and c?) and not (a? and c?)
    --~^ warning: this is `exactly_one?` of 3 operands
    ensure r3: o3? iff d? and not (b? and a?) and not (c? and a?) and not (c? and b?) and (c? or b? or a?)
    --~^ warning: this is `exactly_one?` of 3 operands
    -- A pair left out, two operands, or a conjunct in parentheses: none
    -- fires. A pair written twice is the same conjunction.
    ensure r4: o4? iff not (a? and b?) and not (a? and c?)
    ensure r5: o5? iff not (a? and b?)
    ensure r6: o6? iff not (a? and b?) and not (b? and a?) and not (a? and c?) and not (b? and c?)
    --~^ warning: this is `at_most_one?` of 3 operands
    -- An operand written twice in the disjunction is still the disjunction.
    ensure r6b: o6b? iff (a? or b? or c? or a?) and not (a? and b?) and not (b? and c?) and not (a? and c?)
    --~^ warning: this is `exactly_one?` of 3 operands
    ensure r7: o7? iff not (a? and b?) and (not (a? and c?)) and not (b? and c?)
    -- Nor where an operand indexes, whose guards would change.
    ensure r8: when q.len > 1, o8? iff (not (q[0] > 0 and a?) and not (q[0] > 0 and q[1] > 0) and not (a? and q[1] > 0))
    ensure r9: o9? iff exactly_one?(a?)            --~ warning: this `Bool` expression can be simpler
    ensure r10: o10? iff at_most_one?(b?) or c?    --~ warning: this `Bool` expression can be simpler
    ensure r11: o11? iff exactly_one?(a?, b?, a?)  --~ warning: `a?` is an argument of `exactly_one?` more than once
    ensure r12: o12? iff at_most_one?(a?, b?, c?) and exactly_one?(a?, not a?)
}

proc orderings(s: Severity, t: Severity, g: Grade, o: Single, m: Mode): (
    p1?,
    p2?,
    p3?,
    p4?,
    p5?,
    p6?,
    p7?,
    p8?,
    p9?,
) {
    ensure r1: p1? iff s >= Severity::Silent       --~ warning: this comparison is always `true`
    ensure r2: p2? iff s < Severity::Silent        --~ warning: this comparison is always `false`
    ensure r3: p3? iff Severity::Error >= s        --~ warning: this comparison is always `true`
    ensure r4: p4? iff s > Severity::Error         --~ warning: this comparison is always `false`
    ensure r5: p5? iff g >= Grade(Severity::Silent)  --~ warning: this comparison is always `true`
    ensure r6: p6? iff o <= Single::Only           --~ warning: this comparison is always `true`
    -- Comparisons with a variant between the first and the last, which
    -- chain as `Int`s do, and of an enumeration that is not ordered.
    ensure r7: p7? iff s > Severity::Silent and s < Severity::Error and t <= Severity::Warning
    --~^ warning: these comparisons can be chained
    ensure r8: p8? iff m = Mode::Off or m != Mode::Cool
    ensure r9: p9? iff s < Severity::Warning or s = Severity::Warning
    --~^ warning: these two comparisons are `s <= Severity::Warning`
}

-- The equations are left as they are: a pattern test is
-- `manual_pattern_test`'s fix.
set_option fren.lint.manual_pattern_test "allow" in
proc memberships(s: Severity, m: Mode): (p1?, p2?, p3?, p4?, p4b?, p5?, p6?, p7?, p8?) {
    ensure r1: p1? iff s in {Severity::Silent, Severity::Info}   --~ warning: this is `s <= Severity::Info`
    ensure r2: p2? iff s in {Severity::Error, Severity::Warning}  --~ warning: this is `s >= Severity::Warning`
    ensure r3: p3? iff s = Severity::Silent or s = Severity::Info   --~ warning: this is `s <= Severity::Info`
    ensure r4: p4? iff s != Severity::Error and s != Severity::Warning  --~ warning: this is `s < Severity::Warning`
    -- A variant written twice is still a variant of the test.
    ensure r4b: p4b? iff s = Severity::Error or s = Severity::Warning or s = Severity::Error
    --~^ warning: this is `s >= Severity::Warning`
    -- Not the first or last variants, all of them, or not ordered.
    ensure r5: p5? iff s in {Severity::Silent, Severity::Warning}
    ensure r6: p6? iff s in {
        Severity::Silent,
        Severity::Info,
        Severity::Warning,
        Severity::Error,
    }
    ensure r7: p7? iff m in {Mode::Off, Mode::Heat}
    ensure r8: p8? iff s = Severity::Silent or s = Severity::Info or s = Severity::Error
}

proc bounds(s: Severity, t: Severity): (
    v1: Severity,
    v2: Severity,
    v3: Severity,
    v4: Severity,
    v5: Severity,
) {
    ensure r1: v1 = s.max(Severity::Silent)  --~ warning: this is always `s`
    ensure r2: v2 = s.min(Severity::Silent)  --~ warning: this is always `Severity::Silent`
    ensure r3: v3 = s.max(Severity::Error)   --~ warning: this is always `Severity::Error`
    ensure r4: v4 = s.min(Severity::Error)   --~ warning: this is always `s`
    ensure r5: v5 = s.max(t).min(Severity::Info)
}

proc newtypes(x: Ms, n: Int, y: Bytes): (m1: Ms, k1: Int, m2: Ms, k2: Int, m3: Ms) {
    ensure w1: m1 = Ms(x.0)                 --~ warning: this builds a newtype from the field of one of its own
    ensure w2: k1 = Ms(n + 1).0 * 2         --~ warning: this reads the field of a newtype just built
    ensure w3: k2 = (Ms(n)).0 + 1           --~ warning: this reads the field of a newtype just built
    -- A conversion from another newtype, and a field changed.
    ensure w4: m2 = Ms(y.0)
    ensure w5: m3 = Ms(x.0 + 1)
    expect same: Ms(n) = Ms(n)           --~ warning: both operands of `=` are written the same
}

-- An operand whose definition indexes, or is a table, keeps its guard.
proc guarded(q: Seq<Int>, i: Int, x: Int, z?): (o1?, o2?) {
    ensure r1: o1? iff not (ok? and big?) and not (ok2? and big?) and not (ok? and ok2?)
        where ok? := 0 <= i < q.len, ok2? := 0 <= i < q.len and z?, big? := q[i] > 0
    ensure r2: o2? iff not (pos? and t?) and not (pos2? and t?) and not (pos? and pos2?)
        where pos? := x > 0, pos2? := x > 0 and z?, t? := table {
            x > 0 => true,
        }
}

-- An empty literal takes its type from the newtype, so there is no fix;
-- a round trip inside another is reported once.
proc untyped(q: Seq<Int>, x: Ms): (p1?, p2?, p3?) {
    ensure r1: p1? iff Qs([]).0.len = q.len  --~ warning: this reads the field of a newtype just built
    ensure r2: p2? iff Ss({}).0 = {}         --~ warning: this reads the field of a newtype just built
    ensure r3: p3? iff Ms(x.0).0 = 3         --~ warning: this builds a newtype from the field of one of its own
}
