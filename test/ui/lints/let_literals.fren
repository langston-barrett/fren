-- `zero_prefixed_literal` in the definitions of a `where` clause and a
-- `let`, whose text follows or precedes the expression it names within.
proc c(x: Int): (y?, z?) {
    ensure r: y? iff x > k where k := 007
    --~^ warning: `007` is 7
    ensure s: let j := 010 in z? iff x > j
    --~^ warning: `010` is 10
}

--@ summary: 3 passed, 0 failed, 0 inconclusive, 0 redundant
