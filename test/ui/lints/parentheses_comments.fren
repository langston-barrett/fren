-- Parentheses and comments, which both front ends see through alike: an
-- element or a bound in parentheses, and a comment next to the value of a
-- binding or a field.
set_option fren.lint.definable_output "allow"

struct P { x: Int, y: Int }

comp sub {
    in x: Int
    pub out o?

    req r: o? iff x > 0
}

comp lints {
    in x: Int
    in y: Int
    in s: String
    in q: Seq(Int)
    pub out p1?
    pub out p2?
    pub out p3?
    pub out p4?

    inst w: sub { x := x,  --~ warning: `x := x` is `x`
    }
    inst v: sub { x := /- a comment -/ x }  --~ warning: `x := x` is `x`

    req r1: p1? iff x in {(1), 1}  --~ warning: `1` is repeated in this literal
    req r2: p2? iff x in {1, (1)}  --~ warning: `(1)` is repeated in this literal
    req r3: p3? iff s.len = (0)    --~ warning: say whether it is empty with `""`, not `len`
    req r4: p4? iff q.len > (0)    --~ warning: say whether it is empty with `[]`, not `len`
    expect r5: P { x := x  -- a comment
            , y := y }.x = x
    --~^^ warning: `x := x` is `x`
    --~^^ warning: `y := y` is `y`
}
