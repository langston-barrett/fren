-- Parentheses and comments, which both front ends see through alike: an
-- element or a bound in parentheses, and a comment next to the value of a
-- binding or a field.
set_option fren.lint.definable_output "allow"

struct P { x: Int, y: Int }

proc sub(x: Int): (o?) { ensure r: o? iff x > 0 }

proc lints(x: Int, y: Int, s: String, q: Seq<Int>): (p1?, p2?, p3?, p4?) {
    call w := sub(x)
    call v := sub( /- a comment -/ x)

    ensure r1: p1? iff x in {(1), 1}  --~ warning: `1` is repeated in this literal
    ensure r2: p2? iff x in {1, (1)}  --~ warning: `(1)` is repeated in this literal
    ensure r3: p3? iff s.len = (0)    --~ warning: say whether it is empty with `""`, not `len`
    ensure r4: p4? iff q.len > (0)    --~ warning: say whether it is empty with `[]`, not `len`
    expect r5: P {
        x := x,  -- a comment
        --~^ warning: `x := x` is `x`
        y := y,  --~ warning: `y := y` is `y`
    }.x = x
}
