-- Lints that compare or rewrite parts of an expression leave those whose
-- pattern tests bind names, whose scope the parts' positions decide
-- (`lang::test_scope`).
enum Reply { Empty, Value(Int) }

proc shadowing(r: Reply, v: Int): (w: Int, m: Int) {
    -- The `then` branch's `v` is the payload, and the `else` branch's the input.
    ensure same: w = (if r is Reply::Value(v!) then v else v)
    ensure method: m = (if r is Reply::Value(v!) then v.max(0) else v.max(0))

    expect payload: when r = Reply::Value(3), w = 3 and m = 3
    expect input: when r = Reply::Empty, w = v
}

-- Without a binder, `same_branches` reports it.
proc plain(r: Reply, v: Int): (w: Int) {
    ensure same: w = (if r is Reply::Value(_) then v else v)   --~ warning: both branches of `if` are written the same
}

-- Nor does `branches_sharing_code` move `v` out of the branches, where the
-- two are the payload and the input (`lint::branches_sharing_code`), nor
-- `same_branches` compare branches that mention no binder.
set_option fren.lint.branches_sharing_code "warn" in
proc shared_binders(r: Reply, v: Int): (w: Int, u: Int) {
    ensure sum: w = (if r is Reply::Value(v!) then 1 + v else 2 + v)
    ensure constant: u = (if r is Reply::Value(v!) and v > 0 then 1 else 1)

    expect payload: when r = Reply::Value(3), w = 4
    expect input: when r = Reply::Empty, w = 2 + v
}

-- Without a binder, `branches_sharing_code` reports it.
set_option fren.lint.branches_sharing_code "warn" in
proc shared_plain(r: Reply, v: Int): (w: Int) {
    ensure sum: w = (if r is Reply::Value(_) then 1 + v else 2 + v)   --~ warning: both branches of this `if` end with `+ v`
}

-- Nor does `eq_op` compare operands that see different binders: the right
-- operand's first `v` is the left's payload (`lint::eq_op`).
proc eq_binders(r: Reply, v: Int): (w?, x?, y?) {
    ensure both: w? iff ((v > 1 and r is Reply::Value(v!) and v < 3) and (v > 1 and r is Reply::Value(v!) and v < 3))
    ensure one: x? iff (v > 1 and r is Reply::Value(v!) and v < 3)
    -- Without a binder, it fires.
    ensure plain: y? iff ((v > 1 and r is Reply::Value(_)) and (v > 1 and r is Reply::Value(_)))
    --~^ warning: both operands of `and` are written the same

    expect differ: when r = Reply::Value(0) and v = 5, x? and not w?
}
