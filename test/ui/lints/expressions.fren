-- The expression and constraint lints, in both front ends:
-- `needless_bool_assign`, `needless_match` and `assertions_on_constants`;
-- `suspicious_unary_op_formatting` is in `unary_formatting.fren`.
proc bools(a?, b?, c?, x: Int): (p1?, p2?, p3?, p4?, p5?, p6?) {
    ensure r1: p1? iff if a? then b? else not b?  --~ warning: this `if` gives a `Bool` or its negation
    ensure r2: p2? iff if a? and b? then not (x > 0) else x > 0
    --~^ warning: this `if` gives a `Bool` or its negation
    --~^^ warning: this `Bool` expression can be simpler
    ensure r3: p3? iff if a? then b? else (not (b?))  --~ warning: this `if` gives a `Bool` or its negation
    -- Not written the same, or not negated.
    ensure r4: p4? iff if a? then b? else not a?
    ensure r5: p5? iff if a? then not b? else not b?  --~ warning: both branches of `if` are written the same
    -- A condition that ends in a conditional is put in parentheses.
    ensure r6: p6? iff (if a? and if c? then b? else a? then b? else not b?)
    --~^ warning: write `(a? and if c? then b? else a?) iff b?`
}

enum Shape { Dot, Circle(Int), Rect(Int, Int) }

-- A pattern test is an opaque test: the lints look inside it only at its
-- scrutinee.
proc pattern_tests(s: Shape, b?): (p1?, p2?, p3?, n: Int) {
    use self::Shape::{Circle, Dot}

    ensure r1: p1? iff if s is Circle(_) then b? else not b?
    --~^ warning: write `(s is Circle(_) iff b?)`
    ensure r2: n = if s is Dot then 1 else if s is Dot then 2 else 3
    --~^ warning: `s is Dot` is already tested earlier in this chain
    --~^^ warning: this pattern test is an equation
    --~^^^ warning: this pattern test is an equation
    -- Not compared as values: a test of two variants is left as it is.
    ensure r3: p2? iff (s is Dot and s is Circle(_))  --~ warning: this pattern test is an equation
    ensure r4: p3? iff (if b? then s else s) is Dot  --~ warning: both branches of `if` are written the same
    --~^ warning: this pattern test is an equation
}

proc rebuilt(s: Shape, x: Int): (t1: Shape, t2: Shape, t3: Shape, t4: Shape, t5: Shape, t6: Shape) {
    use self::Shape::{Circle, Dot, Rect}

    ensure r1: t1 = match s {  --~ warning: this `match` gives back its scrutinee
        Dot => Shape::Dot,
        Circle(r) => Circle(r),
        Rect(w, h) => Shape::Rect(w, h),
    }
    ensure r2: t2 = match s {  --~ warning: this `match` gives back its scrutinee
        Shape::Circle(r) => Shape::Circle(r),
        _ => s,
    }
    -- The binders out of order, `_`, a value of another variant, and a `_` arm that is not the scrutinee.
    ensure r3: t3 = match s {
        Rect(w, h) => Rect(h, w),
        _ => s,
    }
    ensure r4: t4 = match s {
        Rect(w, _) => Rect(w, 0),
        _ => s,
    }
    ensure r5: t5 = match s {
        Circle(r) => Circle(r),
        _ => Dot,
    }
    ensure r6: t6 = match s {
        Dot => Dot,
        Circle(r) => Circle(x),
        Rect(w, h) => Rect(w, h),
    }
}

const LIMIT: Int := 10

proc constants(x: Int): (y: Int) {
    assume small: x < LIMIT
    ensure r1: y = x
    expect e1: LIMIT > 0  --~ warning: this expectation mentions no variable
    expect e2: (true)  --~ warning: this expectation mentions no variable
}

expect constant_global: 1 < 2  --~ warning: this expectation mentions no variable
