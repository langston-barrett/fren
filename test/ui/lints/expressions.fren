-- The expression and constraint lints, in both front ends:
-- `needless_bool_assign`, `needless_match` and `assertions_on_constants`;
-- `suspicious_unary_op_formatting` is in `unary_formatting.fren`.
comp bools {
    in a?
    in b?
    in c?
    in x: Int
    pub out p1?
    pub out p2?
    pub out p3?
    pub out p4?
    pub out p5?
    pub out p6?

    req r1: p1? iff if a? then b? else not b?  --~ warning: this `if` gives a `Bool` or its negation
    req r2: p2? iff if a? and b? then not (x > 0) else x > 0
    --~^ warning: this `if` gives a `Bool` or its negation
    --~^^ warning: this `Bool` expression can be simpler
    req r3: p3? iff if a? then b? else (not (b?))  --~ warning: this `if` gives a `Bool` or its negation
    -- Not written the same, or not negated.
    req r4: p4? iff if a? then b? else not a?
    req r5: p5? iff if a? then not b? else not b?  --~ warning: both branches of `if` are written the same
    -- A condition that ends in a conditional is put in parentheses.
    req r6: p6? iff (if a? and if c? then b? else a? then b? else not b?)
    --~^ warning: write `(a? and if c? then b? else a?) iff b?`
}

enum Shape { Dot, Circle(Int), Rect(Int, Int) }

-- A pattern test is an opaque test: the lints look inside it only at its
-- scrutinee.
comp pattern_tests {
    use self::Shape::{Circle, Dot}
    in s: Shape
    in b?
    pub out p1?
    pub out p2?
    pub out p3?
    pub out n: Int

    req r1: p1? iff if s is Circle(_) then b? else not b?
    --~^ warning: write `(s is Circle(_) iff b?)`
    req r2: n = if s is Dot then 1 else if s is Dot then 2 else 3
    --~^ warning: `s is Dot` is already tested earlier in this chain
    --~^^ warning: this pattern test is an equation
    --~^^^ warning: this pattern test is an equation
    -- Not compared as values: a test of two variants is left as it is.
    req r3: p2? iff (s is Dot and s is Circle(_))  --~ warning: this pattern test is an equation
    req r4: p3? iff (if b? then s else s) is Dot  --~ warning: both branches of `if` are written the same
    --~^ warning: this pattern test is an equation
}

comp rebuilt {
    use self::Shape::{Circle, Dot, Rect}
    in s: Shape
    in x: Int
    pub out t1: Shape
    pub out t2: Shape
    pub out t3: Shape
    pub out t4: Shape
    pub out t5: Shape
    pub out t6: Shape

    req r1: t1 = match s { Dot => Shape::Dot, Circle(r) => Circle(r), Rect(w, h) => Shape::Rect(w, h) }
    --~^ warning: this `match` gives back its scrutinee
    req r2: t2 = match s { Shape::Circle(r) => Shape::Circle(r), _ => s }
    --~^ warning: this `match` gives back its scrutinee
    -- The binders out of order, `_`, a value of another variant, and a `_` arm that is not the scrutinee.
    req r3: t3 = match s { Rect(w, h) => Rect(h, w), _ => s }
    req r4: t4 = match s { Rect(w, _) => Rect(w, 0), _ => s }
    req r5: t5 = match s { Circle(r) => Circle(r), _ => Dot }
    req r6: t6 = match s { Dot => Dot, Circle(r) => Circle(x), Rect(w, h) => Rect(w, h) }
}

const LIMIT: Int := 10

comp constants {
    in x: Int
    pub out y: Int

    assume small: x < LIMIT
    req r1: y = x
    expect e1: LIMIT > 0  --~ warning: this expectation mentions no variable
    expect e2: (true)  --~ warning: this expectation mentions no variable
}

expect constant_global: 1 < 2  --~ warning: this expectation mentions no variable
