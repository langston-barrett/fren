-- `suspicious_unary_op_formatting`, in both front ends. Not formatted,
-- since `fren fmt` writes `x >=- 1` as `x >= -1`.

proc unary(x: Int): (p1?, p2?, n1: Int, n2: Int) {
    ensure r1: p1? iff x >=- 1  --~ warning: `>=-` looks like one operator
    ensure r2: p2? iff x != - 1 and x =- 2
    --~^ warning: `=-` looks like one operator
    --~^^ warning: these two comparisons are `x =- 2`
    ensure r3: n1 = 2 *- x  --~ warning: `*-` looks like one operator
    -- Written as meant.
    ensure r4: n2 = x * -2
}
