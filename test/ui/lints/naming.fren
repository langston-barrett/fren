-- Naming rules (`lang::bool_naming`) and uniqueness.

enum Bad? { X }                   --~ error: enum names cannot end in `?`
enum Int { A }                    --~ error: `Int` is a built-in type and cannot be redefined
enum V { A, A }                   --~ error: variant `A` is defined multiple times

proc untyped(x) {}             --~ error: missing type for `x`
proc bool_no_q(flag: Bool) {}  --~ error: `Bool` variable `flag` must end in `?`
proc q_not_bool(n?: Int) {}    --~ error: `n?` ends in `?` but is not a `Bool`
proc req_q(x: Int) { ensure r?: x > 0 }  --~ error: constraint names cannot end in `?`
proc dup() { ensure d: true ensure d: false }   --~ error: `d` is defined multiple times in this procedure

enum E { A }
enum E { B }                      --~ error: the name `E` is already defined in the root module (as an enum)
--~^^ warning: enum `E` is never used

-- `true` and `false` are literals, so nothing could mention a declaration
-- of either (`Reqs/Lang/Lexical#keywords`).
proc lit_var(true: Int): (y: Int) { ensure r: y = 1 }  --~ error: `true` is a literal, so it cannot be declared
proc lit_req(x: Int) { ensure false: x > 0 }  --~ error: `false` is a literal, so it cannot be declared
fn lit_param(true: Int): Int := 1  --~ error: `true` is a literal, so it cannot be declared
enum LitVariant { false, B }      --~ error: `false` is a literal, so it cannot be declared
const true: Int := 1              --~ error: `true` is a literal, so it cannot be declared
proc lit_bang(true!: Int): (y: Int) { ensure r: y = 1 }  --~ error: `true` is a literal, so it cannot be declared
proc true(x: Int): (y: Int) { ensure r: y = x }  --~ error: `true` is a literal, so it cannot be declared
const false: Int := 1             --~ error: `false` is a literal, so it cannot be declared
enum LitE { true }                --~ error: `true` is a literal, so it cannot be declared
struct LitS { false: Int }        --~ error: `false` is a literal, so it cannot be declared
proc lit_req_true(x: Int) { ensure true: x > 0 }  --~ error: `true` is a literal, so it cannot be declared
pub enum LitShape { Circle(Int), Square }
proc lit_match(s: LitShape): (p?) { ensure r: p? iff match s { LitShape::Circle(true!) => p?, _ => false } }
--~^ error: `true` is a literal, so it cannot be declared
pub proc lit_sub(x: Int): (y: Int) { ensure r: y = x }
expect lit_global(false_x: Int) {
    call false := lit_sub(false_x)
    expect lit_global: false.y = 1  --~ error: `false` is a literal, so it cannot be declared
}
proc lit_inst(a: Int) { call true := lit_sub(a) }  --~ error: `true` is a literal, so it cannot be declared
proc true_q(true?): (y?) { ensure r: y? iff true? }

-- Untyped `?` names are `Bool`s.
proc fine(ok?): (done?) { ensure r: done? iff ok? }

mod true                          --~ error: `true` is a literal, so it cannot be declared

--@ exit: 2
