-- The operator and method lints, in both front ends.
set_option fren.lint.bool_equality "warn"

proc comparisons(a: Int, b: Int, u: Set<Int>, v: Set<Int>): (p?, q?, w?, z?) {
    ensure r1: p? iff (a < b or a = b)          --~ warning: these two comparisons are `a <= b`
    ensure r2: q? iff (a <= b and b <= a)       --~ warning: these two comparisons are `a = b`
    ensure r3: w? iff (a + 1 >= b and b != a + 1)  --~ warning: these two comparisons are `a + 1 > b`
    ensure r4: z? iff (u subset v and v subset u)  --~ warning: these two comparisons are `u = v`
    -- Not the same operands, or not a single comparison other than the two.
    expect e1: when a < b or a = a + 1, true
    expect e2: when a <= b or a > b, true
    expect e3: when a < b or a <= b, true
    expect e4: when u subset v or v subset u, true
}

proc bools(x?, y?): (p?, q?) {
    ensure r1: p? iff (x? = y?) and x?          --~ warning: equality of `Bool`s is `iff`
    ensure r2: q? = (x? or y?)                  --~ warning: equality of `Bool`s is `iff`
    -- `!=`, literals and other types are left alone.
    expect e1: when x? != y?, true
    expect e2: when (x? = true) or y?, true
    --~^ warning: this `Bool` expression can be simpler
}

set_option fren.lint.undecidable "allow" in
proc searches(s: String, t: String, q: Seq<Int>): (a?, b?, c?, d?, e?) {
    ensure r1: a? iff s.index_of(t, 0) != -1     --~ warning: this is a call of `contains?`
    ensure r2: b? iff -1 = s.index_of(t, 0)      --~ warning: this is a call of `contains?`
    ensure r3: c? iff s.index_of(t, 0) = 0       --~ warning: this is a call of `starts_with?`
    ensure r4: d? iff s.slice(0, t.len) = t      --~ warning: this is a call of `starts_with?`
    ensure r5: e? iff q.index_of([1, 2], 0) < 0  --~ warning: this is a call of `contains?`
    -- From another position, or another bound.
    expect e1: when s.index_of(t, 1) >= 0 or s.index_of(t, 0) > 0, true
    expect e2: when s.slice(1, t.len) = t or s.slice(0, s.len) = t, true
    --~^ warning: this slice is the whole of its receiver
}

proc conditionals(c?, x: Int, y: Int): (n: Int, m: Int, k: Int, p?) {
    ensure r1: n = 2 * if c? then x else y + 1  --~ warning: the `else` branch extends past the operator
    ensure r2: m = 2 * if c? then x else if c? then y else y + 1
    --~^ warning: the `else` branch extends past the operator
    --~^^ warning: `c?` is already tested earlier in this chain
    ensure r3: p? iff c? and if c? then x > 0 else c? or y > 0
    --~^ warning: the `else` branch extends past the operator
    -- The `else` branch binds more tightly, or is in parentheses.
    ensure r4: k = x + if c? then x else y * 2
    expect e1: when 2 * (if c? then x else y) + 1 > 0 or (2 * if c? then x else (y + 1)) > 0, true
}

set_option fren.lint.undecidable "allow" in
proc identities(x: Int, y: Int, s: String, q: Seq<Int>, u: Set<Int>): (
    a: Int,
    b: Int,
    c: Int,
    d: String,
    e: Seq<Int>,
    f: Set<Int>,
) {
    out d := "" ++ s             --~ warning: this operation has no effect
    out e := q ++ []           --~ warning: this operation has no effect
    out f := u minus {}        --~ warning: this operation has no effect

    ensure r1: a = (x - y) * 1                  --~ warning: this operation has no effect
    ensure r2: b = 0 + x                        --~ warning: this operation has no effect
    ensure r3: c = x + -y                       --~ warning: this negation can be the other operator
    -- The fix of each of these fires again, and the next pass fixes it
    -- (`test/cli/fix/arith.fren`).
    expect e2: when x + -0 = 1, true            --~ warning: this negation can be the other operator
    expect e3: when x - - -y = 1, true
    --~^ warning: this negation can be the other operator
    --~^^ warning: negating twice is the operand itself
    expect e4: when 0 - -y = 1, true            --~ warning: this negation can be the other operator
    -- Not identities: they ignore an operand.
    expect e1: when x - 0 * y >= 1 - x or {} minus u = u, true
    --~^ warning: this `*` is always `0`
    --~^^ warning: this `minus` is always `{}`
    expect e5: unless x in [], true             --~ warning: this `in` is always `false`
}
