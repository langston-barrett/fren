-- Pedantic lints on comparisons, string literals and lists, in both front
-- ends: `invalid_upcast_comparisons`, `unicode_not_nfc` and
-- `unnecessary_trailing_comma`. All are allowed by default.

proc quiet(x: Int, s: String): (p?, m: Set<Int>) {
    out m := {x, 1,}

    ensure r: p? iff (x.abs >= 0 or s = "café")
}

set_option fren.lint.pedantic "warn"
set_option fren.lint.definable_output "allow"
set_option fren.lint.match_could_be_table "allow"
set_option fren.lint.many_single_char_names "allow"

pub enum Mode { Heat, Cool, }  --~ warning: unnecessary trailing comma before `}`

pub enum Fan {
    Low,
    High,
}

pub enum Vent {
    Open, Shut,}  --~ warning: unnecessary trailing comma before `}`

pub struct Reading { value: Int, mode: Mode, }  --~ warning: unnecessary trailing comma before `}`

use self::Mode::{Heat, Cool,}  --~ warning: unnecessary trailing comma before `}`

proc ranges(x: Int, y: Int, n: Nat): (a?, b?, c?, d?, e?, f?, g?, h?, i?, j?, k?, l?, o?, q?, t?) {
    out a? := x.abs >= 0                 --~ warning: this comparison is always `true`
    out b? := (x - y).abs < 0            --~ warning: this comparison is always `false`
    out c? := x.abs > -1                 --~ warning: this comparison is always `true`
    out d? := -2 = (x + y).abs           --~ warning: this comparison is always `false`
    out e? := 0 <= n.abs                 --~ warning: this comparison is always `true`
    out f? := x.abs != -5                --~ warning: this comparison is always `true`
    out g? := 0 > y.abs                  --~ warning: this comparison is always `false`
    -- Not fixed: `abs` can be 0, or any value above.
    out h? := x.abs > 0
    out i? := x.abs <= 0
    out j? := x.abs = 0
    out k? := 0 < x.abs
    out l? := x.abs >= 1
    -- An `Int` that is not a call may be negative, and `min` and `max` have
    -- no least value.
    out o? := x >= 0
    out q? := x.min(y) >= -1
    out t? := x.max(0) >= 0
}

set_option fren.lint.undecidable "allow" in
proc searches(s: String, t: String, i: Int, u: Seq<Int>): (a?, b?, c?, d?, e?, f?, g?) {
    out a? := s.index_of(t, i) >= -1     --~ warning: this comparison is always `true`
    out b? := s.index_of(t, i) < -1      --~ warning: this comparison is always `false`
    out c? := -3 > u.index_of([1], i)    --~ warning: this comparison is always `false`
    out d? := s.index_of(t, i) != -2     --~ warning: this comparison is always `true`
    -- Not fixed: the index can be -1, or any value above.
    out e? := s.index_of(t, i) = -1
    out f? := s.index_of(t, i) > -1
    out g? := s.index_of(t, i) <= -1
}

proc literals(s: String): (a?, b?, c?, d?, e?, f?, g?, h?, i?, j?, k?, l?, m?) {
    out a? := s = "café"               --~ warning: this string literal is not in Unicode NFC
    out b? := s = r"café"              --~ warning: this string literal is not in Unicode NFC
    out c? := s = r#"say "é""#         --~ warning: this string literal is not in Unicode NFC
    -- With an escape sequence, it suggests no literal, but its value is not in NFC.
    out d? := s = "\u0065́"          --~ warning: this string literal is not in Unicode NFC
    out e? := s = "\u0065\u0301"          --~ warning: this string literal is not in Unicode NFC
    out f? := s.starts_with?("Å")  --~ warning: this string literal is not in Unicode NFC
    -- In NFC: precomposed, a mark with no precomposed form, or ASCII.
    out g? := s = "café"
    out h? := s = "q́"
    out i? := s = "\u00e9"
    out j? := s = "plain"
    -- Hangul, composed and not.
    out k? := s = "가"         --~ warning: this string literal is not in Unicode NFC
    out l? := s = "가"
    -- A code point that Unicode 15.0 does not assign is not looked at.
    out m? := s = "é͸"
}

proc lists(x: Int, mode: Mode, fan: Fan, vent: Vent): (
    a: Set<Int>,
    b: Seq<Int>,
    c: Seq<Int>,
    d: Int,
    e: Reading,
    f: Seq<Int>,
    g: Seq<Int>,
) {
    out a := {x, 1,}          --~ warning: unnecessary trailing comma before `}`
    out b := [x, 2, ]         --~ warning: unnecessary trailing comma before `]`
    out c := [
        x,
        3,
    ]
    out d := match mode { Heat => 1, Cool => 2, }  --~ warning: unnecessary trailing comma before `}`
    out e := Reading { value := x, mode := Mode::Heat, }  --~ warning: unnecessary trailing comma before `}`
    -- A comment after the comma: a line ends before the `]`.
    out f := [x, 4, -- four
    ]
    out g := [x, 5]

    call w := quiet(x, "a",)        --~ warning: unnecessary trailing comma before `)`
    expect used: fan != Fan::Low or vent != Vent::Open or mode in {Heat, Cool}
}
