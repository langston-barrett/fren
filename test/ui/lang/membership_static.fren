-- The right of a membership that is neither a collection nor a relation,
-- in both front ends: a type error, never a crash.
-- fren-covers: lang::operator_type
set_option fren.lint.unused_variables "allow"

proc bool_right(s: Int, y?): (ok?) { ensure r: ok? iff s in y? }
--~^ error: `in` needs a `Set<Int>` on its right, found `Bool`
proc condition_right(s: Int): (ok?) { ensure r: ok? iff s in (s < 3) }
--~^ error: `in` needs a `Set<Int>` on its right, found `Bool`
proc int_right(s: Int, t: Int): (ok?) { ensure r: ok? iff s in t }
--~^ error: `in` needs a `Set<Int>` on its right, found `Int`
proc bool_left(y?, t: Int): (ok?) { ensure r: ok? iff y? in t }
--~^ error: `in` needs a `Set<Bool>` on its right, found `Int`
proc string_right(s: Int, t: String): (ok?) { ensure r: ok? iff s in t }
--~^ error: `in` needs a `Set<Int>` on its right, found `String`
