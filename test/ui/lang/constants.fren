-- Constants: values, types, scope, and use in every kind of expression.
set_option fren.lint.chainable_comparison "allow"

-- Expectations about constants test what the language computes.
set_option fren.lint.assertions_on_constants "allow"

mod climate
pub enum Mode { Off, Heat }
pub const MIN_T: Int := 50
pub const MAX_T: Int := MIN_T + 40          -- an earlier constant
const NEG: Int := -3
const STRICT: Bool := MAX_T > 80            -- a `Bool` constant has no `?`
pub const DEFAULT: Mode := Mode::Off

pub comp band {
    in temp: Int
    in target: Int
    pub out too_cold?
    pub out mode: Mode

    assume sane: MIN_T <= target and target <= MAX_T  -- constants in assumptions
    ensure cold: too_cold? iff temp < target + NEG
    ensure off: unless too_cold?, mode = DEFAULT
    ensure heat: when too_cold?, mode = Mode::Heat

    expect strict: STRICT
    expect lowest: when target = MIN_T and temp < 47, too_cold?
}

comp scaled {
    in t: Int
    pub out y: Int
    ensure r: y = (MAX_T - MIN_T) * t + 2 * 3 * t  -- operands with no variables
    expect at_one: when t = 1, y = 46
}

mod other
use climate::{MAX_T, band}

comp user {
    in t: Int
    pub out cold?
    inst b: band { temp := t, target := MAX_T }  -- a constant in a binding
    ensure r: cold? iff b.too_cold?
    expect at_max: when t < MAX_T - 3, cold?
}

comp shadow {
    in MAX_T!: Int                            -- a variable shadows the constant, with `!`
    --~^ warning: variable `MAX_T` should have a snake case name
    pub out y: Int
    ensure r: y = MAX_T
    expect same: y = MAX_T  --~ warning: this is written the same as `r`
}

-- A method applied to a constant reads its value.
const GREETING: String := "hello"
const PRIMES: Seq(Int) := [2, 3, 5]
expect constant_methods: GREETING.len = 5 and GREETING.starts_with?("he") and PRIMES.len = 3

-- A field of a constant record, and a method applied to a field.
struct Place { name: String, floor: Int }
const LOBBY: Place := Place { name := "lobby", floor := 0 }
expect constant_fields: LOBBY.floor = 0 and LOBBY.name.len = 5 and LOBBY.name.starts_with?("lob")

--@ summary: 24 passed, 0 failed, 0 inconclusive, 0 redundant
