-- Traits (`Reqs/Lang/Traits`): a carrier, methods, laws, and
-- expectations checked from the laws alone, in both front ends. A law over
-- a type that is not listed is outside the decidable core. An expectation
-- whose assumptions cannot hold with the laws is an error (`F0602`), and
-- where that is not decided, each constraint whose verdict comes from a
-- proof says that it rests on the laws (`F0665`).
-- In a module, since Lean has an `Option` of its own.
-- fren-covers: lang::trait_expectation
-- fren-covers: view::inconclusive_reported
set_option fren.lint.dead_code "allow"

mod traits

type Key

fn level(Bool): Int

set_option fren.lint.undecidable "allow" in
trait KV {
    fn put(Self, Key, Int): Self
    fn get(Self, Key): Option<Int>

    law get_put(s: Self, k: Key, v: Int, j: Key): get(put(s, k, v), j) = (if j = k then Option::Some(v) else get(s, j))

    -- Follows from the law.
    expect overwritten(s: Self, k: Key, v: Int, w: Int) {
        expect last_wins: get(put(put(s, k, v), k, w), k) = Option::Some(w)  --~ warning: rests on the laws of `traits::KV`
    }

    -- The short form, over the carrier.
    expect read_back: forall (s: Self) (k: Key) (v: Int), get(put(s, k, v), k) = Option::Some(v)  --~ warning: rests on the laws of `traits::KV`

    -- The laws are quantified, so the solver seldom finds a model of them:
    -- a false claim, and a cover goal, are undecided.
    expect other_key(s: Self, k: Key, j: Key, v: Int) {
        expect same: get(put(s, k, v), j) = Option::Some(v)  --~ warning: could not decide whether `traits::KV::other_key::same` holds
        cover stored: get(s, k) != Option::None  --~ warning: could not decide whether `traits::KV::other_key::stored` can be met
    }
}

-- A method's contract is checked as an uninterpreted function's is, at
-- the carrier, and its postcondition is a fact of each application.
set_option fren.lint.undecidable "allow" in
trait Sized {
    fn size(s: Self): (r: Int) { ensure natural: r >= 0 }
    fn grow(Self): Self

    law grows(s: Self): size(grow(s)) = size(s) + 1
    -- A variable that the equation does not mention, which Lean's query
    -- leaves out, as it means nothing.
    law fixed(s: Self, n: Int): size(s) >= 0  --~ warning: unused bound name `n`

    expect positive(s: Self) { expect after_grow: size(grow(s)) > 0 }
    --~^ warning: rests on the laws of `traits::Sized`
}

-- Laws that contradict each other cannot hold with any assumptions.
set_option fren.lint.undecidable "allow" in
trait Contradictory {
    fn size(Self): Int

    law positive(s: Self): size(s) > 0
    law negative(s: Self): size(s) < 0

    expect anything(s: Self) { expect c: size(s) = 42 }
    --~^ warning: rests on the laws of `traits::Contradictory`
}

-- Laws in the core that contradict each other cannot hold with the
-- assumptions either, and the claim is not proved.
trait Clash {
    fn value(Self): Int

    law one(): level(true) = 1
    law two(): level(true) = 2

    expect e(s: Self) {  --~ error: the assumptions of `traits::Clash::e` are unsatisfiable: `one`, `two` contradict each other
        assume known: value(s) >= 0
        expect c: value(s) = 5  --~ warning: rests on the assumptions and calls of `traits::Clash::e` holding together with its trait's laws, which did not pass
    }
}

-- Nor can an assumption that contradicts a law.
set_option fren.lint.undecidable "allow" in
trait Pos {
    fn v(Self): Int

    law pos(s: Self): v(s) >= 0

    expect e(s: Self) {  --~ error: the assumptions of `traits::Pos::e` are unsatisfiable: `pos`, `neg` contradict each other
        assume neg: v(s) < 0
        expect c: v(s) = 5  --~ warning: `traits::Pos::e::c` rests on the assumptions and calls of `traits::Pos::e` holding together with its trait's laws, which did not pass
        cover w: v(s) = 1  --~ error: cannot be met
    }

    -- An assumption with a quantified law, which the solver does not
    -- decide, as a realizability that is not decided is reported.
    expect undecided(s: Self) {  --~ warning: could not decide whether the assumptions and calls of `traits::Pos::undecided` can hold together with its trait's laws
        assume big: v(s) > 3
        expect c: v(s) >= 0  --~ warning: `traits::Pos::undecided::c` rests on the assumptions and calls of `traits::Pos::undecided` holding together with its trait's laws, which did not pass
    }
}

-- The methods of a trait shadow the module's names, without `!`, and
-- every other name is the module's.
fn get(Int): Int

const LIMIT: Int := 3

set_option fren.lint.undecidable "allow" in
trait Bounded {
    fn get(Self): Int

    law bounded(s: Self): get(s) <= LIMIT

    expect below: forall (s: Self), get(s) < LIMIT + 1  --~ warning: rests on the laws of `traits::Bounded`
}

-- A law with no variables, or with only `Bool` ones, is in the decidable
-- core; one over a carrier is not, and a setting before it allows it.
trait Listed {
    fn value(Self): Int

    law closed(): level(true) = 1
    law boolean(b?): level(b?) >= 0
    set_option fren.lint.undecidable "allow" in
    law natural(s: Self): value(s) >= 0

    expect both(s: Self) { expect c: level(true) + value(s) >= 1 }
    --~^ warning: rests on the laws of `traits::Listed`
}

-- A failure's counterexample meets the laws, so it rests on nothing more;
-- a constraint whose expectation passes and whose condition cannot hold
-- says that it rests on them once.
trait Closed {
    fn value(Self): Int

    law closed(): level(true) = 1

    expect wrong(s: Self) {
        expect c: value(s) = 3  --~ error: expectation `traits::Closed::wrong::c` does not hold
    }
    expect never(s: Self) {
        expect c: when level(true) = 2, value(s) = 7  --~ warning: rests on the laws of `traits::Closed`
        --~^ error: vacuous
    }
}

-- Realizability asks without the laws, in both front ends, and the
-- vacuity under the laws is not decided: a law with a `Bool` variable under
-- `when`, over a method with a contract. (A claim
-- here would meet #493's `Symbol '->'` difference, which predates traits.)
set_option fren.lint.undecidable "allow" in
trait Flagged {
    fn obs(s: Self): (r: Int) { ensure low: r >= 0 }

    law flagged(s: Self, b?): when b?, obs(s) >= 0

    expect e0(s: Self) { assume big: obs(s) > 2 }
    --~^ warning: the assumption `big` constrains only parameters that nothing uses
    --~^^ warning: could not decide whether the assumptions and calls of `traits::Flagged::e0` can hold together with its trait's laws
}

-- Without laws, an expectation is about every carrier and every method,
-- and rests on nothing more.
trait Lawless {
    fn value(Self): Int

    expect congruent(s: Self, t: Self) { expect same: when s = t, value(s) = value(t) }

    -- Nothing relates two carriers' values.
    expect equal(s: Self, t: Self) {
        expect same: value(s) = value(t)  --~ error: expectation `traits::Lawless::equal::same` does not hold
    }
}

-- A call whose procedure's assumption fails is that call's error alone:
-- the vacuity under the laws asks of what the call guarantees where the
-- assumption holds, as the item's other checks do, so it is not also a
-- contradiction, and the trait reports as its twin over a contract does.
proc bump(x: Int): (y: Int) {
    assume nonneg: x >= 0
    ensure up: y = x + 1
}

trait Called {
    fn v(Self): Int

    law one(): level(true) = 1

    expect call_bad(s: Self) {  --~ warning: unused variable `s`
        --~^ warning: the realizability of `traits::Called::call_bad` rests on the assumption `traits::bump::nonneg` of call `b`, which did not pass
        assume big: level(true) > 0
        call b := bump(level(true) - 5)  --~ error: the assumption `nonneg` of `traits::bump` may not hold for call `traits::Called::call_bad::b`
        expect c: b.y = 2  --~ warning: `traits::Called::call_bad::c` rests on the assumption `traits::bump::nonneg` of call `b`, which did not pass
    }
}

type T

fn level_of(b?): (r: Int) { ensure one: not b? or r = 1 }

expect call_bad_twin(s: T) {  --~ warning: unused variable `s`
    --~^ warning: the realizability of `traits::call_bad_twin` rests on the assumption `traits::bump::nonneg` of call `b`, which did not pass
    assume big: level_of(true) > 0
    call b := bump(level_of(true) - 5)  --~ error: the assumption `nonneg` of `traits::bump` may not hold for call `traits::call_bad_twin::b`
    expect c: b.y = 2  --~ warning: `traits::call_bad_twin::c` rests on the assumption `traits::bump::nonneg` of call `b`, which did not pass
}

-- `law` is a name like any other outside a trait.
fn law(Int): Int
--@ summary: 29 passed, 8 failed, 11 inconclusive, 0 redundant
