-- Traits (`Reqs/Lang/Traits`): a carrier, methods, laws, and
-- expectations checked from the laws alone, in both front ends. A law over
-- a type that is not listed is outside the decidable core, and every check
-- that rests on laws says that their consistency is not checked (`F0665`).
-- In a module, since Lean has an `Option` of its own.
-- fren-covers: lang::trait_expectation
set_option fren.lint.dead_code "allow"

mod traits

type Key

set_option fren.lint.undecidable "allow" in
trait KV {
    fn put(Self, Key, Int): Self
    fn get(Self, Key): Option<Int>

    law get_put(s: Self, k: Key, v: Int, j: Key): get(put(s, k, v), j) = (if j = k then Option::Some(v) else get(s, j))

    -- Follows from the law.
    expect overwritten(s: Self, k: Key, v: Int, w: Int) {
        expect last_wins: get(put(put(s, k, v), k, w), k) = Option::Some(w)  --~ warning: rests on the laws of `traits::KV`
    }

    -- The short form, over the carrier.
    expect read_back: forall (s: Self) (k: Key) (v: Int), get(put(s, k, v), k) = Option::Some(v)  --~ warning: rests on the laws of `traits::KV`

    -- The laws are quantified, so the solver seldom finds a model of them:
    -- a false claim, and a cover goal, are undecided.
    expect other_key(s: Self, k: Key, j: Key, v: Int) {
        expect same: get(put(s, k, v), j) = Option::Some(v)  --~ warning: could not decide whether `traits::KV::other_key::same` holds
        cover stored: get(s, k) != Option::None  --~ warning: could not decide whether `traits::KV::other_key::stored` can be met
    }
}

-- A method's contract is checked as an uninterpreted function's is, at
-- the carrier, and its postcondition is a fact of each application.
set_option fren.lint.undecidable "allow" in
trait Sized {
    fn size(s: Self): (r: Int) { ensure natural: r >= 0 }
    fn grow(Self): Self

    law grows(s: Self): size(grow(s)) = size(s) + 1
    -- A variable that the equation does not mention, which Lean's query
    -- leaves out, as it means nothing.
    law fixed(s: Self, n: Int): size(s) >= 0  --~ warning: unused bound name `n`

    expect positive(s: Self) { expect after_grow: size(grow(s)) > 0 }
    --~^ warning: rests on the laws of `traits::Sized`
}

-- Laws that contradict each other make every expectation hold, which its
-- warning says.
set_option fren.lint.undecidable "allow" in
trait Contradictory {
    fn size(Self): Int

    law positive(s: Self): size(s) > 0
    law negative(s: Self): size(s) < 0

    expect anything(s: Self) { expect c: size(s) = 42 }
    --~^ warning: rests on the laws of `traits::Contradictory`
}

-- The methods of a trait shadow the module's names, without `!`, and
-- every other name is the module's.
fn get(Int): Int

const LIMIT: Int := 3

set_option fren.lint.undecidable "allow" in
trait Bounded {
    fn get(Self): Int

    law bounded(s: Self): get(s) <= LIMIT

    expect below: forall (s: Self), get(s) < LIMIT + 1  --~ warning: rests on the laws of `traits::Bounded`
}

-- A law with no variables, or with only `Bool` ones, is in the decidable
-- core; one over a carrier is not, and a setting before it allows it.
fn level(Bool): Int

trait Listed {
    fn value(Self): Int

    law closed(): level(true) = 1
    law boolean(b?): level(b?) >= 0
    set_option fren.lint.undecidable "allow" in
    law natural(s: Self): value(s) >= 0

    expect both(s: Self) { expect c: level(true) + value(s) >= 1 }
    --~^ warning: rests on the laws of `traits::Listed`
}

-- A failure's counterexample meets the laws, so it rests on nothing more;
-- a constraint whose expectation passes and whose trigger cannot hold says
-- so once.
trait Closed {
    fn value(Self): Int

    law closed(): level(true) = 1

    expect wrong(s: Self) {
        expect c: value(s) = 3  --~ error: expectation `traits::Closed::wrong::c` does not hold
    }
    expect never(s: Self) {
        expect c: when level(true) = 2, value(s) = 7  --~ warning: rests on the laws of `traits::Closed`
        --~^ error: vacuous
    }
}

-- Realizability asks without the laws, in both front ends: a law with a
-- `Bool` variable under `when`, over a method with a contract. (A claim
-- here would meet #493's `Symbol '->'` difference, which predates traits.)
set_option fren.lint.undecidable "allow" in
trait Flagged {
    fn obs(s: Self): (r: Int) { ensure low: r >= 0 }

    law flagged(s: Self, b?): when b?, obs(s) >= 0

    expect e0(s: Self) { assume big: obs(s) > 2 }
    --~^ warning: the assumption `big` constrains only parameters that nothing uses
}

-- Without laws, an expectation is about every carrier and every method,
-- and rests on nothing more.
trait Lawless {
    fn value(Self): Int

    expect congruent(s: Self, t: Self) { expect same: when s = t, value(s) = value(t) }

    -- Nothing relates two carriers' values.
    expect equal(s: Self, t: Self) {
        expect same: value(s) = value(t)  --~ error: expectation `traits::Lawless::equal::same` does not hold
    }
}

-- `law` is a name like any other outside a trait.
fn law(Int): Int
