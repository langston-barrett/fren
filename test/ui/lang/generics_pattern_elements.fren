-- Generic types whose payloads bring constraints that quantify over a
-- collection's elements, and a recursive generic enumeration whose payloads
-- bring their declared patterns where they are read, in both front ends.
set_option fren.lint.undecidable "allow"

mod generics_pattern_elements

pub struct Pair<A, B> { fst: A, snd: B }
type NodeDigit = n: Int where invariant: n is 0..=9
pub enum Tree<T> { Leaf, Node(NodeDigit, T, Tree<T>) }
type BagDigit = n: Int where invariant: n is 0..=9
pub enum Bag<T> { Empty, More(Pair<BagDigit, T>, Bag<T>) }
type Byte = n: Int where invariant: n is 0..=255

type ElementDigit = n: Int where invariant: n is 0..=9
proc c(x: Option<Set<ElementDigit>>, q: Option<Seq<Byte>>, t: Tree<Int>, b: Bag<Bool>, k: Int) {
    expect member: match x { Option::Some(s) => not (k in s) or k <= 9, Option::None => true }
    expect nth: match q { Option::Some(s) => s = [] or s[0] <= 255, Option::None => true }
    expect tag: match t { Tree::Node(d, _, _) => d <= 9, Tree::Leaf => true }
    expect deep: match t { Tree::Node(_, _, Tree::Node(d, _, _)) => d <= 9, _ => true }
    expect bag: match b { Bag::More(p, Bag::More(r, _)) => p.fst <= 9 and r.fst >= 0, _ => true }
    expect unbounded: match t { Tree::Node(_, v, _) => v <= 9, Tree::Leaf => true }   --~ error: expectation `generics_pattern_elements::c::unbounded` does not hold
}
