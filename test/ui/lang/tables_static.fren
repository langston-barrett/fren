-- Static rules for tables: conditions are `Bool`s, values share a type,
-- and only the last row is `_` (`Reqs/Lang/Expressions#tables`).
set_option fren.lint.dead_code "allow"

proc after_wild(x: Int): (y: Int) { ensure r: y = table { _ => 0, x > 0 => 1 } }
--~^ error: a row after `_` can never be reached
proc two_wild(x: Int): (y: Int) { ensure r: y = table { x > 0 => 1, _ => 0, _ => 2 } }
--~^ error: a row after `_` can never be reached
proc condition(x: Int): (y: Int) { ensure r: y = table { x => 1, _ => 0 } }
--~^ error: type mismatch: expected `Bool`, found `Int`
proc values(x: Int): (y: Int) { ensure r: y = table { x > 0 => 1, _ => true } }
--~^ error: the rows of a table have values of different types: `Int` and `Bool`
proc typed(x: Int): (y?) { ensure r: y? iff table { x > 0 => 1, _ => 0 } }
--~^ error: type mismatch: expected `Bool`, found `Int`
-- A value of `{}` takes its type from another row's.
proc empty_value(x: Int): (s: Set<Int>) { out s := table { x > 0 => {}, _ => {x} } }
proc empty_only(x: Int): (n: Int) { out n := table { x > 0 => {}, _ => {} }.card }
--~^ error: the type of `{}` cannot be known here
