-- Static rules for pattern tests, `e is P`.
set_option fren.lint.dead_code "allow"

enum S { A(Int), B, C(Bool, Int) }
enum T { X, Y }

proc binds(s: S): (z?) { ensure r: z? iff s is S::A(n) }
--~^ error: a pattern test cannot bind `n`
proc binds_alt(s: S): (z?) { ensure r: z? iff s is S::B | S::C(_, n) }
--~^ error: a pattern test cannot bind `n`
proc shadow(n: Int, s: S): (z?) { ensure r: z? iff s is S::A(n!) }
--~^ error: a pattern test cannot bind `n`
proc repeated(s: S): (z?) { ensure r: z? iff s is S::A(_) | S::A(_) }
--~^ error: unreachable pattern
proc not_enum(i: Int): (z?) { ensure r: z? iff i is S::A(_) }
--~^ error: expected a pattern of `Int`, but this is a pattern of `S`
proc not_enum_bool(b?): (z?) { ensure r: z? iff b? is S::A(_) }
--~^ error: expected a pattern of `Bool`, but this is a pattern of `S`
proc other(s: S): (z?) { ensure r: z? iff s is S::A(_) | T::X }
--~^ error: expected a variant of `S`, but this is a variant of `T`
proc unapplied(s: S): (z?) { ensure r: z? iff s is S::A }
--~^ error: variant `S::A` must be applied to its payload
proc arity(s: S): (z?) { ensure r: z? iff s is S::C(_) }
--~^ error: `S::C` takes 2 patterns, but 1 was given
proc unknown(s: S): (z?) { ensure r: z? iff s is S::D(_) }
--~^ error: no variant `D` in enum `S`
proc not_variant(s: S, i: Int): (z?) { ensure r: z? iff s is i }
--~^ error: a pattern test cannot bind `i`
proc not_matched(s: Set<Int>): (z?) { ensure r: z? iff s is _ }
--~^ error: cannot test `Set<Int>` against a pattern

--@ exit: 2
