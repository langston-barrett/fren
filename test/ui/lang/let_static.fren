-- The static rules of `let` and `where` (`Reqs/Lang/Let`).
-- fren-covers: lang::definition_order, lang::definition_type
set_option fren.lint.unused_variables "allow"
set_option fren.lint.dead_code "allow"

fn f(Int): Int
fn g(n: Int): Int := n
const LIMIT: Int := 3

-- Definitions are read in order: none mentions itself or a later one.
proc later(x: Int): (y?) { ensure r: y? iff a? where a? := b?, b? := x > 0 }
--~^ error: `b?` is used before its definition
proc itself(x: Int): (y?) { ensure r: y? iff a? where a? := not a? }
--~^ error: the definition of `a?` mentions itself
-- A name that hides another means it in its own definition.
proc shadow_outer(x: Int): (y?) { ensure r: y? iff x > 0 where x! := x + 1 }

-- A definition's type, written or not, and its name.
proc annotated(x: Int): (y?) { ensure r: let n: Int := x > 0 in y? iff n > 0 }
--~^ error: the definition of `n` has type `Bool`, not `Int`
proc bool_name(x: Int): (y?) { ensure r: let big := x > 0 in y? iff big }
--~^ error: `Bool` variable `big` must end in `?`
-- A `Nat` is not narrowed from an `Int`.
proc narrowed(a: Nat): (b: Int) { ensure r: b = k where k: Nat := a - 1 }
--~^ error: the definition of `k` has type `Int`, not `Nat`
-- Without its type written, a definition synthesizes its type.
proc empty(): (y?) { ensure r: let s := {} in y? iff s = s }
--~^ error: the type of `{}` cannot be known here
proc empty_typed(t: Set<Int>): (y?) { ensure r: let s: Set<Int> := {} in y? iff s = t }
-- `in` ends the last definition, so the membership must be in parentheses.
proc membership(x: Int, s: Set<Int>): (y?) { ensure r: let b? := x in s in y? iff b? }
--~^ error: `in` ends the last definition of a `let`

-- A membership right after the `in` of a body that does not type: the
-- same note.
proc body_membership(x?, s: Set<Int>, t: Set<Int>): (y?) { ensure r: y? iff (let b? := x? in s in t) }
--~^ error: `in` ends the last definition of a `let`

-- A comment after the `in` does not change that.
proc body_comment(x?, s: Set<Int>, t: Set<Int>): (y?) { ensure r: y? iff (let b? := x? in /- s -/ s in t) }
--~^ error: `in` ends the last definition of a `let`

-- Shadowing is explicit, as for any other declaration.
proc implicit(x: Int): (y?) { ensure r: let x := 1 in y? iff x > 0 }
--~^ error: `x` shadows the parameter `x`
proc same_clause(): (y?) { ensure r: let a := 1, a := 2 in y? iff a > 0 }
--~^ error: `a` shadows the definition `a`
proc needless(): (y?) { ensure r: let z! := 1 in y? iff z > 0 }
--~^ error: `z!` shadows nothing

-- Constants and functions are shadowed explicitly too.
proc constant_clash(x: Int): (y?) { ensure r: let LIMIT := 4 in y? iff x > LIMIT }
--~^ error: `LIMIT` shadows the constant `LIMIT`
proc function_clash(x: Int): (y?) { ensure r: let g := 4 in y? iff x > g }
--~^ error: `g` shadows the function `g`
proc clash_ok(x: Int): (y?) { ensure r: let g! := 4, LIMIT! := 5 in y? iff x > g + LIMIT }
--~^ warning: binder `LIMIT` should have a snake case name

-- A name mentions what its definition mentions.
proc assumed(x: Int): (o: Int) { assume a: let v := o in v > x }
--~^ error: assumptions may only mention parameters, but `o` is an output
proc argument(x: Int): (o: Int) { ensure r: let v := o in f(v) = x }
--~^ error: the arguments of a function may not mention an output, but `o` is one
proc nonlinear(x: Int): (o: Int) { ensure r: let k := x in o = k * x }
--~^ error: nonlinear arithmetic is not supported
proc linear(x: Int): (o: Int) { ensure r: let k := 3 in o = k * x }

-- A definition that nothing mentions counts for nothing: what it mentions
-- is not checked, directly or through another unused definition.
proc unused_assumed(x: Int): (o: Int) { assume a: let v := o in x > 0 ensure r: o = x }
proc unused_chain(x: Int): (o: Int) { assume a: let v := o, w := v in x > 0 ensure r: o = x }
proc used_chain(x: Int): (o: Int) { assume a: let v := o, w := v in w > x ensure r: o = x }
--~^ error: assumptions may only mention parameters, but `o` is an output
proc unused_nested(x: Int): (o: Int) { assume a: let v := o in (let w := v in x > 0) ensure r: o = x }
proc operator_type(x: Int): (y?) { ensure r: y? iff (let a := x in a and y?) }
--~^ error: type mismatch: expected `Bool`, found `Int`
proc unused_argument(x: Int): (o: Int) { ensure r: f(let v := o in x) = o }
proc unused_nonlinear(x: Int): (o: Int) { ensure r: o = x where k := x * x }

--@ exit: 2
