-- The types of each comparison in a chained comparison: each is typed as
-- if written alone. The chains that do not parse are in `test/ui/syntax`.
set_option fren.lint.unused_variables "allow"

proc types(x: Int): (ok?) {
    ensure r: when 0 <= x
        < "a", ok?
    --~^ error: type mismatch: expected `Int`, found `String`
}

--@ exit: 2
