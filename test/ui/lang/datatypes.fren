-- Records, enums with payloads, recursive enums and `match`.

struct Point { x: Int, y: Int }
enum Shape { Circle(Int), Rect(Int, Int), Empty }
enum IntList { Nil, Cons(Int, IntList) }

proc area(s: Shape): (a: Int) {
    ensure r: a = match s {
        Shape::Circle(r) => 3 * r,
        Shape::Rect(w, h) => w + h,
        _ => 0,
    }

    expect circle: when s = Shape::Circle(2), a = 6
    expect empty: when s = Shape::Empty, a = 0
    expect wrong: a >= 0            --~ error: expectation `area::wrong` does not hold
}

proc shift(p: Point): (det q: Point) {
    ensure r: q = Point { x := p.x + 1, y := p.y }

    expect moved: q.x > p.x
    expect literal: when p = Point { x := 0, y := 1 }, q = Point { y := 1, x := 1 }
    expect wrong: q.y > p.y         --~ error: expectation `shift::wrong` does not hold
}

-- A recursive enum, read through `match`, as an input.
proc head(l: IntList): (det h: Int) {
    ensure r: h = match l { IntList::Cons(x, _) => x, IntList::Nil => 0 }

    expect nil: when l = IntList::Nil, h = 0
    expect two: when l = IntList::Cons(1, IntList::Cons(2, IntList::Nil)), h = 1
}

-- Binders shadow variables explicitly, and a field of a call or literal can be read.
fn origin(Int): Point

proc reads(r: Int, s: Shape): (z: Int) {
    ensure a: z = match s { Shape::Circle(r!) => r, _ => r } + origin(r).x
    expect literal_field: Point { x := r, y := 0 }.x = r
}

-- Instances see the outputs of records of their instances.
proc twice(p: Point): (q: Point) {
    call once := shift(p)
    call again := shift(once.q)

    ensure r: q = again.q

    expect moved_two: q.x = p.x + 2
}

--@ summary: 25 passed, 2 failed, 0 inconclusive, 0 redundant
