-- Static rules for record updates, `{ r with x := e }`.
set_option fren.lint.dead_code "allow"

struct P { x: Int, y: Int }
struct Q { on?, n: Int }

proc unknown(p: P): (o: P) { ensure r: o = { p with z := 1 } }   --~ error: record `P` has no field `z`
proc repeated(p: P): (o: P) { ensure r: o = { p with x := 1, x := 2 } }
--~^ error: field `x` is given multiple times
proc not_record(i: Int): (o: Int) { ensure r: o = { i with x := 1 } }
--~^ error: cannot update the fields of `Int`
proc not_record_set(s: Set<Bool>): (o?) { ensure r: o? iff { s with x := 1 } = s }
--~^ error: cannot update the fields of `Set<Bool>`
proc not_record_bool(i: Int): (o?) { ensure r: o? iff { i = 1 with x := 1 } }
--~^ error: cannot update the fields of `Bool`
proc field_of_bool(i: Int): (o: Int) { ensure r: o = (i = 1).w }
--~^ error: `Bool` is not a record, so it has no field `w`
proc other_record(p: P, q: Q): (o: P) { ensure r: o = { q with x := 1 } }
--~^ error: record `Q` has no field `x`
proc typed(p: P): (o: P) { ensure r: o = { p with x := true } }
--~^ error: type mismatch: expected `Int`, found `Bool`
proc result_typed(p: P, q: Q): (o: P) { ensure r: o = { q with n := 1 } }
--~^ error: cannot compare `P` with `Q`
proc unknown_short(p: P): (o: P) { ensure r: o = { p with w } }  --~ error: record `P` has no field `w`
proc unbound_short(p: P): (o: P) { ensure r: o = { p with x } }  --~ error: cannot find `x` in this scope
proc empty_base(): (o: P) { ensure r: o = { {} with x := 1 } }
--~^ error: the type of `{}` cannot be known here
-- An update mentions what its updated value and new values mention.
fn big?(P)
proc output_base(n: Int): (o: P) { ensure r: big?({ o with x := n }) }
--~^ error: the arguments of a function may not mention an output, but `o` is one
proc output_value(p: P): (n: Int) { ensure r: big?({ p with x := n }) }
--~^ error: the arguments of a function may not mention an output, but `n` is one
proc output_short(p: P): (x: Int) { ensure r: big?({ p with x }) }
--~^ error: the arguments of a function may not mention an output, but `x` is one
proc input_only(p: P, n: Int): (b?) { ensure r: b? iff big?({ p with x := n }) }
-- The updated value is checked before the fields.
proc base_first(i: Int): (o: Int) { ensure r: o = { i with i := 1, i := 2 } }
--~^ error: cannot update the fields of `Int`

--@ exit: 2
