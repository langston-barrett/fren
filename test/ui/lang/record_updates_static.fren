-- Static rules for record updates, `{ r with x := e }`.
set_option fren.lint.dead_code "allow"

struct P { x: Int, y: Int }
struct Q { on?, n: Int }

comp unknown { in p: P pub out o: P req r: o = { p with z := 1 } }   --~ error: record `P` has no field `z`
comp repeated { in p: P pub out o: P req r: o = { p with x := 1, x := 2 } }
--~^ error: field `x` is given multiple times
comp not_record { in i: Int pub out o: Int req r: o = { i with x := 1 } }
--~^ error: cannot update the fields of `Int`
comp not_record_set { in s: Set(Bool) pub out o? req r: o? iff { s with x := 1 } = s }
--~^ error: cannot update the fields of `Set(Bool)`
comp not_record_bool { in i: Int pub out o? req r: o? iff { i = 1 with x := 1 } }
--~^ error: cannot update the fields of `Bool`
comp other_record { in p: P in q: Q pub out o: P req r: o = { q with x := 1 } }
--~^ error: record `Q` has no field `x`
comp typed { in p: P pub out o: P req r: o = { p with x := true } }
--~^[cli] error: type mismatch: expected `Int`, found `Bool`
--~^^[hosted] error: type mismatch
comp result_typed { in p: P in q: Q pub out o: P req r: o = { q with n := 1 } }
--~^[cli] error: cannot compare `P` with `Q`
--~^^[hosted] error: Type mismatch
comp unknown_short { in p: P pub out o: P req r: o = { p with w } }  --~ error: record `P` has no field `w`
comp unbound_short { in p: P pub out o: P req r: o = { p with x } }  --~ error: cannot find `x` in this scope
comp empty_base { pub out o: P req r: o = { {} with x := 1 } }
--~^ error: the type of `{}` cannot be known here
-- An update mentions what its updated value and new values mention.
fn big?(P)
comp output_base { in n: Int pub out o: P req r: big?({ o with x := n }) }
--~^ error: the arguments of a function may not mention an `out`, but `o` is one
comp output_value { in p: P pub out n: Int req r: big?({ p with x := n }) }
--~^ error: the arguments of a function may not mention an `out`, but `n` is one
comp output_short { in p: P pub out x: Int req r: big?({ p with x }) }
--~^ error: the arguments of a function may not mention an `out`, but `x` is one
comp input_only { in p: P in n: Int pub out b? req r: b? iff big?({ p with x := n }) }
-- The updated value is checked before the fields.
comp base_first { in i: Int pub out o: Int req r: o = { i with i := 1, i := 2 } }
--~^ error: cannot update the fields of `Int`

--@ exit: 2
