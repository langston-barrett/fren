-- `{}` and `[]` take their type from what is expected of them
-- (`lang::empty_literal`): a declared type, the other branch or side, or
-- the arms of a `match` before them. Both front ends report one alike.
set_option fren.lint.dead_code "allow"

fn twice(n: Int): Int := 2 * n
enum S { A(Int), B, C }
proc sub(x: Int): (z: Int) { ensure r: z = x }

-- Expected to be no collection: its type cannot be known.
proc argument(): (y: Int) { ensure r: y = twice({}) }
--~^ error: the type of `{}` cannot be known here
proc binding() { call w := sub(([])) }
--~^ error: the type of `[]` cannot be known here
proc branch(c?): (y: Int) { out y := if c? then 1 else {} }
--~^ error: the type of `{}` cannot be known here
proc compared(): (y: Int) { ensure r: y = {} }
--~^ error: the type of `{}` cannot be known here
proc arm(s: S): (y: Int) { ensure r: y = match s { S::A(a) => a, S::B => {}, S::C => 0 } }
--~^ error: the type of `{}` cannot be known here

-- A `match` with an expected type checks its arms in order against it, so
-- an error in a later arm comes after.
proc first_arm(s: S): (y: Int) { ensure r: y = match s { S::B => {}, S::A(a) => a, S::C => true } }
--~^ error: the type of `{}` cannot be known here
proc first_arm_later_error(s: S): (y: Int) { ensure r: y = match s { S::B => [], S::A(a) => nope, S::C => 1 } }
--~^ error: the type of `[]` cannot be known here

-- Without one, an arm that does not synthesize its type waits for one that
-- does, and has the type it is checked against.
proc waiting(s: S, t: Set<String>): (y: Set<Int>) { out y := match s { S::B => {}, S::A(a) => t, S::C => {} } }
--~^ error: the arms of `match` have different types: `Set<Int>` and `Set<String>`

-- A branch takes the other branch's type first.
proc sibling(c?, t: Set<Int>): (y: Int) { out y := if c? then {} else t }
--~^ error: type mismatch: expected `Int`, found `Set<Int>`

-- Expected to be a collection of the other kind: a type mismatch.
proc set_for_seq(c?): (q: Seq<Int>) { out q := if c? then {} else [1] }
--~^ error: type mismatch: expected `Seq<Int>`, found an empty set
proc seq_for_set(t: Set<Int>): (p?) { ensure r: p? iff t = [] }
--~^ error: type mismatch: expected `Set<Int>`, found an empty sequence
proc seq_note(t: Set<Int>): (p?) { ensure r: p? iff [] = t }
--~^ error: `[]` is an empty sequence
proc union_seq(t: Set<Int>): (u: Set<Int>) { out u := [] union t }
--~^ error: type mismatch: expected `Set<Int>`, found an empty sequence
proc subset_seq(t: Set<Int>): (p?) { ensure r: p? iff t subset [] }
--~^ error: type mismatch: expected `Set<Int>`, found an empty sequence
proc concat_set(q: Seq<Int>): (u: Seq<Int>) { out u := {} ++ q }
--~^ error: type mismatch: expected `Seq<Int>`, found an empty set
proc concat_set_right(q: Seq<Int>): (u: Seq<Int>) { out u := q ++ {} }
--~^ error: type mismatch: expected `Seq<Int>`, found an empty set
proc pair_in_seq(x: Int): (p?) { ensure r: p? iff (x, x) in [] }
--~^ error: type mismatch: expected `Rel<Int, Int>`, found an empty sequence
proc receiver(c?): (y: Int) { out y := (if c? then {} else [1]).len }
--~^ error: type mismatch: expected `Seq<Int>`, found an empty set
proc arm_seq(s: S, t: Set<Int>): (u: Set<Int>) { out u := match s { S::A(a) => [], S::B => t, S::C => t } }
--~^ error: type mismatch: expected `Set<Int>`, found an empty sequence

-- A member of a literal expects the literal's element type, or the first
-- member's that synthesizes one; a pair's members, a relation's types.
proc member_int(x: Int): (n: Int) { out n := {x, {}}.card }
--~^ error: the type of `{}` cannot be known here
proc member_seq(t: Set<Int>): (n: Int) { out n := {[], t}.card }
--~^ error: type mismatch: expected `Set<Int>`, found an empty sequence
proc element_set(q: Seq<Int>): (n: Int) { out n := [{}, q].len }
--~^ error: type mismatch: expected `Seq<Int>`, found an empty set
proc pair_member(t: Set<Int>): (n: Int) { out n := {(1, []), (2, t)}.card }
--~^ error: type mismatch: expected `Set<Int>`, found an empty sequence
proc declared_member(t: Set<Int>): (a: Set<Set<Int>>) { out a := {t, []} }
--~^ error: type mismatch: expected `Set<Int>`, found an empty sequence
proc declared_element(x: Int): (q: Seq<Seq<Int>>) { out q := [{}, [x]] }
--~^ error: type mismatch: expected `Seq<Int>`, found an empty set
proc declared_pair(x: Int): (r: Rel<Int, Set<Int>>) { out r := {(x, [])} }
--~^ error: type mismatch: expected `Set<Int>`, found an empty sequence
proc members(x: Int): (n: Int) { out n := {x, true}.card }
--~^ error: the members of a set have different types: `Int` and `Bool`
proc elements(x: Int): (n: Int) { out n := [x, "a"].len }
--~^ error: the elements of a sequence have different types: `Int` and `String`

-- Accepted: the type that is expected of them is theirs.
proc accepted(c?, s: S, t: Set<Int>, q: Seq<Int>): (
    a: Set<Int>,
    b: Seq<Int>,
    d: Set<Int>,
    f: Int,
    g: Int,
    h: Int,
    i: Set<Set<Int>>,
    j: Seq<Seq<Int>>,
    k: Rel<Int, Set<Int>>,
) {
    out a := if c? then {} else t
    out b := if c? then [] else q
    out d := match s { S::B => {}, S::A(n) => t, S::C => t }
    out f := {(1, {}), (2, t)}.card
    out g := {{}, t}.card
    out h := [[], q].len
    out i := {{}, t}
    out j := [[], q]
    out k := {(1, {}), (2, t)}
}

--@ exit: 2
