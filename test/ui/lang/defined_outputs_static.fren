-- Static rules for defined outputs.
set_option fren.lint.dead_code "allow"

fn f(Int): Int

enum IntList { Nil, Cons(Int, IntList) }

proc cycle(x: Int): (o: Int) {
    let a: Int := b + x             --~ error: the definition of `a` mentions itself
    let b: Int := a

    ensure r: o = a
}

proc in_assumption(x: Int): (p: Int) {
    exists o: Int
    let d: Int := o + x

    assume a: d > 0                 --~ error: assumptions may only mention parameters, but `o` is an output
    ensure r: p = o
}

proc in_argument(x: Int): (p: Int) {
    exists o: Int
    let d: Int := o + x

    ensure r: p = f(d)                 --~ error: the arguments of a function may not mention an output, but `o` is one
    ensure s: o = 0
}

proc nonlinear(x: Int, y: Int): (p: Int) {
    let d: Int := x + 1

    ensure r: p = d * y                --~ error: nonlinear arithmetic is not supported
}

proc unbounded(x: Int): (p?) {
    exists l: IntList                     --~ error: output `l` has the unbounded type `IntList`

    ensure r: p? iff l = IntList::Nil
}

proc typed(x: Int): (d: Int) {
    out d := x > 0
    --~^ error: type mismatch: expected `Int`, found `Bool`
}

proc source(a: Int): (d: Int) {
    out d := a
}

proc binds(x: Int) {
    call w := source(x, x)  --~ error: too many arguments: `source` takes 1 argument
}

proc unused(x: Int): (p: Int) {
    let d: Int := x                 --~ warning: unused variable `d`

    ensure r: p = x
}
--@ exit: 2
