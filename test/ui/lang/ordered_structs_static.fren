-- Static rules for `ordered struct`: an ordered struct's fields, and an
-- ordered newtype's underlying type, are ordered; a struct or newtype
-- without `ordered` has no orderings, `min` or `max`, even of an ordered
-- underlying type; and `-` of a newtype of `Nat` would narrow an `Int`.
-- fren-covers: lang::operator_type
set_option fren.lint.dead_code "allow"

enum Shade { Light, Dark }
ordered enum Level { Low, High }

-- Every field's type, and a newtype's underlying type, must be ordered.
ordered struct Entry { key: Int, tags: Set(Int) }
--~^ error: the field `tags` of the ordered struct `Entry` has the type `Set(Int)`, which is not ordered
ordered struct Flagged { key: Int, on? }
--~^ error: the field `on?` of the ordered struct `Flagged` has the type `Bool`, which is not ordered
ordered struct Painted { shade: Shade }
--~^ error: the field `shade` of the ordered struct `Painted` has the type `Shade`, which is not ordered
ordered struct Flag(Bool)  --~ error: the ordered newtype `Flag` has the underlying type `Bool`, which is not ordered
ordered struct Ids(Set(Int))  --~ error: the ordered newtype `Ids` has the underlying type `Set(Int)`, which is not ordered
struct Ms(Int)
ordered struct Wrapped(Ms)  --~ error: the ordered newtype `Wrapped` has the underlying type `Ms`, which is not ordered
ordered struct Fine { key: Int, level: Level, name: String, size: Nat }

-- Without `ordered`, no orderings, even of an ordered underlying type.
struct Point { x: Int, y: Int }
struct Count(Nat)
comp newtype_order { in a: Ms in b: Ms pub out c? ensure r: c? iff a < b }
--~^ error: `Ms` is not ordered, so its values cannot be compared with `<`
comp newtype_chain { in a: Ms in b: Ms pub out c? ensure r: c? iff Ms(0) <= a < b }
--~^ error: `Ms` is not ordered, so its values cannot be compared with `<=`
comp nat_order { in a: Count in b: Count pub out c? ensure r: c? iff a >= b }
--~^ error: `Count` is not ordered, so its values cannot be compared with `>=`
comp record_order { in a: Point in b: Point pub out c? ensure r: c? iff a > b }
--~^ error: `Point` is not ordered, so its values cannot be compared with `>`
comp record_min { in a: Point in b: Point pub out c: Point := a.min(b) }
--~^ error: `Point` is not ordered, so it has no method `min`
comp newtype_max { in a: Ms in b: Ms pub out c: Ms := a.max(b) }
--~^ error: `Ms` is not ordered, so it has no method `max`

-- An ordered struct has `min` and `max`, of its own type, and no other
-- methods.
comp record_len { in a: Fine pub out n: Int := a.len }  --~ error: record `Fine` has no field `len`
comp other_argument { in a: Fine in p: Point pub out c: Fine := a.min(p) }
--~^ error: type mismatch: expected `Fine`, found `Point`

-- `+` of a newtype of `Nat`, but not `-`, whose `a.0 - b.0` is an `Int`.
ordered struct Seconds(Nat)
comp nat_sum { in a: Seconds in b: Seconds pub out c: Seconds := a + b }
comp nat_difference { in a: Seconds in b: Seconds pub out c: Seconds := a - b }
--~^ error: newtype `Seconds` has no operator `-`
comp nat_count { in a: Count in b: Count pub out c: Count := a + b }

--@ exit: 2
