-- What an expression mentions (`lang::mentions`), for linear arithmetic
-- (`lang::linear_product`) and the decidable core.
set_option fren.lint.dead_code "allow"
set_option fren.lint.unused_variables "allow"

const RATE: Int := 3
enum E { A, V(Int) }
struct R { a: Int }
fn double(n: Int): Int := 2 * n
fn rate(Int): Int
fn pick(b?): String := if b? then "a" else "b"

-- Constants, defined functions applied to constants, variants and record
-- literals without variables, and methods of constants mention nothing.
proc constant(x: Int): (y: Int) { ensure r: y = x * RATE }
proc defined(x: Int): (y: Int) { ensure r: y = 2 * double(3) + double(3) * x }
proc variant(x: Int): (y: Int) { ensure r: y = match E::V(2) { E::V(k) => k, _ => 0 } * x }
proc record_literal(x: Int): (y: Int) { ensure r: y = R { a := 2 }.a * x }
proc record_update(x: Int): (y: Int) { ensure r: y = { R { a := 2 } with a := 3 }.a * x }
--~^ warning: this update gives every field of `R`
proc method(x: Int): (y: Int) { ensure r: y = "abc".len * x }

-- Variables, and what mentions them.
proc shadowed(RATE!: Int, x: Int): (y: Int) { ensure r: y = x * RATE }
--~^ error: the left side mentions the variable `x`, and the right side the variable `RATE`
--~^^ warning: variable `RATE` should have a snake case name
proc defined_arg(x: Int, z: Int): (y: Int) { ensure r: y = x * double(z) }
--~^ error: nonlinear arithmetic is not supported
proc uninterpreted(x: Int): (y: Int) { ensure r: y = x * rate(1) }
--~^ error: the left side mentions the variable `x`, and the right side the function `rate`
-- Each mention once, in the order written, a variable apart from a function.
proc mentions_named(x: Int): (y: Int) { ensure r: y = rate(x) * (x + x) }
--~^ error: the left side mentions the variable `x`, the function `rate`, and the right side the variable `x`
proc record_field(a: Int, x: Int): (y: Int) { ensure r: y = R { a }.a * x }
--~^ error: nonlinear arithmetic is not supported
-- An update mentions what its updated value mentions, even with every
-- field given, and what its new values mention.
proc update_base(p: R, x: Int): (y: Int) { ensure r: y = { p with a := 2 }.a * x }
--~^ error: nonlinear arithmetic is not supported
proc update_field(a: Int, x: Int): (y: Int) { ensure r: y = { R { a := 2 } with a }.a * x }
--~^ error: nonlinear arithmetic is not supported
proc variable_method(s: String, x: Int): (y: Int) { ensure r: y = s.len * x }
--~^ error: nonlinear arithmetic is not supported

-- A defined output mentions what its definition mentions.
proc defined_constant(x: Int): (k: Int, y: Int) { out k := 3 ensure r: y = k * x }
--~^ warning: defined output `k` is the same in every behaviour
proc defined_input(x: Int, z: Int): (k: Int, y: Int) { out k := z + 1 ensure r: y = k * x }
--~^ error: nonlinear arithmetic is not supported

-- A binder mentions what its scrutinee mentions, whatever the arms.
proc scrutinee(e: E, x: Int): (y: Int) { ensure r: y = match e { E::V(k) => 1, _ => 2 } * x }
--~^ error: nonlinear arithmetic is not supported
proc binder(e: E, x: Int): (y: Int) { ensure r: y = match e { E::V(k) => k * x, _ => 0 } }
--~^ error: nonlinear arithmetic is not supported

-- An instance's variable is a variable.
proc inner(a: Int): (b: Int) { out b := a }
proc instance_variable(x: Int): (y: Int) { call i := inner(x) ensure r: y = i.b * x }
--~^ error: the left side mentions the variable `i.b`, and the right side the variable `x`

-- A defined function applied to constants is a constant for the decidable
-- core too; applied to a variable, it is not.
proc core_constant(s: String): (p?) { ensure r: p? iff s.starts_with?(pick(true)) }
proc core_variable(s: String, b?): (p?) { ensure r: p? iff s.starts_with?(pick(b?)) }
--~^ error: outside the decidable core: its argument is not a constant

-- Conditionals, indexing, and literals of sets and sequences mention what
-- their parts mention.
proc conditional(x: Int): (y: Int) { ensure r: y = (if true then 1 else 2) * x }
proc conditional_variable(c?, x: Int): (y: Int) { ensure r: y = (if c? then 1 else 2) * x }
--~^ error: nonlinear arithmetic is not supported
proc index(x: Int): (y: Int) { ensure r: y = [1, 2][0] * x }
proc index_variable(q: Seq<Int>, x: Int): (y: Int) { ensure r: y = q[0] * x }
--~^ error: nonlinear arithmetic is not supported
proc collections(x: Int): (y: Int) { ensure r: y = {1, 2}.card * x + [1, 2].len * x }
proc sequence_variable(z: Int, x: Int): (y: Int) { ensure r: y = [z].len * x }
--~^ error: nonlinear arithmetic is not supported

-- `when` and record literals in definitions, for `constant_output`.
proc when_constant(): (k?) { out k? := (when RATE > 0, true) }
--~^ warning: defined output `k?` is the same in every behaviour
proc when_variable(c?): (k?) { out k? := (when c?, true) }
proc record_constant(): (k: R) { out k := R { a := 2 } }
--~^ warning: defined output `k` is the same in every behaviour
proc record_shorthand(a: Int): (k: R) { out k := R { a } }
proc update_constant(): (k: R) { out k := { R { a := 1 } with a := 2 } }
--~^ warning: defined output `k` is the same in every behaviour
--~^^ warning: this update gives every field of `R`
proc update_variable(p: R): (k: R) { out k := { p with a := 2 } }  --~ warning: this update gives every field of `R`

-- A table mentions what its conditions and values mention.
proc table_constant(x: Int): (y: Int) { ensure r: y = table { RATE > 0 => 1, _ => 2 } * x }
proc table_condition(c?, x: Int): (y: Int) { ensure r: y = table { c? => 1, _ => 2 } * x }
--~^ error: nonlinear arithmetic is not supported
proc table_value(z: Int, x: Int): (y: Int) { ensure r: y = table { RATE > 0 => z, _ => 2 } * x }
--~^ error: nonlinear arithmetic is not supported
