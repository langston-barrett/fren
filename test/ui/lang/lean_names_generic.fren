-- Generic types named as Lean's own declarations are, at the root module:
-- both front ends accept them, since the hosted front end declares them
-- apart from Lean's, in `Fren.Generated` (`Reqs/Generated#names`). The
-- repro of issue #249 with type parameters; `lean_names.fren` has it
-- without, at its own root module.

pub enum Option<T> { None, Some(T) }
pub enum List<T> { Nil, Cons(T, List<T>) }

comp c {
    in x: Option<Int>
    in l: List<Int>
    expect some: when x = Option::Some(3), x != Option::None
    expect cons: l != List::Cons(1, List::Nil) or l = List::Cons(1, List::Nil)
}
