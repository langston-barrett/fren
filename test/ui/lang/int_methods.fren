-- The methods of `Int`: `abs`, `min` and `max`, which are conditionals,
-- with negative operands.
-- Its expectations of constants are deliberate.
set_option fren.lint.assertions_on_constants "allow"

const LOW: Int := -5

expect abs_values: (-3).abs = 3 and (3).abs = 3 and (0).abs = 0 and LOW.abs = 5
expect min_values: (-3).min(2) = -3 and (2).min(-3) = -3 and LOW.min(LOW) = LOW  --~ warning: the receiver and the argument of `min` are written the same
expect max_values: (-3).max(2) = 2 and (2).max(-3) = 2 and LOW.max(0) = 0
expect chained: LOW.abs.min(3) = 3 and (LOW - 2).abs.max(1) = 7

proc tolerance(a: Int, b: Int): (close?, low: Int, high: Int) {
    ensure c: close? iff (a - b).abs <= 2
    ensure l: low = a.min(b)
    ensure h: high = a.max(b)

    expect low_below: low <= high
    expect sum: low + high = a + b
    expect close_range: when close?, high - low <= 2
    expect linear: 2 * a.abs >= a + a
    expect wrong: low = a                            --~ error: expectation `tolerance::wrong` does not hold
}

-- `nonminimal_bool` keeps the operands of a comparison bare.
proc simpler(a: Int): (s?) {
    ensure r: s? iff not ((a - 1).abs > a.max(0) mod 4)  --~ warning: write `(a - 1).abs <= a.max(0) mod 4`
}

-- `identity_op` keeps the operands of `div` and `mod` bound as written.
proc identity(a: Int): (t: Int) {
    ensure r: t = 1 * (a + 1) mod 3                       --~ warning: write `(a + 1)`
}

