-- Repeated names are reported where they are declared again, in source
-- order, whatever kind of member comes first; `_` declares no name.
set_option fren.lint.match_like_membership "allow"

proc parameter_first(x: Int) {
    ensure x: true  --~ error: `x` is defined multiple times in this procedure
}

enum Shape { Pair(Int, Int), Empty }

proc wildcards(s: Shape): (paired?) {
    ensure r: paired? iff match s { Shape::Pair(_, _) => true, Shape::Empty => false }
}

-- A component reports only its first repeat, before any other problem of
-- its members, in both front ends.
proc first_only(
    x: Int,
    x: Int,       --~ error: `x` is defined multiple times in this procedure
    y: Nope,
    y: Int,
) {}
