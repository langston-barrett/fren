-- Sets: literals, `{}`, operators, `card`, and the `in` line rule, in both
-- front ends.
-- fren-covers: lang::type_facts

-- Expectations about constants test what the language computes.
set_option fren.lint.assertions_on_constants "allow"

-- A literal with a repeat is tested on purpose.
set_option fren.lint.duplicate_elements "allow"

enum Lint { Unused, Glob, Naming }

proc fix_selected(lint: Lint, only: Set<Lint>, skip: Set<Lint>): (det fixed?) {
    ensure rule: fixed? iff ((only = {} or lint in only) and not lint in skip)

    expect default_all: when only = {} and not lint in skip, fixed?
    expect skip_wins: when lint in skip, not fixed?
    expect wrong: fixed?                                  --~ error: expectation `fix_selected::wrong` does not hold
}

-- Skipping more never fixes more.
expect skip_monotone(
    a_lint: Lint,
    a_only: Set<Lint>,
    a_skip: Set<Lint>,
    b_lint: Lint,
    b_only: Set<Lint>,
    b_skip: Set<Lint>,
) {
    call a := fix_selected(a_lint, a_only, a_skip)
    call b := fix_selected(b_lint, b_only, b_skip)
    expect skip_monotone: when a.lint = b.lint and a.only = b.only and a.skip subset b.skip and b.fixed?, a.fixed?
}

proc counts(s: Set<Int>, t: Set<Int>): (n: Int, det both: Set<Int>) {
    out both := s union t

    ensure r: n = (s union t).card

    expect bound: n <= s.card + t.card
    expect intersection: (s inter t) subset s
    expect defined: n = both.card
}

expect literals: {1, 1, 2}.card = 2 and ({} union {1}).card = 1 and 3 in ({1, 2, 3} minus {2})  --~ warning: this operation has no effect
expect precedence: {1} union {2} inter {3} = {1}

-- An `in` at the start of a line starts an input, so `s` ends `r`.
proc lines(
    x: Int,
    s: Set<Int>,
    y: Int,                                               --~ warning: unused variable `y`
): (ok?) {
    ensure r: ok? iff x in s
}
--@ summary: 20 passed, 1 failed, 0 inconclusive, 0 redundant
--@ exit: 1
