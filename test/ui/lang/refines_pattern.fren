-- fren-covers: refinement::refinement_result_domain
-- Both checking and counterexample validation must retain the input type.
proc concrete(x: Int): (y: Int) { out y := x }
proc specification(x: Int is 1..): (y: Int) { out y := x }
expect bad() {
    call c := concrete(0)
    refines c specification(0)  --~ error: expectation `bad::refines_1` does not hold
}
