-- Static rules of traits (`Reqs/Lang/Traits`), in both front ends.
set_option fren.lint.dead_code "allow"

mod traits_static

type Key

-- A trait's members are methods, laws and expectations
-- (`lang::trait_member`), each its own first error.
trait Members {
    fn size(Self): Int
    const START: Int := 0  --~ error: a trait has no constants
}

trait Defaults {
    fn size(Self): Int
    fn twice(s: Self): Int := 2 * size(s)  --~ error: a method of trait `traits_static::Defaults` has no body, for now
}

trait Visible {
    pub fn size(Self): Int  --~ error: a member of trait `traits_static::Visible` is not written `pub`
}

trait Generic {
    fn pick<T>(Self, T): T  --~ error: a method of trait `traits_static::Generic` has no type parameters, for now
}

-- No member's block has a `use`, for now.
trait Uses {
    fn size(Self): Int
    expect sized(s: Self) {  --~ error: a member of trait `traits_static::Uses` has no `use`, for now
        use self::Key
        expect c: size(s) >= size(s)
    }
}

-- An expectation of a trait is checked by the solver alone.
trait Tested {
    fn size(Self): Int
    set_option fren.evidence "random" in
    expect sized(s: Self) { expect c: size(s) >= 0 }
    --~^ error: `fren.evidence` cannot be set to `"random"` for an expectation of a trait
}

-- A law's name is written without `?` or `!`.
trait Questioned {
    fn size(Self): Int
    law big?(s: Self): size(s) > 0  --~ error: constraint names cannot end in `?`
}

trait Banged {
    fn size(Self): Int
    law big!(s: Self): size(s) > 0  --~ error: `big!` shadows nothing
}

-- A law has no checks of its own to set.
trait Settled {
    fn size(Self): Int
    set_option fren.evidence "random" in  --~ error: `fren.evidence` cannot be set to `"random"` for a law
    law sized(s: Self): size(s) >= 0
}

-- Every setting before a law is checked, in either order, before any is in
-- effect.
trait SettledUnder {
    fn size(Self): Int
    set_option fren.evidence "random" in  --~ error: `fren.evidence` cannot be set to `"random"` for a law
    set_option fren.lint.undecidable "allow" in
    law sized(s: Self): size(s) >= 0
}

trait SettledOver {
    fn size(Self): Int
    set_option fren.lint.undecidable "allow" in
    set_option fren.enumeration.size 2 in  --~ error: `fren.enumeration.size` cannot be set to `2` for a law
    law sized(s: Self): size(s) >= 0
}

-- A method's contract sees the methods before it, not those after.
trait Later {
    fn size(s: Self): (r: Int) { ensure big: r > weight(s) }
    --~^ error: cannot find `weight` in this scope
    fn weight(Self): Int
}

-- A trait's name is in `CamelCase`, and a law's in `snake_case`.
trait lower_case {}  --~ warning: trait `lower_case` should have a camel case name

trait Cased {
    fn size(Self): Int
    set_option fren.lint.undecidable "allow" in
    law BigSize(s: Self): size(s) > 0  --~ warning: law `BigSize` should have a snake case name
}

-- `Self` and the members share one namespace.
trait Twice {
    fn size(Self): Int
    fn size(Self, Int): Int  --~ error: `size` is defined multiple times in this trait
}

trait Carrier {
    fn Self(Self): Int  --~ error: `Self` is defined multiple times in this trait
}

-- `Self` is an abstract type, so no payload is one.
trait Payloads {
    fn wrap(Self): Option<Self>  --~ error: a payload cannot have the abstract type `traits_static::Payloads::Self`
}

-- Outside a trait, `Self` means nothing.
fn outside(Self): Int  --~ error: cannot find `Self` in this scope

-- A law is a `Bool`, and its variables are distinct.
trait Laws {
    fn size(Self): Int

    law number(s: Self): size(s)  --~ error: type mismatch: expected `Bool`, found `Int`
    law twice(s: Self, s: Self): size(s) = size(s)  --~ error: parameter `s` is defined multiple times

    -- A member's errors stop only what follows them in it, as an item's do.
    expect after(s: Self, t: Self) {  --~ warning: unused variable `t`
        expect c: size(s) >= 0
    }
}

-- Each law is outside the decidable core, for now, so `undecidable`, an
-- error by default, reports it.
trait Undecidable {
    fn size(Self): Int

    law natural(s: Self): size(s) >= 0  --~ error: outside the decidable core
}
--@ exit: 2
