-- Instances: what they contribute to checks, and the `instance` check.

comp counter {
    in n: Int
    pub out next: Int
    out scratch: Int

    assume nonneg: n >= 0

    ensure inc: next = n + 1
    ensure copy: scratch = n
}

-- `b`'s assumption follows from `a`'s guarantees.
comp twice {
    in n: Int
    pub out m: Int

    assume nonneg: n >= 0  --~ warning: `n` is never negative

    inst a: counter { n }
    inst b: counter { n := a.next }

    ensure result: m = b.next

    expect plus_two: m = n + 2
}

comp unguarded {
    in n: Int
    pub out m: Int

    inst c: counter { n }  --~ error: the assumption `nonneg` of `counter` may not hold for instance `unguarded::c`

    ensure result: m = c.next
}

comp chooser {
    pub out b?
    --~^ warning: unused variable `b?`
}

-- Instance variables are not the comp's to choose: whatever `pick` does, the
-- comp must cope.
comp hopes {   --~ error: no outputs satisfy `lucky`
    pub out x: Int
    inst pick: chooser {}
    ensure lucky: pick.b? and x = 0
}

comp observes {
    in n: Int

    assume nonneg: n >= 0  --~ warning: `n` is never negative

    inst c: counter { n }

    ensure zero: when c.next = 0, n = 0  --~ error: `observes::zero` is vacuous: its condition can never hold, given `c`
    expect big: c.next > 5           --~ error: expectation `observes::big` does not hold
}

