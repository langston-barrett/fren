-- Static rules for contracts (`Reqs/Lang/Items#contracts`): a clause is a
-- `Bool`, named apart from the parameters and the other clauses; an
-- uninterpreted function with a contract names its parameters; and the
-- function applies itself only in a postcondition, to its parameters.
set_option fren.lint.dead_code "allow"

type Name

fn unnamed(Int): Int   --~ error: the parameters of uninterpreted function `unnamed` must be named
    ensure pos: true

fn typed(n: Int): Int := n
    assume big: n + 1   --~ error: type mismatch: expected `Bool`, found `Int`

fn clash(n: Int): Int := n
    assume n: n > 0     --~ error: `n` is defined multiple times

fn twice(n: Int): Int := n
    assume p: n > 0
    ensure p: twice(n) > 0   --~ error: `p` is defined multiple times

fn circular(n: Int): Int
    assume small: circular(n) < 10   --~ error: a precondition of `circular` cannot apply `circular`

fn other_args(n: Int): Int
    ensure next: other_args(n + 1) > 0   --~ error: a postcondition of `other_args` applies `other_args` to other than its parameters

fn swapped(a: Int, b: Int): Int := a - b
    ensure anti: swapped(b, a) = -swapped(a, b)   --~ error: a postcondition of `swapped` applies `swapped` to other than its parameters

fn questioned(n: Int): Int := n
    ensure big?: n > 0   --~ error: constraint names cannot end in `?`

fn outside(n: Int): Int := n
    assume known: m > 0   --~ error: cannot find `m` in this scope

-- A clause may apply uninterpreted functions declared before, unlike a
-- body, and the function itself in a postcondition, to its parameters.
fn arity(Name): Nat
fn positive_arity(n: Name): Nat
    assume some_arity: arity(n) > 0
    ensure bounded: positive_arity(n) <= arity(n)
