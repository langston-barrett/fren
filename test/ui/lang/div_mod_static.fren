-- Static rules for `div`, `mod` and the methods of `Int`: the divisor is a
-- literal or a constant, other than `0`, whose value is known.
set_option fren.lint.unused_variables "allow"
set_option fren.lint.dead_code "allow"
set_option fren.lint.non_snake_case "allow"

const ZERO: Int := 4 - 2 * 2
const LENGTH: Int := "abcd".len
const WORD: String := "a"

proc by_variable(x: Int, y: Int): (q: Int) { out q := x div y }
--~^ error: the divisor of `div` must be an integer literal or a constant
proc expression(x: Int): (q: Int) { out q := x mod (2 * 3) }
--~^ error: the divisor of `mod` must be an integer literal or a constant
proc zero(x: Int): (q: Int) { out q := x div 0 }
--~^ error: `div` by zero
proc negated_zero(x: Int): (q: Int) { out q := x mod -(0) }
--~^ error: `mod` by zero
proc zero_constant(x: Int): (q: Int) { out q := x mod ZERO }
--~^ error: `mod` by zero
proc unknown_constant(x: Int): (q: Int) { out q := x div LENGTH }
--~^ error: the value of `LENGTH`, the divisor of `div`, is not known when the spec is read
proc shadowed(ZERO!: Int, x: Int): (q: Int) { out q := x div ZERO }
--~^ error: the divisor of `div` must be an integer literal or a constant
proc method_divisor(x: Int): (q: Int) { out q := x div (-2).abs }
--~^ error: the divisor of `div` must be an integer literal or a constant
proc string_divisor(x: Int): (q: Int) { out q := x div WORD }
--~^ error: type mismatch: expected `Int`, found `String`
proc bool_dividend(p?): (q: Int) { out q := p? div 2 }
--~^ error: type mismatch: expected `Int`, found `Bool`

proc unknown_method(x: Int): (q: Int) { out q := x.absolute }
--~^ error: `Int` has no method `absolute`
proc chained_unknown(x: Int): (q: Int) { out q := (x - 1).abs.absolute }
--~^ error: `Int` has no method `absolute`
proc min_arity(x: Int): (q: Int) { out q := x.min(1, 2) }
--~^ error: `min` takes 1 argument, but 2 were given
proc max_type(x: Int, p?): (q: Int) { out q := x.max(p?) }
--~^ error: type mismatch: expected `Int`, found `Bool`
proc nonlinear(x: Int, y: Int): (q: Int) { out q := x * y.abs }
--~^ error: nonlinear arithmetic is not supported

--@ exit: 2
