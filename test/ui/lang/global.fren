-- Global expectations: several behaviours, several components, constants.
-- fren-covers: lang::global_checks
set_option fren.lint.chainable_comparison "allow"

-- Expectations about constants test what the language computes.
set_option fren.lint.assertions_on_constants "allow"

const LOW: Int := 0
const HIGH: Int := 10

proc band(temp: Int, target: Int): (too_cold?, too_hot?) {
    assume sane: LOW <= target and target <= HIGH
    exists secret: Int
    ensure cold: too_cold? iff temp < target - 2
    ensure hot: too_hot? iff temp > target + 2
    ensure s: secret = temp
}

proc fast_band(temp: Int, target: Int): (too_cold?, too_hot?) {
    ensure cold: too_cold? iff temp + 2 < target
    ensure hot: too_hot? iff temp - 2 > target
}

expect sane_range: LOW < HIGH
expect exclusive(b_temp: Int, b_target: Int) {
    assume b_sane: LOW <= b_target and b_target <= HIGH
    call b := band(b_temp, b_target)
    expect exclusive: not (b.too_cold? and b.too_hot?)
}
expect colder_is_cold(a_temp: Int, a_target: Int, b_temp: Int, b_target: Int) {
    assume a_sane: LOW <= a_target and a_target <= HIGH
    assume b_sane: LOW <= b_target and b_target <= HIGH
    call a := band(a_temp, a_target)
    call b := band(b_temp, b_target)
    expect colder_is_cold: when a.target = b.target and a.temp <= b.temp and b.too_cold?, a.too_cold?
}
expect same_band(f_temp: Int, f_target: Int, b_temp: Int, b_target: Int) {
    assume b_sane: LOW <= b_target and b_target <= HIGH
    call f := fast_band(f_temp, f_target)
    call b := band(b_temp, b_target)
    expect same_band: when f.temp = b.temp and f.target = b.target,
        (f.too_cold? iff b.too_cold?) and (f.too_hot? iff b.too_hot?)
}

-- The assumptions, copied from the procedure's, say that `target` is in range.
expect assumed(b_temp: Int, b_target: Int) {
    assume b_sane: LOW <= b_target and b_target <= HIGH
    call b := band(b_temp, b_target)
    expect assumed: b.target <= HIGH
}

expect wrong(a_temp: Int, a_target: Int, b_temp: Int, b_target: Int) {
    assume a_sane: LOW <= a_target and a_target <= HIGH
    assume b_sane: LOW <= b_target and b_target <= HIGH
    call a := band(a_temp, a_target)
    call b := band(b_temp, b_target)
    expect wrong: when a.temp <= b.temp, a.too_cold? iff b.too_cold?  --~ error: expectation `wrong::wrong` does not hold
}
expect never(a_temp: Int, a_target: Int) {
    assume a_sane: LOW <= a_target and a_target <= HIGH
    call a := band(a_temp, a_target)
    expect never: when a.target > HIGH, a.too_hot?  --~ error: `never::never` is vacuous: its condition can never hold, given `a`
}
-- Contradictory assumptions make every expectation hold vacuously.
expect contra(a: Int) {  --~ error: the assumptions of `contra` are unsatisfiable: `lo`, `hi` contradict each other
    assume lo: a > 5
    assume hi: a < 3
    call c := band(a, LOW)
    expect claim: c.too_cold?  --~ warning: `contra::claim` rests on the realizability of `contra`, which did not pass
}
expect contra_alone(a: Int) {  --~ error: the assumptions of `contra_alone` are unsatisfiable: `lo`, `hi` contradict each other
    assume lo: a > 5
    assume hi: a < 3
    expect claim: a = 0  --~ warning: `contra_alone::claim` rests on the realizability of `contra_alone`, which did not pass
}
expect false_const: HIGH < LOW               --~ error: expectation `false_const` does not hold

mod m
use band
expect nested(a_temp: Int, a_target: Int) {
    use HIGH
    use LOW
    assume a_sane: LOW <= a_target and a_target <= HIGH
    call a := band(a_temp, a_target)
    expect nested: when a.temp > 100, a.too_hot?
}

--@ summary: 36 passed, 5 failed, 2 inconclusive, 0 redundant
