-- Global expectations: several behaviours, several components, constants.
set_option fren.lint.chainable_comparison "allow"

-- Expectations about constants test what the language computes.
set_option fren.lint.assertions_on_constants "allow"

const LOW: Int := 0
const HIGH: Int := 10

comp band {
    in temp: Int
    in target: Int

    assume sane: LOW <= target and target <= HIGH
    pub out too_cold?
    pub out too_hot?
    out secret: Int
    ensure cold: too_cold? iff temp < target - 2
    ensure hot: too_hot? iff temp > target + 2
    ensure s: secret = temp
}

comp fast_band {
    in temp: Int
    in target: Int
    pub out too_cold?
    pub out too_hot?

    ensure cold: too_cold? iff temp + 2 < target
    ensure hot: too_hot? iff temp - 2 > target
}

expect sane_range: LOW < HIGH
expect exclusive: forall (b: band), not (b.too_cold? and b.too_hot?)
expect colder_is_cold: forall (a b: band),
    when a.target = b.target and a.temp <= b.temp and b.too_cold?, a.too_cold?
expect same_band: forall (f: fast_band) (b: band),
    when f.temp = b.temp and f.target = b.target,
    (f.too_cold? iff b.too_cold?) and (f.too_hot? iff b.too_hot?)

-- The assumptions of a binder's component are hypotheses: `target` is in range.
expect assumed: forall (b: band), b.target <= HIGH

expect wrong: forall (a b: band),            --~ error: expectation `wrong` does not hold
    when a.temp <= b.temp, a.too_cold? iff b.too_cold?
expect never: forall (a: band),
    when a.target > HIGH, a.too_hot?
--~^ error: `never` is vacuous: its condition can never hold
expect false_const: HIGH < LOW               --~ error: expectation `false_const` does not hold

mod m
use band
expect nested: forall (a: band), when a.temp > 100, a.too_hot?

--@ summary: 19 passed, 3 failed, 0 inconclusive, 0 redundant
