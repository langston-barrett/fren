-- A cover goal's name shares the component's namespace, and the goal is a
-- `Bool`, like any constraint.

comp named {
    in x: Int
    cover x: x > 0     --~ error: `x` is defined multiple times in this component
}

comp typed {
    in x: Int
    cover big: x + 1   --~[cli] error: expected `Bool`, found `Int`
    --~^[hosted] error: Type mismatch
}
