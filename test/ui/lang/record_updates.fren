-- Record updates, `{ r with x := e }`, in both front ends.

pub struct Point { x: Int, y: Int }

pub struct State { count: Int, on?, tags: Set<Bool> }

proc moves(p: Point, n: Int): (det q: Point, det y: Int) {
    ensure r: q = { p with x := n }
    ensure read: y = { p with x := 1 }.y

    expect keeps_y: q.y = p.y
    expect sets_x: q.x = n
    expect as_literal: q = Point { x := n, y := p.y }
    expect every_field: { p with y := 2, x := 1 } = Point { x := 1, y := 2 }  --~ warning: this update gives every field of `Point`
    expect same: { p with x := p.x } = p
    expect wrong: q = p  --~ error: expectation `moves::wrong` does not hold
}

-- A field alone means `x := x`; `{}` takes its field's type; the updated
-- value may be any record-valued expression.
proc shorthand(s: State, count: Int): (t: State, u: State) {
    out t := { s with count, tags := {} }
    out u := { { s with on? := true } with count := count + 1 }

    expect counted: t.count = count and t.on? = s.on? and t.tags = {}
    expect both: u.on? and u.count = count + 1 and u.tags = s.tags
}

-- The issue's nested form, with a dotted path as the updated value; an
-- instance's variable as the updated value.
pub struct Line { start: Point, stop: Point }

proc held(a: Point): (b: Point) { out b := a }

proc nested(l: Line, n: Int): (m: Line, k: Point, j: Point) {
    out m := { l with start := { l.start with x := n } }
    out k := { l.stop with y := 0 }
    call h := held(l.start)
    out j := { h.b with y := n }

    expect moved: m.start.x = n and m.start.y = l.start.y and m.stop = l.stop
    expect cleared: k = Point { x := l.stop.x, y := 0 }
    expect through_instance: j = Point { x := l.start.x, y := n }
}

-- A defined function whose body updates a value that is not a name, which
-- is bound once.
fn same_point(p: Point): Point := p
fn moved(p: Point, n: Int): Point := { same_point(p) with x := n }

proc through_function(p: Point, n: Int): (det q: Point) {
    ensure r: q = moved(p, n)

    expect keeps_y: q.y = p.y
    expect sets_x: q.x = n
}

-- An index in an updated value that is bound once.
proc guarded_base(ps: Seq<Point>): (det a: Point, det b: Point) {
    ensure ra: a = { ps[0] with x := 1 }  --~ error: an index of `guarded_base::ra` may be out of range
    ensure rb: b = if ps != [] then { ps[0] with x := 1 } else Point { x := 1, y := 0 }

    expect sets: when ps != [], b.x = 1 and b.y = ps[0].y
}

-- An update is an atom: an operand of `=` and `not` without parentheses.
proc atoms(s: State): (det on?) {
    ensure r: on? iff not { s with on? := false }.on?

    expect always_on: on?
}

-- An index within an update is guarded as anywhere else.
proc guarded(q: Seq<Int>, ps: Seq<Point>, p: Point): (det a: Point, det b: Point, det c: Point) {
    ensure ra: a = if q != [] then { p with x := q[0] } else p
    ensure rb: b = { p with x := q[0] }  --~ error: an index of `guarded::rb` may be out of range
    ensure rc: c = { ps[0] with x := 1, y := 2 }  --~ error: an index of `guarded::rc` may be out of range
    --~^ warning: this update gives every field of `Point`

    expect sets: when q != [], a.x = q[0]
    expect every_field: c = Point { x := 1, y := 2 }
}

