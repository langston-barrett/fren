-- Static rules for pattern tests that bind names (`lang::test_scope`).
set_option fren.lint.dead_code "allow"

enum Reply { Empty, Value(Int), Pair(Int, Int) }

-- Where nothing sees the names, a test cannot bind them.
proc alone(r: Reply): (z?) { ensure a: z? iff r is Reply::Value(v) }
--~^ error: a pattern test cannot bind `v` here
proc last(r: Reply, b?): (z?) { ensure a: z? iff (b? and r is Reply::Value(v)) }
--~^ error: a pattern test cannot bind `v` here
proc in_unless(r: Reply): (w: Int) { ensure a: unless r is Reply::Value(v), w = 0 }
--~^ error: a pattern test cannot bind `v` here
proc in_or(r: Reply, b?): (z?) { ensure a: z? iff (r is Reply::Value(v) or b?) }
--~^ error: a pattern test cannot bind `v` here
proc in_not(r: Reply): (w: Int) { ensure a: when not r is Reply::Value(v), w = 0 }
--~^ error: a pattern test cannot bind `v` here
proc body_is(r: Reply): (z?) { ensure a: when z?, r is Reply::Value(v) }
--~^ error: a pattern test cannot bind `v` here

-- The names are not in scope outside what sees them.
proc else_branch(r: Reply): (w: Int) { ensure a: w = (if r is Reply::Value(v) then 0 else v) }
--~^ error: cannot find `v`
proc unless_and(r: Reply): (w: Int) { ensure a: unless r is Reply::Value(v) and v > 0, w = v }
--~^ error: cannot find `v`
proc before(r: Reply): (z?) { ensure a: z? iff (v > 0 and r is Reply::Value(v)) }
--~^ error: cannot find `v`
proc under_or(r: Reply, b?): (w: Int) { ensure a: when (r is Reply::Value(v) and v > 0) or b?, w = v }
--~^ error: cannot find `v`

-- An or-pattern binds no names, as in a `match`.
proc or_pattern(r: Reply): (w: Int) { ensure a: when r is Reply::Value(v) | Reply::Pair(v, _), w = v }
--~^ error: an or-pattern cannot bind `v`

-- Each name once in a pattern, and shadowing only with `!`.
proc twice(r: Reply): (w: Int) { ensure a: when r is Reply::Pair(v, v), w = v }
--~^ error: `v` is bound multiple times in this pattern
proc shadows_input(r: Reply, v: Int): (w: Int) { ensure a: when r is Reply::Value(v), w = v }
--~^ error: `v` shadows
proc shadows_test(r: Reply, s: Reply): (w: Int) { ensure a: when r is Reply::Value(v) and s is Reply::Value(v), w = v }
--~^ error: `v` shadows

-- A binder of `Bool` ends in `?`.
enum Flag { On(Bool), Off }
proc bool_name(f: Flag): (z?) { ensure a: when f is Flag::On(b), z? iff b }
--~^ error: `Bool` variable `b` must end in `?`

-- A binder of a generic payload has the instantiated type.
enum Opt<T> { None, Some(T) }
proc generic(o: Opt<Int>): (w?) { ensure a: when o is Opt::Some(x), w? iff x }
--~^ error: type mismatch: expected `Bool`, found `Int`

--@ exit: 2
