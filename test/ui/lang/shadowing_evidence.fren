-- Evidence settings reach members declared with `!`, which they name
-- without it: a `det out`, an instance, and, for a component set to
-- testing, the definedness of a defined output. Only the `fren` command
-- tests (`Reqs/Check#checking-by-testing`).
--@ only: cli
pub fn y(Int): Int
pub fn p(Int): Int
pub fn d(Int): Int

pub proc positive(k: Int) {
    assume pos: k > 0
}

pub proc members(n: Int): (set_option fren.evidence "tested" in det y!: Int) {
    set_option fren.evidence "tested" in
    call p := positive(1)

    ensure r: y = n + p.k
}

set_option fren.evidence "tested" in
pub proc defined(q: Seq<Int>): (d!: Int) {
    assume nonempty: q != []
    out d := q[0]
}

--@ summary: 7 passed (3 by testing), 0 failed, 0 inconclusive, 0 redundant
