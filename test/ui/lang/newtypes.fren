-- Newtypes, `struct Ms(Int)`, in both front ends: built with `Ms(e)`,
-- read with `x.0`, compared, added and subtracted.
-- fren-covers: lang::operator_type
-- Its round trips are deliberate.
set_option fren.lint.redundant_newtype_roundtrip "allow"

pub ordered struct Ms(Int)
pub struct Bytes(Int)
pub ordered struct Name(String)
pub struct Flag(Bool)

pub enum Mode { Idle, Busy }

pub struct Tagged(Mode)
pub struct Tags(Set<Int>)

proc timer(elapsed: Ms, budget: Ms, size: Bytes): (det left: Ms, det over?, det total: Ms) {
    assume positive: elapsed >= Ms(0) and budget >= Ms(0)
    out left := budget - elapsed
    out over? := elapsed > budget
    out total := elapsed + budget

    expect left_value: left.0 = budget.0 - elapsed.0
    expect built: left = Ms(budget.0 - elapsed.0)
    expect round_trip: Ms(elapsed.0) = elapsed
    expect chained: Ms(0) <= elapsed <= total
    expect sums: total - budget = elapsed
    expect bytes: Bytes(size.0) = size
    expect wrong: left = budget  --~ error: expectation `timer::wrong` does not hold
}

-- A newtype of `String` is ordered, but has no `+` or `-`.
proc names(a: Name, b: Name): (det early?) {
    out early? := a < Name("m")

    expect sorted: early? iff a.0 < "m"
    expect read: a.0 = b.0 or a != b
    expect not_empty: a.0 != ""  --~ error: expectation `names::not_empty` does not hold
}

-- Newtypes of other types have `=` and `!=`, and are read with `.0`.
proc others(f: Flag, t: Tagged): (det on?, det busy?) {
    out on? := f.0
    out busy? := t = Tagged(Mode::Busy)

    expect flag: on? iff f = Flag(true)
    expect mode: busy? iff t.0 = Mode::Busy
}

-- A newtype of an ordered enumeration is ordered as its values are.
pub ordered enum Level { Low, Mid, High }
pub ordered struct Grade(Level)

proc grades(g: Grade): (det top?) {
    out top? := g >= Grade(Level::High)

    expect order: top? iff g = Grade(Level::High)
    expect chain: Grade(Level::Low) <= g <= Grade(Level::High)
}

-- In sets, sequences, records, functions and instances.
pub struct Job { took: Ms, size: Bytes }

fn cost(Ms): Ms
fn half(m: Ms): Ms := Ms(m.0 div 2)

proc collections(times: Set<Ms>, queue: Seq<Ms>, job: Job): (det longest: Ms, det halved: Ms) {
    assume some: queue.len = 1 and queue[0] in times
    out longest := job.took
    out halved := half(job.took)

    expect member: Ms(queue[0].0) in times
    expect record: longest = job.took and Job { took := longest, size := job.size } = job
    expect same_cost: cost(longest) = cost(job.took)
    expect halves: halved.0 = job.took.0 div 2
    expect literal: {Ms(1), longest} = {longest, Ms(1)}
}

proc waiting(t: Ms): (det later: Ms) {
    out later := t + Ms(1)
}

proc uses(now: Ms) {
    call w := waiting(now)

    expect after: w.later > now
}

-- A counterexample shows newtypes as Fren builds them, in both front ends.
pub struct Slot { start: Ms, tags: Set<Ms> }

proc shown(t: Ms, s: Slot): (det next: Ms) {
    assume pinned: t = Ms(3) and s = Slot { start := Ms(2), tags := {Ms(9), Ms(10)} }
    out next := t + Ms(1)

    expect small: next < Ms(4)  --~ error: expectation `shown::small` does not hold
}

-- A newtype of a finite type is finite: the domain of a relation into one
-- is in the decidable core.
pub struct Bits(Set<Bool>)
pub struct B2(Bits)

proc finite(r: Rel<Int, Flag>, q: Rel<Int, Bits>, p: Rel<Int, B2>): (
    det d: Set<Int>,
    det e: Set<Int>,
    det f: Set<Int>,
) {
    out d := r.domain
    out e := q.domain
    out f := p.domain

    expect domain: 1 in d iff ((1, Flag(true)) in r or (1, Flag(false)) in r)
    expect of_sets: when q = {}, e = {}
    expect nested: when p = {}, f = {}
}

-- The value of a newtype is checked against its underlying type, so `{}`
-- may be one.
proc empty_value(s: Set<Int>): (det t: Tags) {
    out t := if s = {} then Tags({}) else Tags(s)

    expect same: t.0 = s
}

-- In refinements, with bindings over newtypes.
proc deadline(t: Ms): (d: Ms) {
    ensure r: d >= t
}

proc next_tick(t: Ms): (d: Ms) {
    ensure r: d = t + Ms(1)
}

proc seconds(s: Int): (d: Int) {
    ensure r: d = s + 1
}

expect ticks(t: Ms) {
    use Ms
    call concrete := next_tick(t)
    refines concrete deadline(t)
}
expect counted(s: Int) {
    call concrete := seconds(s)
    expect r: (Ms((concrete.d))) >= (Ms((s)))
}
expect late(t: Ms) {
    use Ms
    call concrete := deadline(t)
    refines concrete next_tick(t)  --~ error: expectation `late::refines_1` does not hold
}

--@ summary: 65 passed, 4 failed, 0 inconclusive, 0 redundant
--@ exit: 1
