-- Static rules for calls (`inst::binding`, `inst::mention`).
-- fren-covers: call::earlier

proc sub(x: Int, y?): (z: Int) {
    --~^ warning: unused variable `y?`
    exists hidden: Int

    ensure r: z = x
    ensure h: hidden = x
}

enum E { A }

proc missing(y?) { call s := sub(y?) }                     --~ error: too few arguments: `sub` takes 2 arguments
proc extra(y?) { call s := sub(1, y?, 2) }                 --~ error: too many arguments: `sub` takes 2 arguments
proc old(y?) { inst s: sub { y?, x := 1 } }                --~ error: instances are written as calls
proc not_comp() { call s := E() }                             --~ error: expected a component, but `E` is an enum
proc q_name(y?) { call s? := sub(1, y?) }          --~ error: instance names cannot end in `?`
proc dup_name(y?) { call y? := sub(1, y?) }        --~ error: `y?` is defined multiple times in this comp

proc out_bound(y?): (o: Int) { call s := sub(o, y?) ensure r: o = 0 }
--~^ error: bindings may only mention `in` variables and earlier instances, but `o` is an `out`
proc later(y?) { call a := sub(b.z, y?) call b := sub(1, y?) }
--~^ error: instance `b` is not declared before this binding
proc itself(y?) { call a := sub(a.z, y?) }         --~ error: instance `a` is not declared before this binding
proc private_var(y?): (o: Int) { call a := sub(1, y?) ensure r: o = a.hidden }
--~^ error: `a.hidden` is private to instance `a`
proc assumes_inst(y?) { call a := sub(1, y?) assume bad: a.z = 0 }
--~^ error: assumptions may only mention `in` variables, but `a.z` belongs to instance `a`
proc no_field(y?): (o: Int) { call a := sub(1, y?) ensure r: o = a.nope }
--~^ error: instance `a` has no `in` or `pub out` named `nope`
proc not_inst(): (o: Int) { ensure r: o = q.z }            --~ error: `q.z` is not a single name
proc mistyped(y?) { call a := sub(y?, y?) }
--~^ error: type mismatch: expected `Int`, found `Bool`

mod m
proc secret() {}

mod n
use m                                                      --~ warning: unused import `m`
proc outside() { call s := m::secret() }                      --~ error: `secret` is private to module `m`

--@ exit: 2
