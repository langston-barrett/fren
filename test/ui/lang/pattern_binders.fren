-- Pattern tests that bind names: in the later operands of their `and`, the
-- body of `when`, and the `then` branch of `if` (`lang::test_scope`).
-- fren-covers: lang::pattern_binding

pub enum Reply { Empty, Value(Int), Pair(Int, Int) }

-- `when x is P(d), D` means `match x { P(d) => D, _ => true }`.
proc when_body(r: Reply, limit: Int): (det bounded?) {
    ensure rule: bounded? iff (when r is Reply::Value(v), v <= limit)

    expect as_match: bounded? iff match r { Reply::Value(v) => v <= limit, _ => true }
    expect empty: when r = Reply::Empty, bounded?
    expect wrong: bounded?  --~ error: expectation `when_body::wrong` does not hold
}

-- `x is P(d) and E` means `match x { P(d) => E, _ => false }`, and the names
-- of each test are in scope in the later operands of its chain.
proc and_chain(r: Reply, s: Reply): (det increasing?, det big?) {
    ensure increasing: increasing? iff r is Reply::Value(a) and s is Reply::Value(b) and a < b
    ensure big: big? iff (r is Reply::Pair(x, y) and x + y > 10) or r = Reply::Empty

    expect as_match: increasing? iff match r {
        Reply::Value(a) => match s { Reply::Value(b) => a < b, _ => false },
        _ => false,
    }
    expect parenthesized: increasing? iff (r is Reply::Value(a) and (s is Reply::Value(b) and a < b))
    expect left_nested: increasing? iff ((r is Reply::Value(a) and s is Reply::Value(b)) and a < b)
    expect pair: when r = Reply::Pair(5, 6), big?
}

-- `if x is P(d) then e1 else e2`: the names are in scope in `e1` only.
proc if_branch(r: Reply): (det n: Int) {
    ensure rule: n = (if r is Reply::Value(v) and v > 0 then v else 0)

    expect non_negative: n >= 0
    expect as_match: n = match r { Reply::Value(v) if v > 0 => v, _ => 0 }
}

-- Nested conditions, and a binder that shadows the input `v` with `!`.
proc nested(r: Reply, v: Int): (w: Int) {
    ensure rule: when r is Reply::Value(v!), when v > 0, w = v
    ensure other: unless r is Reply::Value(_), w = v

    expect positive: when r = Reply::Value(3), w = 3
    expect input: when r = Reply::Empty, w = v
}
