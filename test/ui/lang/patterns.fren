-- Patterns: `matches?`, in both front ends.

-- Expectations about constants test what the language computes.
set_option fren.lint.assertions_on_constants "allow"

-- `(a|b)+` tests alternation on purpose.
set_option fren.lint.manual_pattern_char_comparison "allow"

enum Case { Snake, Camel, Upper }

comp in_case {
    in case: Case
    in name: String
    pub det out conventional?

    req snake: when case = Case::Snake, conventional? iff not name.matches?(r".*[A-Z].*")
    req camel: when case = Case::Camel, conventional? iff name.matches?(r"[A-Z][^_]*")
    req upper: when case = Case::Upper, conventional? iff name.matches?(r"[A-Z][^a-z]*")

    expect lowercase_is_snake: when not name.matches?(r".*[A-Z].*"), conventional? iff case = Case::Snake
    expect mixed_not_upper: when case = Case::Upper and name.matches?(r"[A-Z]+[a-z][A-Za-z]*"),
        not conventional?
    expect wrong: when case = Case::Camel, conventional?  --~ error: expectation `in_case::wrong` does not hold
}

comp codes {
    in code: String
    pub out lint?

    assume well_formed: code.matches?(r"F0[1-7][0-9][0-9]")

    req r: lint? iff code.starts_with?("F07")

    expect five: code.len = 5
    expect not_eight: not code.starts_with?("F08")
}

expect repetition: "aaa".matches?(r"a{2,3}") and not "a".matches?(r"a{2,3}") and "ab".matches?(r"(a|b)+")
expect escapes: "a.b".matches?(r"a\.b") and not "axb".matches?(r"a\.b") and "?".matches?(r"\?")
--~^ warning: this pattern has no operator but `.*`
--~^^ warning: this pattern has no operator but `.*`
--~^^^ warning: this pattern has no operator but `.*`
expect classes: "-".matches?(r"[a-]") and "q".matches?(r"[^a-p]") and not "a".matches?(r"[^a-p]")
--@ summary: 21 passed, 1 failed, 0 inconclusive, 0 redundant
--@ exit: 1
