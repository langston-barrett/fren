-- Generic defined functions (`Reqs/Lang/GenericFunctions`), in both front
-- ends: each application is unfolded at its instance, whose type arguments
-- are inferred from the arguments and the expected type. In a module, since
-- Lean has an `Option` and a `List` of its own.
set_option fren.lint.dead_code "allow"

mod generic_functions

pub struct Pair<A, B> { fst: A, snd: B }
pub enum List<T> { Nil, Cons(T, List<T>) }

-- The identity, at any type.
fn id<T>(x: T): T := x

-- Over an `Option`-like type.
fn unwrap_or<T>(o: Option<T>, d: T): T := match o { Option::Some(x) => x, Option::None => d }
fn is_some?<T>(o: Option<T>) := o != Option::None

-- Two type parameters.
fn swap<A, B>(p: Pair<A, B>): Pair<B, A> := Pair { fst := p.snd, snd := p.fst }

-- Nested applications of generic functions, within a generic one.
fn first_or<T>(p: Pair<Option<T>, T>): T := id(unwrap_or(p.fst, id(p.snd)))

-- Through a recursive generic type: the head of a list, if it has one.
fn head<T>(l: List<T>): Option<T> := match l { List::Cons(x, _) => Option::Some(x), List::Nil => Option::None }

-- A result that only the expected type gives an argument, with a contract.
fn nothing<T>(n: Int): (result: Option<T>) {
    assume positive: n > 0
    out result := let r: Option<T> := Option::None in r
    ensure empty: let r: Option<T> := nothing(n) in r = Option::None
}

proc options(x: Option<Int>, b?): (
    det y: Int,
    det q: Pair<Bool, Int>,
    det s?,
    det n: Option<Bool>,
) {
    out y := unwrap_or(x, id(3))
    out q := swap(Pair { fst := y, snd := b? })
    out s? := is_some?(x)
    out n := if b? then nothing(1) else Option::Some(b?)

    expect missing: when x = Option::None, y = 3
    expect present: when x = Option::Some(5), y = 5 and s?
    expect swapped: q.fst = b? and q.snd = y
    expect from_result: n != Option::Some(true)
}

proc nested(p: Pair<Option<Bool>, Bool>): (det r?) {
    out r? := first_or(p)

    expect fallback: when p.fst = Option::None, r? = p.snd
    expect inner: when p.fst = Option::Some(true), r?
}

proc lists(l: List<Int>, b?): (det h: Option<Int>, det k: Option<Bool>) {
    out h := head(l)
    out k := head(List::Cons(b?, List::Nil))

    expect empty: when l = List::Nil, h = Option::None
    expect cons: when l = List::Cons(4, List::Nil), h = Option::Some(4)
    expect literal: k = Option::Some(b?)
}

-- A wrong expectation, at an instance: the counterexample is of `Int`s.
proc wrong(x: Option<Int>): (det y: Int) {
    out y := unwrap_or(x, 0)

    expect positive: y > 0  --~ error: expectation `generic_functions::wrong::positive` does not hold
}
--@ summary: 29 passed, 1 failed, 0 inconclusive, 0 redundant
--@ exit: 1
