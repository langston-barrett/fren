-- Pattern tests, `e is P`, in both front ends.
set_option fren.lint.irrefutable_is "allow"
set_option fren.lint.match_like_membership "allow"

pub enum Shape { Circle(Int), Rect(Int, Int), Empty }

proc kinds(s: Shape): (det round?, det boxy?) {
    ensure round: round? iff s is Shape::Circle(_)
    ensure boxy: boxy? iff s is Shape::Rect(_, _) | Shape::Empty

    expect circle: when s = Shape::Circle(3), round? and not boxy?
    expect one_of: round? iff not boxy?
    expect as_match: round? iff match s { Shape::Circle(_) => true, _ => false }
    expect wrong: not boxy?  --~ error: expectation `kinds::wrong` does not hold
}

-- At the precedence of the comparisons, below `not`, `and` and `or`.
proc precedence(s: Shape, t: Shape): (det n?, det both?) {
    ensure n: n? iff not s is Shape::Circle(_)
    ensure both: both? iff s is Shape::Circle(_) and t is | Shape::Rect(_, _) | Shape::Empty

    -- One alternative per line, each after a `|`.
    expect per_line: both? iff s is Shape::Circle(_) and t is
        | Shape::Empty
        | Shape::Rect(_, _)

    expect not_outside: n? iff not (s is Shape::Circle(_))
    expect and_outside: both? iff ((s is Shape::Circle(_)) and (t is Shape::Rect(_, _) | Shape::Empty))
}

-- Variants brought into scope by `use`, and patterns that match every value.
proc imported(s: Shape): (det sized?) {
    use self::Shape::{Circle, Empty, Rect}

    ensure r: sized? iff s is Circle(_) | Rect(_, _)

    expect sized: sized? iff s != Empty
    expect every: s is Circle(_) | Rect(_, _) | Empty
    expect wildcard: s is _
}

-- Wherever a `Bool` may be written.
const CIRCLE: Bool := Shape::Circle(1) is Shape::Circle(_)

fn circle?(s: Shape) := s is Shape::Circle(_)

struct Measure { sides: Int, size: Int }

proc flagged(round?): (det sides: Int) {
    ensure r: sides = (if round? then 0 else 4)
}

proc places(s: Shape): (
    det size: Int,
    det doubled: Int,
    det round?,
    det measure: Measure,
    det by_fn?,
) {
    out round? := s is Shape::Circle(_)

    call f := flagged(s is Shape::Circle(_))

    ensure size_rule: size = (if s is Shape::Circle(_) then 1 else 2)
    ensure doubled_rule: doubled = match s { Shape::Rect(w, _) => (if s is Shape::Rect(_, _) then w else 0), _ => 0 }
    ensure measure_rule: when s is Shape::Rect(_, _) | Shape::Empty,
        measure = Measure { sides := if s is Shape::Circle(_) then 0 else 4, size }
    ensure other: unless s is Shape::Rect(_, _) | Shape::Empty, measure = Measure { sides := f.sides, size }
    ensure by_fn_rule: by_fn? iff circle?(s)

    expect constant: CIRCLE  --~ warning: this expectation mentions no variable
    expect same_fn: by_fn? iff round?
    expect sized: size = 1 iff round?
    expect sides: measure.sides = 0 iff round?
}

expect boxy: forall (p: places), p.s is Shape::Rect(_, _) | Shape::Empty iff not p.round?

-- `nonminimal_bool` keeps the parentheses that a pattern test needs, since
-- it binds as a comparison.
proc simpler(s: Shape, b?): (det ok?, det z?) {
    ensure r: ok? = if s is Shape::Circle(_) then true else false  --~ warning: write `(s is Shape::Circle(_))`
    ensure q: z? iff not ((s is Shape::Circle(_)) = b?)  --~ warning: write `(s is Shape::Circle(_)) != b?`
}

--@ summary: 49 passed, 1 failed, 0 inconclusive, 0 redundant
--@ exit: 1
