-- In a global expectation's leading `forall`, a binder whose type is a
-- component ranges over its behaviours, and one whose type is a type over
-- its values; one `forall` may have both.
-- fren-covers: lang::quantifier_binder

enum Mode { Off, Heat, Cool }

comp thermostat {
    in mode: Mode
    in cold?
    pub out heating?

    req rule: heating? iff mode = Mode::Heat and cold?
}

expect only_heat: forall (t: thermostat) (m: Mode),
    when t.mode = m and t.heating?, m = Mode::Heat
expect values_first: forall (m: Mode) (t: thermostat), when t.mode = m, (t.heating? iff (m = Mode::Heat and t.cold?))
expect values_only: forall (a? b?: Bool), (a? and b?) iff not (not a? or not b?)
expect wrong: forall (t: thermostat) (m: Mode), t.mode = m  --~ error: expectation `wrong` does not hold

--@ summary: 5 passed, 1 failed, 0 inconclusive, 0 redundant
