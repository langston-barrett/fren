-- A global expectation's leading `forall` ranges over values; one that
-- ranged over a procedure's behaviours, with values too, is written with
-- parameters and calls (`lang::quantifier_binder`).
-- fren-covers: lang::quantifier_binder

enum Mode { Off, Heat, Cool }

proc thermostat(mode: Mode, cold?): (heating?) {
    ensure rule: heating? iff mode = Mode::Heat and cold?
}

expect only_heat(t_mode: Mode, t_cold?, m: Mode) {
    call t := thermostat(t_mode, t_cold?)
    expect only_heat: when t.mode = m and t.heating?, m = Mode::Heat
}
expect values_first(m: Mode, t_mode: Mode, t_cold?) {
    call t := thermostat(t_mode, t_cold?)
    expect values_first: when t.mode = m, (t.heating? iff (m = Mode::Heat and t.cold?))
}
expect values_only: forall (a? b?: Bool), (a? and b?) iff not (not a? or not b?)  --~ warning: this expectation mentions no variable
expect wrong(t_mode: Mode, t_cold?, m: Mode) {
    call t := thermostat(t_mode, t_cold?)
    expect wrong: t.mode = m  --~ error: expectation `wrong::wrong` does not hold
}

--@ summary: 10 passed, 1 failed, 0 inconclusive, 0 redundant
