-- Global expectations written with a `forall` over procedures' behaviours,
-- as before they had parameters (F0416), in both front ends: with a fix,
-- and without one, where a procedure is in another module, or its
-- assumptions mention a variable other than its parameters.
mod m

pub proc double(x: Int): (y: Int) {
    assume small: x < 100
    ensure r: y = 2 * x
}

proc defined(x: Int): (y: Int) {
    let big? := x > 10
    assume big: big?
    ensure r: y = x
}

expect monotone: forall (a b: double), when a.x <= b.x, a.y <= b.y
--~^ error: assuming what its procedures assume
expect through_let: forall (d: defined), d.y > 10
--~^ error: so it has no fix

mod n
use m::double
expect elsewhere: forall (a: double), a.y = 2 * a.x
--~^ error: so it has no fix

mod p
const LIM: Int := 5

proc band(target: Int): (y: Int) {
    assume sane: target > LIM
    ensure r: y = target
}

proc shadowed(x: Int): (y: Int) {
    assume a1: match x { y! => y > 0 }
    ensure r: y = x
}

-- A binder over values that would hide what an assumption reads.
expect cap: forall (b: band) (LIM!: Int), when LIM < 0, b.target > 5
--~^ error: would hide, so it has no fix
-- An assumption that declares a variable of its own with `!`.
expect bang: forall (s: shadowed), s.y > 0
--~^ error: or declares a name that a parameter has, so it has no fix
-- A quantifier in the body over a procedure.
expect inner: forall (a: band), forall (b: band), a.y = b.y
--~^ error: a quantifier in its body ranges over a procedure
