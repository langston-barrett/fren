-- Global expectations written with a `forall` over procedures' behaviours,
-- as before they had parameters (F0416), in both front ends: an error
-- whose help says how to write it, and a binder over values alongside,
-- which alone would be a quantifier.
mod m

pub proc double(x: Int): (y: Int) {
    assume small: x < 100
    ensure r: y = 2 * x
}

enum Mode { Off, On }

expect monotone: forall (a b: double), when a.x <= b.x, a.y <= b.y
--~^ error: global expectations are written with parameters and calls
expect mixed: forall (a: double) (m: Mode), when m = Mode::On, a.y = 2 * a.x
--~^ error: global expectations are written with parameters and calls

mod n
use m::double
expect elsewhere: forall (a: double), a.y = 2 * a.x
--~^ error: write each binder `a: p` as parameters for `p`'s parameters and a call of `p`
