-- Precedence and associativity: each expectation holds only if the
-- guarantee parses as the manual says.
-- fren-covers: lang::operand

proc arith(x: Int, y: Int, z: Int): (a: Int, b: Int) {
    ensure left: a = x - y - z
    ensure tighter: b = x + y * 2
    expect left_assoc: a = (x - y) - z
    expect times_first: b = x + (y * 2)
}

-- `collapsible_when` would collapse the nested `when`.
set_option fren.lint.collapsible_when "allow" in
proc logic(p?, q?, r?): (o?, n?, e?) {
    ensure unary: o? iff not p? and q? or r?
    ensure nested: n? iff (when p?, when q?, r?)
    ensure loose: e? iff (p? iff q? = r?)
    expect not_binds_tightly: o? iff (((not p?) and q?) or r?)
    expect right_nested: n? iff (when p?, (when q?, r?))
    expect iff_loosest: e? iff (p? iff (q? = r?))
}
