-- Static rules for strings: methods, types, and the decidable core.
set_option fren.lint.unused_variables "allow"

proc unknown(s: String): (n: Int) { ensure r: n = s.length }
--~^ error: `String` has no method `length`
proc no_methods(b?): (p?) { ensure r: p? iff (b?).contains?(1) }
--~^ error: `Bool` has no methods, so it has no method `contains?`
proc arity(s: String): (p?) { ensure r: p? iff s.starts_with?("a", "b") }
--~^ error: `starts_with?` takes 1 argument, but 2 were given
proc arg_type(s: String): (t: String) { out t := s.at("1") }
--~^ error: type mismatch: expected `Int`, found `String`
proc unbounded(s: String) { exists t: String ensure r: t = s }
--~^ error: output `t` has the unbounded type `String`
proc concat_type(s: String): (n: Int) { out n := (s ++ 1).len }
--~^ error: type mismatch: expected `String`, found `Int`

-- Outside the decidable core.
proc search(s: String): (i: Int) { ensure r: i = s.index_of("x", 0) }
--~^ error: outside the decidable core: searching a string
proc argument(s: String, t: String): (p?) { ensure r: p? iff s.starts_with?(t) }
--~^ error: outside the decidable core: its argument is not a constant
proc position(s: String, i: Int): (t: String) { out t := s.at(i) }
--~^ error: outside the decidable core: its position is not a constant
proc words(a: String, b: String): (p?) { ensure r: p? iff a ++ b = b ++ a }
--~^ error: outside the decidable core: searching a string, or `++` here
--~^^ error: outside the decidable core: searching a string, or `++` here
proc named_words(a: String, b: String): (ab: String, p?) { out ab := a ++ b ensure r: p? iff ab = b }
--~^ error: outside the decidable core: searching a string, or `++` here
proc compare(a: String, b: String): (p?) { ensure r: p? iff a < b }
--~^ error: outside the decidable core: it compares two strings
proc output(x: Int): (n: Int) { exists o: Int let s: String := if o > x then "a" else "b" ensure r: n = s.len }
--~^ error: outside the decidable core: an operand mentions an output of an infinite type

-- Opting out.
set_option fren.lint.undecidable "allow" in
proc opted(a: String, b: String): (p?) { ensure r: p? iff a.starts_with?(b) }
proc uses(x: String) { call w := opted(x, x) }
--~^ error: `opted` is outside the decidable core, and so is what calls it
--@ exit: 2
