-- Natural numbers: what a `Nat` brings, and widening.
-- fren-covers: lang::operator_type, lang::widening, lang::literal_type, lang::nat_variable

fn count(Int): Nat
fn inc(n: Nat): Nat := n + 1

const ZERO: Nat := 0

-- An input is at least 0 by assumption; an output by guarantee.
proc counted(n: Nat, m: Int): (y: Nat) {
    exists hidden: Nat

    ensure r: y = n + hidden

    expect inputs: n >= 0
    expect outputs: y >= n
    -- Each application of a function into `Nat` is at least 0.
    expect applied: count(m) >= ZERO and count(m - 1) + count(m) >= 0
    expect bad_widening: n > m  --~ error: expectation `counted::bad_widening` does not hold
}

-- A defined output is a `Nat` by its definition; `-` gives an `Int`.
proc defined(n: Nat): (det next: Nat, det prev: Int, det mixed: Int) {
    out next := inc(n)
    out prev := n - 1
    out mixed := if n > 0 then n else -1

    expect next_positive: next >= 1
    expect prev_at_least: prev >= -1
    expect mixed_at_least: mixed >= -1
    expect prev_negative: prev >= 0  --~ error: expectation `defined::prev_negative` does not hold
}

-- No output is a `Nat` below 0.
proc unreal(n: Nat) {  --~ error: `unreal` is not realizable
    exists y: Nat
    ensure r: y = n - 1
}

-- An instance's variables are at least 0, as its component's own are.
proc user(k: Nat) {
    call w := counted(k + 1, 3)

    expect positive: w.y >= 1
}

-- A `Nat` widens where an `Int` is expected: an index, an argument, a member.
fn half(Int): Int

proc widened(q: Seq<Int>, k: Nat): (x: Int) {
    assume in_range: k < q.len
    ensure r: x = q[k] + half(k)

    expect member: when q = [3, 4], q[k] in {3, 4} and k in {0, 1}
}

-- An assumption that a `Nat` is at least 0 always holds.
proc redundant(n: Nat): (y?) {
    assume nonneg: n >= 0  --~ warning: `redundant::nonneg` is redundant: it always holds
    ensure r: y? iff n > 0

    expect zero: when n < 1, not y?
}

-- A determined `Nat` output.
proc determined(n: Nat): (det y: Nat) {
    ensure r: y + y = n + n

    expect same: y = n
}

expect outputs_grow(a_n: Nat, a_m: Int) {
    call a := counted(a_n, a_m)
    expect outputs_grow: a.y >= a.n
}

-- A refinement widens in the direction values flow. An `Int` input of the
-- concrete component serves for a `Nat` of the abstract one, and is at
-- least 0 by the abstract one's type: for `n < 0`, `shifted` breaks `floor`.
proc floor(n: Nat): (c: Int) { ensure r: c >= n }
proc shifted(n: Int): (c: Int) { ensure r: c = if n >= 0 then n else n - 1 }
expect nat_input(n: Nat) {
    call concrete := shifted(n)
    refines concrete floor(n)
}

-- A `Nat` output of the concrete component serves for an `Int`, and is at
-- least 0 by its type, as is each application of a function into `Nat`.
proc above(): (c: Int) { ensure r: c >= -1 }
proc counted_out(n: Int): (c: Nat) { ensure r: c = count(n) }
proc hidden_out(): (c: Nat) { ensure r: c != 5 }
expect nat_output(n: Int) {
    call concrete := counted_out(n)
    refines concrete above()
}
expect nat_output_typed() {
    call concrete := hidden_out()
    refines concrete above()
}

-- Determinism over an instance's variable, applied to a function into `Nat`:
-- `z` is 0 only because both `z` and `count(w.y)` are at least 0, in the
-- second copy of the behaviour as in the first.
proc applied_to_instance(k: Nat): (det z: Nat) {
    call w := counted(k, 1)

    ensure r: z = 0 or z + count(w.y) < 0
}

-- A conflict that depends on an instance's `Nat` output.
proc below_instance(k: Nat) {  --~ error: `below_instance` is not realizable
    exists x: Int
    call w := counted(k, 0)

    ensure r: x < 0 and x = w.y
}

-- A pattern test beside a `Nat`.
enum Size { Small, Big(Int) }
proc sized(n: Nat, s: Size): (big?) {
    ensure r: big? iff (n > 0 and s is Size::Big(_))

    expect positive: when big?, n >= 1
}

-- `div` and `mod` of a `Nat` by a positive constant are `Nat`s, as are `min`
-- and `max` of `Nat`s; by a negative constant, and `abs`, they are `Int`s.
const HALF: Nat := 2
proc divided(n: Nat, m: Nat, x: Int): (
    halved_n: Nat,
    rest: Nat,
    low: Nat,
    high: Nat,
    neg: Int,
    size: Int,
) {
    out halved_n := n div HALF
    out rest := n mod 3
    out low := n.min(m)
    out high := n.max(7)
    out neg := n div -2
    out size := n.abs + x.min(n)

    expect bounded: rest < 3 and low <= m and high >= 7 and neg <= 0
    expect halved: halved_n + halved_n <= n
    expect sized: size <= n + n
}

-- A chained comparison widens a `Nat`.
proc chained_nat(n: Nat, q: Seq<Int>): (inside?) {
    ensure r: inside? iff 0 <= n < q.len

    expect nonempty: when inside?, q != []
}

-- `{}` takes its type from the other branch, as without `Nat`s.
proc empty_branch(c?, s: Set<Int>, n: Nat): (t: Set<Int>) {
    out t := if c? then {} else s

    expect member: when not c? and n in s, n in t
}

