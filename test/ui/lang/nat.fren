-- Natural numbers: what a `Nat` brings, and widening.
-- fren-covers: lang::operator_type, lang::widening, lang::literal_type, lang::nat_variable

fn count(Int): Nat
fn inc(n: Nat): Nat := n + 1

const ZERO: Nat := 0

-- An input is at least 0 by assumption; an output by requirement.
comp counted {
    in n: Nat
    in m: Int
    pub out y: Nat
    out hidden: Nat

    req r: y = n + hidden

    expect inputs: n >= 0
    expect outputs: y >= n
    -- Each application of a function into `Nat` is at least 0.
    expect applied: count(m) >= ZERO and count(m - 1) + count(m) >= 0
    expect bad_widening: n > m   --~ error: expectation `counted::bad_widening` does not hold
}

-- A defined output is a `Nat` by its definition; `-` gives an `Int`.
comp defined {
    in n: Nat
    pub det out next: Nat := inc(n)
    pub det out prev: Int := n - 1
    pub det out mixed: Int := if n > 0 then n else -1

    expect next_positive: next >= 1
    expect prev_at_least: prev >= -1
    expect mixed_at_least: mixed >= -1
    expect prev_negative: prev >= 0   --~ error: expectation `defined::prev_negative` does not hold
}

-- No output is a `Nat` below 0.
comp unreal {   --~ error: `unreal` is not realizable: for the input n = 0, no outputs satisfy `r`
    in n: Nat
    out y: Nat
    req r: y = n - 1   --~ info: is false when n = 0
}

-- An instance's variables are at least 0, as its component's own are.
comp user {
    in k: Nat
    inst w: counted { n := k + 1, m := 3 }

    expect positive: w.y >= 1
}

-- A `Nat` widens where an `Int` is expected: an index, an argument, a member.
fn half(Int): Int

comp widened {
    in q: Seq(Int)
    in k: Nat
    pub out x: Int

    assume in_range: k < q.len
    req r: x = q[k] + half(k)

    expect member: when q = [3, 4], q[k] in {3, 4} and k in {0, 1}
}

-- An assumption that a `Nat` is at least 0 always holds.
comp redundant {
    in n: Nat
    pub out y?

    assume nonneg: n >= 0   --~ warning: `redundant::nonneg` is redundant: it always holds
    req r: y? iff n > 0

    expect zero: when n < 1, not y?
}

-- A determined `Nat` output.
comp determined {
    in n: Nat
    pub det out y: Nat

    req r: y + y = n + n

    expect same: y = n
}

expect outputs_grow: forall (a: counted), a.y >= a.n

-- A refinement reads a `Nat` of the concrete component where the abstract
-- one has an `Int`, and the applications of its components' functions are
-- at least 0.
comp loose { in n: Int pub out c: Int req r: c >= n }
comp tight { in n: Nat pub out c: Nat req r: c = n + count(n) }
refine tightened: tight refines loose

-- Determinism over an instance's variable, applied to a function into `Nat`.
comp applied_to_instance {
    in k: Nat
    inst w: counted { n := k, m := 1 }
    pub det out z: Nat

    req r: z + count(w.y) = count(w.y) + k
}

-- A conflict that depends on an instance's `Nat` output.
comp below_instance {   --~ error: `below_instance` is not realizable
    in k: Nat
    inst w: counted { n := k, m := 0 }
    out x: Int

    req r: x < 0 and x = w.y   --~ info: is false when
}

-- A pattern test beside a `Nat`.
enum Size { Small, Big(Int) }
comp sized {
    in n: Nat
    in s: Size
    pub out big?

    req r: big? iff (n > 0 and s is Size::Big(_))

    expect positive: when big?, n >= 1
}

-- `{}` takes its type from the other branch, as without `Nat`s.
comp empty_branch {
    in c?
    in s: Set(Int)
    in n: Nat
    pub out t: Set(Int) := if c? then {} else s

    expect member: when not c? and n in s, n in t
}

--@ summary: 46 passed, 4 failed, 0 inconclusive, 1 redundant
--@ exit: 1
