-- Natural numbers: what a `Nat` brings, and widening.
-- fren-covers: lang::operator_type, lang::widening, lang::literal_type, lang::nat_variable

fn count(Int): Nat
fn inc(n: Nat): Nat := n + 1

const ZERO: Nat := 0

-- An input is at least 0 by assumption; an output by requirement.
comp counted {
    in n: Nat
    in m: Int
    pub out y: Nat
    out hidden: Nat

    req r: y = n + hidden

    expect inputs: n >= 0
    expect outputs: y >= n
    -- Each application of a function into `Nat` is at least 0.
    expect applied: count(m) >= ZERO and count(m - 1) + count(m) >= 0
    expect bad_widening: n > m   --~ error: expectation `counted::bad_widening` does not hold
}

-- A defined output is a `Nat` by its definition; `-` gives an `Int`.
comp defined {
    in n: Nat
    pub det out next: Nat := inc(n)
    pub det out prev: Int := n - 1
    pub det out mixed: Int := if n > 0 then n else -1

    expect next_positive: next >= 1
    expect prev_at_least: prev >= -1
    expect mixed_at_least: mixed >= -1
    expect prev_negative: prev >= 0   --~ error: expectation `defined::prev_negative` does not hold
}

-- No output is a `Nat` below 0.
comp unreal {   --~ error: `unreal` is not realizable: for the input n = 0, no outputs satisfy `r`
    in n: Nat
    out y: Nat
    req r: y = n - 1   --~ info: is false when n = 0
}

-- An instance's variables are at least 0, as its component's own are.
comp user {
    in k: Nat
    inst w: counted { n := k + 1, m := 3 }

    expect positive: w.y >= 1
}

-- A `Nat` widens where an `Int` is expected: an index, an argument, a member.
fn half(Int): Int

comp widened {
    in q: Seq(Int)
    in k: Nat
    pub out x: Int

    assume in_range: k < q.len
    req r: x = q[k] + half(k)

    expect member: when q = [3, 4], q[k] in {3, 4} and k in {0, 1}
}

-- An assumption that a `Nat` is at least 0 always holds.
comp redundant {
    in n: Nat
    pub out y?

    assume nonneg: n >= 0   --~ warning: `redundant::nonneg` is redundant: it always holds
    req r: y? iff n > 0

    expect zero: when n < 1, not y?
}

-- A determined `Nat` output.
comp determined {
    in n: Nat
    pub det out y: Nat

    req r: y + y = n + n

    expect same: y = n
}

expect outputs_grow: forall (a: counted), a.y >= a.n

--@ summary: 31 passed, 3 failed, 0 inconclusive, 1 redundant
--@ exit: 1
