-- Types and the `in`/`out` discipline.
-- fren-covers: lang::operator_type

enum E { A }

proc nonlinear(x: Int): (y: Int) { ensure r: y = x * x }   --~ error: nonlinear arithmetic is not supported
proc linear(x: Int): (y: Int) { ensure r: y = 2 * x - x * (-3) }
proc on_out(x: Int): (y: Int) { assume a: y > 0 }       --~ error: assumptions may only mention parameters, but `y` is an output

proc mismatch(x: Int) { ensure r: x + true = 1 }
--~^ error: type mismatch: expected `Int`, found `Bool`
proc compare(e: E) { ensure r: e = 1 }
--~^ error: cannot compare `E` with `Int`
proc branches(c?): (y: Int) { ensure r: y = if c? then 1 else true }
--~^ error: the branches of `if` have different types: `Int` and `Bool`
proc condition(x: Int): (y: Int) { ensure r: y = if x then 1 else 2 }
--~^ error: type mismatch: expected `Bool`, found `Int`

-- Each operator's operands, as both front ends check them, at the operand
-- (`lang::operator_type`, `lang::conditional`).
proc and_int(x: Int): (p?) { ensure r: p? iff x and true }
--~^ error: type mismatch: expected `Bool`, found `Int`
proc not_int(x: Int): (p?) { ensure r: p? iff not x }
--~^ error: type mismatch: expected `Bool`, found `Int`
proc when_int(x: Int): (p?) { ensure r: p? iff (when x, true) }
--~^ error: type mismatch: expected `Bool`, found `Int`
proc plus_bool(b?): (y: Int) { ensure r: y = b? + 1 }
--~^ error: type mismatch: expected `Int`, found `Bool`
proc neg_bool(b?): (y: Int) { ensure r: y = -b? }
--~^ error: type mismatch: expected `Int`, found `Bool`
proc lt_bool(b?): (p?) { ensure r: p? iff b? < 1 }
--~^ error: type mismatch: expected `Int`, found `Bool`
proc set_branches(c?, s: Set<Int>, t: Set<String>): (y: Int) { ensure r: y = (if c? then s else t).card }
--~^ error: the branches of `if` have different types: `Set<Int>` and `Set<String>`
proc union_int(x: Int, s: Set<Int>): (p?) { ensure r: p? iff s = x union s }
--~^ error: type mismatch: expected `Set<Int>`, found `Int`
proc subset_types(s: Set<Int>, t: Set<String>): (p?) { ensure r: p? iff s subset t }
--~^ error: type mismatch: expected `Set<Int>`, found `Set<String>`
proc concat_types(q: Seq<Int>, u: Seq<String>): (y: Int) { ensure r: y = (q ++ u).len }
--~^ error: type mismatch: expected `Seq<Int>`, found `Seq<String>`
proc chain_bool(b?): (p?) { ensure r: p? iff 0 <= b? < 3 }
--~^ error: type mismatch: expected `Int`, found `Bool`
proc div_bool(b?): (y: Int) { ensure r: y = b? div 2 }
--~^ error: type mismatch: expected `Int`, found `Bool`
-- A comparison is a `Bool` in both front ends, never a `Prop`.
proc div_comparison(x: Int): (y: Int) { ensure r: y = (x > 0) div 2 }
--~^ error: type mismatch: expected `Int`, found `Bool`
proc and_note(x: Int): (p?) { ensure r: p? iff x and true }
--~^ error: the operands of `and` are `Bool`s
proc branches_note(c?): (y: Int) { ensure r: y = if c? then 1 else true }
