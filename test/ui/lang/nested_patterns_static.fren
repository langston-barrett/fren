-- Static rules for nested, literal and range patterns, in both front ends.
set_option fren.lint.dead_code "allow"
set_option fren.lint.unused_variables "allow"

enum Shape { Circle(Int), Square(Int), Empty }
enum Reply { Ok(Shape), Err(Int) }
enum B { X, Y }
enum Wide { V(B, B, B, B, B, B, B, B, B) }
const MAX: Int := 9
const NAME: String := "a"

const LENGTH: Int := "abc".len

proc missing_nested(r: Reply): (z: Int) { ensure q: z = match r { Reply::Ok(Shape::Circle(_)) => 0, Reply::Err(_) => 1 } }
--~^ error: non-exhaustive match: `Reply::Ok(Shape::Square(_))`, `Reply::Ok(Shape::Empty)` not covered
proc missing_int(r: Reply): (z: Int) { ensure q: z = match r { Reply::Ok(_) => 0, Reply::Err(..=-1) => 1, Reply::Err(1..) => 2 } }
--~^ error: non-exhaustive match: `Reply::Err(0)` not covered
proc missing_bool(b?): (z: Int) { ensure q: z = match b? { true => 0 } }
--~^ error: non-exhaustive match: `false` not covered
proc missing_string(s: String): (z: Int) { ensure q: z = match s { "a" => 0, "b" => 1 } }
--~^ error: non-exhaustive match: `_` not covered
proc missing_ranges(n: Int): (z: Int) { ensure q: z = match n { ..=0 => 0, 2.. => 1 } }
--~^ error: non-exhaustive match: `1` not covered
proc missing_nat(k: Nat): (z: Int) { ensure q: z = match k { 0 => 0, 2.. => 1 } }
--~^ error: non-exhaustive match: `1` not covered
proc negative_nat(k: Nat): (z: Int) { ensure q: z = match k { ..=-1 => 0, _ => 1 } }
--~^ error: unreachable arm
proc within(n: Int): (z: Int) { ensure q: z = match n { 0..=9 => 0, 5 => 1, _ => 2 } }
--~^ error: unreachable arm
proc covered_bool(b?): (z: Int) { ensure q: z = match b? { true => 0, false => 1, _ => 2 } }
--~^ error: unreachable arm
proc after_binder(n: Int): (z: Int) { ensure q: z = match n { k => k, 0 => 1 } }
--~^ error: unreachable arm
proc inner_alternative(r: Reply): (z: Int) { ensure q: z = match r { Reply::Ok(Shape::Empty | Shape::Empty) => 0, _ => 1 } }
--~^ error: unreachable pattern
proc inner_binder(r: Reply): (z: Int) { ensure q: z = match r { Reply::Ok(Shape::Circle(n) | Shape::Square(_)) => 0, _ => 1 } }
--~^ error: an or-pattern cannot bind `n`
proc twice(r: Reply): (z: Int) { ensure q: z = match r { Reply::Ok(Shape::Circle(n)) | Reply::Err(n) => n, _ => 0 } }
--~^ error: an or-pattern cannot bind `n`
proc wrong_literal(n: Int): (z: Int) { ensure q: z = match n { "a" => 0, _ => 1 } }
--~^ error: expected a pattern of `Int`, but this is a pattern of `String`
proc wrong_variant(n: Int): (z: Int) { ensure q: z = match n { Shape::Empty => 0, _ => 1 } }
--~^ error: expected a pattern of `Int`, but this is a pattern of `Shape`
proc wrong_payload(r: Reply): (z: Int) { ensure q: z = match r { Reply::Err(true) => 0, _ => 1 } }
--~^ error: expected a pattern of `Int`, but this is a pattern of `Bool`
proc wrong_range(s: String): (z: Int) { ensure q: z = match s { 0..=9 => 0, _ => 1 } }
--~^ error: expected a pattern of `String`, but this is a pattern of `Int`
proc empty_range(n: Int): (z: Int) { ensure q: z = match n { 9..=0 => 0, _ => 1 } }
--~^ error: the range `9..=0` matches no integer
proc empty_exclusive(n: Int): (z: Int) { ensure q: z = match n { MAX..9 => 0, _ => 1 } }
--~^ error: the range `MAX..9` matches no integer
proc variable_bound(n: Int, m: Int): (z: Int) { ensure q: z = match n { 0..=m => 0, _ => 1 } }
--~^ error: a range's bound must be an integer or a constant of `Int` or `Nat`, but this is a variable
proc string_bound(n: Int): (z: Int) { ensure q: z = match n { 0..=NAME => 0, _ => 1 } }
--~^ error: a range's bound must be an integer or a constant of `Int` or `Nat`, but this is a constant of `String`
proc unknown_value(n: Int): (z: Int) { ensure q: z = match n { 0..=LENGTH => 0, _ => 1 } }
--~^ error: the value of `LENGTH` is not known where the range is checked
proc constant_binder(n: Int): (z: Int) { ensure q: z = match n { MAX => 0 } }
--~^ error: `MAX` shadows the constant `MAX`
proc is_nothing(k: Nat): (z?) { ensure q: z? iff k is -5..=-1 }
--~^ error: unreachable pattern
proc is_nothing_or(k: Nat): (z?) { ensure q: z? iff k is -1 | -2 }
--~^ error: unreachable pattern
proc not_matched(s: Set<Int>): (z: Int) { ensure q: z = match s { _ => 0 } }
--~^ error: cannot match on `Set<Int>`
proc is_binder(r: Reply): (z?) { ensure q: z? iff r is Reply::Ok(Shape::Circle(n)) }
--~^ error: a pattern test cannot bind `n`
proc is_alternative(n: Int): (z?) { ensure q: z? iff n is 0..=9 | 5 }
--~^ error: unreachable pattern
proc is_set(s: Set<Int>): (z?) { ensure q: z? iff s is _ }
--~^ error: cannot test `Set<Int>` against a pattern

proc too_many(w: Wide): (z: Int) {
    ensure q: z = match w {
        Wide::V(B::X | B::Y, B::X | B::Y, B::X | B::Y, B::X | B::Y, B::X | B::Y, B::X | B::Y, B::X | B::Y, B::X | B::Y, B::X | B::Y) => 0,
        --~^ error: this pattern stands for 512 cases, more than 256
        _ => 1,
    }
}
proc too_many_is(w: Wide): (z?) { ensure q: z? iff w is Wide::V(B::X | B::Y, B::X | B::Y, B::X | B::Y, B::X | B::Y, B::X | B::Y, B::X | B::Y, B::X | B::Y, B::X | B::Y, B::X | B::Y) }
--~^ error: this pattern stands for 512 cases, more than 256

--@ exit: 2
