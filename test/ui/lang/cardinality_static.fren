-- Static rules for the cardinality operators: each argument is a `Bool`,
-- there is at least one, and their names are reserved.
-- fren-covers: lang::cardinality_args
set_option fren.lint.unused_variables "allow"
set_option fren.lint.dead_code "allow"

enum Mode { Off, On }

comp int_argument { in a? in x: Int expect e: exactly_one?(a?, x) }
--~^ error: type mismatch: expected `Bool`, found `Int`
comp nat_argument { in a? in n: Nat expect e: at_most_one?(n, a?) }
--~^ error: type mismatch: expected `Bool`, found `Nat`
comp enum_argument { in m: Mode expect e: exactly_one?(m) }
--~^ error: type mismatch: expected `Bool`, found `Mode`
comp string_argument { in a? expect e: at_most_one?(a?, a?, "yes") }
--~^ error: type mismatch: expected `Bool`, found `String`
comp sum_argument { in x: Int expect e: exactly_one?(x + 1 > 0, x + 1) }
--~^ error: type mismatch: expected `Bool`, found `Int`
comp empty_argument { expect e: exactly_one?({}) }
--~^ error: type mismatch: expected `Bool`, found `{}`
comp empty_sequence_argument { in a? expect e: at_most_one?(a?, []) }
--~^ error: type mismatch: expected `Bool`, found `[]`
comp no_arguments { expect e: exactly_one?() }
--~^ error: `exactly_one?` needs at least one argument
comp no_arguments_operand { in a? expect e: a? or at_most_one?() }
--~^ error: `at_most_one?` needs at least one argument
comp result_typed { in a? in n: Int expect e: n.max(exactly_one?(a?)) > 0 }
--~^ error: type mismatch: expected `Int`, found `Bool`
comp unapplied { in a? expect e: exactly_one? }
--~^ error: function `exactly_one?` must be applied to arguments
comp qualified { in a? expect e: self::at_most_one?(a?) }
--~^ error: cannot find `at_most_one?`

-- The names are reserved: no function is named so, and a variable that is
-- shadows the built-in function, with `!`.
fn exactly_one?(x: Int): Bool := x > 0
--~^ error: `exactly_one?` is a built-in function and cannot be redefined
fn at_most_one?(Int)
--~^ error: `at_most_one?` is a built-in function and cannot be redefined
comp implicit_shadow { in exactly_one? expect e: exactly_one? }
--~^ error: `exactly_one?` shadows the built-in function `exactly_one?`
comp variable_applied { in exactly_one?! expect e: exactly_one?(exactly_one?) }
--~^ error: expected a function, but `exactly_one?` is a variable

--@ exit: 2
