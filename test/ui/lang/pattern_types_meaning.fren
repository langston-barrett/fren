-- What pattern types bring: fields, payloads, `Nat`s within values,
-- collections, recursive enumerations, quantifiers and refinements.
-- fren-covers: lang::pattern_finite, lang::nat_place

type Byte = subset_value: Int where invariant: subset_value is 0..=255
type Digit = subset_value: Int where invariant: subset_value is 0..=9

-- A record's fields and an enumeration's payloads bring their constraints,
-- however deep, and a `Nat` within one is at least 0.
struct Stock { item: Byte, count: Nat }
enum Reading { Raw(Stock), Missing }
type SubsetPatternTypesMeaning1 = subset_value?: Bool where invariant: subset_value?
struct Flag { on?: SubsetPatternTypesMeaning1 }

proc stocked(r: Reading, a: Flag, b: Flag) {
    expect deep: match r { Reading::Raw(s) => s.item <= 255 and s.count >= 0, Reading::Missing => true }
    expect same: a = b
}

-- A newtype of a pattern type.
type SubsetPatternTypesMeaning2 = subset_value: Int where invariant: subset_value is 1..=3
struct Level(SubsetPatternTypesMeaning2)

proc levels(l: Level): (y: Int) {
    ensure r: y = l.0 + 1

    expect high: y <= 4
}

-- A quantifier ranges over a bounded pattern type.
type SubsetPatternTypesMeaning3 = subset_value: Int where invariant: subset_value is 0..=7
proc digits(d: Digit) {
    expect all: forall (k: Digit), k + d <= 18
    expect some: exists (k: SubsetPatternTypesMeaning3), k = 7 and k > d - 3
    expect one: d < 10
}

-- Elements bring their constraint for every element, outside the
-- decidable core.
set_option fren.lint.undecidable "allow" in
proc collections(s: Set<Digit>, q: Seq<Digit>) {
    expect members: 12 in s or s != {}   --~ error: expectation `collections::members` does not hold
    expect index: when q != [], q[0] <= 9
    expect no_twelve: not 12 in s
}

-- A recursive enumeration's payload brings its constraint where it is read.
set_option fren.lint.undecidable "allow" in
enum Chain { End, Link(Digit, Chain) }

proc chained(c: Chain) {
    expect heads: match c { Chain::Link(d, Chain::Link(e, _)) => d + e <= 18, _ => true }
}

-- A global expectation's parameters bring their types' constraints.
expect positive(a_l: Level) {
    call a := levels(a_l)
    expect positive: a.l.0 >= 1
}

-- A refinement assumes what the abstract component's inputs bring, and
-- checks what the concrete one's do.
type SubsetPatternTypesMeaning4 = subset_value: Int where invariant: subset_value is 0..=9
proc abstract_lvl(n: SubsetPatternTypesMeaning4): (y: Int) { ensure r: y >= n }
type SubsetPatternTypesMeaning5 = subset_value: Int where invariant: subset_value is 0..
proc concrete_lvl(n: SubsetPatternTypesMeaning5): (y: Int) { ensure r: y = n }
refine narrower: concrete_lvl refines abstract_lvl
