-- Static rules for patterns.
set_option fren.lint.unused_variables "allow"

proc c0(s: String, p: String): (a?) { ensure r: a? iff s.matches?(p) }
--~^ error: the argument of `matches?` must be a string literal
proc c1(s: String, p: String): (a?) { ensure r: a? iff s.matches?(r"[z-a]") }
--~^ error: the range `z-a` in a pattern is reversed
proc c2(s: String, p: String): (a?) { ensure r: a? iff s.matches?(r"^a") }
--~^ error: invalid pattern: patterns have no anchors
proc c3(s: String, p: String): (a?) { ensure r: a? iff s.matches?(r"\d+") }
--~^ error: invalid pattern: unknown escape
proc c4(s: String, p: String): (a?) { ensure r: a? iff s.matches?(r"(a") }
--~^ error: invalid pattern: unclosed `(`
proc c5(s: String, p: String): (a?) { ensure r: a? iff s.matches?(r"[]") }
--~^ error: invalid pattern: an empty class matches no character
--@ exit: 2
