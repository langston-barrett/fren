-- Name resolution and visibility (`modules::resolve`, `modules::item_visible`).
-- fren-covers: modules::two_segments, lang::path_shape, lang::declared_before

pub enum E { A, B }
pub enum F { A, C }
use E::*   --~ warning: `use E::*` imports every variant of `E`
use F::*   --~ warning: `use F::*` imports every variant of `F`
use E::*   -- opening `E` again does not make its variants ambiguous
--~^ warning: unused import `E::*`
--~^^ warning: `use E::*` imports every variant of `E`

proc ambiguous(e: E) { ensure r: e = A }   --~ error: `A` is ambiguous: it could be any of `E::A`, `F::A`
proc unknown(): (y: Int) { ensure r: y = z }  --~ error: cannot find `z` in this scope
proc qualified(e: E, f: F): (o?) { ensure r: o? iff (e = B or f = C or e = E::A) }
proc not_a_value(e: E) { ensure r: e = E }  --~ error: expected a value, but `E` is an enum
proc not_a_type(x: qualified) {}        --~ error: expected a type, but `qualified` is a procedure
proc no_variant(e: E) { ensure r: e = E::Z }  --~ error: no variant `Z` in enum `E`

use qualified::*    --~ error: only enums can be opened with `*`, but `qualified` is a procedure
use nothing::here   --~ error: cannot find `nothing` in the root module
use E               --~ error: the name `E` is already defined in the root module

mod a
enum Hidden { H }
pub enum Shown { S }

mod a::inner
use a::Hidden
proc sees_parent(h: Hidden) {}  --~ warning: unused variable `h`

mod b
use a::Hidden       --~ error: `Hidden` is private to module `a`
use a::Shown
use a::Shown        --~ error: the name `Shown` is already imported into module `b`
use self::Missing   --~ error: cannot find `Missing` in module `b`
proc sees_pub(s: Shown) {}      --~ warning: unused variable `s`
use a::self::Shown  --~ error: cannot find `self` in module `a`
proc uses_later(x: Later) {}    --~ error: cannot find `Later` in this scope
enum Later { L }                   --~ warning: enum `Later` is never used

--@ exit: 2
