-- `let` and `where` (`Reqs/Lang/Let`): names that stand for their definitions.
-- fren-covers: lang::definition_order, lang::definition_type, lang::definition_form

-- Some bodies are only their last definition's name, to test where a
-- definition can be written.
set_option fren.lint.let_and_return "allow"

enum Mode { Off, Heat }
use self::Mode::{Heat, Off}

pub comp thermostat {
    in temp: Int
    in target: Int
    pub out mode: Mode

    -- A `where` clause is in scope in the trigger and the body.
    ensure heat: when cold?, mode = Heat
        where margin := 2, cold? := temp < target - margin
    ensure idle: unless cold?, mode = Off where cold? := temp < target - 2

    -- A `let` within part of an expression, and a later definition that
    -- mentions an earlier one.
    expect bounded: mode = Heat iff (let lo := target - 2, hi: Int := lo in temp < hi)
    -- Shadowing an earlier name of the same clause.
    expect shadowed: let x := target, x! := x - 2 in when temp < x, mode = Heat
    -- A chained comparison in a definition.
    expect chained: let sane? := 0 <= temp < 200 in when sane?, temp >= 0
    -- A membership in a definition, in parentheses.
    expect member: let known? := (mode in {Off, Heat}) in known?
}

-- A trigger is read through a `where` clause: this one can never hold, so
-- it is vacuous.
comp vacuous {
    in x: Int
    pub out y?

    ensure r: when big? and not big?, y? where big? := x > 0
    --~^ error: is vacuous
}

-- A defined output, a function's body, a constant and a global expectation
-- take a `where` clause too.
pub fn clamp(n: Int): Int := if n < lo then lo else n where lo := 0
--~^ warning: this conditional is `max`

pub const LIMIT: Int := base + 1 where base := 9

comp defined {
    in a: Int
    pub out b: Int := c + c where c := clamp(a)

    expect positive: b >= 0
    expect limit: b + LIMIT >= 10
}

expect same_mode: forall (p q: thermostat), when same?, p.mode = q.mode
    where same? := p.temp = q.temp and p.target = q.target

-- An index in a definition is guarded where its name is mentioned, as if
-- the definition were written there.
comp guarded {
    in q: Seq(Int)
    pub out first: Int

    ensure r: let head := q[0] in when q != [], first = head
    expect e: when q != [], first = q[0]
}

-- Unguarded where it is mentioned, the index may be out of range.
comp unguarded {
    in q: Seq(Int)
    pub out first: Int

    ensure r: first = head where head := q[0]
    --~^ error: may be out of range
}

-- An unused definition has no effect, not even on definedness.
comp unused {
    in q: Seq(Int)
    pub out n: Int

    ensure r: n = 1 where head := q[0]  --~ warning: unused definition `head`
}

-- A `let` nested in a definition takes its own `in`: in an `if`, whose
-- condition and `then` branch are delimited, in a `match` and in brackets.
comp nested {
    in x: Int
    in m: Mode
    pub out y: Int

    ensure r: y = x
    expect then_branch: let a := if x > 0 then let b := 1 in b else 2 in a > 0
    expect else_branch: let a := if x > 0 then 1 else let b := 2 in b in a > 0
    expect condition: let a := if x in {1, 2} then 1 else 0 in a >= 0
    expect scrutinee: let n := match (let z := m in z) { Off => 0, Heat => 1 } in n >= 0
    expect arm: let n := match m { Off => (let z := 0 in z), Heat => 1 } in n >= 0
    expect brackets: let s := {(let z := 1 in z), x} in x in s
}

-- A name mentioned under two different guards: each mention is guarded by
-- its own.
comp twice {
    in q: Seq(Int)
    pub out first: Int

    ensure r: let h := q[0] in (when q != [], first = h) and (when q = [], first = 0)
}

-- A definition put under a `match` arm whose binder shadows one it
-- mentions still means the outer binder.
enum Shape { C(Int), E }

comp renamed {
    in s: Shape
    in t: Shape
    pub out ok?

    ensure r: ok?
    expect inner: match s {
        Shape::C(n) => (let a := n + 1 in match t { Shape::C(n!) => a = n + 1, _ => true }),
        _ => true,
    }
    --~^^^^ error: `renamed::inner` does not hold
}

--@ summary: 41 passed, 3 failed, 0 inconclusive, 0 redundant
--@ exit: 1
