-- Several static errors in each of two items: neither front end checks
-- anything, not even `clean`, which has none and is unrealizable, and both
-- say so without counting the errors (see `Reqs/View`).
comp first {
    in x: Int
    pub out y: Int
    ensure a: y = x * x  --~ error: nonlinear arithmetic is not supported
    ensure b: y = nope  --~ error: cannot find `nope` in this scope
}

comp second {
    in x: Int
    pub out y: Int
    ensure a: y = x * x  --~ error: nonlinear arithmetic is not supported
    ensure b: y = x * y  --~ error: nonlinear arithmetic is not supported
}

comp clean {
    in x: Int
    pub out y: Int
    ensure a: y = x
    ensure b: y = x + 1
}
