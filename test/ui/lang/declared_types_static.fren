-- An expression where a type is declared: both front ends report one of
-- another type at the expression, with a note naming the declared type
-- (`lang::widening`, `lang::arm_type`).
set_option fren.lint.dead_code "allow"

type Name
fn arity(Name): Int
fn twice(n: Int): Int := 2 * n
struct P { x: Int, y: Int }
enum S { A(Int), B }

proc sub(x: Int): (z: Int) { ensure r: z = x }

proc argument(b?): (y: Int) { ensure r: y = twice(b?) }
--~^ error: argument 1 of `twice` has type `Int`
proc abstract_argument(): (y: Int) { ensure r: y = arity(1) }
--~^ error: argument 1 of `arity` has type `Name`
proc payload(b?): (s: S) { ensure r: s = S::A(b?) }
--~^ error: value 1 of the payload of `S::A` has type `Int`
proc field(b?): (p: P) { ensure r: p = P { x := b?, y := 0 } }
--~^ error: `x` of `P` has type `Int`
proc update(p: P, b?): (o: P) { ensure r: o = { p with y := b? } }
--~^ error: `y` of `P` has type `Int`
proc binding(b?) { call w := sub(b?) }
--~^ error: `x` of `sub` has type `Int`
proc definition(b?): (d: Int) { out d := b? }
--~^ error: `d` has type `Int`, so its definition must too
proc constraint(x: Int) { ensure r: x + 1 }
--~^ error: a constraint is a `Bool`
proc assumption(x: Int) { assume a: x }
--~^ error: a constraint is a `Bool`
proc expectation(x: Int) { expect e: x - 1 }
--~^ error: a constraint is a `Bool`
proc goal(x: Int) { cover g: x }
--~^ error: a constraint is a `Bool`
const K: Int := true
--~^ error: `K` has type `Int`
fn result?(n: Int) := n
--~^ error: `result?` returns `Bool`
expect global(w_x: Int) {
    call w := sub(w_x)
    expect global: w.z
}
--~^ error: an expectation is a `Bool`

-- A `Nat` widens to an `Int` wherever one is declared, as in a record
-- update; an `Int` is never narrowed to a `Nat`.
proc nat_update(p: P, n: Nat): (o: P) { ensure r: o = { p with x := n } }
proc nat_definition(x: Int): (d: Nat) { out d := x }
--~^ error: `d` has type `Nat`, so its definition must too

-- The arms of a `match` have one type, after widening.
proc nat_arms(s: S, n: Nat): (y: Int) { ensure r: y = match s { S::A(a) => a, S::B => n } }
proc arms(s: S): (y: Int) { ensure r: y = match s { S::A(a) => a, S::B => "b" } }
--~^ error: the arms of `match` have different types: `Int` and `String`
proc arms_note(s: S): (y: Int) { ensure r: y = match s { S::A(a) => a, S::B => true } }
--~^ error: so all must have the same type, or be `Nat`s and `Int`s

-- A branch `{}` takes its type from the other branch.
proc empty_set(c?, t: Set<Int>): (s: Set<Int>) { out s := if c? then {} else t }
proc empty_branch_set(c?, t: Set<Int>): (y: Int) { out y := if c? then {} else t }
--~^ error: type mismatch: expected `Int`, found `Set<Int>`
proc empty_branch_and(b?, c?, t: Set<Int>): (p?) { ensure r: p? iff b? and (if c? then {} else t) }
--~^ error: type mismatch: expected `Bool`, found `Set<Int>`

--@ exit: 2
