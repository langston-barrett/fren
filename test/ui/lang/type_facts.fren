-- The facts of types over their constituents: a pattern type whose
-- pattern matches finitely many integers is finite, and so is a type built
-- from it; a newtype over a finite type is listed, as a record is.
-- fren-covers: lang::type_facts, lang::quantified_type
mod type_facts

set_option fren.lint.assertions_on_constants "allow"
set_option fren.lint.struct_field_names "allow"
set_option fren.lint.eq_op "allow"

type SubsetTypeFacts1 = subset_value: Int where invariant: subset_value is 0..=3
struct P { x: SubsetTypeFacts1 }
type SubsetTypeFacts2 = subset_value: Int where invariant: subset_value is 0..=2
enum Small { S(SubsetTypeFacts2), T }
struct Pair<A, B> { fst: A, snd: B }
enum Maybe<T> { Nothing, Just(T) }
struct Flag(Bool)
struct Count(Int)

expect fields: forall (p: P), p.x <= 3
expect payloads: forall (s: Small), (match s { Small::S(n) => n <= 2, Small::T => true })
type SubsetTypeFacts3 = subset_value: Int where invariant: subset_value is 0..=2
expect maybes: forall (o: Maybe<SubsetTypeFacts3>), o != Maybe::Just(3)
type SubsetTypeFacts4 = subset_value: Int where invariant: subset_value is 1..=2
expect pairs: forall (p: Pair<Bool, SubsetTypeFacts4>), p.snd >= 1
expect flags: forall (f: Flag), f = Flag(true) or f = Flag(false)
expect flag_count: exists (f: Flag), f.0
expect too_big: forall (p: P), p.x < 3    --~ error: expectation `type_facts::too_big` does not hold

-- A newtype over an infinite type is not listed.
set_option fren.lint.undecidable "warn" in
proc counts(): (ok?) {
    ensure r: ok? iff (forall (c: Count), c = c)    --~ warning: this is outside the decidable core: a quantifier over a type whose values cannot be listed
}
