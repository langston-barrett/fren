-- Static rules for quantifiers: the types they expand, how many instances
-- they have, and their bound names. A quantifier over any other type is
-- unbounded, and outside the decidable core, which `undecidable` reports at
-- its binder.
-- fren-covers: lang::quantified_type, lang::quantifier_size
set_option fren.lint.eq_op "allow"

enum Method { Len, Card, Rev }
enum Byte { B(Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool) }
enum Nine { N(Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool) }
enum Tree { Leaf, Node(Tree) }
enum Boxed { Box(Int) }
struct Pair { a?, b? }
type Name

proc valid(): (ok?) { ensure r: ok? }

proc ints(): (ok?) {
    ensure r: ok? iff (forall (n: Int), n = n)    --~ error: this is outside the decidable core: a quantifier over a type whose values cannot be listed
}

proc nats(): (ok?) {
    ensure r: ok? iff (forall (n: Nat), n = n)    --~ error: this is outside the decidable core: a quantifier over a type whose values cannot be listed
}

proc strings(): (ok?) {
    ensure r: ok? iff (exists (s: String), s = "")  --~ error: this is outside the decidable core: a quantifier over a type whose values cannot be listed
}

proc names(): (ok?) {
    ensure r: ok? iff (exists (n: Name), n = n)   --~ error: this is outside the decidable core: a quantifier over a type whose values cannot be listed
}

proc sets(): (ok?) {
    ensure r: ok? iff (exists (s: Set<Bool>), s = {})  --~ error: this is outside the decidable core: a quantifier over a type whose values cannot be listed
}

proc recursive(): (ok?) {
    ensure r: ok? iff (exists (t: Tree), t = Tree::Leaf)  --~ error: this is outside the decidable core: a quantifier over a type whose values cannot be listed
}

proc payload(): (ok?) {
    ensure r: ok? iff (exists (b: Boxed), b = b)  --~ error: this is outside the decidable core: a quantifier over a type whose values cannot be listed
}

-- At most 256 instances, counting those of the quantifiers around one:
-- `Byte` has exactly 256, `Nine` 512, two `Method`s and a `Pair` 3 * 3 * 4
-- = 36, and nested within `Method`, 108; `Byte` within `Bool` has 512.
proc sizes(): (ok?, also?) {
    ensure r: ok? iff (exists (b: Byte), b = b)
    ensure s: also? iff (forall (m k: Method) (p: Pair), m = m or k = k or (exists (n: Method), n = n or p = p))
}

proc too_many_nested(): (ok?) {
    ensure r: ok? iff (forall (x?: Bool), exists (b: Byte), x? or b = b)
    --~^ error: with the quantifiers around it, this quantifier has 512 instances, more than 256
}

-- A payload of a set type, which is unbounded.
enum Holder { Holds(Set<Bool>) }

proc set_payload(): (ok?) {
    ensure r: ok? iff (exists (h: Holder), h = h)  --~ error: this is outside the decidable core: a quantifier over a type whose values cannot be listed
}

expect nat_binder: forall (n: Nat), n >= 0  --~ error: this is outside the decidable core: a quantifier over a type whose values cannot be listed
--~^ warning: this expectation mentions no variable

proc too_many(): (ok?) {
    ensure r: ok? iff (exists (n: Nine), n = n)   --~ error: this quantifier has 512 instances, more than 256
}

proc too_many_combined(): (ok?) {
    ensure r: ok? iff (exists (b: Byte) (x?: Bool), x?)  --~ error: this quantifier has 512 instances, more than 256
}

proc component(): (ok?) {
    ensure r: ok? iff (exists (c: valid), true)   --~ error: expected a type, but `valid` is a component
}

proc twice(): (ok?) {
    ensure r: ok? iff (exists (m: Method) (m: Method), true)  --~ error: `m` is bound multiple times in this quantifier
}

proc bool_name(): (ok?) {
    ensure r: ok? iff (exists (b: Bool), b)       --~ error: `Bool` variable `b` must end in `?`
}

proc shadows(k: Method): (ok?) {
    ensure r: ok? iff (exists (k: Method), k = Method::Len)  --~ error: `k` shadows the input `k`
}

proc shadows_explicitly(
    k: Method,    --~ warning: unused variable `k`
): (ok?) {
    ensure r: ok? iff (exists (k!: Method), k = Method::Len)
    expect e: ok?
}

proc not_bool(): (ok?) {
    ensure r: ok? iff (forall (m: Method), 1)  --~ error: type mismatch: expected `Bool`, found `Int`
    --~^ warning: unused bound name `m`
}

--@ exit: 2
