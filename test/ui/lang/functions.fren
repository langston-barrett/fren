-- Abstract types and uninterpreted functions: the checks hold under every
-- interpretation, which calls, both copies of determinism, and the calls
-- of a global expectation share.

type Name
fn ends_in_q?(Name)
fn arity(Name): Int
fn rename(Name): Name

proc naming(name: Name, annotated?): (
    det accepted?,                  -- a function of the inputs is determined
) {
    ensure rule: accepted? iff (ends_in_q?(name) or annotated?)

    expect q_accepted: when ends_in_q?(name), accepted?
    expect always: accepted?        --~ error: expectation `naming::always` does not hold
}

proc distinct(a: Name, b: Name): (
    same?,
    first: Name,                    -- an output of an abstract type
) {
    assume injective: when arity(a) = arity(b), a = b
    ensure r: same? iff a = b
    ensure pick: first = a

    expect by_arity: when arity(a) = arity(b), same?
    expect congruence: when same?, rename(a) = rename(b)
    -- Nothing is known of `rename` beyond being a function.
    expect fixed: rename(a) = a     --~ error: expectation `distinct::fixed` does not hold
}

proc renamed(n: Name): (ok?) {
    call w := naming(rename(n), false)

    ensure r: ok? iff w.accepted?
    expect same_function: ok? iff ends_in_q?(rename(n))  -- the instance's function is this one
}

expect consistent(x_name: Name, x_annotated?, y_name: Name, y_annotated?) {
    call x := naming(x_name, x_annotated?)
    call y := naming(y_name, y_annotated?)
    expect consistent: when x.name = y.name and x.annotated? = y.annotated?, x.accepted? = y.accepted?
}

--@ summary: 19 passed, 2 failed, 0 inconclusive, 0 redundant
