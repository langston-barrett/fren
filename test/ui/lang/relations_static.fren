-- Static rules for relations: typing, pairs, and the decidable core.
-- fren-covers: lang::relation_op, lang::pair_membership, lang::finite, lang::unbounded
set_option fren.lint.unused_variables "allow"

type Name

enum Role { Viewer, Admin }

proc closure_type(r: Rel<Int, String>): (p?) { ensure q: p? iff (1, 2) in r.closure }
--~^ error: `closure` needs a relation of a type with itself, found `Rel<Int, String>`
proc join_types(r: Rel<Role, Role>, q: Rel<Int, Role>): (p?) { ensure s: p? iff r join q = r }
--~^ error: cannot join `Rel<Role, Role>` with `Rel<Int, Role>`
proc join_set(s: Set<Role>, q: Rel<Role, Role>): (p?) { ensure t: p? iff s join q = q }
--~^ error: `join` needs relations, found `Set<Role>`
proc pair(x: Int): (p?) { ensure q: p? iff (x, 1) = (1, x) }
--~^ error: a pair can only be a member of a relation literal or the left of `in`
-- A pair in parentheses is neither a member of a relation literal nor the
-- left of `in`.
proc paren_in(x: Int, r: Rel<Int, Int>): (p?) { ensure q: p? iff ((1, x)) in r }
--~^ error: a pair can only be a member of a relation literal or the left of `in`
proc paren_member(x: Int, r: Rel<Int, Int>): (p?) { ensure q: p? iff r = {((1, x))} }
--~^ error: a pair can only be a member of a relation literal or the left of `in`
proc paren_members(x: Int, r: Rel<Int, Int>): (p?) { ensure q: p? iff r = {(2, x), ((1, x))} }
--~^ error: a pair can only be a member of a relation literal or the left of `in`
proc paren_eq(x: Int): (p?) { ensure q: p? iff x = ((1, x)) }
--~^ error: a pair can only be a member of a relation literal or the left of `in`
proc unknown(r: Rel<Role, Role>): (n: Int) { ensure q: n = r.size }
--~^ error: `Rel<Role, Role>` has no method `size`
proc pair_type(r: Rel<Role, Role>): (p?) { ensure q: p? iff (1, Role::Admin) in r }
--~^ error: `in` needs a `Rel<Int, Role>` on its right, found `Rel<Role, Role>`
proc unbounded(x: Role) { exists r: Rel<Role, Role> ensure q: (x, x) in r }
--~^ error: output `r` has the unbounded type `Rel<Role, Role>`
struct Abstract { r: Rel<Name, Role> }
--~^ error: a field's type cannot have the abstract type `Name` within it

-- Outside the decidable core: relational operators over types that are not
-- finite.
proc reach(parent: Rel<Name, Name>, a: Name, b: Name): (p?) { ensure q: p? iff (a, b) in parent.closure }
--~^ error: outside the decidable core: a relational operator over a type that is not finite
proc middle(r: Rel<Role, Int>, q: Rel<Int, Role>): (p?) { ensure s: p? iff (Role::Admin, Role::Viewer) in r join q }
--~^ error: outside the decidable core: a relational operator over a type that is not finite
proc finite_ok(r: Rel<Role, Role>, a: Role): (p?) { ensure q: p? iff (a, a) in r.closure and a in r.domain }

-- Opting out.
set_option fren.lint.undecidable "allow" in
proc opted(parent: Rel<Name, Name>, a: Name): (p?) { ensure q: p? iff (a, a) in parent.closure }
--@ exit: 2
