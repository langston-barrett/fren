-- What explicit shadowing means: within its scope, a name declared with
-- `!` is the declaration, not the name it hides.
set_option fren.lint.non_snake_case "allow"

const RATE: Int := 2
fn scale(Int): Int
enum Shape { Circle(Int), Square }

-- A binder over an input: in its arm, `x` is the payload.
proc payload(x: Int, s: Shape): (p?) {
    ensure r: p? iff match s {
        Shape::Circle(x!) => x > 0,
        _ => x > 0,
    }

    expect circle: when s = Shape::Circle(1) and x = -1, p?
    expect square: when s = Shape::Square and x = -1, not p?
    expect wrong: when s = Shape::Circle(1) and x = -1, not p?  --~ error: expectation `payload::wrong` does not hold
}

-- A mention of the binder is not one of the input it shadows.
proc unused_input(
    x: Int,                         --~ warning: unused variable `x`
    s: Shape,
): (p?) {
    ensure r: p? iff match s { Shape::Circle(x!) => x > 0, _ => true }
}

-- A variable over a constant and over a function, and a parameter over a
-- constant.
proc var_over_items(RATE!: Int, scale!: Int): (y: Int) {
    ensure r: y = RATE + scale

    expect own: when RATE = 5 and scale = 1, y = 6
}

fn bump(RATE!: Int): Int := RATE + 1

proc param_over_const(): (y: Int) {
    ensure r: y = bump(10)

    expect own: y = 11
    expect constant: y = RATE + 1   --~ error: expectation `param_over_const::constant` does not hold
}

-- A binder of a global expectation over a constant.
proc sub(v: Int): (w: Int) {
    ensure r: w = v + scale(v)
}

expect binder(RATE_v: Int) {
    call RATE! := sub(RATE_v)
    expect binder: RATE.w = RATE.v + scale(RATE.v)
}

--@ summary: 20 passed, 2 failed, 0 inconclusive, 0 redundant
