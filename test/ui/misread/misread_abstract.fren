-- Run with `FREN_MISREAD_MODELS` set (`Reqs/Models#testing`). Both front
-- ends evaluate a formula that mentions a value of an abstract type or of
-- a generic function's type parameter, each value of the type as the
-- model gives it (`Reqs/Models#how-the-front-ends-evaluate`), so both
-- catch a misread whose contradiction is in such a formula.

set_option fren.lint.unused_variables "allow"
set_option fren.lint.unused_assumption "allow"
set_option fren.lint.dead_code "allow"
set_option fren.lint.undecidable "allow"

type Name

fn label(n: Name): Int := 3

-- The model's values of `Name`, compared...
proc abstract_eq(n: Name, m: Name, a: Int) {
    require pinned: n = m and a = -1
    expect e: a > 0  --~ error: internal error: the solver's model for the expectation check of `abstract_eq::e` makes its hypothesis `pinned` false in Fren's semantics
}

proc abstract_neq(n: Name, m: Name, a: Int) {
    require pinned: n != m and a = -1
    expect e: a > 0  --~ error: internal error: the solver's model for the expectation check of `abstract_neq::e` makes its hypothesis `pinned` false in Fren's semantics
}

-- ...given to a function...
proc abstract_given(n: Name, m: Name, a: Int) {
    require same: n = m
    require pinned: a = -1 and label(n) = 3
    expect e: a > 0  --~ error: internal error: the solver's model for the expectation check of `abstract_given::e` makes its hypothesis `pinned` false in Fren's semantics
}

-- ...within a sequence...
proc abstract_seq(q: Seq<Name>, a: Int) {
    require pinned: q.len = 2 and a = -1
    expect e: a > 0  --~ error: internal error: the solver's model for the expectation check of `abstract_seq::e` makes its hypothesis `pinned` false in Fren's semantics
}

-- ...and deciding an `if`.
proc int_if(x: Name, y: Name, a: Int) {
    require pinned: (if x = y then 0 else 1) = a
    expect e: a = 3  --~ error: internal error: the solver's model for the expectation check of `int_if::e` makes its hypothesis `pinned` false in Fren's semantics
}

proc bool_if(x: Name, y: Name, a: Int) {
    require pinned: if x = y then a = 0 else a = 1
    expect e: a = 3  --~ error: internal error: the solver's model for the expectation check of `bool_if::e` makes its hypothesis `pinned` false in Fren's semantics
}

-- A variable that the model leaves free, with no default value, is
-- unknown, and so is `label(n)`, but `a = -1` decides the `and`, on
-- either side (`check::partial_and`).
proc abstract_free(n: Name, a: Int) {
    require pinned: a = -1 and label(n) = 3
    expect e: a > 0  --~ error: internal error: the solver's model for the expectation check of `abstract_free::e` makes its hypothesis `pinned` false in Fren's semantics
}

-- Likewise at a type parameter: compared...
fn at_eq<T>(x: T, y: T, a: Int): (r: Int) {
    require pinned: x = y and a = -1
    out r := a
    ensure positive: at_eq(x, y, a) > 0  --~ error: internal error: the solver's model for the postcondition check of `at_eq::positive` makes its hypothesis `at_eq.pinned` false in Fren's semantics
}

-- ...in a generic function's body, which compares them classically, and
-- which the evaluation compares at the model's type...
fn same<T>(x: T, y: T): Int := if x = y then 1 else 0

fn generic_if<T>(x: T, y: T, a: Int): (r: Int) {
    require pinned: same(x, y) = 1 and a = -1
    out r := a
    ensure positive: generic_if(x, y, a) > 0  --~ error: internal error: the solver's model for the postcondition check of `generic_if::positive` makes its hypothesis `generic_if.pinned` false in Fren's semantics
}

-- ...and free, given to a function whose body does not read it.
fn ignore<U>(x: U): Int := 0
fn identity<T>(x: T): T := x

fn at_free<T>(x: T, a: Int): (r: Int) {
    require pinned: ignore(x) = 0 and a = -1
    out r := a
    ensure positive: at_free(x, a) > 0  --~ error: internal error: the solver's model for the postcondition check of `at_free::positive` makes its hypothesis `at_free.pinned` false in Fren's semantics
}

-- A quantifier ranges over the whole sort, not just the model's one
-- value. In that model `exists x: Fin 1, x != n` would be false and its
-- universal dual true, but Fren's evaluation leaves both unknown, also
-- when a definition contains the quantifier. An uninterpreted observer
-- keeps one sort value in the model, without constraining its whole
-- domain by another quantifier. The claim pins `a` without a separate
-- integer hypothesis, and its free argument keeps it unknown after the
-- injected shift, so it cannot hide a wrongly decided quantifier.
fn another?<T>(n: T) := exists (x: T), x != n
fn only?<T>(n: T) := forall (x: T), x = n
fn observe<T>(T): Int

fn abstract_exists<U>(unused: U, n: Name, free: Name, a: Int): (r: Int) {
    require observed: observe(n) = 0
    require pinned: (exists (x: Name), x != n) or a = -1
    out r := a
    ensure e: abstract_exists(unused, n, free, a) != -1 and ignore(free) = 0  --~ error: the postcondition `e` of `abstract_exists` does not hold
}

fn abstract_forall<U>(unused: U, n: Name, free: Name, a: Int): (r: Int) {
    require observed: observe(n) = 0
    require pinned: not (forall (x: Name), x = n) or a = -1
    out r := a
    ensure e: abstract_forall(unused, n, free, a) != -1 and ignore(free) = 0  --~ error: the postcondition `e` of `abstract_forall` does not hold
}

fn abstract_quantified_and<U>(unused: U, n: Name, a: Int): (r: Int) {
    require pinned: (exists (x: Name), x != n) and a = -1
    out r := a
    ensure e: abstract_quantified_and(unused, n, a) > 0  --~ error: internal error: the solver's model for the postcondition check of `abstract_quantified_and::e` makes its hypothesis `abstract_quantified_and.pinned` false in Fren's semantics
}

-- An unused bound name is still a quantifier. Two distinct model values
-- force its finite stand-in even though the body does not read the name.
fn abstract_forall_unused<U>(unused: U, n: Name, m: Name, free: Name, a: Int): (r: Int) {
    require distinct: n != m
    require pinned: (forall (unused_value: Name), a = -1) or a = -1
    out r := a
    ensure e: abstract_forall_unused(unused, n, m, free, a) != -1 and ignore(free) = 0  --~ error: the postcondition `e` of `abstract_forall_unused` does not hold
}

fn at_quantifier<T>(x: T, free: T, a: Int): (r: Int) {
    require observed: observe(x) = 0
    require pinned: another?(x) or a = -1
    out r := a
    ensure positive: at_quantifier(x, free, a) != -1 and ignore(free) = 0  --~ error: the postcondition `positive` of `at_quantifier` does not hold
}

fn at_universal<T>(x: T, free: T, a: Int): (r: Int) {
    require observed: observe(x) = 0
    require pinned: not only?(x) or a = -1
    out r := a
    ensure positive: at_universal(x, free, a) != -1 and ignore(free) = 0  --~ error: the postcondition `positive` of `at_universal` does not hold
}

-- The model can omit every value of `T`. Its fallback type still stands
-- for a sort when the quantifier's bound name is unused.
fn at_universal_unused<T>(x: T, a: Int): (r: Int) {
    require pinned: a = -1 or (forall (unused: T), a = -1)
    out r := a
    ensure positive: at_universal_unused(x, a) != -1 and ignore(x) = 0  --~ error: the postcondition `positive` of `at_universal_unused` does not hold
}

-- The same erased-binder rule applies to any unlisted type, even when
-- its type is unrelated to the model's abstract sorts.
fn concrete_unused(x: Name, a: Int): (r: Int) {
    require pinned: a = -1 or (forall (unread: Int), a = -1)
    out r := a
    ensure positive: concrete_unused(x, a) != -1 and ignore(x) = 0  --~ error: the postcondition `positive` of `concrete_unused` does not hold
}

-- A generic type parameter may occur in fields and payloads. An
-- explicit abstract type argument, such as `Option<Name>`, is forbidden.
-- A tuple is represented by a relation's pair; tuples are not parameter
-- types in source syntax. The newtype is beside the sort, not around it.
struct SortBox<T> { value: T }
struct Tag(Int)
enum Wrapped<T> { Empty, One(T), Two(T, Int) }

fn at_option<T>(o: Option<T>, a: Int): (r: Int) {
    require pinned: o is Option::Some(_) and a = -1 and ignore(o) = 0
    out r := a
    ensure positive: at_option(o, a) > 0  --~ error: internal error: the solver's model for the postcondition check of `at_option::positive` makes its hypothesis `at_option.pinned` false in Fren's semantics
}

proc abstract_pair(x: Rel<Name, Tag>, a: Int) {
    require pinned: x.card = 1 and a = -1 and ignore(x) = 0
    expect e: a > 0  --~ error: internal error: the solver's model for the expectation check of `abstract_pair::e` makes its hypothesis `pinned` false in Fren's semantics
}

proc abstract_set(s: Set<Name>, a: Int) {
    require pinned: s.card = 1 and a = -1 and ignore(s) = 0
    expect e: a > 0  --~ error: internal error: the solver's model for the expectation check of `abstract_set::e` makes its hypothesis `pinned` false in Fren's semantics
}

fn at_nested<T>(o: Option<SortBox<Seq<T>>>, a: Int): (r: Int) {
    require pinned: o is Option::Some(_) and a = -1 and ignore(o) = 0
    out r := a
    ensure positive: at_nested(o, a) > 0  --~ error: internal error: the solver's model for the postcondition check of `at_nested::positive` makes its hypothesis `at_nested.pinned` false in Fren's semantics
}

fn at_payload<T>(o: Wrapped<T>, a: Int): (r: Int) {
    require pinned: o is Wrapped::Two(_, _) and a = -1 and ignore(o) = 0
    out r := a
    ensure positive: at_payload(o, a) > 0  --~ error: internal error: the solver's model for the postcondition check of `at_payload::positive` makes its hypothesis `at_payload.pinned` false in Fren's semantics
}

-- Equal records exercise confirmation after successful reconstruction.
-- Distinct record payloads hit the pre-existing backend failure #871;
-- test/known/871-record-domain.fren retains that separate reproduction.
fn at_record<T>(x: SortBox<T>, y: SortBox<T>, a: Int): (r: Int) {
    require pinned: x = y and a = -1 and same(x, y) = 1
    out r := a
    ensure positive: at_record(x, y, a) > 0  --~ error: internal error: the solver's model for the postcondition check of `at_record::positive` makes its hypothesis `at_record.pinned` false in Fren's semantics
}

-- Both a defined variable and a call's output may be absent from the
-- model. Their reads are unknown even though the definitions ignore them;
-- the false integer conjunct still refutes the misread model.
proc copy(x: Name): (v: Name) { out v := x }

proc abstract_defined(x: Name, a: Int) {
    let z: Name := identity(x)
    call c := copy(z)
    require pinned: a = -1 and label(z) = 3
    expect e: a > 0 and ignore(c.v) = 0  --~ error: internal error: the solver's model for the expectation check of `abstract_defined::e` makes its hypothesis `pinned` false in Fren's semantics
}

fn at_defined<T>(x: T, a: Int): (r: Int) {
    let z: T := identity(x)
    require pinned: a = -1 and ignore(z) = 0
    out r := a
    ensure positive: at_defined(x, a) > 0  --~ error: internal error: the solver's model for the postcondition check of `at_defined::positive` makes its hypothesis `at_defined.pinned` false in Fren's semantics
}

enum SortList<T> { Nil, Cons(T, SortList<T>) }

fn rec_len<T>(l: SortList<T>): Int := match l {
    SortList::Nil => 0,
    SortList::Cons(_, r) => 1 + rec_len(r),
}

fn rec_has?<T>(l: SortList<T>, x: T) := match l {
    SortList::Nil => false,
    SortList::Cons(y, r) => y = x or rec_has?(r, x),
}

-- Specialization compiles generic recursion at the model's sort. The
-- recursive confirmation first reads the model correctly: `x` is free,
-- so `ignore(x)` is unknown and the model cannot be confirmed. It must
-- not substitute an arbitrary inhabitant for `x`.
fn at_rec<T>(x: T, q: SortList<T>, a: Int): (r: Int) {
    require pinned: a = -1 and rec_len(q) = 2 and ignore(x) = 0
    out r := a
    ensure positive: at_rec(x, q, a) > 0  --~ warning: does not confirm the counterexample: it refutes it, or cannot evaluate it
}

fn at_rec_has<T>(q: SortList<T>, x: T, a: Int): (r: Int) {
    require pinned: rec_has?(q, x) and a = -1
    out r := a
    ensure positive: at_rec_has(q, x, a) > 0  --~ error: internal error: the solver's model for the postcondition check of `at_rec_has::positive` makes its hypothesis `at_rec_has.pinned` false in Fren's semantics
}

-- A function type over a sort is not a quantified proposition, including
-- the implicit type of an argument retained for strict evaluation.
fn higher_label(x: Name): Int := 0
fn higher_apply(f: fn(Name) -> Int, x: Name): Int := 0

proc abstract_higher(x: Name, y: Name, a: Int) {
    require eq: x = y
    require pinned: a = -1 and higher_apply(higher_label, x) = 0
    expect e: a > 0  --~ error: internal error: the solver's model for the expectation check of `abstract_higher::e` makes its hypothesis `pinned` false in Fren's semantics
}

-- A recursion without type parameters keeps its compiled definition.
-- A neighbouring quantifier still ranges over the whole abstract type,
-- so recursive confirmation cannot decide it over the finite model.
enum IntList { Nil, Cons(Int, IntList) }

fn int_len(l: IntList): Int := match l {
    IntList::Nil => 0,
    IntList::Cons(_, rest) => 1 + int_len(rest),
}

fn rec_quantified(n: Name, l: IntList, a: Int): (r: Int) {
    require pinned: int_len(l) = 0 and (exists (x: Name), x = n)
    out r := a
    ensure positive: rec_quantified(n, l, a) > 0  --~ warning: does not confirm the counterexample: it refutes it, or cannot evaluate it
}

-- A known operand beside an unknown quantifier can still confirm the
-- original model. Reporting then catches the shifted integer value.
fn rec_quantified_known(n: Name, l: IntList, a: Int): (r: Int) {
    require integer: a = -1
    require pinned: int_len(l) = 0 and ((exists (x: Name), x = n) or a = -1)
    out r := a
    ensure positive: rec_quantified_known(n, l, a) > 0  --~ error: internal error: the solver's model for the postcondition check of `rec_quantified_known::positive` makes its hypothesis `rec_quantified_known.integer` false in Fren's semantics
}

fn rec_nested_quantified(n: Name, l: IntList, q: Seq<Name>, a: Int): (r: Int) {
    require members: q = [n]
    require pinned: int_len(l) = 0 and (forall (x: Name), when x in q, exists (y: Name), y = x)
    out r := a
    ensure positive: rec_nested_quantified(n, l, q, a) > 0  --~ warning: does not confirm the counterexample: it refutes it, or cannot evaluate it
}

-- The fallback must compile the prepared expression too: unfolding
-- this generic helper replaces its classical decision at the model's
-- concrete element type, beside the recursion's compiled definition.
fn bounded_value<T>(q: Seq<T>, a: Int): Int := if (forall (x: T), when x in q, a = -1) then 1 else 0

fn rec_bounded(n: Name, l: IntList, q: Seq<Name>, a: Int): (r: Int) {
    require members: q = [n]
    require pinned: int_len(l) = 0 and bounded_value(q, a) = 1
    out r := a
    ensure positive: rec_bounded(n, l, q, a) > 0  --~ error: internal error: the solver's model for the postcondition check of `rec_bounded::positive` makes its hypothesis `rec_bounded.pinned` false in Fren's semantics
}

-- A domain in a quantifier's guard ranges over those values, even when
-- their type is abstract. The shifted integer makes its body false.
proc bounded_seq(n: Name, q: Seq<Name>, a: Int) {
    require members: q = [n]
    require pinned: forall (x: Name), when x in q, x = n and a = -1
    expect e: a > 0  --~ error: internal error: the solver's model for the expectation check of `bounded_seq::e` makes its hypothesis `pinned` false in Fren's semantics
}

proc bounded_set(n: Name, s: Set<Name>, a: Int) {
    require members: s = {n}
    require pinned: exists (x: Name), x in s and x = n and a = -1
    expect e: a > 0  --~ error: internal error: the solver's model for the expectation check of `bounded_set::e` makes its hypothesis `pinned` false in Fren's semantics
}

proc bounded_pair(n: Name, q: Seq<Name>, a: Int) {
    require members: q = [n]
    require pinned: forall (x y: Name), when x in q and y in q, x = y and a = -1
    expect e: a > 0  --~ error: internal error: the solver's model for the expectation check of `bounded_pair::e` makes its hypothesis `pinned` false in Fren's semantics
}

-- The model has a value outside the domain, so ranging over all model
-- values without retaining the membership guard would refute it.
proc bounded_seq_outside(n: Name, m: Name, q: Seq<Name>, a: Int) {
    require members: q = [n] and n != m
    require pinned: forall (x: Name), when x in q, x = n and a = -1
    expect e: a > 0  --~ error: internal error: the solver's model for the expectation check of `bounded_seq_outside::e` makes its hypothesis `pinned` false in Fren's semantics
}

proc bounded_set_outside(n: Name, m: Name, s: Set<Name>, a: Int) {
    require members: s = {n} and n != m
    require pinned: forall (x: Name), when x in s, x = n and a = -1
    expect e: a > 0  --~ error: internal error: the solver's model for the expectation check of `bounded_set_outside::e` makes its hypothesis `pinned` false in Fren's semantics
}

-- An empty domain makes the universal true even when its body is false.
proc bounded_empty(n: Name, m: Name, q: Seq<Name>, a: Int) {
    require different: n != m
    require pinned: q = [] and a = -1 and (forall (x: Name), when x in q, a = 1)
    expect e: a > 0  --~ error: internal error: the solver's model for the expectation check of `bounded_empty::e` makes its hypothesis `pinned` false in Fren's semantics
}

-- Making the retained binder computable must not let its old decision
-- decide a substituted unknown condition. The integer conjunct is false.
fn unused_value(a: Int): Int := if (forall (u: Int), a = -1) then 1 else 0
fn unused_local(a: Int): Int := let b? := (forall (u: Int), a = -1) in if b? then 1 else 0
fn unused_compound(a: Int): Int := if ((forall (u: Int), a = -1) and a < 0) then 1 else 0

proc unused_decisions(a: Int) {
    require pinned: a = -1 and unused_value(a) = 1 and unused_local(a) = 1 and unused_compound(a) = 1
    expect e: a > 0  --~ error: internal error: the solver's model for the expectation check of `unused_decisions::e` makes its hypothesis `pinned` false in Fren's semantics
}

--@ exit: 1
