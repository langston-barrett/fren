-- Run with `FREN_MISREAD_MODELS` set (`Reqs/Models#testing`). A generic
-- function's checks hold for every type, so their models have values of
-- its type parameter, which confirmation treats as a value of an abstract
-- type (`Reqs/Models#free-values`). Here `x` is free: the query that the
-- solver answers, with `ignore` unfolded, does not mention it, so the
-- model leaves it out, and a type parameter has no default value. Evaluation
-- is strict, so `ignore(x)`, and with it `pinned`, is undecided in both
-- front ends (`model::known_application`), and both show the misread
-- model; at `Int`, `x` has the default value `0`, and both catch it.

set_option fren.lint.unused_variables "allow"
set_option fren.lint.unused_assumption "allow"
set_option fren.lint.dead_code "allow"

fn ignore<U>(x: U): Int := 0

fn at_parameter<T>(x: T, a: Int): (r: Int) {
    assume pinned: ignore(x) = a + 1
    out r := a
    ensure positive: at_parameter(x, a) > 0  --~ error: the postcondition `positive` of `at_parameter` does not hold
}

-- At `Int`, both front ends catch it.
fn at_int(x: Int, a: Int): (r: Int) {
    assume pinned: ignore(x) = a + 1
    out r := a
    ensure positive: at_int(x, a) > 0  --~ error: internal error: the solver's model for the postcondition check of `at_int::positive` makes its hypothesis `at_int.pinned` false in Fren's semantics
}

-- A value of an abstract type that the formulas read is its type's `k`th
-- value, `T#k`, compared with `=`, so both front ends decide `pinned` and
-- catch the misread `a`.
type T

proc abstract_read(x: T, y: T, a: Int) {
    assume distinct: x != y
    assume pinned: if x = y then a = 0 else a = 1
    expect e: a = 3  --~ error: internal error: the solver's model for the expectation check of `abstract_read::e` makes its hypothesis `pinned` false in Fren's semantics
}

-- Likewise a value of a type parameter.
fn parameter_read<U>(x: U, y: U, a: Int): (r: Int) {
    assume distinct: x != y
    assume pinned: if x = y then a = 0 else a = 1
    out r := a
    ensure two: parameter_read(x, y, a) = 3  --~ error: internal error: the solver's model for the postcondition check of `parameter_read::two` makes its hypothesis `parameter_read.pinned` false in Fren's semantics
}

--@ exit: 1
