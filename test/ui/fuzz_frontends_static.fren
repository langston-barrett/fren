-- An undecidable construct near a difference that `fren_fuzz_frontends`
-- found, on which the front ends agree.

-- A `++` compared with a variable, without parentheses.
proc concat(s: String, t: String): (y?) {
    ensure q: y? iff s = t ++ "b"
    --~^ error: searching a string, or `++` here, which makes a word equation, may be undecidable
}

-- The same, with parentheses, which do not make it a comparison of
-- strings too (#98).
proc concat_paren(s: String, t: String): (y?) {
    ensure q: y? iff s = (t ++ "b")
    --~^ error: searching a string, or `++` here, which makes a word equation, may be undecidable
}

-- Methods without arguments chained after a parenthesized receiver (#97).
proc chained_paren(r: Rel<Int, Int>): (y?) {
    ensure q: y? iff (r).range.card = 1
    --~^ error: a relational operator over a type that is not finite quantifies over its values
    --~^^ error: the solver does not reliably combine counting with relational operators
}

-- Counting with relational operators, through an instance, where cvc5
-- aborted (#100): neither front end checks anything after a static error,
-- not even `mixed`, which has none.
proc mixed(n: Int, t: Set<Int>) {
    ensure q: ((t inter {0, 3}) union t) = (({(0, 0), (1, 2)}).range inter {3, n})
}

proc counts_mixed(r: Rel<Int, Int>, t: Set<Int>): (y?) {
    call w := mixed(r.card, t)
    --~^ error: the solver does not reliably combine counting with relational operators
    ensure q: y? iff (w.n + ({(1, 2)}).card) > 1
}

-- An instance of a component that cannot be found, or that has a static
-- error, is reported once, not again where it is used.
proc uses_unknown(x: Int): (z?) {
    call w := nope(x)
    --~^ error: cannot find `nope` in this scope
    ensure r: z? iff w.y = 1
}

proc squared(x: Int): (y: Int) {
    ensure q: y = x * x
    --~^ error: nonlinear arithmetic is not supported
}

proc uses_squared(x: Int): (z?) {
    call w := squared(x)
    --~^ error: cannot find `squared` in this scope
    ensure r: z? iff w.y = 1
}
--@ exit: 2
