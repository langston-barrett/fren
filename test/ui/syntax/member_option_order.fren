-- A member's `set_option` of an option other than `fren.evidence` is
-- reported as it is parsed, before a dotted pattern binder after it, in
-- both front ends.

pub enum S { A(Int), B }

proc c(s: S): (z: Int) {
    set_option fren.lint.dead_code "allow" in   --~ error: `fren.lint.dead_code` cannot be set before a member
    ensure r: z = match s { S::A(x.y) => 0, _ => 1 }
}
