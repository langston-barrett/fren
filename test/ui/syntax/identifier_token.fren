-- fren-covers: lang::identifier
-- `s!` is a Lean token, the prefix of `s!"..."`, which Lean reads in
-- preference to an identifier. Where Fren expects an identifier, the Lean
-- front end reads it as one, so both front ends read `s!` then `=`
-- (`Lexical.md#identifiers`).

proc c(s: Int): (z?) { ensure r: z? iff s!=1 }  --~ error: cannot find `s!` in this scope
