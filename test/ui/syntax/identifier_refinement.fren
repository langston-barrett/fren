-- A letter that Lean allows but Fren does not (F0119), in a refinement's
-- binding, in both front ends.

proc c(x: Int): (y: Int) { ensure r: y = x }
proc a(n: Int): (z: Int) { ensure r: z = n }

expect ok(x: Int) {
    call c := c(x)
    refines c a(xα)  --~ error: `xα` is not an identifier in Fren
}
