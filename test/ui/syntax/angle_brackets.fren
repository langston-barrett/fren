-- Type arguments in angle brackets, nested, next to comparisons, and
-- closed by Lean's `>>` and `>>>` tokens, which are read one `>` at a time
-- (`Reqs/Lang/Generics#angle-brackets`).
mod m
pub struct Pair<A, B> { fst: A, snd: B }

fn size<T>(o: Option<T>): Int := if o = Option::None then 0 else 1

type SubsetAngleBrackets1 = subset_value: Int  where invariant: subset_value is 0..=9
proc c(
    x: Option<Set<Int>>,
    p: Pair<Int, Option<Set<Int>>>,
    r: Rel<Int, Option<Pair<Int, Bool>>>,
    q: Seq<Option<Int>>,
    d: Option<SubsetAngleBrackets1>,
): (det y: Int) {
    out y := size(x)

    expect bounded: y<2
    expect binder: forall (b: Option<Bool>), size(b)<=size(x) or size(x)<1
    expect tight: let s: Set<Int>:= {y, y + 1} in s.card>1
    expect related: (p.fst, Option::Some(Pair { fst := y, snd := true })) in r or q.len>1 or d = Option::None  --~ error: does not hold
}
