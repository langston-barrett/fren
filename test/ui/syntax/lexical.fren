-- fren-covers: lang::identifier, lang::identifier_shape, lang::longest_identifier, lang::escape_sequence, lang::escape_start, lang::escape_text, lang::punctuator_end, lang::longest_punctuator
-- Identifiers, escape sequences and punctuators, written as tightly as
-- they lex, which both front ends must read alike.

-- Expectations about constants test what the language computes.
set_option fren.lint.assertions_on_constants "allow"

-- The lengths of literals are tested on purpose.
set_option fren.lint.const_is_empty "allow"

expect escapes: "\x41\u0042\t\\\"\'".len = 6 and "\x41\u0042\t\\\"\'".starts_with?("AB")
expect newlines: "\n\r".len = 2 and "\n" != "n" and "\r" != "r"
expect raw: r"a\n".len = 3 and r#"say "hi""#.len = 8

comp counter {
    in x': Int
    in ready?
    pub det out y: Int

    ensure rule: y = (if ready? then x' + 1 else x')
}

enum Mode { Off, Low, High }

comp outer {
    in a: Int
    in m: Mode
    pub det out level: Int

    inst c: counter { x' := a, ready? := true }
    ensure level_rule: level = match m { Mode::Off => 0, _ => 1 }

    expect dotted: c.y=a+1
    expect symbols: c.y>=a and a<=c.y and a<c.y
    expect wildcard: when m != Mode::Off, level=1
    expect wrong: c.y = a                                                  --~ error: expectation `outer::wrong` does not hold
}

-- `!` ends an identifier, after its `?` if it has one.
enum Flag { Set(Bool), Unset }

comp tight {
    in ready?
    in f: Flag
    pub det out go?

    ensure rule: go? iff match f { Flag::Set(ready?!)=>ready?, _=>ready? }

    expect payload: when f=Flag::Set(true), go?
}

--@ summary: 18 passed, 1 failed, 0 inconclusive, 0 redundant
--@ exit: 1
