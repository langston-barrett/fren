-- A binding of a refinement cannot be a bare `when`, which would swallow
-- the bindings after it.
proc a(p?, q?) {}
proc c(x?) {}
refine r: c refines a { p? := when x?, x?, q? := x? }
--~^[cli] error: `when` must be parenthesized here
--~^^[hosted] error:
refine ok: c refines a { p? := (when x?, x?), q? := x? }
--@ exit: 2
