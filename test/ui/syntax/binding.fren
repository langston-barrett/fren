struct Flags { p?, q? }
proc c(x?): (r: Flags) {
    out r := Flags { p? := when x?, x?, q? := true }  --~[cli] error: `when` must be parenthesized here
--~^[hosted] error: unexpected identifier; expected '}'
}
proc ok(x?): (r: Flags) {
    out r := Flags { p? := (when x?, x?), q? := true }  --~[hosted] warning: the condition and the body of `when` are written the same
}
--@ exit: 2
