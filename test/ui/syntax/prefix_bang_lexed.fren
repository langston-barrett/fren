-- Prefix `!` is reported by the lexer, so it comes before a dotted pattern
-- binder even when the binder is written first, in both front ends.

pub enum S { A(Int), B }

proc c(s: S, x?): (z: Int) {
    ensure r: z = match s { S::A(a.b) => 0, _ => 1 }
    ensure q: !x?   --~ error: `!` is not an operator in Fren
}
