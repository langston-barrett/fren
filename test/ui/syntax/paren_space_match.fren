-- A variant's binders follow it directly, with no space.
pub enum S { A(Int), B }
comp c { in s: S pub out p? ensure r: p? iff match s { S::A (_) => true, S::B => false } }
--~^[cli] error: a space before the `(` of the binders of `S::A`
