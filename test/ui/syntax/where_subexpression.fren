-- A `where` clause follows a whole constraint, not a part of one.
proc c(x: Int): (y?) { ensure r: y? iff (x > z where z := 1) }
--~^[cli] error: expected `)`, found keyword `where`
--~^^[hosted] error: unexpected token 'where'; expected ')' or ','
proc ok(x: Int): (y?) { ensure r: y? iff x > z where z := 1 }
