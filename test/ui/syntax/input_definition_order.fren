-- A parameter's definition is reported as it is parsed, before a dotted
-- pattern binder after it, in both front ends.

pub enum S { A(Int), B }

proc c(
    s: S,
    a: Int := 3,
    --~^ error: a parameter cannot have a definition
): (z: Int) {
    ensure r: z = match s { S::A(x.y) => a, _ => 1 }
}
--@ exit: 2
