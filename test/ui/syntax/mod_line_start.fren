-- The `mod` of a remainder is on the line of its left operand: at the
-- start of a line, `mod` starts a module, so this is not `x mod 2`.
proc c(x: Int): (r: Int) {

    ensure e: r = x
    --~^[hosted] error: unexpected token 'mod'; expected '}'
        mod 2
        --~^[cli] error: expected a member (`use`, `assume`, `exists`, `let`, `out`, `call`, `ensure`, `expect` or `cover`) or `}`, found keyword `mod`
        --~^^[hosted] error: expected identifier
}
