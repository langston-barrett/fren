-- A definition cannot be a bare `when`, which would run on into the next definition.
-- fren-covers: lang::definition_form
proc c(x: Int): (y?) { ensure r: let a? := when x > 0, x > 1, b? := a? in y? iff b? }
--~^[cli] error: `when` must be parenthesized here
--~^^[hosted] error: unexpected identifier; expected 'in'
proc ok(x: Int): (y?) { ensure r: let a? := (when x > 0, x > 1), b? := a? in y? iff b? }
--@ exit: 2
