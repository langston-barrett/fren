-- A binding of a refinement cannot be a bare quantifier, which would run on
-- into the bindings after it.
enum E { A, B }
proc a(p?, q?) {}
proc c(x: E) {}
refine r: c refines a { p? := exists (e: E), e = x, q? := true }
--~^[cli] error: `exists` must be parenthesized here
--~^^[hosted] error:
refine ok: c refines a { p? := (exists (e: E), e = x), q? := true }
--@ exit: 2
