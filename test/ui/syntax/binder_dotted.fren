-- A pattern binder that is not a single segment is reported before any
-- other problem of its item, in both front ends: here an earlier unknown
-- name, the wrong number of binders, and a binder in an or-pattern.
set_option fren.lint.dead_code "allow"

enum S { A(Int), B, C(Bool, Int) }

comp earlier {
    in s: S
    pub out z: Int
    ensure q: nope
    ensure r: z = match s { S::A(a.b) => a.b, _ => 0 }   --~ error: `a.b` is not a single name
}
