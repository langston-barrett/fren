-- An operator of another language is reported as it is parsed, before a
-- dotted pattern binder after it, in both front ends.

pub enum S { A(Int), B }

proc c(s: S, x: Int): (z: Int) {
    ensure q: x == 1   --~ error: `==` is not an operator in Fren
    ensure r: z = match s { S::A(a.b) => 0, _ => 1 }
}
