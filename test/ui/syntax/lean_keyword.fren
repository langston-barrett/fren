-- Lean's keywords, such as `at`, `for` and `fun`, are reserved: neither
-- front end accepts one as a declared name (F0221), and a use of one
-- finds no declaration (`Lexical.md#keywords`).

comp c0 { in at: Int pub out z? ensure r: z? iff at = 1 }
--~^ error: `at` is a Lean keyword, so it cannot be declared

struct Slot { at: Int }
--~^ error: `at` is a Lean keyword, so it cannot be declared

enum Way { by, Through }
--~^ error: `by` is a Lean keyword, so it cannot be declared

comp fun { in x: Int pub out y: Int ensure r: y = x }
--~^ error: `fun` is a Lean keyword, so it cannot be declared

const for: Int := 1
--~^ error: `for` is a Lean keyword, so it cannot be declared

comp c1 { in x: Int pub out y: Int ensure from: y = x }
--~^ error: `from` is a Lean keyword, so it cannot be declared

-- `at` is still a method.
comp c2 { in s: String pub out y: String := s.at(0) }

-- A use of one finds no declaration.
comp c3 { in x: Int pub out y: Int ensure r: y = do }
--~^ error: cannot find `do` in this scope

fn twice(for: Int): Int := for + for
--~^ error: `for` is a Lean keyword, so it cannot be declared

comp c4 { in x: Int pub out p? ensure r: p? iff match x { Type => Type > 0 } }
--~^ error: `Type` is a Lean keyword, so it cannot be declared

comp c5 { in x: Int pub out y: Int := let have := x in have }
--~^ error: `have` is a Lean keyword, so it cannot be declared

expect e: forall (show: Bool), show = show
--~^ error: `show` is a Lean keyword, so it cannot be declared
--@ exit: 2
