-- Only an or-pattern starts with `|`: before a pattern of one alternative,
-- it separates nothing.
pub enum Sign { Negative, Zero, Positive }

proc c(s: Sign): (det y: Int) {
    out y := match s {
        | Sign::Negative
        | Sign::Zero => 0,
        | Sign::Positive => 1,  --~ error: a pattern of one alternative does not start with `|`
    }
}
--@ exit: 2
