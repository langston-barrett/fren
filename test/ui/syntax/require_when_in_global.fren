-- `require` in a global expectation's block, unlabelled, under a leading
-- `when` (`F0417`), reported at the keyword.
proc double(x: Int): (y: Int) { ensure r: y = 2 * x }

expect even(x: Int) {
    require when x > 0, and { small: x < 10 }  --~ error: global expectations have no `require` members
    call d := double(x)
    expect e: d.y mod 2 = 0
}
--@ exit: 2
