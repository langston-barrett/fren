-- Name resolution and visibility (`modules::resolve`, `modules::item_visible`).
-- fren-covers: modules::two_segments, lang::path_shape, lang::declared_before

pub enum E { A, B }
pub enum F { A, C }
use E::*   --~ warning: `use E::*` imports every variant of `E`
use F::*   --~ warning: `use F::*` imports every variant of `F`
use E::*   -- opening `E` again does not make its variants ambiguous
--~^ warning: unused import `E::*`
--~^^ warning: `use E::*` imports every variant of `E`

comp ambiguous { in e: E req r: e = A }   --~ error: `A` is ambiguous: it could be any of `E::A`, `F::A`
comp unknown { pub out y: Int req r: y = z }  --~ error: cannot find `z` in this scope
comp qualified { in e: E in f: F pub out o? req r: o? iff (e = B or f = C or e = E::A) }
comp not_a_value { in e: E req r: e = E }  --~ error: expected a value, but `E` is an enum
comp not_a_type { in x: qualified }        --~ error: expected a type, but `qualified` is a comp
comp no_variant { in e: E req r: e = E::Z }  --~ error: no variant `Z` in enum `E`

use qualified::*    --~ error: only enums can be opened with `*`, but `qualified` is a comp
use nothing::here   --~ error: cannot find `nothing` in the root module
use E               --~ error: the name `E` is already defined in the root module

mod a
enum Hidden { H }
pub enum Shown { S }

mod a::inner
use a::Hidden
comp sees_parent { in h: Hidden }  --~ warning: unused variable `h`

mod b
use a::Hidden       --~ error: `Hidden` is private to module `a`
use a::Shown
use a::Shown        --~ error: the name `Shown` is already imported into module `b`
use self::Missing   --~ error: cannot find `Missing` in module `b`
comp sees_pub { in s: Shown }      --~ warning: unused variable `s`
use a::self::Shown  --~ error: cannot find `self` in module `a`
comp uses_later { in x: Later }    --~ error: cannot find `Later` in this scope
enum Later { L }                   --~ warning: enum `Later` is never used

--@ exit: 2
