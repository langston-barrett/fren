-- Static rules for a refinement's bindings (`refinement::binding`,
-- `refinement::mention`): both front ends report them alike.

comp c {
    in x: Int
    in b?
    pub out y: Int
    out hidden: Int
    req r: y = (if b? then x else 0)
    req h: hidden = x
}

comp a { in n: Int pub out z: Int req r: z >= n }

refine unknown: c refines a { w := y }        --~ error: `a` has no variable `w`
refine twice: c refines a { z := y, z := y }  --~ error: variable `z` of `a` is bound multiple times
refine input_out: c refines a { n := y, z := y }
--~^ error: a binding of an input of `a` may only mention `in` variables of `c`, but `y` is an `out`
refine private_out: c refines a { n := x, z := hidden }  --~ error: `hidden` is private to `c`
refine unbound: c refines a { z := y }        --~ error: `c` cannot refine `a`: it has no variable `n`
refine mistyped: c refines a { n := b?, z := y }
--~^[cli] error: type mismatch: expected `Int`, found `Bool`
--~^^[hosted] error: Type mismatch

-- `{ k }` alone means `k := k`, so it needs a variable `k` of `c`.
comp b { in k: Int pub out z: Int req r: z >= k }
refine shorthand: c refines b { z := y, k }  --~ error: cannot find `k` in this scope

-- Only `c`'s own variables are in scope: not those of its instances.
comp outer { in n: Int pub out z: Int inst inner: c { x := n, b? := true } req r: z = inner.y }
refine instance_var: outer refines a { z := inner.y }  --~ error: `inner.y` is not a single name

--@ exit: 2
