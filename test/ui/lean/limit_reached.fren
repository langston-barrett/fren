-- A check that reaches one of Lean's limits is reported as its own error,
-- which says how to raise the limit, and the other checks keep their
-- verdicts (`Fren.failureMsg`). Unfolding `f60` nests sixty applications,
-- deeper than `maxRecDepth` lets the check go, while elaborating each
-- function needs much less.
--@ only: hosted
set_option maxRecDepth 64

pub fn f0(x: Int): Int := x
pub fn f1(x: Int): Int := f0(x) + 1
pub fn f2(x: Int): Int := f1(x) + 1
pub fn f3(x: Int): Int := f2(x) + 1
pub fn f4(x: Int): Int := f3(x) + 1
pub fn f5(x: Int): Int := f4(x) + 1
pub fn f6(x: Int): Int := f5(x) + 1
pub fn f7(x: Int): Int := f6(x) + 1
pub fn f8(x: Int): Int := f7(x) + 1
pub fn f9(x: Int): Int := f8(x) + 1
pub fn f10(x: Int): Int := f9(x) + 1
pub fn f11(x: Int): Int := f10(x) + 1
pub fn f12(x: Int): Int := f11(x) + 1
pub fn f13(x: Int): Int := f12(x) + 1
pub fn f14(x: Int): Int := f13(x) + 1
pub fn f15(x: Int): Int := f14(x) + 1
pub fn f16(x: Int): Int := f15(x) + 1
pub fn f17(x: Int): Int := f16(x) + 1
pub fn f18(x: Int): Int := f17(x) + 1
pub fn f19(x: Int): Int := f18(x) + 1
pub fn f20(x: Int): Int := f19(x) + 1
