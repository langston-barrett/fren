pub fn f58(x: Int): Int := f57(x) + 1
pub fn f59(x: Int): Int := f58(x) + 1
pub fn f60(x: Int): Int := f59(x) + 1

expect chain(x: Int) {  --~ error: checking `chain` in Lean reached a limit: maximum recursion depth has been reached
    expect e: f60(x) = x + 60
}

expect shallow(x: Int) {
    expect e: f1(x) = x + 1
}
