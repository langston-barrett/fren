-- `impl`: obligations, how they are discharged, and what is reported.
--@ only: hosted

enum Verdict { Pass, Fail, Inconclusive }
use Verdict::{Pass, Fail, Inconclusive}

proc exit(ran?, worst: Verdict): (code: Int) {
  ensure not_run: unless ran?, code = 2
  ensure failed: when ran? and worst = Fail, code = 1
  ensure inconclusive: when ran? and worst = Inconclusive, code = 3
  ensure passed: when ran? and worst = Pass, code = 0
}

def good (ran : Bool) (v : Verdict) : Nat :=
  if !ran then 2 else match v with | .Fail => 1 | .Inconclusive => 3 | .Pass => 0

def bad (ran : Bool) (v : Verdict) : Nat :=
  if !ran then 2 else match v with | .Fail => 1 | _ => 0

-- `decide` proves it, so it is a theorem.
impl good_exit: exit for (ran : Bool) (v : Verdict) { ran? := ran, worst := v, code := good ran v }

-- `decide` refutes it, with a counterexample.
impl bad_exit: exit for (ran : Bool) (v : Verdict) { ran? := ran, worst := v, code := bad ran v }
--~^ error: `bad_exit` does not implement `exit`: `inconclusive` is false when ran = true, v = Verdict::Inconclusive

proc double(n: Int): (m: Int) {
  exists scratch: Int
  assume nonneg: n >= 0
  ensure twice: m = 2 * n
  ensure copy: scratch = n
}

def dbl (n : Int) : Int := n + n

-- `decide` does not apply to `Int`, and the solver can't see `dbl`.
impl by_solver: double for (n : Int) { n := n, m := dbl n }   --~ warning: could not prove that `by_solver` implements `double`
-- A written proof; the private `out` is only said to exist.
impl by_proof: double for (n : Int) { n := n, m := dbl n } by
  intro n _; exact ⟨n, by simp [dbl]; omega, rfl⟩
-- The solver proves it when no definitions are involved; it becomes an axiom.
impl inlined: double for (n : Int) { n := n, m := n + n }

-- The solver sees through a `where` clause, as it does through a `let`.
proc shifted(n: Int): (m: Int) {
  ensure r: m = k + 1 where k := (let j := n in j)  --~ warning: this `let` only gives back its last definition
}
impl shifted_by_solver: shifted for (n : Int) { n := n, m := n + 1 }
-- A wrong written proof is Lean's error.
impl wrong: double for (n : Int) { n := n, m := n } by
  intro n _; exact ⟨n, rfl, rfl⟩   --~ error: type mismatch

impl missing: double for (n : Int) { n := n }       --~ error: missing `m` of `double`
impl private_: double for (n : Int) { n := n, m := n + n, scratch := n }   --~ error: `scratch` is a private variable of `double`
impl twice_: double for (n : Int) { n := n, n := n, m := n }   --~ error: `n` is mapped multiple times
impl unknown: double for (n : Int) { n := n, k := n, m := n }   --~ error: `double` has no variable `k`
impl not_comp: Verdict { }                          --~ error: expected a procedure, but `Verdict` is an enum

-- No values of the binders satisfy the assumptions, so it proves nothing.
proc gated(on?): (lit?) {
  assume powered: on?
  ensure lit: lit? iff on?
}
impl never_on: gated for (b : Bool) { on? := false, lit? := b }   --~ warning: `never_on` holds only because no values of its binders satisfy the assumptions of `gated`

/-- info: 'inlined' depends on axioms: [inlined] -/
#guard_msgs in
#print axioms inlined

#fren_trace  --~ info: evidence: 2 proved, 1 solver, 0 tested, 0 trusted, 1 missing
