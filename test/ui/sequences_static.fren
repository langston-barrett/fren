-- Static rules for sequences: typing, `[]`, and the decidable core.
set_option fren.lint.unused_variables "allow"

type Name

comp not_seq { in s: Set(Int) pub out x: Int req r: x = s[0] }
--~^ error: cannot index a `Set(Int)`
comp untyped { in q: Seq(Int) pub out p? req r: p? iff [].len = 0 }
--~^ error: the type of `[]` cannot be known here
comp unknown { in q: Seq(Int) pub out n: Int req r: n = q.size }
--~^ error: `Seq(Int)` has no method `size`
comp unbounded { in x: Int out q: Seq(Int) req r: q = [x] }
--~^ error: output `q` has the unbounded type `Seq(Int)`
struct Abstract { names: Seq(Name) }
--~^ error: a field's type cannot have the abstract type `Name` within it
enum Tree { Leaf, Node(Seq(Tree)) }
--~^ error: `Tree` cannot be an element type within itself

-- Outside the decidable core: word equations.
comp concat { in q: Seq(Int) in r: Seq(Int) pub out p? req s: p? iff q ++ r = q }
--~^ error: outside the decidable core: an operation on sequences other than indexing
comp member { in q: Seq(Int) in x: Int pub out p? req s: p? iff x in q }
--~^ error: outside the decidable core: an operation on sequences other than indexing
comp reversed { in q: Seq(Int) pub out p? req s: p? iff q.rev = q }
--~^ error: outside the decidable core: an operation on sequences other than indexing

-- In the core: indexing, length, update, and literal operands.
comp array { in q: Seq(Int) in x: Int pub out p? req s: p? iff (q.len > 1 and q.update(0, x)[1] = x or x in [1, 2]
        or q.starts_with?([x])) }
--@ exit: 2
