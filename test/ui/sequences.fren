-- Sequences: literals, `[]`, `++`, indexing, methods and definedness, in
-- both front ends.

-- `q[i] = q[i]` tests definedness alone.
set_option fren.lint.eq_op "allow"

type Job

comp dispatch {
    in pending: Seq(Job)
    in running: Set(Job)
    in capacity: Int
    pub out start?               -- start the job at the head of the queue

    assume sane: capacity >= 0

    req rule: start? iff (pending != [] and running.card < capacity and not pending[0] in running)

    expect waits_when_full: when running.card >= capacity, not start?
    expect head_only: when start?, pending != []
    expect two: when start?, pending.len >= 2  --~ error: expectation `dispatch::two` does not hold
}

enum Mode { Long, Short }

-- Each form of guard, in expectations that hold, so that only
-- definedness can fail. `nonminimal_bool` would rewrite the `if`.
set_option fren.lint.nonminimal_bool "allow" in
comp guards {
    in q: Seq(Int)
    in i: Int
    in m: Mode
    pub out p?

    req r: p? iff i > 0

    expect by_when: when q.len > 2, q[2] = q[2]
    expect by_unless: unless q.len <= 3, q[3] = q[3]
    expect by_if: if 0 <= i and i < q.len then q[i] = q[i] else true
    expect by_and: (q.len > 4 and q[4] = q[4]) or q.len <= 4
    expect by_or: q.len <= 5 or q[5] = q[5]
    expect by_match: match m { Mode::Long => q.len <= 6 or q[6] = q[6], Mode::Short => true }
    expect first: when q[0] > 0, true                 --~ error: an index of `guards::first` may be out of range
    expect late: when q[1] > 0 and q.len > 1, true   --~ error: an index of `guards::late` may be out of range
    --~^ warning: the bound comes after the index it guards
}

-- A requirement can guarantee another's definedness.
comp together {
    in q: Seq(Int)
    pub out x: Int

    assume long: q.len > 3

    req third: x = q[3]
}

-- The meaning of each operation, on constants.
expect concat_lit: [1, 2] ++ [3] = [1, 2, 3] and [1, 2].len = 2 and [] ++ [1] = [1]  --~ warning: this operation has no effect
expect slice_lit: [1, 2, 3].slice(1, 5) = [2, 3] and [1, 2, 3].slice(3, 1) = []
expect update_lit: [1].update(3, 9) = [1] and [1, 2].update(1, 9) = [1, 9]
set_option fren.lint.empty_argument "allow" in
expect index_of_lit: [1, 2].index_of([], 2) = 2 and [1, 2, 1].index_of([1], 1) = 2 and [1].index_of([2], 0) = -1  --~ warning: this is a call of `contains?`
expect at_lit: [5, 6].at(1) = [6] and [5, 6].at(2) = [] and [5, 6][1] = 6
expect search_lit: 2 in [1, 2] and [1, 2, 3].starts_with?([1]) and [1, 2, 3].ends_with?([2, 3]) and [1, 2, 3].contains?([2])
expect rev_lit: [1, 2].rev = [2, 1] and [1, 2].replace([2], [3, 4]) = [1, 3, 4]
--@ summary: 47 passed, 3 failed, 0 inconclusive, 0 redundant
--@ exit: 1
