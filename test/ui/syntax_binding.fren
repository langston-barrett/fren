-- A binding cannot be a bare `when`, which would swallow the bindings after it.
comp sub { in a? in b? }
--~^[hosted] warning: unused variable `a?`
--~^^[hosted] warning: unused variable `b?`
comp c { in x? inst s: sub { a? := when x?, x?, b? := x? } }
--~^[cli] error: `when` must be parenthesized here
--~^^[hosted] error: unexpected identifier; expected
comp ok { in x? inst s: sub { a? := (when x?, x?), b? := x? } }
--@ exit: 2
