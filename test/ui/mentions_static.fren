-- What an expression mentions (`lang::mentions`), for linear arithmetic
-- (`lang::linear_product`) and the decidable core.
set_option fren.lint.dead_code "allow"
set_option fren.lint.unused_variables "allow"

const RATE: Int := 3
enum E { A, V(Int) }
struct R { a: Int }
fn double(n: Int): Int := 2 * n
fn rate(Int): Int
fn pick(b?: Bool): String := if b? then "a" else "b"

-- Constants, defined functions applied to constants, variants and record
-- literals without variables, and methods of constants mention nothing.
comp constant { in x: Int pub out y: Int req r: y = x * RATE }
comp defined { in x: Int pub out y: Int req r: y = 2 * double(3) + double(3) * x }
comp variant { in x: Int pub out y: Int req r: y = match E::V(2) { E::V(k) => k, _ => 0 } * x }
comp record_literal { in x: Int pub out y: Int req r: y = R { a := 2 }.a * x }
comp method { in x: Int pub out y: Int req r: y = "abc".len * x }

-- Variables, and what mentions them.
comp shadowed { in RATE!: Int in x: Int pub out y: Int req r: y = x * RATE }
--~^ error: nonlinear arithmetic is not supported
-- The `fren` command drops the lints of an item with an error.
--~^^^[hosted] warning: variable `RATE` should have a snake case name
comp defined_arg { in x: Int in z: Int pub out y: Int req r: y = x * double(z) }
--~^ error: nonlinear arithmetic is not supported
comp uninterpreted { in x: Int pub out y: Int req r: y = x * rate(1) }
--~^ error: nonlinear arithmetic is not supported
comp record_field { in a: Int in x: Int pub out y: Int req r: y = R { a }.a * x }
--~^ error: nonlinear arithmetic is not supported
comp variable_method { in s: String in x: Int pub out y: Int req r: y = s.len * x }
--~^ error: nonlinear arithmetic is not supported

-- A defined output mentions what its definition mentions.
comp defined_constant { in x: Int pub out k: Int := 3 pub out y: Int req r: y = k * x }
--~^ warning: defined output `k` is the same in every behaviour
comp defined_input { in x: Int in z: Int pub out k: Int := z + 1 pub out y: Int req r: y = k * x }
--~^ error: nonlinear arithmetic is not supported

-- A binder mentions what its scrutinee mentions, whatever the arms.
comp scrutinee { in e: E in x: Int pub out y: Int req r: y = match e { E::V(k) => 1, _ => 2 } * x }
--~^ error: nonlinear arithmetic is not supported
comp binder { in e: E in x: Int pub out y: Int req r: y = match e { E::V(k) => k * x, _ => 0 } }
--~^ error: nonlinear arithmetic is not supported

-- An instance's variable is a variable.
comp inner { in a: Int pub out b: Int := a }
comp instance_variable { in x: Int inst i: inner { a := x } pub out y: Int req r: y = i.b * x }
--~^ error: nonlinear arithmetic is not supported

-- A defined function applied to constants is a constant for the decidable
-- core too; applied to a variable, it is not.
comp core_constant { in s: String pub out p? req r: p? iff s.starts_with?(pick(true)) }
comp core_variable { in s: String in b?: Bool pub out p? req r: p? iff s.starts_with?(pick(b?)) }
--~^ error: outside the decidable core: its argument is not a constant
