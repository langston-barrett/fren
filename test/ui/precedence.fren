-- Precedence and associativity: each expectation holds only if the
-- requirement parses as the manual says.
-- fren-covers: lang::operand

comp arith {
    in x: Int
    in y: Int
    in z: Int
    pub out a: Int
    pub out b: Int
    req left: a = x - y - z
    req tighter: b = x + y * 2
    expect left_assoc: a = (x - y) - z
    expect times_first: b = x + (y * 2)
}

comp logic {
    in p?
    in q?
    in r?
    pub out o?
    pub out n?
    pub out e?
    req unary: o? iff not p? and q? or r?
    req nested: n? iff (when p?, when q?, r?)
    req loose: e? iff (p? iff q? = r?)
    expect not_binds_tightly: o? iff (((not p?) and q?) or r?)
    expect right_nested: n? iff (when p?, (when q?, r?))
    expect iff_loosest: e? iff (p? iff (q? = r?))
}
