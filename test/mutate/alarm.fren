-- An alarm that rings above a threshold, through an instance of a
-- comparator that assumes its limit is positive. The comparator's
-- expectation and cover goal pin down its assumption, and the alarm's
-- expectations, local and global, pin down its rule.
mod alarm

pub proc threshold(x: Int, limit: Int): (det over?) {
    assume positive: limit > 0
    ensure rule: over? iff x > limit

    expect small: when x <= 1, not over?
    cover lowest: limit = 1
}

pub proc alarm(temp: Int): (det ring?) {
    call t := threshold(temp, 40)
    ensure rings: ring? iff t.over?

    expect hot: when temp = 41, ring?
}

expect quiet(a_temp: Int) {
    call a := alarm(a_temp)
    expect quiet: when a.temp <= 40, not a.ring?
}
