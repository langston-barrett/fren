-- A password rule: at least eight lowercase letters and digits, at least
-- one of them a letter.
mod password

const MIN_LENGTH: Int := 8

fn long_enough?(s: String) := s.len >= MIN_LENGTH

pub comp password {
    in text: String
    pub det out ok?

    ensure rule: ok? iff (long_enough?(text) and text.matches?(r"[0-9]*[a-z][a-z0-9]*"))

    expect short: when text = "abcdefg", not ok?
    expect letters: when text = "abcdefgh", ok?
    expect digits: when text = "12345678", not ok?
    expect letter_first: when text = "a1234567", ok?
    expect letter_last: when text = "1234567a", ok?
}
