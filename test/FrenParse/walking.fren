-- case: fixed_walking
pub mod skeleton

pub enum Light { Red, Amber, Green }

pub fn next(l: Light): Light := match l {
    Light::Red => Light::Green,
    Light::Green => Light::Amber,
    Light::Amber => Light::Red,
}

pub fn wait(l: Light, base: Int): Int := match l {
    Light::Red => base + 30,
    Light::Amber => base + 5,
    Light::Green => base,
}

expect cycles(l: Light) {
    expect back: next(next(next(l))) = l
}

expect waits(l: Light, base: Int) {
    assume bounded: base <= 100
    expect at_most: wait(l, base) <= 130
}

expect wrong(l: Light) {
    expect never_red: next(l) != Light::Red
}
-- result: context=0; mod skeleton; enum Light [Red,Amber,Green]; fn next (match l (Light::Red Light::Green) (Light::Green Light::Amber) (Light::Amber Light::Red)); fn wait (match l (Light::Red (+ base 30)) (Light::Amber (+ base 5)) (Light::Green base)); expect cycles [expect back (= (call next (call next (call next l))) l)]; expect waits [assume bounded (<= base 100),expect at_most (<= (call wait l base) 130)]; expect wrong [expect never_red (!= (call next l) Light::Red)]

