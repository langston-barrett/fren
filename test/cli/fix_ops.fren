--@ args: fix --check
-- `fren fix` fixes the operator and method lints.
set_option fren.lint.bool_equality "warn"
set_option fren.lint.undecidable "allow"

pub comp c {
    in a: Int
    in b: Int
    in x?
    in y?
    in s: String
    in t: String
    in u: Set(Int)
    pub out n: Int
    pub out m: Int
    pub out p?
    pub out q?
    pub out w?
    pub out z?

    req r1: p? iff (a > b or b > a) and (x? = y?)
    req r2: q? iff s.index_of(t, 0) <= -1 or s.slice(0, t.len) = t
    req r3: n = 1 * a + if x? then b else b + 1
    req r4: m = a - -b
    req r5: w? iff s ++ "" = t
    req r6: z? iff (u minus {}) = {} union u
}
