--@ args: fix --check
-- `fren fix` removes a lint setting in effect at no item, keeping the item
-- after `set_option ... in`, replaces a record literal that copies a value
-- with the value, and writes a `.` between letters or digits in a pattern
-- as `[.]`.
set_option fren.lint.disallowed_names "deny"
set_option fren.lint.style "allow"

struct Point { x: Int, y: Int }

set_option fren.lint.non_snake_case "allow" in
set_option fren.lint.non_snake_case "warn" in
comp copies {
    in p: Point
    in s: String
    pub out q: Point
    pub out ok?

    req r: q = Point { x := p.x, y := p.y }
    req m: ok? iff s.matches?(r"v1.2") and s.matches?(".*file.txt")
}

set_option fren.lint.style "warn"
