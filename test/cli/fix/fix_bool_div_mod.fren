--@ args: fix --check
-- `fren fix` keeps `div`, `mod` and the methods of `Int` as operands of a
-- comparison without parentheses, as they bind more tightly.
pub comp c {
    in x: Int
    in y: Int
    pub out o?
    pub out p?
    pub out q?

    req r1: o? iff not (x mod 2 = 0)
    req r2: p? iff not not (x div -3 < y mod 4 * 2)
    req r3: q? iff not ((x - y).abs >= x.min(y)) and not (2 * x div 3 != (x + 1) mod 5)
}
