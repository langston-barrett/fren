--@ args: fix --check
-- A fix that rewrites around a field read, a method call or an index of a
-- parenthesized receiver keeps the receiver's parentheses.
pub proc c(x: Int, y: Int, q: Seq<Int>, i: Int): (o?, p?, r?) {
    ensure r1: o? iff not ((x - y).abs = 0)
    ensure r2: p? iff not ((x - y).min(i) = 0)
    ensure r3: when 0 <= i and i < q.len, r? iff not ((q)[i] = 1)
}
