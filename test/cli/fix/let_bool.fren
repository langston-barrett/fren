--@ args: fix --check
-- `fren fix` keeps the parentheses that a `let` needs as an operand, and
-- simplifies within its body.
set_option fren.lint.let_and_return "allow" in
pub proc c(a?, x: Int): (o?, p?, q?) {
    ensure r1: o? iff not not (let k := 2 in x > k)
    ensure r2: p? iff (let b? := a? in b?) = true
    ensure r3: q? iff (let k := 2 in not (x < k)) and a?
}
