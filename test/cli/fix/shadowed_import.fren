--@ args: fix --check
-- An import that brings in a name that a `!` declaration hides is used, so
-- `fren fix` keeps it, and narrows a glob to keep that name, while it
-- removes the import that nothing uses. Otherwise `Square!` and `Red!`
-- would hide nothing, and fail with F0218.
set_option fren.lint.non_snake_case "allow"
set_option fren.lint.eq_op "allow"

pub enum Shape { Circle(Int), Square }
pub enum Color { Red, Green, Blue }

pub proc by_name(Square!: Int): (y: Int) {
    use self::Shape::Square
    use self::Color::Green

    ensure r: y = Square
}

pub proc by_glob(Red!: Int): (p?) {
    use self::Color::*

    ensure r: p? iff (Red > 0 and Blue = Blue)
}
