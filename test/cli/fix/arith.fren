--@ args: fix --check
-- `fren fix` fixes double parentheses and the arithmetic lints, with the
-- operands parenthesized where they need it, and only there, and the new
-- forms of `length_zero` and `membership_chain`.
set_option fren.lint.membership_chain "warn"

fn f(Int): Int

pub comp c {
    in x: Int
    in y: Int
    in s: String
    in q: Seq(Int)
    pub out a? := (((x > 0))) and f(((y))) > 0
    pub out b: Int := - -(x + y) * 2 + f(-(-(x))) + f(- - -y)
    pub out d: Int := (x + y) * -1 + -1 * f(x) + x * (-1) * -1
    pub out e? := x >= y + 1 and 1 + y <= x and x - 1 >= y and y <= x - 1 and x - 1 >= y + 1
    pub out g? := 0 < s.len or 1 <= q.len or s.len != 0 or q.len < 1 or 0 = s.len
    pub out h? := (x != 1 and x != 2 and x != y) or (q != [] and (y = 1 or y = q[0] or y = 2))
}
