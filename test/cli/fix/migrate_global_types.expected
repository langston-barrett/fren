--- test/cli/fix/migrate_global_types.fren
+++ test/cli/fix/migrate_global_types.fren
@@ -14 +14,10 @@
-expect same: forall (a b: p), when a.n = b.n and a.x = b.x, a.y = b.y
+expect same(a_x: Seq<source::E>, a_n: Int is -10..=10, b_x: Seq<source::E>, b_n: Int is -10..=10) {
+    use source
+    assume a_present: a_x != [] and a_x[0] = source::E::A
+    assume a_range: a_n > source::LOW
+    assume b_present: b_x != [] and b_x[0] = source::E::A
+    assume b_range: b_n > source::LOW
+    call a := p(a_x, a_n)
+    call b := p(b_x, b_n)
+    expect same: when a.n = b.n and a.x = b.x, a.y = b.y
+}
exit=1
