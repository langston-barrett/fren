--@ args: fix --check
-- `fren fix` writes trivial patterns as equations and calls, escaping the
-- string, with parentheses only where an operand needs them.
pub proc c(s: String, t: String): (p?, k?) {
    ensure r1: p? iff s.matches?("abc") and s.matches?(r"a\.b\\.*") and s.matches?(".*x") and s.matches?(r#".*"\(.*"#) and s.matches?("a\nb")
    ensure r2: k? = (s ++ t).matches?("q") and not (s ++ t).matches?(".*q")
}
