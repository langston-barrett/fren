--@ args: fix --check -W arbitrary_source_item_ordering
-- `fren fix` puts the members of a component in order, each with its
-- comments and the blank lines before it, but for the first.
enum Shape { Square, Circle }

proc helper(x: Int): (v: Int) {
    ensure r: v = x
}

proc c(x: Int, shape: Shape): (
    -- The result.
    det y: Int,         -- a trailing comment
) {
    ensure first: x >= 0

    ensure r: y = x + w.v
    expect square: shape = Square or y = x + w.v
    set_option fren.evidence "tested" in
    call w := helper(x)
    use self::Shape::Square
    assume small: x < 100
}

-- Not fixed: in order, `z` would come before the instance it mentions.
proc mentions(x: Int): (y: Int) {
    call w := helper(x)
    let z: Int := w.v
    ensure r: y = z
}

-- Not fixed: two members on one line.
proc one_line(x: Int): (y: Int) { ensure r: y = x }
