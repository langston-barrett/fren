--@ args: fix --check
-- Fixes that rewrite around `div` and `mod` keep their operands bound as
-- written: `div` and `mod` bind as tightly as `*`, and are left-associative.
pub proc c(x: Int, c?): (a: Int, b: Int, d: Int, e: Int) {
    ensure ra: a = 3 * if c? then x mod 2 else x mod 2
    ensure rb: b = x div 2 * 1
    ensure rd: d = 1 * (x + 1) mod 3
    ensure re: e = (x mod 4 * 1).max(1).min(x div -2) + 0
}
