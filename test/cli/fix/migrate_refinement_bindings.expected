--- test/cli/fix/migrate_refinement_bindings.fren
+++ test/cli/fix/migrate_refinement_bindings.fren
@@ -10 +10,5 @@
-refine shifted: implementation refines spec { x := z - 1 }
+expect shifted(z: Int) {
+    assume spec_domain: (z - 1) > -1
+    call concrete := implementation(z)
+    refines concrete spec(z - 1)
+}
@@ -20 +24,5 @@
-refine preserves_names: swapped refines pair_spec {}
+expect preserves_names(x: Int) {
+    call concrete := swapped(x)
+    expect first_value: (concrete.first) = (x)
+    expect second_value: (concrete.second) = (x) + 1
+}
exit=1
