--@ args: fix --check -A undecidable
-- `fren fix` compares a length read through a field with an empty
-- collection, and keeps the receiver's parentheses.
struct R { s: String, q: Seq(Int), t: Set(Int), x: Int }

pub comp c {
    in r: R
    pub out p1?
    pub out p2?
    pub out p3?

    req r1: p1? iff (r).s.len = 0 or (r).t.card > 0
    req r2: p2? iff { r with x := 1 }.q.len != 0
    req r3: p3? iff ("ab" ++ (r).s).len = 0
}
