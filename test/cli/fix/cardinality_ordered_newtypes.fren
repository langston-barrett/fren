--@ args: fix --check -W manual_ordering
-- The fixes of `manual_at_most_one`, `manual_ordering`,
-- `redundant_newtype_roundtrip`, `unnecessary_min_or_max`, and of
-- `nonminimal_bool` on a cardinality operator of one argument.
pub ordered enum Level { Low, Mid, High, Top }
pub struct Ms(Int)
pub struct Qs(Seq<Int>)

pub proc c(a?, b?, c?, d?, l: Level, x: Ms, n: Int, q: Seq<Int>, i: Int): (
    p1?,
    p2?,
    p3?,
    p4?,
    p5?,
    p6?,
    p7?,
    p8?,
    m1: Level,
    m2: Level,
    y: Ms,
    k: Int,
    g1?,
    g2?,
) {
    ensure r1: p1? iff not (a? and b?) and not (a? and c?) and not (b? and c?)
    ensure r2: p2? iff d? and (a? or b? or c?) and not (b? and a?) and not (c? and a?) and not (c? and b?)
    ensure r3: p3? iff not (a? and b?) and not (a? and c?) and not (b? and c?) and (c? or b? or a?) and d?
    ensure r4: p4? iff l in {Level::Low, Level::Mid}
    ensure r5: p5? iff l = Level::Top or l = Level::High
    ensure r6: p6? iff l != Level::Low and l != Level::Mid
    ensure r7: p7? iff not exactly_one?(a? or b?)
    ensure r8: p8? iff at_most_one?(d?) and c?
    ensure r9: m1 = l.max(Level::Low)
    ensure r10: m2 = l.min(Level::Low)
    ensure r11: y = Ms(x.0)
    ensure r12: k = 2 * Ms(n + 1).0
    -- Neither is fixed: an operand's guard, and an empty literal.
    ensure r13: g1? iff not (ok? and big?) and not (ok2? and big?) and not (ok? and ok2?)
        where ok? := 0 <= i < q.len, ok2? := 0 <= i < q.len and d?, big? := q[i] > 0
    ensure r14: g2? iff Qs([]).0.len = q.len
}
