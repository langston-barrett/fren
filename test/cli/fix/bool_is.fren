--@ args: fix --check
-- The simpler forms of `nonminimal_bool` keep the parentheses that a
-- pattern test needs as an operand, since it binds as a comparison.
pub enum Shape { Circle(Int), Empty }

pub proc c(s: Shape, b?): (ok?, z?) {
    ensure r: ok? = if s is Shape::Circle(_) then true else false
    ensure q: z? iff not ((s is Shape::Circle(_)) = b?)
}
