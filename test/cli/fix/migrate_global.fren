--@ args: fix --check --fmt
-- fren-covers: lang::global_migration_name
-- Fresh names, multiple behaviours, mixed value binders, a local
-- definition in a precondition, and a where clause in the old body.
proc p(x: Int): (det y: Int) {
    let limit: Int := x + 1
    assume positive: limit > 0
    ensure value: y = x
}
expect same: forall (a b: p) (a_x: Int) (m?: Bool), when a.x = b.x and m? and a_x = 0, a.y = v where v: Int := b.y
