--@ args: fix --check
-- Old global expectations that `fren fix` leaves as they are (F0416), since
-- the fix would change what they mean or leave an error: a binder over
-- values that hides a constant that the procedure's assumption reads, an
-- assumption that declares with `!` a variable of its own, and a
-- quantifier in the body over a procedure.
const LIM: Int := 5

proc band(target: Int): (y: Int) {
    assume sane: target > LIM
    ensure r: y = target
}

proc shadowed(x: Int): (y: Int) {
    assume a1: match x { y! => y > 0 }
    ensure r: y = x
}

expect cap: forall (b: band) (LIM!: Int), when LIM < 0, b.target > 5
expect bang: forall (s: shadowed), s.y > 0
expect inner: forall (a: band), forall (b: band), a.y = b.y
