--@ args: fix --check -W if_chain_match
-- `if_chain_match` on pattern tests with payloads, and `match_like_membership`
-- on literal, range and nested patterns.
enum Shade { Light, Dark, Tinted(Int) }

pub comp c {
    in s: Shade
    in n: Int
    pub out k: Int
    pub out a?
    pub out b?
    pub out d?

    ensure r1: k = if s is Shade::Tinted(_) then 1 else if s is Shade::Dark | Shade::Light then 2 else 3
    ensure r2: a? iff match n { 0 | 1 => true, _ => false }
    ensure r3: b? iff match n { 0..=9 => true, _ => false }
    ensure r4: d? iff match s { Shade::Tinted(0) => false, _ => true }
}
