--@ args: fix --check
-- The fixes of `is_equality`, `match_like_membership` to a pattern test,
-- `chainable_comparison`, and `int_plus_one` within a chain.
enum Shade { Light, Dark, Tinted(Int) }

pub proc c(s: Shade, i: Int, n: Int, m: Int, p?): (a?, b?, d?, e?, f?, g?, h?, j?, k?) {
    ensure r1: a? iff s is Shade::Light
    ensure r2: b? iff not (s) is Shade::Light | Shade::Dark
    ensure r3: d? iff match s { Shade::Light => false, Shade::Dark | Shade::Tinted(_) => true }
    ensure r4: e? = match s { Shade::Tinted(_) => true, _ => false }
    ensure r5: f? iff p? and 0 <= i and i < n and m > 0
    ensure r6: g? iff i < n and i > 0
    ensure r7: h? iff 0 < i and i < n and n < m
    ensure r8: j? iff 0 <= i and i <= n - 1
    ensure r9: k? iff n - 1 >= i and i >= 0
}
