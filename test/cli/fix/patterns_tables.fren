--@ args: fix --check -W unnested_or_patterns -W match_bool -W single_match_else
-- `fren fix` fixes the lints of nested, literal and range patterns, and of
-- tables.
-- fren-covers: lint::collapsible_match, lint::wildcard_in_or_patterns, lint::manual_range_patterns, lint::unnested_or_patterns, lint::match_bool, lint::single_match_else, lint::same_rows
enum Shape { Circle(Int), Square(Int), Empty }
enum Reply { Ok(Shape), Err(Int) }
enum Pair { Two(Shape, Int), None }

proc c(r: Reply, p: Pair, n: Int, s: Shape, b?): (
    det a: Int,
    det d: Int,
    det e: Int,
    det f: Int,
    det g: Int,
    det h: Int,
    det i: Int,
    det j: Int,
) {
    out a := match r {
        Reply::Ok(x) => match x { Shape::Circle(_) => 1, Shape::Square(1 | 2) => 2, _ => 0 },
        _ => 0,
    }
    out d := match p { Pair::Two(t, k) => match t { Shape::Empty => k, _ => 0 }, _ => 0 }
    out e := match n { 1 | 2 | 3 => 1, 4 | 5 => 2, ..=0 | 6.. => 3 }
    out f := match s { Shape::Circle(1) | Shape::Circle(2) => 1, Shape::Empty | _ => 0 }
    out g := 3 * match b? { true => n, false => 0 }
    out h := table { n > 0 => n + 1, _ => n + 1 } + 1
    out i := match r { Reply::Ok(Shape::Circle(_)) => 1, _ => 0 }
    out j := match n { 0..=9 => 1, _ => 0 }
}
