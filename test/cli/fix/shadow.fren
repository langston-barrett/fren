--@ args: fix --check
-- `fren fix` cannot apply the fixes of static errors, so it only suggests
-- the `!` of explicit shadowing, and its removal.
pub const LIMIT: Int := 3

pub proc c(LIMIT: Int): (p?) {
    ensure r: p? iff LIMIT > 0
}

pub proc d(y!: Int): (p?) {
    ensure r: p? iff y < LIMIT
}
