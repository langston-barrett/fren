--@ args: fix --check
-- `fren fix` drops the leading zeros of a decimal literal.
-- fren-covers: lint::zero_prefixed_literal
const LIMIT: Int := 0100

proc c(x: Int): (p?, q?) {
    ensure r1: p? iff x < 010 or x = 00_1 or x = 01_000 or x = -00 or x = 0x10
    ensure r2: q? iff x in {07, 0, LIMIT}
}
