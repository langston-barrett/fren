--@ args: fix --check
-- `fren fix` removes a constraint or global expectation that repeats one of
-- its kind, writes invisible characters in a literal as escapes, removes
-- them from a comment, and replaces `when true, D` and `unless false, D`
-- with `D`. An expectation that repeats a guarantee is kept.
proc c(a?, b?, s: String): (p?, q?, o?) {
    ensure r1: p? iff a? or b?
    ensure r2: p?  iff  a? or b?
    ensure r3: when true, q? iff a?
    ensure r4: o? iff (unless false, b?) and s.matches?(r"a​[0-9]\\") and s != "‮"
    expect e1: p? iff a? or b?
    expect e2: when a?, p?
    expect e3: when a?,
        p?  -- a repeat
    -- a ⁦comment⁩
}

expect g1(x_a?, x_b?, x_s: String) {
    call x := c(x_a?, x_b?, x_s)
    expect g1: when x.a?, x.p?
}
set_option fren.lint.eq_op "allow" in
expect g2(x_a?, x_b?, x_s: String) {
    call x := c(x_a?, x_b?, x_s)
    expect g2: when x.a?, x.p?
}
