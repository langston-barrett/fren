--@ args: fix --check
-- `fren fix` removes a condition that decides nothing, parenthesizing the
-- branch where `lang::operand` requires it, and removes repeated elements,
-- with the separator before each. `eq_op` and `empty_argument` have no fix.
comp c {
    in a?
    in b?
    in x: Int
    in t: Set(Int)
    in r: Rel(Int, Int)
    in s: String
    pub out p1?
    pub out p2?
    pub out p3?
    pub out p4?
    pub out p5?
    pub out n1: Int
    pub out n2: Int
    pub out n3: Int
    pub out n4: Int

    req r1: n1 = if a? then x+1 else x + 1
    req r2: n2 = 2 * if a? then x + 1 else (x + 1)
    req r3: n3 = x - if a? then -x else -x
    req r4: n4 = -if a? then x * 2 else x * 2
    req r5: p1? iff b? and (if a? then b? or x > 0 else b? or x > 0)
    req r6: p2? iff not if a? then b? else b?
    req r7: p3? iff t = {1, 2, 1, 3, 2,}
    req r8: p4? iff r = {
        (1, 2),
        (2, 3),
        (1,2),
    }
    req r9: p5? iff (x = x) and s.contains?("") and t != {}
}
