--@ args: fix --check -W if_not_else
-- `fren fix` rewrites conditionals, keeping operands' parentheses only where
-- they are needed.
comp c {
    in a?
    in b?
    in x: Int
    in y: Int
    pub out p?
    pub out q?
    pub out m: Int
    pub out n: Int

    req r1: unless not (a? or b?), p?
    req r2: unless x != y, q?
    req r3: when a?, when (b? or p?), q?
    req r4: unless (a? iff b?), unless x = 1, p?
    req r5: m = if not a? then x else y
    req r6: n = if x != y then (if a? then x else y) else 0
    req r7: p? or if not q? then a? else b?
}
