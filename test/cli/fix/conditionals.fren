--@ args: fix --check -W if_not_else
-- `fren fix` rewrites conditionals, keeping operands' parentheses only where
-- they are needed.
proc c(a?, b?, x: Int, y: Int): (p?, q?, m: Int, n: Int) {
    ensure r1: unless not (a? or b?), p?
    ensure r2: unless x != y, q?
    ensure r3: when a?, when (b? or p?), q?
    ensure r4: unless (a? iff b?), unless x = 1, p?
    ensure r5: m = if not a? then x else y
    ensure r6: n = if x != y then (if a? then x else y) else 0
    ensure r7: p? or if not q? then a? else b?
}
