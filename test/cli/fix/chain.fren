--@ args: fix --check -W pedantic -A definable_output -A many_single_char_names
-- `fren fix` writes a chain of `if` as a `match`, and `x := x` as `x`.
enum Mode { Heat, Cool, Off }

struct Point { x: Int, y: Int }

proc sub(x: Int): (p?) {
    ensure r: p? iff x > 0
}

pub proc c(m: Mode, x: Int, a?): (y: Int, z: Int, q?) {
    call s := sub(x)

    ensure r1: y = if m = Mode::Heat then 1 else if m in {Mode::Cool, Mode::Off} then 2 else 0
    ensure r2: q? iff if m = Mode::Heat then a? else if m = Mode::Cool then (when x > 0, a?) else not a?
    ensure r3: z = Point { x := x, y := 2 * if m = Mode::Off then 1 else if m = Mode::Heat then 2 else 3 + x }.y
}
