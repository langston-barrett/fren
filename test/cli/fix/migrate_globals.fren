--@ args: fix --check
-- `fren fix` migrates global expectations written with a `forall` over
-- procedures' behaviours (`Reqs/Lang/Global#migration`): each binder's
-- parameters, the procedures' assumptions, with their imports, the calls,
-- and the claim, with its comments.
mod m

pub enum Mode { Heat, Cool, Off }

struct R { x: Int }

fn twice(f: fn(Int) -> Int, x: Int): Int := f(f(x))

proc band(temp: Int, target: Int is 50..=90): (too_cold?, too_hot?) {
    use self::Mode::Heat
    assume sane: target != 70 or Heat = Mode::Heat
    ensure cold: too_cold? iff temp < target - 2
    ensure hot: too_hot? iff temp > target + 2
}

proc pick(r: R, m: Mode): (y: Int) {
    assume positive: twice(|v| v + r.x, 0) > 0 and R { x := 1 } != r
    ensure value: y = r.x
}

expect colder_is_cold: forall (a b: band),   -- monotone
    when a.target = b.target and a.temp <= b.temp and b.too_cold?, a.too_cold? or unused = 1
        where unused := 1  -- the `where` goes with it, with its comment

expect mixed: forall (a: band) (m: Mode), when m = Mode::Heat, a.too_cold? or not a.too_cold?

expect picked: forall (p: pick), p.y > 0 or unused = 1
    where unused := 0
