--@ args: fix --check -W allow_attributes -W wildcard_enum_match_arm -W needless_raw_strings -W non_ascii_literal -W precedence -W wildcard_single_variant
-- `fren fix` fixes the lints of the `restriction` group that it can.
-- Nothing needs this one, so its expectation is unfulfilled, and removed.
set_option fren.lint.glob_imports "allow"
-- This one is needed, so it stays, as an expectation.
set_option fren.lint.unused_variables "allow"
set_option fren.lint.unfulfilled_lint_expectations "allow"

enum Mode { Heat, Cool, Off, Auto }
enum Shape { Circle(Int), Rect(Int, Int), Dot }

comp fixes {
    use self::Mode::{Cool, Heat}
    in mode: Mode
    in shape: Shape
    in text: String
    in spare: Int
    in first?
    in second?
    in third?
    in left: Set(Int)
    in right: Set(Int)
    in other: Set(Int)
    pub out level: Int
    pub out size: Int
    pub out single: Int
    pub out lower?
    pub out quoted?
    pub out accented?
    pub out astral?
    pub out loose?
    pub out open_ended?
    pub out sets: Set(Int) := left minus right inter other

    -- Written as the other arms write their variants.
    ensure wildcard: level = match mode { Heat => 1, Cool => 2, _ => 3 }
    -- `wildcard_single_variant` has the same fix, made once.
    ensure single_rule: single = match mode { Heat => 1, Cool => 2, Mode::Off => 3, _ => 4 }
    ensure payloads: size = match shape { Shape::Dot => 0, _ => 1 }
    ensure raw: lower? iff text.matches?(r"[a-z]+")
    -- A `"` needs the raw literal.
    ensure raw_quoted: quoted? iff text.matches?(r#"a"[a-z]"#)
    -- A raw literal becomes an ordinary one, with escapes.
    ensure accented_rule: accented? iff text.matches?(r"caf[éè]\.")
    -- Beyond `U+FFFF`, there is no escape.
    ensure astral_rule: astral? iff text = "😀é"
    ensure loose_rule: loose? iff (first? or second? and third?)
    -- An operand that ends in an `if` is put in parentheses whole.
    ensure open_ended_rule: open_ended? iff (first? or second? and if third? then first? else level > 0)
}
