--@ args: fix --check
-- `x!=1` reads `x!` then `=`: the first suggestion makes it the comparison,
-- and the second, for a name written with `!`, removes the `!`. Neither is
-- applied, since the error is static.
pub proc c(x: Int): (p?) {
    ensure r: p? iff x!=1
}

-- Where no `=` follows, only the second applies: `x !` would not parse.
pub proc d(x: Int): (p?) {
    ensure r: p? iff x!
}
