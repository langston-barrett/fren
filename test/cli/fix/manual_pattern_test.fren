--@ args: fix --check
-- `fren fix` writes equations of one expression with values that patterns
-- write as a pattern test, with the pattern tests among them, and the dual
-- as a negated one.
enum Shade { Light, Dark, Tinted(Int) }

fn count(b?): Int := if b? then 1 else 0

pub comp c {
    in s: Shade
    in x: Int
    in t: String
    in q: Seq<Int>
    in p?
    pub out a? := x = 429 or 503 = x
    pub out b? := x = 429 or x is 500..=599
    pub out d? := p? or (x = 1) or x = 2 or t = "a"
    pub out e? := x != 0 and not x is 10..
    pub out f? := s = Shade::Light or s is Shade::Tinted(_)
    pub out g? := q != [] and (q[0] = 1 or q[0] = 2)
    pub out h? := not (t = "a" or t = "b") and p?
    pub out i? := x = 1 or x = 2 or x = 3
    -- Parentheses that are not an operator's operand stay.
    pub out k? := match (x = 1 or x = 2) { true => p?, false => false }
    pub out l: Int := table { (x = 1 or x = 2) => 0, x > 5 => 1, _ => 2 }
    pub out m: Int := count(x = 1 or x = 2)
    pub out n? := s is Shade::Tinted(1..=3) or s = Shade::Light
    -- A comment within the operands: no fix.
    pub out j? := x = 1 or /- one more -/ x = 2
}
