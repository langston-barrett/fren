--@ args: fix --check
-- `fren fix` writes equations of one expression with values that patterns
-- write as a pattern test, with the pattern tests among them, and the dual
-- as a negated one.
enum Shade { Light, Dark, Tinted(Int) }

fn count(b?): Int := if b? then 1 else 0

pub proc c(s: Shade, x: Int, t: String, q: Seq<Int>, p?): (
    a?,
    b?,
    d?,
    e?,
    f?,
    g?,
    h?,
    i?,
    k?,
    l: Int,
    m: Int,
    n?,
    j?,
) {
    out a? := x = 429 or 503 = x
    out b? := x = 429 or x is 500..=599
    out d? := p? or (x = 1) or x = 2 or t = "a"
    out e? := x != 0 and not x is 10..
    out f? := s = Shade::Light or s is Shade::Tinted(_)
    out g? := q != [] and (q[0] = 1 or q[0] = 2)
    out h? := not (t = "a" or t = "b") and p?
    out i? := x = 1 or x = 2 or x = 3
    -- Parentheses that are not an operator's operand stay.
    out k? := match (x = 1 or x = 2) { true => p?, false => false }
    out l := table { (x = 1 or x = 2) => 0, x > 5 => 1, _ => 2 }
    out m := count(x = 1 or x = 2)
    out n? := s is Shade::Tinted(1..=3) or s = Shade::Light
    -- A comment within the operands: no fix.
    out j? := x = 1 or /- one more -/ x = 2
}
