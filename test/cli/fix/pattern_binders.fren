--@ args: fix --check
-- `fren fix` leaves an `if` whose condition's pattern test binds a name as
-- it is: its branches may be written the same and mean different values
-- (`lang::test_scope`), and rewriting it could move the name out of scope.
-- Elsewhere in the same item, it still fixes what it can.
enum Reply { Empty, Value(Int) }
proc c(r: Reply, v: Int, a?): (w: Int, m: Int, o?, p?) {
    ensure same: w = (if r is Reply::Value(v!) then v else v)
    ensure method: m = (if r is Reply::Value(v!) then v.max(0) else v.max(0))
    ensure bool: o? iff (if r is Reply::Value(v!) then v > 0 else false)
    ensure other: p? iff (if a? then true else false)
}
