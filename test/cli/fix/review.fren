--@ args: fix --check
-- Fixes around parentheses and comments: a repeated element in parentheses
-- is removed with them, and a comment between an operator and an `if`
-- whose branches are the same does not hide the operator, so the branch is
-- still parenthesized.
proc c(a?, x: Int, t: Set<Int>): (p1?, p2?, n: Int) {
    ensure r1: p1? iff t = {(x), x}
    ensure r2: p2? iff t = {x, (x)}
    ensure r3: n = 2 * -- a comment
        if a? then x + 1 else x + 1
}
