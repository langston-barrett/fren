--@ args: fix --check -W match_could_be_table
-- `fren fix` writes a `match` whose arms are disjoint as a table.
-- fren-covers: lint::match_could_be_table
enum Shape { Circle(Int), Square(Int), Empty }

proc c(s: Shape, k: Int): (det a: Int, det b: Int, det c: Int) {
    out a := match s { Shape::Circle(_) => 1, Shape::Square(_) => 2, Shape::Empty => 0 }
    out b := 2 * match k { ..=-1 => -1, 0 => 0, 1.. => 1 }
    -- The arms overlap: the order matters.
    out c := match k { 0..=5 => 1, 3..=9 => 2, _ => 0 }
}
