--@ args: fix --check
-- `fren fix` leaves a procedure that only claims as it is: writing `expect`
-- in place of `proc` would break a call of it in a file it is not given, so
-- `proc_without_outputs` has no fix.
set_option fren.lint.proc_without_outputs "warn"

pub proc band(temp: Int): (cold?) { ensure rule: cold? iff temp < 18 }

proc colder_is_cold(a: Int, b: Int) {
    assume sorted: a <= b
    call x := band(a)
    call y := band(b)
    expect colder: when y.cold?, x.cold?
}

proc nothing() {}
