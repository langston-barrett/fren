-- Two guarantees that force an output of an enumeration only to variants,
-- different ones, and a whole value against a variant of a payload of two
-- values (F0601).
-- fren-covers: check::clash_notes
enum Shape { Circle(Int), Square(Int), Rect(Int, Int), Empty }

proc variants(): (s: Shape) {
    ensure round: s is Shape::Circle(_)
    ensure square: s is Shape::Square(_)
}

proc mixed(x: Int): (s: Shape) {
    ensure one: s = Shape::Circle(x)
    ensure boxy: s is Shape::Rect(_, _)
}
