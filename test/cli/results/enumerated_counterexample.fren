-- A counterexample found by enumeration, the smallest, shown as the
-- solver's are (`Reqs/Check#checking-by-enumeration`).
enum Mode { Off, Heat, Cool }

set_option fren.evidence "enumerated" in
proc thermostat(mode: Mode, temp: Int is -2..=2): (det on?) {
    ensure r: on? iff (mode = Mode::Heat and temp < 0)
    expect cold: when mode = Mode::Heat, on?
}
