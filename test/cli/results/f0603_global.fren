-- A global expectation that does not hold (F0603), and one that is vacuous
-- (F0605).
set_option fren.lint.chainable_comparison "allow"
const HIGH: Int := 10

proc band(temp: Int, target: Int): (too_cold?) {
    assume sane: 0 <= target and target <= HIGH
    ensure cold: too_cold? iff temp < target - 2
}

expect same(a_temp: Int, a_target: Int, b_temp: Int, b_target: Int) {
    assume a_sane: 0 <= a_target and a_target <= HIGH
    assume b_sane: 0 <= b_target and b_target <= HIGH
    call a := band(a_temp, a_target)
    call b := band(b_temp, b_target)
    expect same: when a.temp = b.temp, a.too_cold? iff b.too_cold?
}
expect never(a_temp: Int, a_target: Int) {
    assume a_sane: 0 <= a_target and a_target <= HIGH
    call a := band(a_temp, a_target)
    expect never: when a.target > HIGH, a.too_cold?
}
