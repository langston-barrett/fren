-- Two arms of a table over a scrutinee that may both be taken: both
-- guards hold where `x` is 0.
enum Mode { Off, On(Int) }

comp level {
    in m: Mode
    pub out y: Int

    ensure r: y = table m {
        Mode::Off => 0,
        Mode::On(x) if x >= 0 => x,
        Mode::On(x) if x <= 0 => 1,
    }
}
