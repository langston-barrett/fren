--@ args: check
-- Under `fren check`, with testing as the evidence, a procedure's own
-- assumption that has no value in any input gets `F0617` beside the
-- procedure's `F0610`, which it explains: `q[7]` is out of range in every
-- test.
set_option fren.evidence "random"

pub proc guarded(q: Seq<Int>): (n: Int) {
    assume seventh: q[7] > 0
    ensure r: n = q.len
}
