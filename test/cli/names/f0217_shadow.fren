-- Declarations that hide a name in scope, without `!`.
mod rates
pub const RATE: Int := 2

mod plant
use rates::RATE
set_option fren.lint.non_snake_case "allow"

pub enum Shape { Circle(Int), Square }

pub proc c(RATE: Int): (y: Int) {
    ensure r: y = RATE
}

pub proc d(x: Int, s: Shape): (p?) {
    ensure r: p? iff match s {
        Shape::Circle(x) => x > 0,
        _ => x > 0,
    }
}
