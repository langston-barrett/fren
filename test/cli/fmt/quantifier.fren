--@ args: fmt --check
-- `fren fmt` spaces a quantifier's binders as a global expectation's, and
-- indents a body that continues on the next line.
enum Mode { Off, Heat }
comp c {
  in m: Mode
  pub out o?
  req r:o? iff(forall(k   j:Mode)  ( n :Mode),k=m or j = n)
  req s: o? iff (exists (k: Mode),
  k = m)
}
