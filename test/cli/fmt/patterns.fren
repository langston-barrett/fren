--@ args: fmt --check
-- `fren fmt` writes a nested pattern's payload like a call's arguments, a
-- negative literal without a space, and a range without spaces in it.
enum Shape { Circle(Int), Empty }
enum Reply { Ok(Shape), Err(Int) }
const MAX: Int := 9
proc c(r: Reply): (y: Int) {
    ensure q: y = match r {
        Reply::Ok( Shape::Circle(_)|Shape::Empty ) => 0,
        Reply::Err(- 1) => 1,
        Reply::Err(-5..=MAX|10..) => 2,
        _ => 3,
    }
}
