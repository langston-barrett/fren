--@ args: fmt --check
-- A blank line goes before and after each top-level item that spans
-- several lines, as laid out, and a run of one-line items keeps the blank
-- lines it has. The comments just above an item go with it, so the blank
-- line goes above them; a `--~` annotation goes with the line above it; a
-- `set_option ... in` is part of the item after it.
pub enum Mode { Heat, Cool }
proc packed(m: Mode): (on?) { ensure r: on? iff m = Mode::Heat }
proc tall(m: Mode): (on?) {
    ensure r: on? iff m = Mode::Heat
    ensure s: on? iff m != Mode::Cool
}
proc after_tall(m: Mode): (on?) { ensure r: on? iff m = Mode::Heat }
proc spaced(m: Mode): (on?) { ensure r: on? iff m = Mode::Heat }

proc packed_again(m: Mode): (on?) { ensure r: on? iff m = Mode::Heat }
-- Documents `documented`: the blank line goes above this comment.
proc documented(m: Mode): (on?) {
    ensure r: on? iff m = Mode::Heat
    ensure s: on? iff m != Mode::Cool
}
proc annotated(m: Mode): (on?) {
    ensure r: on? iff m = Mode::Heat
    ensure s: on? iff m != Mode::Cool
}
--~^ an annotation of the line above, which stays under it
proc after_annotation(m: Mode): (on?) { ensure r: on? iff m = Mode::Heat }
set_option fren.lint.constant_output "allow" in
proc zero(): (r: Int) { out r := 0 }
set_option fren.lint.constant_output "allow" in
proc one(): (r: Int) { out r := 1 }
-- Laid out on several lines, though written on one.
proc two_members_on_one_line(m: Mode): (on?) { ensure r: on? iff m = Mode::Heat ensure s: on? }
-- Laid out on one line, though written on several.
proc joined(m: Mode): (on?) {
    ensure r: on? iff m = Mode::Heat
}
proc after_joined(m: Mode): (on?) { ensure r: on? iff m = Mode::Heat }
-- A comment just after an item, apart from the next, stays where it is.

proc after_comment(m: Mode): (on?) {
    ensure r: on? iff m = Mode::Heat
    ensure s: on? iff m != Mode::Cool
}
-- A comment just after an item goes with the item after it.
fn last(m: Mode) := m = Mode::Heat
