--@ args: fmt --check
-- `fren fmt` lays out a table over a scrutinee as a `match`: its arms are
-- spaced as any other, one to a line, each `|` that starts a line starts
-- its alternative, and every arm gets a trailing comma, as a table by
-- conditions does.
enum Mode { Off, Heat, Cool }

proc c(m: Mode, t: Int): (y: Int) {
    ensure a: y = table m {Mode::Off if t>0=>1,_=>0}
    ensure b: y = table m {
    | Mode::Off
          | Mode::Heat if t > 0 =>
    1,
    Mode::Cool   if   (t < 0 and t > -5) => 2,
    _ => 0
    }
    ensure d: y = table {t>0=>1,_=>0}
}
