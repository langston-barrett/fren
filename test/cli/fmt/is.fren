--@ args: fmt --check
-- `fren fmt` spaces `is` as a comparison, and the `|` of its pattern as in
-- an arm, and lines up the alternatives written one per line.
enum Shape { Circle(Int), Rect(Int, Int), Empty }
comp c {
in s: Shape
  pub out o?
  req r :o? iff s is   Shape::Circle(_)|Shape::Rect(_,_)
  req l: o? iff s is
  | Shape::Circle(_)
      | Shape::Empty
}
