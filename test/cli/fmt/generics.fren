--@ args: fmt --check
-- `fren fmt` writes type parameters and type arguments as a call's
-- parentheses, directly after the name.
pub enum Option(  T ) { None, Some( T ) }
pub struct Pair( A,B ) { fst: A, snd: B }
comp c {
    in x: Option(Pair( Int,Bool ))
    pub out y: Option(Int)
    ensure r: y = Option::None
}
