--@ args: fmt --check
-- `fren fmt` writes type parameters and type arguments in angle brackets
-- spaced as a call's parentheses, directly after the name, and a
-- comparison's `<` and `>` with spaces.
pub enum Option<  T > { None, Some( T ) }
pub struct Pair< A,B > { fst: A, snd: B }
proc c(x: Option<Pair< Int,Bool >>, s: Set< Option< Set<Int> > >, n: Int): (y: Option<Int>) {
    ensure r: y = Option::None
    ensure q: forall (t: Set< Int >), n<3 or n>t.card
}
