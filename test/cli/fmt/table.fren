--@ args: fmt --check
-- `fren fmt` puts a table's rows one to a line, as a `match`'s arms, and
-- gives every row a trailing comma.
proc c(x: Int): (y: Int) {
    ensure a: y = table {x > 0=>1,_=>0}
    ensure b: y = table {
    x > 0 => 1,
          x <= 0 =>
    0
    }
    ensure d: y = table { x > 0 => 1, _ => 0, }
}
