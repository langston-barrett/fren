--@ args: fmt --check
-- `fren fmt` writes a pattern type's `is` between spaces, and its range
-- without them, and a type alias's `:=` between spaces.
type   Byte:=Int   is  0..=255
pub enum Level { Low, High }
type Loud :=Level is Level::High|Level::Low
proc c(b: Set< Byte >, n:Int is 1..): (l: Loud) {
    ensure r: l = Level::High
}
