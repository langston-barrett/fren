--@ args: fmt --check
-- `fren fmt` writes a pattern type's `is` between spaces, and its range
-- without them, and a type alias's `:=` between spaces.
type   Byte= subset_value: Int    where invariant: subset_value is  0..=255
pub enum Level { Low, High }
type Loud = subset_value: Level  where invariant: subset_value is Level::High|Level::Low
type SubsetPatternTypes1 = subset_value: Int  where invariant: subset_value is 1..
proc c(b: Set< Byte >, n:SubsetPatternTypes1): (l: Loud) {
    ensure r: l = Level::High
}
