--@ args: fmt --check
-- `fren fmt` keeps the `!` of explicit shadowing, and its spaces are those
-- of the name alone.
const RATE: Int := 2
enum Shape { Circle(Int), Square }
fn bump(RATE!:Int):Int := RATE+1
comp   c{
in RATE! :Int
in ready?!
  pub out p?
  req r :p? iff match s {Shape::Circle(x!)=>x>RATE , _ => ready?}
}
expect e: forall (RATE! : c), RATE.p?
