--@ args: fmt --check
-- A block with two or more members is vertical, one member to a line, as
-- rustfmt writes a function's body: a procedure's, a function's and a
-- global expectation's block. A block with one member that fits on its
-- line is on one line, and one whose member spans several lines, has a
-- line comment or would end its line past column 100, counting a comment
-- after its `}` and however long the line is before it, is vertical, as is
-- one after a signature that spans several lines. An empty
-- block stays `{}`, an evidence setting stays with the member after it,
-- `use` members on one line become a block of imports, and a block already
-- written so stays as it is.
pub enum Mode { Heat, Cool }
struct P { x: Int }

pub proc c(m: Mode): (on?) { ensure r: on? iff m = Mode::Heat }

pub proc d(m: Mode): (on?) {
    ensure r: on? iff m = Mode::Heat
}

pub proc long(m: Mode): (on?) {
    ensure r: on? iff m = Mode::Heat or m = Mode::Cool or m = Mode::Heat or m = Mode::Cool or m = Mode::Heat
}

pub proc just_fits(n: Int): (on?) {
    ensure r: on? iff n = 1111111111111111111111111111111111111111
}

pub proc just_too_long(n: Int): (on?) {
    ensure r: on? iff n = 1111111111111111111111111111111111111
}

pub proc long_signature(
    m: Mode,  -- the mode
): (on?) {
    ensure r: on? iff m = Mode::Heat
}

pub proc long_signature_joined(
    m: Mode,  -- the mode
): (on?) { ensure r: on? iff m = Mode::Heat }

pub proc a_very_long_procedure_name_that_goes_on_and_on_and_on_and_on_and_on_and_on_and_on_and_xyz(): (y?) {
    ensure r: y?
}

pub proc trailing(n: Int): (y?) {
    ensure r: y? iff n > 111111111111111111111111111111111111111111
}  -- a trailing comment here

pub proc trailing_fits(n: Int): (y?) {
    ensure r: y? iff n > 1
}  -- a trailing comment here

pub proc commented(m: Mode): (on?) {
    ensure r: on? iff m = Mode::Heat  -- heating
}

proc nested(m: Mode): (o?) {
    ensure r: o? iff and { m = Mode::Heat, P { x := 1 } != P { x := 2 } }
}

pub proc nested_long(m: Mode): (on?) {
    ensure r: on? iff and { m = Mode::Heat, m = Mode::Cool, m = Mode::Heat, m = Mode::Cool, m = Mode::Heat }
}

pub fn single(x: Int): (r: Int) {
    out r := x + 1
}

expect single_global(m: Mode) {
    expect a: m is Mode::Heat | Mode::Cool
}

pub proc only_use(m: Mode): (on?) {
    use self::Mode::Heat
}

pub proc e(m: Mode): (on?) { ensure r: on? iff m = Mode::Heat  set_option fren.evidence "random" in expect s: on? or m = Mode::Cool }

pub proc f(n: Int): (y: Int) { ensure r: y = match n { 0 => 1, _ => 0 } }

pub fn g(x: Int): (r: Int) { assume p: x > 0  out r := x + 1 }

expect h(m: Mode) { expect a: m is Mode::Heat | Mode::Cool }

pub proc i() {}

pub proc j(x: Int): (y: Int) { ensure a: y = x

    -- Not less.
    ensure b: y >= x }

pub proc k(m: Mode): (on?) { use self::Mode::Heat use self::Mode::Cool ensure r: on? iff m = Heat or m = Cool }
