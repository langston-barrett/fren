--@ args: fmt --check
-- `fren fmt --check` on a formatted file: no output.
pub enum Mode { Heat, Cool }

proc c(
    t: Int,    -- the temperature
): (mode: Mode) {
    ensure r: mode = if t < 18 then Mode::Heat else Mode::Cool
}

-- A short procedure with one member is on one line, but `c`'s block is
-- vertical, as its signature spans several lines.
proc d(m: Mode): (on?) { ensure r: on? iff m = Mode::Heat }
