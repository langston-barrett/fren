--@ args: fix --check -W pedantic -A definable_output
-- `fren fix` writes a chain of `if` as a `match`, and `x := x` as `x`.
enum Mode { Heat, Cool, Off }

struct Point { x: Int, y: Int }

comp sub {
    in x: Int
    pub out p?

    req r: p? iff x > 0
}

pub comp c {
    in m: Mode
    in x: Int
    in a?
    pub out y: Int
    pub out z: Int
    pub out q?
    inst s: sub { x := x }

    req r1: y = if m = Mode::Heat then 1 else if m in {Mode::Cool, Mode::Off} then 2 else 0
    req r2: q? iff if m = Mode::Heat then a? else if m = Mode::Cool then (when x > 0, a?) else not a?
    req r3: z = Point { x := x, y := 2 * if m = Mode::Off then 1 else if m = Mode::Heat then 2 else 3 + x }.y
}
