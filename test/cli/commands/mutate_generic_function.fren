--@ args: mutate
-- A generic function's body is mutated as any defined function's is, and
-- each mutant is checked at the instances that its applications use.
mod m

pub fn size<T>(o: Option<T>, n: Int): Int := match o {
    Option::Some(_) => n + 1,
    Option::None => n,
}

pub proc c(x: Option<Bool>): (det y: Int) {
    out y := size(x, 0)

    expect e: x = Option::None or y = 1
    expect f: x != Option::None or y = 0
}
