--@ args: mutate --list
-- A generic type's variants are swapped for each other, as any
-- enumeration's are: each mutant is still well typed.
mod m

pub enum Option<T> { None, Some(T) }

pub proc c(x: Option<Int>): (y: Option<Int>) {
    ensure r: y = (match x { Option::Some(n) => Option::Some(n + 1), Option::None => Option::None })
}
