-- Refinement (`Reqs/Lang/Refinement`): `word` refines `shape`, which the
-- solver finds hard, so it is tested; it does not refine `wrong`, which
-- the solver refutes with a counterexample at the refinement.
mod lexref

-- The precise rule, which the solver struggles with.
pub proc word(text: String): (det accepted?) {
    ensure rule: accepted? iff text.matches?(r"[A-Za-z_][A-Za-z0-9_']*([.][A-Za-z_][A-Za-z0-9_']*)*[?]?")
}

-- A simpler shape: a word never contains `..`, and never starts with a digit.
pub proc shape(text: String): (accepted?) {
    ensure no_dots: when text.contains?(".."), not accepted?
    ensure no_digit: when text.starts_with?("1"), not accepted?
    expect dots_rejected: when text = "a..b", not accepted?
}

set_option fren.evidence "random" in
expect word_has_shape(text: String) {
    call concrete := word(text)
    refines concrete shape(text)
}

-- False: `word` accepts "ab", which `wrong` rejects.
pub proc wrong(text: String): (accepted?) {
    ensure never: when text != "", not accepted?
}

expect word_is_wrong(text: String) {
    call concrete := word(text)
    refines concrete wrong(text)
}
