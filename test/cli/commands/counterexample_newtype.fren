-- A counterexample shows newtypes as Fren builds them, within records and
-- sets too: the Lean front end shows the same (`src/FrenTest/Newtypes.lean`).
pub ordered struct Ms(Int)
pub struct Slot { start: Ms, tags: Set<Ms> }

proc shown(t: Ms, s: Slot): (det next: Ms) {
    assume pinned: t = Ms(3) and s = Slot { start := Ms(2), tags := {Ms(9), Ms(10)} }
    out next := t + Ms(1)

    expect small: next < Ms(4)
}
