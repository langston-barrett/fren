-- Snapshot of the binary's full output for failing checks: message layout,
-- help and notes, counterexample values, the summary and the exit code.
proc exit(n_fail: Int, n_inconc: Int): (code: Int) {
    assume counts: n_fail >= 0 and n_inconc >= 0
    exists scratch: Int
    ensure failures: when n_fail > 0, code = 1
    ensure inconc: when n_inconc > 0, code = 3
    ensure negative: when n_fail < 0, code = 4
    ensure scratch_def: scratch = n_fail
    expect zero: when n_fail = 0, code = 0
}

-- Instances: only earlier instances appear in an instance's counterexample,
-- and instance variables can't be assumed about.
proc chooser(): (b?) {}
proc uses(n_fail: Int): (ok?) {
    call first := exit(n_fail, 0)
    call second := exit(first.code, n_fail)
    call pick := chooser()
    ensure r: ok? iff pick.b?
    ensure lucky: pick.b?
}
