-- Refinement with bindings (`Reqs/Lang/Refinement#bindings`): `fmt_exit`
-- refines `exit_status` only through the binding of `ran?` to
-- `all_parsed?`; `bad_exit` does not, with a counterexample; and `stops`
-- refines `forbidding` through an abstraction function, an expression
-- binding.
mod exits

pub proc exit_status(ran?): (code: Int) {
    ensure not_run: code = 2 iff not ran?
    ensure documented: code is 0..=3
}

pub proc fmt_exit(all_parsed?, changed?): (code: Int) {
    ensure r: code = (if not all_parsed? then 2 else if changed? then 1 else 0)
}

expect fmt_exit_status(all_parsed?, changed?) {
    call concrete := fmt_exit(all_parsed?, changed?)
    refines concrete exit_status((all_parsed?))
}

-- False: `bad_exit` exits with 4 when everything parsed.
pub proc bad_exit(all_parsed?): (code: Int) { ensure r: code = (if not all_parsed? then 2 else 4) }

expect bad_exit_status(all_parsed?) {
    call concrete := bad_exit(all_parsed?)
    refines concrete exit_status((all_parsed?))
}

pub enum Level { Allow, Warn, Forbid }

use self::Level::Forbid

-- The abstract view: a flag, rather than a level.
pub proc forbidding(forbidden?, count: Int): (stops?) {
    assume some: count > 0
    ensure r: stops? iff forbidden?
}

pub proc stops(level: Level, count: Int): (halted?, det failures: Int) {
    ensure r: halted? iff level = Forbid
    ensure f: failures = (if level = Forbid then count else 0)
}

expect abstraction(level: exits::Level, count: Int) {
    use exits
    assume spec_some: (count) > 0
    call concrete := stops(level, count)
    expect r: ((concrete.failures) > 0) iff ((level) = exits::Level::Forbid)
}
