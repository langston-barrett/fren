-- Testing shows a newtype's value as Fren builds it, as the solver's
-- counterexamples do, though its value is its underlying type's.
pub ordered struct Ms(Int)
pub struct Job { took: Ms, waits: Set<Ms> }

set_option fren.evidence "random" in
pub proc timer(job: Job, took: Ms): (det left: Ms) {
    out left := Ms(10) - took

    expect fits: left > Ms(5)
    expect waited: job.took in job.waits
}
