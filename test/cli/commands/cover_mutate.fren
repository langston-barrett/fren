--@ args: mutate
-- A cover goal kills the mutants that rule its scenario out, such as
-- `temp > 100` changed to `temp > 101`, which no expectation notices, and
-- the expectations kill the others: every mutant is killed.
proc heater(temp: Int): (alarm?) {
    ensure r: alarm? iff temp > 100

    expect hot: when temp > 200, alarm?
    expect cold: when temp <= 100, not alarm?
    cover edge: temp = 101 and alarm?
}
