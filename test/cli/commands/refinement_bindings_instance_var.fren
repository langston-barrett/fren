-- A binding sees only the concrete component's own variables: the
-- variables of its instances, such as `inner.y`, are not in scope.
proc sub(v: Int): (y: Int) { ensure r: y = v }
proc outer(x: Int): (z: Int) { call inner := sub(x) ensure r: z = inner.y }
proc a(x: Int): (z: Int) { ensure r: z = x }
refine fits: outer refines a { z := inner.y }
