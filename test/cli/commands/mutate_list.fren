--@ args: mutate --list -A const_is_empty
-- Every origin, at every kind of site: constraints, defined outputs,
-- instance bindings, constants and defined functions. Expectations, local
-- and global, are not mutated. Swapping the first `and` of a chain, or
-- the last `or`, adds parentheses, and an operand that replaces its
-- operator keeps its own. A divisor is never made `0`: `STEP`, which one
-- names, is not changed, and neither is the `1` of `-1` changed to `0`. Each
-- operator of a chained comparison is swapped, and its first and last
-- comparisons are dropped. A cardinality operator is swapped for the
-- other, and loses an argument while at least one remains. A quantifier is
-- swapped, and its body mutated once, not at each instance. The rows of a
-- table are swapped and dropped. A payload-free variant is shifted to
-- those next to it, by the name in scope; the branches of an `if` and the
-- values of two arms in a row are swapped, but not those of an arm whose
-- pattern binds a name; a negation and a trigger are dropped, and so is
-- each field of a record update of two; `min` and `max` are swapped, and so
-- are `starts_with?` and `ends_with?`.
set_option fren.lint.chainable_comparison "allow"
set_option fren.lint.irrefutable_is "allow"
mod m

pub enum Mode { Off, Heat, Cool }

pub enum Reading { Value(Int), Missing, Stale(Int) }

pub struct Span { lo: Int, hi: Int, open? }

use self::Mode::{Cool, Heat, Off}

const LIMIT: Int := 10
const STEP: Int := 1

fn twice(x: Int): Int := x + x

pub proc sub(a: Int, on?): (b: Int) {
    ensure r: b = a - 1 or on?
}

pub proc c(x: Int, s: String, m: Mode, rd: Reading, sp: Span): (ok?, y: Int) {
    assume bounded: x >= 0 and x <= LIMIT
    out y := twice(x) + 1
    call w := sub(x * 2, true)
    ensure r: when x > 2 and x < 5 or not ok?, s.matches?(r"[a-z_]+x*")
    -- `a` is not removed from `[a^b]` or `[a^]`, which would negate them.
    ensure carets: s.matches?(r"[a^b][a^]") or ok?
    ensure chained: ok? or x = 4 or x = 6
    ensure parity: x mod STEP = 0 or x div -1 > 2
    ensure chain: unless m = Off, (ok? or x = 1) and m in {Heat, Cool} and [1, 2].len = 2
    ensure known: ok? or rd is Reading::Value(_) | Reading::Stale(_) | Reading::Missing
    -- One alternative per line, after a leading `|`.
    ensure stale: when rd is
        | Reading::Stale(_)
        | Reading::Missing,
        not ok?
    ensure ranged: ok? or 0 <= x < y <= LIMIT
    ensure exclusive: at_most_one?(x = 1, x = 2, x = 3) or exactly_one?(x > 3)
    ensure all_modes: ok? or (forall (k: Mode), k != m or x > 1)
    -- The values of two rows in a row swapped, and each row dropped.
    ensure coded: y = table {
        m = Heat => 1,
        m = Cool => 2,
        _ => 0,
    }
    ensure branches: y = if ok? then -x else x.max(0)
    ensure arms: y = match rd {
        Reading::Missing => 0,
        Reading::Stale(_) => 1,
        Reading::Value(v) => v,
    }
    ensure modes: m != Mode::Heat or s.starts_with?("h")
    ensure spans: sp = { sp with
        lo := x.min(y),
        hi := 3,
    }

    expect e: when x = 3, ok?
}

expect g(p_x: Int, p_s: String, p_m: Mode, p_rd: Reading, p_sp: Span) {
    assume p_bounded: p_x >= 0 and p_x <= LIMIT
    call p := c(p_x, p_s, p_m, p_rd, p_sp)
    expect g: p.x <= 10
}
