--@ args: mutate --list
-- A variant written by its name alone is shifted only to the variants of
-- its own enumeration that are in scope by their names: `W` is `B`'s, so
-- `X` of `A` is not changed to it. A name that a binder shadows, as
-- `Heat!` does, is not shifted, since it may mean the binder. Written as
-- `E::V`, any neighbour is in scope. A `use` brings names into scope only
-- after it, and a component's own `use`s only into the component: `C::P`
-- in `d` is shifted to `C::Q`, but `P` in `e`, which its own `use` brings,
-- is not shifted to `Q`, whose `use` comes after `e`.
set_option fren.lint.non_snake_case "allow"
mod m

pub enum A { X, W }
pub enum B { W, Z }
pub enum Mode { Off, Heat, Cool }
pub enum C { P, Q }

use self::A::X
use self::B::W
use self::Mode::{Cool, Heat}

pub comp c {
    in a: A
    in b: B
    in m: Mode
    in k: Int
    pub out ok?
    pub out y: Int

    ensure r: ok? iff a = X
    ensure s: ok? or b = W
    ensure t: ok? or m = Cool or a = A::W
    ensure u: y = match k { 0 => 5, Heat! => Heat + 1 }
}

pub comp d {
    in g: C
    pub out ok?

    ensure r: ok? iff g = C::P
}

pub comp e {
    use self::C::P
    in a: A
    in g: C
    pub out ok?

    ensure r: ok? iff (a = A::W and g = P)
}

use self::C::Q
