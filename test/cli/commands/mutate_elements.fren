--@ args: mutate --list -A collapsible_when
-- A quantifier over a sequence's elements stays in the decidable core:
-- neither `forall` nor `exists` is swapped, a membership stays a conjunct
-- of its guard (its `and` is not made an `or`, and is not dropped for its
-- other operand), and its trigger is neither dropped nor negated, nor is a
-- trigger before it negated. Everything else is mutated: the other
-- conjuncts, a trigger before the membership is dropped, one after it is
-- dropped and negated, and so are the body and an `and` around the
-- quantifier. Where `undecidable` is allowed, the quantifier is mutated
-- like any other.
pub mod m

pub fn ident?(w: String) := w != ""

pub fn guarded?(names: Seq<String>) :=
    forall (v: String), when v in names and v != "x", ident?(v)

pub fn triggered?(names: Seq<String>, a?, b?) :=
    forall (v: String), when a?, when v in names, when b?, ident?(v)

pub fn some?(names: Seq<String>) :=
    exists (v: String), v in names and ident?(v) and v != "y"

pub fn nested?(names: Seq<String>, others: Seq<String>) :=
    forall (v: String), when v in names, forall (w: String), when w in others, v != w

pub fn around?(names: Seq<String>, a?) :=
    a? and (forall (v: String), when v in names, ident?(v) and v != "q")

set_option fren.lint.undecidable "allow" in
pub fn allowed?(names: Seq<String>) :=
    forall (v: String), when v in names, ident?(v)
