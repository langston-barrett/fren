--@ args: eval --proc c --set q=[1,3,2] --set s={4} --set sorted?=false --set pos?=true --set any?=true
-- `fren eval` evaluates an unbounded quantifier over its guard's domain:
-- `sorted?` at each position of `q`, and `pos?` at each member of `s`.
-- `any?`'s bound name has no domain, so the evaluator does not know `a`,
-- nor the status: every variable is set, since with `a` unknown, the
-- search would find no behaviour.
set_option fren.lint.undecidable "allow" in
proc c(q: Seq<Int>, s: Set<Int>): (sorted?, pos?, any?) {
    ensure r: sorted? iff (forall (i: Int), when 0 <= i < q.len - 1, q[i] <= q[i + 1])
    ensure p: pos? iff (forall (x: Int), when x in s, x > 0)
    ensure a: any? iff (exists (x: Int), x > 5)
}
