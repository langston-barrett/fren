-- A refinement set to testing asks the solver nothing, not even the
-- definedness of the bindings of the abstract component's instances: its
-- only results are the two passes by testing in the summary.
pub proc helper(v: Int): (w: Int) {
    ensure r: w = v
}

pub proc first(q: Seq<Int>): (y: Int) {
    assume nonempty: q != []
    call h := helper(q[0])
    ensure r: y = h.w
}

pub proc exact(q: Seq<Int>): (y: Int) {
    assume nonempty: q != []
    ensure r: y = q[0]
}

set_option fren.evidence "tested" in
expect same(q: Seq<Int>) {
    assume spec_nonempty: (q) != []
    call concrete := exact(q)
    refines concrete first(q)
}
