-- A refinement's definedness failures are reported at the refinement, not
-- at the abstract component's index, as its other checks are.
pub proc first(q: Seq<Int>): (y: Int) {
    ensure r: y = q[0]
}
pub proc exact(q: Seq<Int>): (y: Int) {
    ensure r: when q != [], y = q[0]
}
refine same: exact refines first
