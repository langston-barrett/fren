-- A refinement set to testing tests only its obligation: the assumption of
-- the abstract component's instance `g` is a hypothesis, so it is not
-- tested, and the summary counts one test, the expectation `r`.
pub proc guarded(k: Int): (m: Int) {
    assume pos: k > 0
    ensure r: m = k
}

pub proc abstract(x: Int): (y: Int) {
    assume pos: x > 0
    call g := guarded(x)
    ensure r: y >= g.m
}

pub proc concrete(x: Int): (y: Int) {
    ensure r: y = x + 1
}

set_option fren.evidence "tested" in
expect fits(x: Int) {
    assume spec_pos: (x) > 0
    call concrete_1 := concrete(x)
    refines concrete_1 abstract(x)
}
