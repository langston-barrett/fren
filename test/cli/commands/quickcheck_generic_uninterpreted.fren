--@ args: quickcheck
-- Testing a generic function without a body: a random interpretation gives
-- each instance a function of its own, whose values meet its
-- postconditions at that instance, and are of its result type there
-- (`Reqs/Eval#searching-for-behaviours`).

pub fn rank<T>(x: T): Int
    ensure natural: rank(x) >= 0
pub fn size<T>(Option<T>): Nat

comp c {
    in x: Int
    in p?
    pub det out i: Int := rank(x)
    pub det out j: Int := rank(p?)
    pub det out n: Int := size(Option::Some(x))

    expect natural: i >= 0 and j >= 0 and n >= 0
    -- Nothing relates two instances.
    expect same: i = j
}
