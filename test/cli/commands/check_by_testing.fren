-- Checks set to testing (`Reqs/Check#checking-by-testing`): the solver is
-- asked nothing about them. `no_empty_segment` is beyond the solver in
-- practice, and passes by testing; `wrong` is false, and testing refutes it.
mod lex

pub proc word(text: String): (det accepted?) {
    ensure rule: accepted? iff text.matches?(r"[A-Za-z_][A-Za-z0-9_']*([.][A-Za-z_][A-Za-z0-9_']*)*[?]?")

    expect dotted: when text = "w.x.y?", accepted?
    set_option fren.evidence "random" in
    expect no_empty_segment: when text.contains?(".."), not accepted?
    set_option fren.evidence "random" in
    expect wrong: when text.contains?("x"), not accepted?
}

-- Set for the whole component, but its `det out` by the solver.
set_option fren.evidence "random" in
pub proc parity(n: Int): (set_option fren.evidence "solver" in det even?) {
    ensure r: even? iff n is 0 | 2 | 4
    expect zero: when n = 0, even?
}

-- An instance set to testing: its assumption is tested, and false.
pub proc positive(k: Int) {
    assume pos: k > 0
}

pub proc caller(m: Int) {
    set_option fren.evidence "random" in
    call p := positive(m)
}

-- Without `in`, it sets every later component and global expectation.
set_option fren.evidence "random"

expect global_wrong(p_n: Int) {
    call p := parity(p_n)
    expect global_wrong: when p.n = 2, not p.even?
}

-- A check set to testing whose trigger never held: the help does not send
-- the user back to `fren check`.
pub proc narrow(x: Int): (big?) {
    ensure r: big? iff x > 1000
    set_option fren.evidence "random" in
    expect e: when 7 * x = 123459, big?
}
