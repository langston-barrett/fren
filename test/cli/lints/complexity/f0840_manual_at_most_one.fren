-- Conjuncts that negate each pair of three operands, with and without
-- their disjunction.
proc c(a?, b?, c?): (p?, q?) {
    ensure r: p? iff not (a? and b?) and not (a? and c?) and not (b? and c?)
    ensure s: q? iff (a? or b? or c?) and not (a? and b?) and not (a? and c?) and not (b? and c?)
}
