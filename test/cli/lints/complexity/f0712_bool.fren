-- `Bool` expressions with a simpler form.
pub proc sub(i?): (j?) {
    ensure r: j? iff i?
}

pub proc c(a?, b?, x: Int): (o?, p?, q?, w?) {
    call s := sub(if a? then true else false)

    ensure r1: o? iff a? = true
    ensure r2: when not not (a? or b?), w? or not (x < 3)
    ensure r3: p? = (if b? then false else true) or false = a?
    ensure r4: q? iff b? and not not (a? != true)
}
