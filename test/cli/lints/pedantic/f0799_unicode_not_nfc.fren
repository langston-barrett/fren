-- `unicode_not_nfc`: a literal not in NFC, raw too, with the literal in NFC
-- suggested where it has no escape sequence, and no fix.
set_option fren.lint.unicode_not_nfc "warn"

comp c {
    in s: String
    pub out p?

    req r: p? iff (s = "café" or s = r#"é"# or s = "\u0065́" or s = "café")
}
