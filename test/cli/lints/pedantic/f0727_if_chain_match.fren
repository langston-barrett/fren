-- `if_chain_match`, which is allowed by default.
set_option fren.lint.if_chain_match "warn"

enum Mode { Heat, Cool, Off }

proc c(m: Mode): (y: Int, z: Int) {
    ensure r: y = if m = Mode::Heat then 1 else if m = Mode::Cool or m = Mode::Off then 2 else 0
    ensure s: z = if m = Mode::Heat then 1 else 0
}
