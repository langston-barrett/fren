-- `branches_sharing_code`, on either side of the operator, but not where
-- the fix would be a product of two operands that mention variables.
set_option fren.lint.branches_sharing_code "warn"

proc c(c?, x: Int): (y: Int, z: Int, w: Int, v: Int) {
    ensure r1: y = if c? then 2 * x + 1 else x + 1
    ensure r2: z = if c? then x - 1 else x - 2
    ensure r3: w = if c? then 3 * (x + 1) else 2 * (x + 1)
    ensure r4: v = if c? then (x + 1) * 3 else (x - 1) * 3
}
