-- Tests of the first or the last variants of an ordered enumeration.
set_option fren.lint.manual_ordering "warn"

pub ordered enum Level { Low, Mid, High, Top }

proc c(l: Level): (p?, q?) {
    ensure r: p? iff l in {Level::Low, Level::Mid}
    ensure s: q? iff l != Level::Top and l != Level::High
}
