-- Comparisons with the first or the last variant of an ordered
-- enumeration, and through a newtype of one.
pub ordered enum Level { Low, Mid, High }
pub ordered struct Grade(Level)

proc c(l: Level, g: Grade): (p?, q?) {
    ensure r: p? iff l >= Level::Low or Level::High < l
    ensure s: q? iff g <= Grade(Level::High)
}
