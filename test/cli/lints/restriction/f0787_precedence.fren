-- `precedence`, allowed by default.
set_option fren.lint.precedence "warn"

proc alarm(armed?, open?, moving?, zones: Set<Int>, quiet: Set<Int>, tripped: Set<Int>): (
    ringing?,
    loud: Set<Int>,
) {
    out loud := zones minus quiet inter tripped

    ensure ringing_rule: ringing? iff (moving? or armed? and open?)
}
