-- Variables that nothing mentions; a global expectation's call that
-- nothing reads is not one.
pub proc sub(a: Int): (b: Int) {
    ensure r: b = a
}

pub proc c(x: Int, spare: Int): (y: Int, loose?) {
    call s := sub(x)

    ensure r: y = x
}

expect g(p_x: Int, p_spare: Int, q_x: Int, q_spare: Int) {
    call p := c(p_x, p_spare)
    call q := c(q_x, q_spare)
    expect g: p.y = p.x
}
