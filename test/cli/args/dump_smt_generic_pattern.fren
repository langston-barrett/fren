--@ args: check --dump-smt
-- `--dump-smt` of subset types as type arguments: a payload of a type
-- parameter brings its argument's constraint, guarded by its variant, and
-- one of an element type quantifies over the elements, with `fmf-bound`.
set_option fren.lint.undecidable "allow"

type Byte = n: Int where invariant: n is 0..=255

type Digit = n: Int where invariant: n is 0..=9
proc c(x: Option<Byte>, s: Option<Set<Digit>>) {
    expect byte: match x {
        Option::Some(b) => b <= 255,
        Option::None => true,
    }
    expect digits: match s {
        Option::Some(e) => not (10 in e),
        Option::None => true,
    }
}
