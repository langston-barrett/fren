--@ args: check --dump-smt
-- `--dump-smt` of pattern types as type arguments: a payload of a type
-- parameter brings its argument's constraint, guarded by its variant, and
-- one of an element type quantifies over the elements, with `fmf-bound`.
set_option fren.lint.undecidable "allow"

type Byte := Int is 0..=255

proc c(x: Option<Byte>, s: Option<Set<Int is 0..=9>>) {
    expect byte: match x { Option::Some(b) => b <= 255, Option::None => true }
    expect digits: match s { Option::Some(e) => not (10 in e), Option::None => true }
}
