--@ args: check --dump=obligations
-- `--dump=obligations` of a generic function: its checks at a sort of its
-- own for its type parameter, `::unwrap_or::0::T`, and its instance at
-- `Int` that a procedure applies, with `Option`'s constructors and
-- selector at that instance; a `det` output's determinism has both copies
-- of each variable (`Reqs/Cli#obligations`).
pub fn id<T>(x: T): T := x

pub fn unwrap_or<T>(o: Option<T>, d: T): (r: T) {
    assume known: o != Option::None
    out r := match o {
        Option::Some(x) => x,
        Option::None => id(d),
    }
    ensure payload: Option::Some(unwrap_or(o, d)) = o
}

proc c(x: Option<Int>): (det y: Int) {
    assume some: x != Option::None
    out y := unwrap_or(x, 0)
}
