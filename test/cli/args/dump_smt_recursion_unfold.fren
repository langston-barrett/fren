--@ args: check --dump-smt
-- `--dump-smt` of a spec with a recursive function: a query unfolds the
-- definitions that apply it, as `twice` does, to find its applications
-- and their facts, and leaves the others to the solver, as `small?`, which
-- applies none (`Reqs/Lang/Recursion#solver-encoding`).
pub enum T { Leaf, Node(T) }

pub fn depth(t: T): Int := match t {
    T::Leaf => 0,
    T::Node(u) => 1 + depth(u),
}

pub fn twice(t: T): Int := depth(t) + depth(t)

pub fn small?(n: Int) := n < 3

proc p(t: T, n: Int): (y: Int) {
    ensure r: y = twice(t)

    expect even: small?(n) or y = 2 * depth(t)
}
