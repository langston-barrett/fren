--@ args: check --dump=theories
-- Signatures, clauses and links retain their theory structure; terms are opaque.
set_option fren.lint.glob_imports "allow"
set_option fren.lint.manual_pattern_test "allow"
set_option fren.lint.undecidable "allow"

pub mod library

pub struct Box<T> { value: T }

pub enum Choice { A, B }

pub struct Number(Int)

pub type Pos = x: Int where positive: x > 0

pub fn id<T>(x: T): T := x

pub fn size(Box<Int>): Int

pub fn inc(x: Int): (r: Int) {
    require positive: x > 0
    out r := x + 1
    ensure grows: r > x
}

pub proc echo(x: Int): (det y: Int) { out y := id(x) }

pub trait Sized {
    fn size(Self): Int

    law nonnegative(s: Self): size(s) >= 0
}

mod client

use library::{Box, Number, echo, id, inc, size}
use library::Choice::*

proc round_trip(x: Int): (det y: Int) {
    require positive: x > 0
    call inner := echo(x)
    out y := inc(id(inner.y))
    expect grows: y > x
}

expect same(x: Box<Int>, flag?) {
    expect order: size(x) <= size(x) + 1
    expect nominal: Number(x.value) != Number(x.value + 1)
    expect variants: (if flag? then A else B) != (if flag? then B else A)
}
