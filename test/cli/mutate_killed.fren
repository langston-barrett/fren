--@ args: mutate
-- Every mutant is killed or equivalent, so the exit status is 0. A check
-- that fails on the spec itself kills nothing.
comp c {
    in x: Int
    pub out pos?

    req r: pos? iff (x > 0 and x >= 1)
    expect zero: when x = 0, not pos?
    expect one: when x = 1, pos?
    expect wrong: pos?
}
