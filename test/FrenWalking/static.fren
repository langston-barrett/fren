-- case: full_reordered
mod m
enum E { A, B }
fn f(e: E): Int := match e { E::B => 1, E::A => 0 }
-- result: static accepted; functions=1; bodies=1

-- case: missing
mod m
enum E { A, B }
fn f(e: E): Int := match e { E::A => 0 }
-- result: coverage m.E; missing=1; repeated=0

-- case: same_count_duplicate
mod m
enum E { A, B }
fn f(e: E): Int := match e { E::A => 0, E::A => 1 }
-- result: coverage m.E; missing=1; repeated=1

-- case: self_recursion
mod m
fn f(x: Int): Int := f(x)
-- result: termination m.f: some call is not guarded under every choice of decreasing parameters

-- case: mutual_recursion
mod m
fn f(x: Int): Int := g(x)
fn g(x: Int): Int := f(x)
-- result: termination m.f, m.g: some call is not guarded under every choice of decreasing parameters

-- case: caller_outside_group
mod m
fn top(x: Int): Int := g(x)
fn g(x: Int): Int := f(x)
fn f(x: Int): Int := g(x)
-- result: termination m.g, m.f: some call is not guarded under every choice of decreasing parameters

-- case: let_of_parameter
mod m
fn f(x: Int, y: Int): Int := let z := x in f(z, y)
-- result: termination m.f: some call is not guarded under every choice of decreasing parameters

-- case: recursion_in_condition
mod m
fn f(x: Int): Bool := f(x)
expect q() { expect uses_unchecked: f(1) }
-- result: termination m.f: some call is not guarded under every choice of decreasing parameters

-- case: false_goal_remains_goal
mod m
expect q() { expect deliberately_false: false }
-- result: static accepted; functions=0; bodies=1
