-- A library's generic function without a body, whose contract fails at
-- its type parameter's sort, applied here only at `Int`, where it holds
-- (`test/cli/results/f0631_generic_imported.fren`).
mod lib
pub fn other<T>(x: T): T
    ensure diff: other(x) != x
comp use_int { in x: Int pub det out y: Int := other(x) expect moved: y != x }
