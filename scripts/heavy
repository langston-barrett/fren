#!/usr/bin/env python3
"""Run a command that uses every core, such as `lake build`, `lake test`, a
fuzzer or a mutation run, while holding one of a few machine-wide slots, so
that parallel jobs don't pile up.

    scripts/heavy [--offline] [--] COMMAND [ARG...]
    scripts/heavy --stats [HOURS]
    scripts/heavy --alternate MINUTES VALUE

Slots are `flock`ed files in ~/.cache/heavy/ (`slot0`, `slot1`, ...), so a
crashed or killed holder releases its slot, and every copy of this script on
a machine shares them. Each owner publishes its own memory report; numeric
PIDs are local diagnostics, never identities for another owner to signal.

Slots: at most `HEAVY_SLOTS` jobs run at once, else the number in
~/.cache/heavy/slots, else 2.

Memory: the combined resident-memory target is `HEAVY_MEM_GB` gigabytes,
else the number in ~/.cache/heavy/mem_gb, else 80% of the
machine's physical memory. A job's memory is that of its whole process
group, summed about every second. A job waits to start while the running
ones use more than 60% of the cap. Legacy holders coexist with new ones:
verified visible RSS counts directly, and all unobserved legacy holders
together reserve half the cap. A verified stale monitor still reserves a full
cap. When measured memory exceeds the cap, the compatible owner with the
greatest admission sequence terminates its own group (TERM, then KILL) and
exits with 137; estimates never trigger eviction. Every owner also enforces
its own cap. Registry waits have a short deadline: on timeout admission
waits and monitors enforce their own cap until shared accounting resumes.
Controlled build entrypoints instead include every group in their owned Linux
process session and use anchored pidfd cleanup; they require a subreaper and
native procfs visibility. Other commands retain the process-group path.
Failure to identify, measure or publish memory otherwise stops the command
with exit 125. Linux requires `NSpid` in
procfs status; systems without it fail identification with exit 125.
Legacy estimates are not bounds on invisible memory, so mixed-version
accounting is a sampled target, not a hard combined limit. The files are
re-read on every use, so changing one takes effect for running jobs too.
An unset, empty, invalid, infinite or non-positive setting falls through to
the next, with a warning unless it is unset.

Load (opt-in): `HEAVY_MAX_LOAD`, else ~/.cache/heavy/max_load, else off.
Wait for the 1-minute load to be below this value, for at most 10 minutes;
slots and memory still apply. `HEAVY_MAX_LOAD=off` overrides the file.

Every completed job appends a JSON line to ~/.cache/heavy/log.jsonl
(`HEAVY_LOG` overrides the path), including the job's user/system CPU
seconds and CPU seconds per run second. On Linux, orphaned workers in its
process group are adopted and waited for too. Machine CPU busy fractions
come from /proc/stat intervals at start, about every 30 seconds and end;
busy excludes idle and iowait. Unavailable readings give null summaries.
One-second samples also record CPU by executable name, live concurrency,
runnable pressure against online logical CPUs, and machine context-switch
rates. Process status switch counts complement wait4's final involuntary
switch total. A historical per-command memory prediction is frozen beside
actual peak RSS; it does not yet change admission's live-RSS rule.
Logging never fails a job. `--stats`
compares completions in the last HOURS (default 24), by admission policy
and job kind. `--alternate` switches the file setting between VALUE and
absent every MINUTES, logging each flip for the policy exposure times.
Run one alternator for all agents, with HEAVY_MAX_LOAD unset everywhere.
SIGINT, SIGTERM and SIGHUP stop it and remove the file, leaving admission off,
unless inherited as ignored (for example SIGHUP under nohup). Further signals
are ignored during cleanup, then the inherited handlers are restored.

`--offline` runs COMMAND with no network: on Linux in a new user and
network namespace (`unshare -rn`), whose only interface is loopback, which
is down, and in which COMMAND runs as uid 0, mapped to the user; and on
macOS under `sandbox-exec` with a profile that denies all IP networking,
loopback included, and name lookups, but allows other Unix sockets. When it cannot cut the
network, heavy fails (exit 126) rather than run COMMAND online. Use it
for what never needs the network: binaries that a pull request built,
fuzzers and mutation runs. Builds and `lake test` stay online, since
Lake fetches packages and elan fetches toolchains.

`python3 scripts/heavy_test.py` tests parsing, settings, load admission
and lease accounting, namespace translation and local termination with
scratch state and tiny jobs.
"""
import contextlib
import ctypes
import importlib.machinery
import importlib.util
import fcntl
import json
import math
import os
import platform
import re
import select
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import uuid

STATE = os.path.expanduser("~/.cache/heavy")
DEFAULT_SLOTS = 2
DEFAULT_MEM_FRACTION = 0.8
START_FRACTION = 0.6
LOAD_GRACE_SECONDS = 600
LOAD_SAMPLE_SECONDS = 30
PREDICTION_JOBS = 20
PREDICTION_SECONDS = 7 * 86400
REPORT_STALE_SECONDS = 10
REGISTRY_WAIT_SECONDS = 0.2
REGISTRY_RETRY_SECONDS = 0.01
# Most urgent first; the index is the class's rank in the queue.
PRIORITY_CLASSES = ("main-repair", "critical-path", "merge-blocking", "edit-loop", "exploratory")
PRIORITY_NICE = dict(zip(PRIORITY_CLASSES, (0, 2, 4, 7, 10)))
PRIORITY_WEIGHT = dict(zip(PRIORITY_CLASSES, (250, 160, 100, 50, 25)))
DEFAULT_AGING_SECONDS = 300
WAITER_STALE_MS = 30000
WAITER_ABANDONED_SECONDS = 60
WAITER_BYTES = 512
USAGE = ("usage: heavy [--offline] [--] <command> [args...] | heavy --stats [hours] | "
         "heavy --alternate <minutes> <value>")

# Denies all IP networking, inbound and outbound, loopback included, and
# name lookups through mDNSResponder, which would send DNS queries for the
# command, and allows everything else, other Unix sockets too, since they
# are local IPC. Later rules take precedence.
MACOS_OFFLINE_PROFILE = """\
(version 1)
(allow default)
(deny network*)
(allow network* (local unix-socket))
(allow network* (remote unix-socket))
(deny network-outbound (remote unix-socket (path-literal "/private/var/run/mDNSResponder")))
(deny mach-lookup (global-name "com.apple.dnssd.service"))
"""


class UsageError(Exception):
    pass


def parse_args(argv):
    """(offline, command) from heavy's arguments, without the program name.
    Options come before the command; `--` ends them."""
    offline = False
    i = 0
    while i < len(argv) and argv[i].startswith("-"):
        arg = argv[i]
        i += 1
        if arg == "--":
            break
        if arg == "--offline":
            offline = True
        elif arg in ("-h", "--help"):
            raise UsageError(__doc__)
        else:
            raise UsageError(f"heavy: unknown option {arg}\n{USAGE}")
    if i >= len(argv):
        raise UsageError(USAGE)
    return offline, argv[i:]


def meminfo_kb(text):
    """MemTotal, in KB, from the text of /proc/meminfo."""
    for line in text.splitlines():
        fields = line.split()
        if len(fields) >= 2 and fields[0] == "MemTotal:":
            return int(fields[1])
    raise ValueError("no MemTotal in /proc/meminfo")


def memsize_kb(text):
    """KB, from the bytes that `sysctl -n hw.memsize` prints."""
    return int(text.strip()) // 1024


def physical_memory_kb(system=None, meminfo="/proc/meminfo"):
    """The machine's physical memory, in KB."""
    system = system or platform.system()
    if system == "Linux":
        with open(meminfo) as f:
            return meminfo_kb(f.read())
    if system == "Darwin":
        out = subprocess.run(["sysctl", "-n", "hw.memsize"], capture_output=True,
                             text=True, check=True).stdout
        return memsize_kb(out)
    raise ValueError(f"cannot tell the physical memory on {system}")


def positive(kind, text):
    value = kind(text)
    if not (math.isfinite(value) and value > 0):
        raise ValueError(f"{text.strip()!r} is not a positive finite number")
    return value


_warned = set()


def warn_once(where, text, warn):
    if (where, text) not in _warned:
        _warned.add((where, text))
        warn(f"heavy: ignoring {where}={text.strip()!r}, which is not a positive finite number")


def setting(env, name, kind, environ=None, state=STATE, warn=None):
    """The positive finite `kind` that the environment variable `env` holds,
    else the one in the file `name` in the state directory, else None; read
    on every call. A value that is set but rejected is reported once, by
    `warn`, on stderr by default."""
    environ = os.environ if environ is None else environ
    warn = warn or (lambda m: print(m, file=sys.stderr))
    text = environ.get(env)
    if text is not None:
        try:
            return positive(kind, text)
        except ValueError:
            warn_once(env, text, warn)
    path = os.path.join(state, name)
    try:
        with open(path) as f:
            text = f.read()
    except OSError:
        return None
    try:
        return positive(kind, text)
    except ValueError:
        if text.strip():
            warn_once(path, text, warn)
        return None


def slot_count(environ=None, state=STATE, warn=None):
    n = setting("HEAVY_SLOTS", "slots", int, environ, state, warn)
    return DEFAULT_SLOTS if n is None else n


def max_load(environ=None, state=STATE, warn=None):
    environ = os.environ if environ is None else environ
    if environ.get("HEAVY_MAX_LOAD", "").strip().lower() == "off":
        return None
    return setting("HEAVY_MAX_LOAD", "max_load", float, environ, state, warn)


def load_average():
    try:
        value = os.getloadavg()[0]
        return value if math.isfinite(value) and value >= 0 else None
    except (OSError, AttributeError):
        return None


def over_start_fraction(rss, cap):
    """Whether the charged memory is above 60% of the cap, in exact integers:
    `0.6 * cap` rounds, so a float comparison moves the boundary."""
    return 5 * rss > 3 * cap


def start_rule(waited, rss, cap, limit, load_reader=load_average):
    """Admission besides the slot lock; a missing load reading fails open."""
    if over_start_fraction(rss, cap):
        return False
    # Load decays slowly and includes unrelated work. Ten minutes bounds
    # that extra delay without ever bypassing the slot or memory limits.
    if limit is None or waited >= LOAD_GRACE_SECONDS:
        return True
    load = load_reader()
    return load is None or load < limit


def can_start(waited, rss, cap, limit, load_reader=load_average):
    """This job's own admission besides the slot lock and its turn."""
    return start_rule(waited, rss, cap, limit, load_reader)


def priority_class(label):
    """A missing or unknown label is exploratory: it never jumps the queue."""
    return label if label in PRIORITY_CLASSES else "exploratory"


def aging_ms(environ=None, state=STATE, warn=None):
    """The wait that outweighs one priority class, in milliseconds."""
    seconds = setting("HEAVY_AGING_SECONDS", "aging_seconds", float, environ, state, warn)
    return round((DEFAULT_AGING_SECONDS if seconds is None else seconds) * 1000)


def monotonic_ms():
    return time.monotonic_ns() // 1000000


def queue_key(waiter, step):
    return PRIORITY_CLASSES.index(priority_class(waiter["priority"])) * step + waiter["enqueued_ms"]


def queue_before(a, b, step):
    """Strict queue order: the aged key, then the enqueue sequence."""
    first, second = queue_key(a, step), queue_key(b, step)
    return first < second or (first == second and a["sequence"] < b["sequence"])


def queue_contends(waiter, slot, rss, load_reader, now):
    """Whether a waiter could take this slot now, under its own settings.
    One that could not holds nobody back."""
    return (0 <= now - waiter["updated_ms"] <= WAITER_STALE_MS and slot < waiter["slots"]
            and start_rule((now - waiter["enqueued_ms"]) / 1000, rss, waiter["cap_kb"],
                           waiter["max_load"], load_reader))


def queue_ahead(own, others, slot, rss, load_reader, now, step):
    """How many other waiters take this slot before `own`."""
    return sum(1 for waiter in others
               if queue_before(waiter, own, step) and queue_contends(waiter, slot, rss, load_reader, now))


def valid_waiter(waiter):
    integer = lambda value: type(value) is int
    limit = waiter.get("max_load") if isinstance(waiter, dict) else None
    return (isinstance(waiter, dict) and waiter.get("version") == 1
            and all(integer(waiter.get(k)) for k in ("sequence", "enqueued_ms", "updated_ms", "slots", "cap_kb"))
            and (waiter.get("priority") is None or isinstance(waiter["priority"], str))
            and (limit is None or (type(limit) in (int, float) and math.isfinite(limit) and limit > 0)))


class Waiting:
    """This job's entry among the waiting jobs: one file, locked for as long
    as the job waits and rewritten in place on every poll. A file whose lock
    is free belongs to no one, and a stale one to a stopped waiter; neither
    counts. Publishing is best effort: a job that cannot publish still
    starts by the memory rule, and only loses its place in the order."""

    def __init__(self, state, label, queued=None):
        now = monotonic_ms() if queued is None else int(queued * 1000)
        self.entry = {"version": 1, "sequence": time.monotonic_ns(), "priority": label,
                      "enqueued_ms": now, "updated_ms": now, "slots": 0, "cap_kb": 0,
                      "max_load": None, "pid": os.getpid()}
        self.directory = os.path.join(state, "waiters")
        self.path = os.path.join(self.directory, uuid.uuid4().hex + ".json")
        self.fd = None
        try:
            os.makedirs(self.directory, exist_ok=True)
            self.fd = os.open(self.path, os.O_RDWR | os.O_CREAT | os.O_EXCL, 0o600)
            # A reader's probe holds a shared lock only for an instant.
            fcntl.flock(self.fd, fcntl.LOCK_EX)
        except OSError as error:
            print(f"heavy: cannot join the waiting jobs ({error}); starting in arrival order", file=sys.stderr)
            self.close()

    def beat(self, slots, cap, limit):
        """Publish the settings this job waits under, and that it is alive."""
        self.entry.update(updated_ms=monotonic_ms(), slots=slots, cap_kb=cap, max_load=limit)
        if self.fd is None:
            return
        try:
            # One padded write in place: a reader never sees a truncated file.
            os.pwrite(self.fd, json.dumps(self.entry).ljust(WAITER_BYTES).encode(), 0)
        except OSError:
            pass

    def others(self):
        """The published entries of the other live waiters."""
        found = []
        try:
            names = sorted(os.listdir(self.directory))
        except OSError:
            return found
        for name in names:
            path = os.path.join(self.directory, name)
            if path == self.path or not name.endswith(".json"):
                continue
            try:
                fd = os.open(path, os.O_RDONLY)
            except OSError:
                continue
            try:
                try:
                    fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
                except BlockingIOError:
                    try:
                        waiter = json.loads(os.pread(fd, WAITER_BYTES, 0))
                    except (OSError, ValueError):
                        continue
                    if valid_waiter(waiter):
                        found.append(waiter)
                    continue
                except OSError:
                    continue
                # Nobody holds it. Its owner locks it right after creating
                # it, so only an old unlocked file is abandoned.
                try:
                    if time.time() - os.fstat(fd).st_mtime > WAITER_ABANDONED_SECONDS:
                        os.unlink(path)
                except OSError:
                    pass
            finally:
                os.close(fd)
        return found

    def close(self):
        """Leave the queue: at admission, before the job is spawned, and on
        every other way out."""
        fd, self.fd = self.fd, None
        if fd is None:
            return
        try:
            os.unlink(self.path)
        except OSError:
            pass
        os.close(fd)


def own_cgroup(read=None):
    """The directory of heavy's cgroup v2 group, or None."""
    try:
        if read is None:
            with open("/proc/self/cgroup") as f:
                text = f.read()
        else:
            text = read()
    except OSError:
        return None
    for line in text.splitlines():
        if line.startswith("0::/"):
            return os.path.join("/sys/fs/cgroup", line[4:])
    return None


def parent_pid(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            return process_stat(f.read())["ppid"]
    except (OSError, ValueError, IndexError):
        return None


def cgroup_outsiders(directory, parent=parent_pid, own=None):
    """How many processes in the cgroup are neither heavy nor an ancestor of
    it. Heavy calls this before it starts the job, so every other process
    is someone else's work. None if the membership cannot be read."""
    family, pid = set(), os.getpid() if own is None else own
    while pid and pid not in family:
        family.add(pid)
        pid = parent(pid)
    try:
        with open(os.path.join(directory, "cgroup.procs")) as f:
            members = [int(line) for line in f.read().split()]
    except (OSError, ValueError):
        return None
    return sum(1 for member in members if member not in family)


def raise_nice(group, nice):
    """Raise the niceness of a new session's process group, and of its
    autogroup where the kernel groups sessions; never lower either. Heavy's
    own monitor keeps its niceness, since it enforces the memory cap."""
    try:
        if nice > os.getpriority(os.PRIO_PGRP, group):
            os.setpriority(os.PRIO_PGRP, group, nice)
    except OSError:
        pass
    try:
        with open(f"/proc/{group}/autogroup", "r+") as f:
            if nice > int(f.read().split()[-1]):
                f.seek(0)
                f.write(str(nice))
    except (OSError, ValueError, IndexError):
        pass


def cpu_weight(label, writable, outsiders):
    """The `cpu.weight` to write, if the cgroup is this job's alone."""
    return PRIORITY_WEIGHT[priority_class(label)] if writable and outsiders == 0 else None


class CpuShare:
    """The kernel's share of the CPU for a job, from its priority class.
    Jobs in separate cgroups compete by `cpu.weight`; niceness orders only
    the processes of one cgroup. Heavy sets both and arbitrates nothing."""

    def __init__(self, label, record, cgroup=own_cgroup, outsiders=cgroup_outsiders):
        self.path, self.previous = None, None
        self.nice = PRIORITY_NICE[priority_class(label)]
        record.update(priority=priority_class(label), cpu_nice=self.nice, cpu_weight=None)
        directory = cgroup() if platform.system() == "Linux" else None
        if directory is None:
            return
        path = os.path.join(directory, "cpu.weight")
        count = outsiders(directory) if os.access(path, os.W_OK) else None
        weight = cpu_weight(label, count is not None, count)
        if weight is None:
            return
        try:
            with open(path) as f:
                previous = f.read().strip()
            with open(path, "w") as f:
                f.write(str(weight))
        except OSError:
            return
        self.path, self.previous = path, previous
        record["cpu_weight"] = weight

    def restore(self):
        path, self.path = self.path, None
        if path is not None:
            try:
                with open(path, "w") as f:
                    f.write(self.previous)
            except OSError:
                pass


def sample_load(record, load_reader, now, last=None):
    if last is not None and now - last < LOAD_SAMPLE_SECONDS:
        return last
    load = load_reader()
    if load is not None:
        record["load_samples"].append(load)
    return now


def process_sample(state, pid, *counters):
    """What one stat sample shows (`heavy_process_sample`): the state X
    decides before the identity and the counters are judged."""
    return "vanished" if state == "X" else "rejected" if pid <= 0 or min(counters) < 0 else "process"


def process_stat(text):
    """Identity, group and self CPU ticks; comm may contain spaces or ')'.
    A sample in state X is of a process that was reaped and is being
    released: it has no parent, group or session left, so it has vanished
    (ProcessLookupError), as if its stat file were already gone. A zombie
    (Z) is a process still, with its final counters, until it is reaped."""
    left, right = text.index("("), text.rindex(")")
    fields = text[right + 1:].split()  # Begins at field 3 (state).
    # A released process may lack the fields that follow its state.
    if process_sample(fields[0], 1, 0) == "vanished":
        raise ProcessLookupError("process is dead")
    pid, ppid, pgrp, session, user, system, start, rss = (int(v) for v in
                                              (text[:left], fields[1], fields[2], fields[3], fields[11],
                                               fields[12], fields[19], fields[21]))
    if process_sample(fields[0], pid, ppid, pgrp, session, user, system, start, rss) != "process":
        raise ValueError("invalid process counters")
    return {"pid": pid, "ppid": ppid, "comm": text[left + 1:right], "state": fields[0],
            "pgrp": pgrp, "session": session, "ticks": user + system, "start": start, "rss_pages": rss}


def cpu_ticks(path="/proc/stat"):
    """Aggregate CPU counters: user, nice, system, idle, iowait, irq,
    softirq and steal. Guest times are already included in user/nice."""
    try:
        with open(path) as f:
            fields = f.readline().split()
        if not fields or fields[0] != "cpu" or len(fields) < 5:
            return None
        ticks = tuple(int(v) for v in fields[1:9])
        if any(v < 0 for v in ticks):
            return None
        return ticks + (0,) * (8 - len(ticks))
    except (OSError, ValueError):
        return None


def cpu_interval(before, after):
    """Busy/total ticks between adjacent readings, or None without a
    usable interval. A reset (including a decreasing iowait) rebaselines."""
    if before is None or after is None:
        return None
    delta = [end - start for start, end in zip(before, after)]
    total = sum(delta)
    if any(v < 0 for v in delta) or total <= 0:
        return None
    return {"busy_ticks": total - delta[3] - delta[4], "total_ticks": total}


def sample_cpu(record, now, last=None, final=False, reader=None):
    if last is not None and not final and now - last[0] < LOAD_SAMPLE_SECONDS:
        return last
    ticks = (reader or cpu_ticks)()
    if last is not None:
        interval = cpu_interval(last[1], ticks)
        if interval is not None:
            record["cpu_busy_samples"].append(interval)
    return now, ticks


def cpu_summary(record):
    # Reaping folds each result under a short signal mask. Retain only its
    # aggregate, even when a long job waits for many thousands of workers.
    usage = record.pop("_cpu_usage", (0, 0, 0, 0))
    record["cpu_user_seconds"] += usage[0]
    record["cpu_system_seconds"] += usage[1]
    record["involuntary_context_switches"] = record.get("involuntary_context_switches", 0) + usage[3]
    record["peak_rss_kb"] = max(record["peak_rss_kb"], usage[2])
    samples = record["cpu_busy_samples"]
    busy = sum(s["busy_ticks"] for s in samples)
    total = sum(s["total_ticks"] for s in samples)
    record.update(cpu_busy_mean=busy / total if total else None,
                  cpu_busy_max=max((s["busy_ticks"] / s["total_ticks"] for s in samples),
                                   default=None))
    record["cpu_seconds"] = record["cpu_user_seconds"] + record["cpu_system_seconds"]
    seconds = record["run_seconds"]
    record["cpu_parallelism"] = record["cpu_seconds"] / seconds if seconds > 0 else None


def machine_counters(path="/proc/stat"):
    """Independent runnable-task, logical-CPU and context-switch readings."""
    try:
        with open(path) as f:
            lines = [line.split() for line in f]
    except (OSError, ValueError):
        return {}
    out = {}
    cores = len({p[0] for p in lines if len(p) >= 5 and re.fullmatch(r"cpu\d+", p[0])
                 and all(v.isdigit() for v in p[1:5])})
    if cores:
        out["cpu_cores"] = cores
    for parts in lines:
        if len(parts) == 2 and parts[0] in ("ctxt", "procs_running"):
            try:
                value = int(parts[1])
                if value >= 0:
                    out[parts[0]] = value
            except ValueError:
                pass
    return out


class MachineSampler:
    def __init__(self):
        self.running_count = self.running_sum = self.oversubscribed = 0
        self.running_max = self.ratio_max = None
        self.ratio_sum = 0.0
        self.rate_count = self.switches = 0
        self.seconds = 0.0
        self.rate_max = None
        self.last = None

    def sample(self, now, reading):
        cores, running, ctxt = (reading.get(k) for k in ("cpu_cores", "procs_running", "ctxt"))
        if cores is not None and cores > 0 and running is not None:
            ratio = running / cores
            self.running_count += 1
            self.running_sum += running
            self.ratio_sum += ratio
            self.running_max = max(self.running_max or 0, running)
            self.ratio_max = max(self.ratio_max or 0, ratio)
            self.oversubscribed += running > cores
        if self.last is not None and ctxt is not None:
            before, previous = self.last
            if previous is not None and now > before and ctxt >= previous:
                seconds, switches = now - before, ctxt - previous
                self.rate_count += 1
                self.seconds += seconds
                self.switches += switches
                self.rate_max = max(self.rate_max or 0, switches / seconds)
        self.last = now, ctxt

    def finish(self, record):
        count = self.running_count
        record.update(
            procs_running_sample_count=count,
            procs_running_mean=self.running_sum / count if count else None,
            procs_running_max=self.running_max,
            runnable_per_core_mean=self.ratio_sum / count if count else None,
            runnable_per_core_max=self.ratio_max,
            oversubscribed_fraction=self.oversubscribed / count if count else None,
            ctxt_rate_sample_count=self.rate_count,
            ctxt_observed_seconds=self.seconds, ctxt_switches=self.switches,
            ctxt_per_second_mean=self.switches / self.seconds if self.seconds else None,
            ctxt_per_second_max=self.rate_max)


def process_switches(text):
    for line in text.splitlines():
        fields = line.split()
        if len(fields) == 2 and fields[0] == "nonvoluntary_ctxt_switches:":
            value = int(fields[1])
            return value if value >= 0 else None
    return None


def group_processes(pgid, proc="/proc", live=None, session=False):
    """Linux process-group snapshots, or None when procfs is unavailable.
    Read self utime/stime only: child times would count workers twice."""
    try:
        entries = os.listdir(proc)
    except OSError:
        return None
    found = []
    scope = "session" if session else "pgrp"
    for entry in entries:
        if not entry.isdigit():
            continue
        path = os.path.join(proc, entry)
        try:
            with open(os.path.join(path, "stat")) as f:
                row = process_stat(f.read())
            if row["pid"] != int(entry):
                continue
            if live is not None:
                live.add((row["pid"], row["start"]))
            if row[scope] != pgid:
                continue
            try:
                row["name"] = os.path.basename(os.readlink(os.path.join(path, "exe")))
                row["name"] = row["name"].removesuffix(" (deleted)")
            except OSError:
                row["name"] = None  # Zombies have no exe link; retain a cached name below.
            try:
                with open(os.path.join(path, "status")) as f:
                    row["switches"] = process_switches(f.read())
            except (OSError, ValueError):
                row["switches"] = None
            with open(os.path.join(path, "stat")) as f:
                check = process_stat(f.read())
            if (check["pid"], check["start"], check[scope]) == (row["pid"], row["start"], pgid):
                found.append(row)
        except (OSError, ValueError, IndexError):
            continue  # Processes can disappear or become unreadable during a scan.
    return found


class ProcessSampler:
    def __init__(self, started, ticks_per_second):
        self.started = started
        self.hz = ticks_per_second if ticks_per_second and ticks_per_second > 0 else None
        self.previous = {}
        self.names = {}
        self.samples = 0
        self.switches = 0
        self.switch_samples = 0

    def sample(self, now, boot_now, rows, live=None):
        if rows is None or not self.hz:
            # Do not bridge an unreadable scan when estimating per-process cores.
            for state in self.previous.values():
                state["gap"] = True
            return
        self.samples += 1
        counts = {}
        current = {}
        for row in rows:
            identity = row["pid"], row["start"]
            before = self.previous.get(identity)
            name = row["name"] or (before["name"] if before and row["comm"] == before["comm"]
                                    else row["comm"])
            data = self.names.setdefault(name, {"core_seconds": 0.0, "observed_core_seconds": 0.0,
                                               "observed_process_seconds": 0.0,
                                               "peak_cores_per_process": None, "peak_process_count": 0,
                                               "processes_seen": 0})
            seen_names = before["seen_names"] if before else set()
            if name not in seen_names:
                seen_names.add(name)
                data["processes_seen"] += 1
            if row["state"] not in ("Z", "X"):
                counts[name] = counts.get(name, 0) + 1
            ticks = row["ticks"] - (before["ticks"] if before else 0)
            # Newly observed group members were born after the job started.
            # Their lifetime CPU is known, though their birth time is tick-rounded.
            if before:
                elapsed = now - before["at"]
            elif boot_now is not None:
                elapsed = min(now - self.started, max(0, boot_now - row["start"] / self.hz))
            else:
                elapsed = 0
            if ticks >= 0:
                seconds = ticks / self.hz
                data["core_seconds"] += seconds
                if elapsed > 0 and not (before and before["gap"]):
                    data["observed_core_seconds"] += seconds
                    data["observed_process_seconds"] += elapsed
                    peak = data["peak_cores_per_process"]
                    data["peak_cores_per_process"] = max(peak or 0, seconds / elapsed)
            switches = row["switches"]
            previous_switches = before["switches"] if before else None
            if switches is not None:
                self.switch_samples += 1
                if previous_switches is not None:
                    self.switches += max(0, switches - previous_switches)
                else:
                    self.switches += switches
            current[identity] = {**row, "name": name, "at": now, "gap": False,
                                 "seen_names": seen_names,
                                 "switches": switches if switches is not None else previous_switches}
        # A live worker can leave and rejoin the group. Keep its baseline
        # across that gap without adding CPU or counting the lifetime again.
        if live is not None:
            for identity, before in self.previous.items():
                if identity in live and identity not in current:
                    current[identity] = dict(before, gap=True)
        # Completed lifetimes' contributions remain only in per-name totals.
        self.previous = current
        for name, count in counts.items():
            self.names[name]["peak_process_count"] = max(self.names[name]["peak_process_count"], count)

    def finish(self, record):
        for data in self.names.values():
            seconds = data["observed_process_seconds"]
            data["mean_cores_per_process"] = data["observed_core_seconds"] / seconds if seconds else None
        record.update(process_cpu=self.names if self.samples else None,
                      process_samples=self.samples,
                      nonvoluntary_ctxt_switches=self.switches if self.switch_samples else None)


def command_forecast(command, state=STATE, environ=None, now=None):
    """Build and invoke this checkout's Lean adviser; unknown on failure."""
    environ = os.environ if environ is None else environ
    now = time.time() if now is None else now
    root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    package = os.path.join(root, "tools", "heavy-observe")
    build_dir = os.path.join(package, ".lake")
    adviser = os.path.join(build_dir, "build", "bin", "compiler_advice")
    path = environ.get("HEAVY_LOG") or os.path.join(state, "log.jsonl")
    build = ["lake", "--rehash", "--no-cache", "-d", package, "build", "compiler_advice", "--wfail"]
    query = [adviser, "--job-forecast", path, str(now), command,
             str(PREDICTION_SECONDS), str(PREDICTION_JOBS), root]
    try:
        os.makedirs(build_dir, exist_ok=True)
        with open(os.path.join(build_dir, "prediction-build.lock"), "a") as lock:
            deadline = time.monotonic() + 120
            while True:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        return None, 0
                    select.select([], [], [], min(0.05, remaining))
            try:
                result = subprocess.run(query, capture_output=True, text=True, timeout=30)
            except FileNotFoundError:
                result = None
            if result is None or result.returncode:
                # Lake's trace can survive an externally replaced binary. Force
                # a relink when the source-verifying protocol rejects it.
                adapter = os.path.join(build_dir, "build", "lib", "lean", "ForecastMain")
                for stale in (adviser, adviser + ".trace", adapter + ".olean", adapter + ".trace"):
                    try:
                        os.unlink(stale)
                    except FileNotFoundError:
                        pass
                # Lake's shared artifact cache does not track include_str inputs.
                # Do not restore a stale adapter from it after invalidation.
                with tempfile.TemporaryDirectory(prefix="heavy-forecast-cache-") as cache:
                    subprocess.run(build, cwd=package, capture_output=True, timeout=120, check=True,
                                   env={**os.environ, "LAKE_CACHE_DIR": cache})
                result = subprocess.run(query, capture_output=True, text=True, timeout=30, check=True)
            peak, count = json.loads(result.stdout)
            return peak, count
    except (OSError, ValueError, TypeError, subprocess.SubprocessError):
        return None, 0


def append_log(record, state=STATE, environ=None):
    """Append a complete line, locking across retries of a short write."""
    environ = os.environ if environ is None else environ
    try:
        path = environ.get("HEAVY_LOG") or os.path.join(state, "log.jsonl")
        data = (json.dumps(record, allow_nan=False) + "\n").encode()
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            size = os.fstat(fd).st_size
            try:
                remaining = memoryview(data)
                while remaining:
                    written = os.write(fd, remaining)
                    if written <= 0:
                        raise OSError("log write made no progress")
                    remaining = remaining[written:]
            except OSError:
                os.ftruncate(fd, size)
                raise
        finally:
            os.close(fd)
    except (OSError, ValueError, TypeError):
        pass  # Telemetry must never change a command's exit status.


def flip_policy(value, state=STATE, environ=None, clock=time.time):
    """Publish a complete setting atomically, or remove it for off."""
    path = os.path.join(state, "max_load")
    if value == "off":
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
    else:
        with tempfile.NamedTemporaryFile(mode="w", dir=state, delete=False) as f:
            temporary = f.name
            try:
                f.write(f"{value}\n")
                f.close()
                os.replace(temporary, path)
            finally:
                if os.path.exists(temporary):
                    os.unlink(temporary)
    append_log({"event": "policy", "at": clock(), "max_load": value,
                "slots": slot_count(environ, state)}, state, environ)


def alternate(minutes, value, state=STATE, environ=None, sleep=time.sleep, clock=time.time):
    os.makedirs(state, exist_ok=True)
    with open(os.path.join(state, "alternate.lock"), "a+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError("heavy: another --alternate already holds this state directory")
        previous = {}
        stopping = False

        def stop(sig, frame):
            nonlocal stopping
            if not stopping:
                stopping = True
                raise KeyboardInterrupt

        try:
            for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
                handler = signal.getsignal(sig)
                if handler is not signal.SIG_IGN:
                    previous[sig] = handler
                    signal.signal(sig, stop)
            current = value
            try:
                while True:
                    flip_policy(current, state, environ, clock)
                    sleep(minutes * 60)
                    current = "off" if current != "off" else value
            finally:
                stopping = True
                flip_policy("off", state, environ, clock)
        finally:
            for sig, handler in previous.items():
                signal.signal(sig, handler)


def job_kind(command):
    """Retain command/flags/job names, removing paths, seeds and numbers.
    Keep executable basenames, including the command after `lake env`."""
    executables = {0}
    if len(command) > 2 and os.path.basename(command[0]) == "lake" and command[1] == "env":
        executables.add(2)
    if command and re.fullmatch(r"python[\d.]*|bash|sh", os.path.basename(command[0])):
        for i, word in enumerate(command[1:], 1):
            if word in ("-c", "-m"):
                break
            if not word.startswith("-"):
                executables.add(i)
                break
    words, skip = [], False
    for i, word in enumerate(command):
        if skip:
            skip = False
            continue
        if word in ("--seed", "--random-seed"):
            skip = True
            continue
        if word.startswith(("--seed=", "--random-seed=")):
            continue
        flag, equal, value = word.partition("=")
        if equal and flag.startswith("-"):
            word = flag
            if not re.search(r"[/\\]", value) and not re.fullmatch(
                    r"[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?", value):
                word += "=" + value
        if re.search(r"[/\\]", word):
            if i not in executables:
                continue
            word = os.path.basename(word)
        elif re.fullmatch(r"[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?", word):
            continue
        elif i not in executables and word.endswith((".fren", ".lean", ".json", ".txt")):
            continue
        word = re.sub(r"\d+", "", word)
        if word:
            words.append(word)
    return shlex.join(words) or "<command>"


def percentiles(values):
    """Linearly interpolated percentiles, in seconds."""
    values = sorted(values)
    out = {}
    for p in (50, 90, 95, 99):
        if not values:
            out[f"p{p}"] = None
            continue
        rank = (len(values) - 1) * p / 100
        low, high = math.floor(rank), math.ceil(rank)
        out[f"p{p}"] = values[low] + (values[high] - values[low]) * (rank - low)
    return out


def policy_key(row):
    load, slots = row["max_load"], row["slots"]
    if load != "off" and not (type(load) in (int, float) and math.isfinite(load) and load > 0):
        raise ValueError("invalid max_load")
    if type(slots) is not int or slots <= 0:
        raise ValueError("invalid slots")
    return load, slots


def wait_policy_changed(row):
    """Whether a wait spans an observed policy change; None for older records
    without enough evidence. Enqueue settings diagnose a crossover, never
    decide the policy that is billed for the admitted job."""
    if type(row.get("wait_policy_changed")) is not bool:
        return None
    try:
        initial = policy_key({"max_load": row["enqueued_max_load"], "slots": row["enqueued_slots"]})
    except (KeyError, TypeError, ValueError, OverflowError):
        return None
    return row["wait_policy_changed"] or initial != policy_key(row)


def summarize(rows, hours, rate_jobs=None, wait_rows=None):
    loads = [v for row in rows for v in row["load_samples"]]
    rate_jobs = len(rows) if rate_jobs is None else rate_jobs
    wait_rows = rows if wait_rows is None else wait_rows
    return {
        "jobs": len(rows), "observed_hours": hours,
        "failed_jobs": sum(r.get("exit_status") != 0 for r in rows),
        "rate_jobs": rate_jobs, "jobs_per_hour": rate_jobs / hours if hours > 0 else None,
        "wait_jobs": len(wait_rows),
        "wait_seconds": percentiles([r["wait_seconds"] for r in wait_rows]),
        "run_seconds": percentiles([r["run_seconds"] for r in rows]),
        "latency_seconds": percentiles([r["wait_seconds"] + r["run_seconds"] for r in wait_rows]),
        "mean_load": sum(loads) / len(loads) if loads else None,
    }


def stats(hours, state=STATE, environ=None, now=None):
    """Rates use logged policy intervals, clipped to the requested window.
    Only admissions within a matching interval count toward policy rates;
    waits that span policy changes are reported separately from comparisons.
    Raw counts and top-level timings still describe every completion in the window.
    Attribute completions to their admission policy, even across a flip.
    Ignore malformed lines, including an incomplete concurrent append."""
    environ = os.environ if environ is None else environ
    now = time.time() if now is None else now
    rows, flips = [], []
    path = environ.get("HEAVY_LOG") or os.path.join(state, "log.jsonl")
    try:
        with open(path) as f:
            for line in f:
                try:
                    row = json.loads(line)
                    key = policy_key(row)
                    if row.get("event") == "policy":
                        at = row["at"]
                        if type(at) in (int, float) and math.isfinite(at) and 0 <= at <= now:
                            flips.append((at, key))
                        continue
                    numbers = [row[k] for k in ("started_at", "ended_at", "wait_seconds", "run_seconds")]
                    if "enqueued_at" in row:
                        numbers.append(row["enqueued_at"])
                    loads = row["load_samples"]
                    if not isinstance(loads, list):
                        continue
                    if not all(type(v) in (int, float) and math.isfinite(v) and v >= 0
                               for v in numbers + loads):
                        continue
                    if not isinstance(row["job_kind"], str) or type(row["exit_status"]) is not int:
                        continue
                    if "wait_policy_changed" in row and type(row["wait_policy_changed"]) is not bool:
                        continue
                    if "enqueued_max_load" in row or "enqueued_slots" in row:
                        policy_key({"max_load": row["enqueued_max_load"], "slots": row["enqueued_slots"]})
                    if any(k in row and not isinstance(row[k], str) for k in ("command", "worktree")):
                        continue
                    if now - hours * 3600 <= row["ended_at"] <= now:
                        rows.append(row)
                except (ValueError, TypeError, KeyError, OverflowError):
                    continue
    except FileNotFoundError:
        pass
    exposure, intervals = {}, []
    flips.sort(key=lambda flip: flip[0])
    for i, (at, key) in enumerate(flips):
        end = flips[i + 1][0] if i + 1 < len(flips) else now
        begin = max(at, now - hours * 3600)
        duration = max(0, end - begin) / 3600
        if duration > 0:
            exposure[key] = exposure.get(key, 0) + duration
            intervals.append((begin, end, key))
    grouped, wait_groups, rate_counts, excluded_waits = {}, {}, {}, []
    for row in rows:
        key = policy_key(row)
        grouped.setdefault(key, []).append(row)
        changed = wait_policy_changed(row)
        if changed is False:
            wait_groups.setdefault(key, []).append(row)
            if any(k == key and begin <= row["started_at"] < end for begin, end, k in intervals):
                rate_counts[key] = rate_counts.get(key, 0) + 1
        else:
            fields = ("command", "worktree", "enqueued_at", "started_at", "max_load", "slots",
                      "enqueued_max_load", "enqueued_slots", "wait_seconds", "run_seconds")
            excluded_waits.append({**{k: row[k] for k in fields if k in row},
                                   "reason": "policy_changed_while_waiting" if changed else "wait_policy_unknown"})
    policies, kinds = [], {}
    # Compare only successful runs: a fast failure is not a speedup.
    successful = {}
    for row in rows:
        if row.get("exit_status") == 0:
            successful.setdefault((policy_key(row), row["job_kind"]), []).append(row["run_seconds"])
    for key in sorted(set(grouped) | set(exposure), key=lambda k: (k[1], str(k[0]))):
        load, slots = key
        policy = {"max_load": load, "slots": slots,
                  **summarize(grouped.get(key, []), exposure.get(key, 0), rate_counts.get(key, 0),
                              wait_groups.get(key, []))}
        ratios = []
        for kind in sorted({r["job_kind"] for r in grouped.get(key, [])}):
            values = successful.get((key, kind), [])
            baseline = successful.get((("off", slots), kind), [])
            median = percentiles(values)["p50"]
            off_median = percentiles(baseline)["p50"]
            ratio = median / off_median if median is not None and off_median else None
            if load != "off" and ratio is not None and ratio > 0:
                ratios.append(ratio)
            kinds.setdefault(kind, []).append({"max_load": load, "slots": slots,
                "successful_jobs": len(values), "run_seconds": percentiles(values),
                "run_ratio_vs_off": ratio})
        policy.update(matched_kinds=len(ratios), normalized_run_ratio_vs_off=(
            math.exp(sum(math.log(r) for r in ratios) / len(ratios)) if ratios else None))
        policies.append(policy)
    # Waits by priority class are the evidence for the admission order and
    # its aging step. Records from before the classes have no class.
    classes = {}
    for row in rows:
        label = row.get("priority")
        classes.setdefault(priority_class(label) if isinstance(label, str) else "unrecorded", []).append(row)
    by_priority = [{"priority": name, "jobs": len(found),
                    "jobs_per_hour": len(found) / hours if hours > 0 else None,
                    "wait_seconds": percentiles([r["wait_seconds"] for r in found]),
                    "max_wait_seconds": max(r["wait_seconds"] for r in found),
                    "run_seconds": percentiles([r["run_seconds"] for r in found])}
                   for name in (*PRIORITY_CLASSES, "unrecorded") for found in [classes.get(name)] if found]
    return {"hours": hours, **summarize(rows, sum(exposure.values()), sum(rate_counts.values())),
            "policies": policies, "by_kind": kinds, "by_priority": by_priority,
            "excluded_waits": excluded_waits}


_physical = []


def mem_cap_kb(environ=None, state=STATE, physical=None, warn=None):
    """The memory cap, in KB: `HEAVY_MEM_GB`, else the file `mem_gb`, else
    80% of `physical()`, the physical memory in KB."""
    gb = setting("HEAVY_MEM_GB", "mem_gb", float, environ, state, warn)
    if gb is not None:
        return int(gb * 1024 * 1024)
    if physical is None:
        if not _physical:
            _physical.append(physical_memory_kb())
        kb = _physical[0]
    else:
        kb = physical()
    return int(kb * DEFAULT_MEM_FRACTION)


def offline_command(command, system=None, check=None):
    """`command` wrapped so that it runs with no network, or a RuntimeError
    saying why it cannot be. `check` runs a command and says whether it
    succeeded."""
    system = system or platform.system()
    if check is None:
        def check(c):
            try:
                return subprocess.run(c, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                      stderr=subprocess.DEVNULL).returncode == 0
            except OSError:
                return False
    if system == "Linux":
        wrapper = ["unshare", "-rn", "--"]
        if not check(wrapper + ["true"]):
            raise RuntimeError(
                "heavy: --offline needs unprivileged user namespaces, and `unshare -rn true` "
                "failed; enable them (for example the sysctls "
                "kernel.unprivileged_userns_clone=1, or "
                "kernel.apparmor_restrict_unprivileged_userns=0 under AppArmor), "
                "or run the command without --offline only if it may use the network")
        return wrapper + command
    if system == "Darwin":
        wrapper = ["sandbox-exec", "-p", MACOS_OFFLINE_PROFILE]
        if not check(wrapper + ["true"]):
            raise RuntimeError("heavy: --offline needs sandbox-exec, and it failed")
        return wrapper + command
    raise RuntimeError(f"heavy: --offline is not supported on {system}")


def group_rss_kb(proc="/proc", system=None, session=False):
    """Resident memory of groups visible through this caller's procfs/ps view.
    These IDs must never be looked up on another namespace's behalf."""
    if (system or platform.system()) == "Linux":
        page_size = os.sysconf("SC_PAGE_SIZE")
        rss = {}
        for pid in os.listdir(proc):
            if not pid.isdigit():
                continue
            try:
                with open(os.path.join(proc, pid, "stat")) as f:
                    row = process_stat(f.read())
                kb = row["rss_pages"] * page_size // 1024
                key = row["session" if session else "pgrp"]
                rss[key] = rss.get(key, 0) + kb
            except (OSError, ValueError, IndexError):
                continue
        return rss
    result = subprocess.run(["ps", "-A", "-o", "pgid=,rss="], capture_output=True, text=True)
    if result.returncode:
        raise OSError("ps could not measure process-group memory")
    out = result.stdout
    rss = {}
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[0].isdigit() and parts[1].isdigit():
            rss[int(parts[0])] = rss.get(int(parts[0]), 0) + int(parts[1])
    return rss


def pid_namespace():
    try:
        return os.readlink("/proc/self/ns/pid")
    except OSError:
        return None


def visible_group(child_pid, proc="/proc", system=None):
    """Translate our own child's local PID into the procfs view's PGID.
    With an ancestor's /proc mount, NSpid locates the child among our own
    children. Linux requires NSpid in the caller's status and, for ancestor
    procfs, in candidate status files. Never resolve another slot's numeric
    PID this way."""
    if (system or platform.system()) != "Linux":
        return child_pid
    with open(os.path.join(proc, "self", "stat")) as f:
        parent = process_stat(f.read())["pid"]
    with open(os.path.join(proc, "self", "status")) as f:
        fields = next(line.split()[1:] for line in f if line.startswith("NSpid:"))
    depth = len(fields) - 1
    if depth < 0 or int(fields[-1]) != os.getpid():
        raise ValueError("cannot identify this process in the procfs PID namespace")
    # A single NSpid entry identifies our own procfs view without needing
    # permission to read root's /proc/1/ns/pid on an ordinary host.
    if depth == 0 and parent == os.getpid():
        candidates = [str(child_pid)]
        depth = None
    else:
        candidates = [p for p in os.listdir(proc) if p.isdigit()]
    for pid in candidates:
        try:
            with open(os.path.join(proc, pid, "stat")) as f:
                row = process_stat(f.read())
            if row["ppid"] != parent or row["pgrp"] != row["pid"]:
                continue
            if depth is not None:
                with open(os.path.join(proc, pid, "status")) as f:
                    ids = next(line.split()[1:] for line in f if line.startswith("NSpid:"))
                if len(ids) <= depth or int(ids[depth]) != child_pid:
                    continue
            return row["pgrp"]
        except (OSError, ValueError, IndexError, StopIteration):
            continue
    raise ValueError("cannot identify the command's process group in procfs")


class RegistryBusy(TimeoutError):
    """Shared accounting is temporarily unavailable; keep local enforcement."""


@contextlib.contextmanager
def registry(state):
    # Acquisition, publication and release share this short-lived lock.
    # A stopped holder must not stall other monitors or admission checks.
    # Never wait for a slot while holding it, and never replace a slot inode.
    fd = os.open(os.path.join(state, "registry.lock"), os.O_RDWR | os.O_CREAT, 0o600)
    previous = None
    deadline = time.monotonic() + REGISTRY_WAIT_SECONDS
    try:
        while True:
            # Mask before acquiring: handlers may spend seconds killing a group.
            previous = signal.pthread_sigmask(signal.SIG_BLOCK,
                (signal.SIGINT, signal.SIGTERM, signal.SIGHUP))
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                signal.pthread_sigmask(signal.SIG_SETMASK, previous)
                previous = None
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise RegistryBusy("registry lock deadline expired")
                time.sleep(min(REGISTRY_RETRY_SECONDS, remaining))
        yield
    finally:
        # Release before unmasking, including when the critical section fails.
        try:
            os.close(fd)
        finally:
            if previous is not None:
                signal.pthread_sigmask(signal.SIG_SETMASK, previous)


def atomic_state(path, value):
    with tempfile.NamedTemporaryFile(mode="w", dir=os.path.dirname(path), delete=False) as f:
        temporary = f.name
        try:
            json.dump(value, f, allow_nan=False)
            f.close()
            os.replace(temporary, path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)


def read_report(path):
    try:
        with open(path) as f:
            row = json.load(f)
        monitor = row.get("monitor")
        valid_monitor = monitor is None or (isinstance(monitor, dict)
            and type(monitor.get("pid")) is int and monitor["pid"] > 0
            and type(monitor.get("start")) is int and monitor["start"] >= 0
            and isinstance(monitor.get("namespace"), str))
        if (row["version"] == 3 and isinstance(row["job_id"], str)
                and re.fullmatch(r"[0-9a-f]{32}", row["job_id"])
                and type(row["order"]) is int and row["order"] > 0
                and type(row["rss_kb"]) is int and row["rss_kb"] >= 0
                and type(row["updated_monotonic"]) in (int, float) and math.isfinite(row["updated_monotonic"])
                and valid_monitor):
            return row
    except (OSError, ValueError, TypeError, KeyError, AttributeError, OverflowError):
        pass
    return None


def report_current(report, status_job, observed, now):
    """A slot token must agree, and a visible kernel owner must agree too.
    With no visible owner, only a fresh report can vouch for its monitor."""
    if report["job_id"] != status_job:
        return False
    if observed is not None:
        return observed == report.get("monitor")
    return 0 <= now - report["updated_monotonic"] <= REPORT_STALE_SECONDS


def report_path(state, slot):
    return os.path.join(state, f".{slot}.json")


def slot_job_id(text):
    match = re.search(r"\[heavy-job=([0-9a-f]{32})\]\s*$", text)
    return match[1] if match else None


def monitor_identity(pid="self", proc="/proc"):
    """An identity read through a kernel-reported PID, never a slot's PID."""
    with open(os.path.join(proc, str(pid), "stat")) as f:
        try:
            row = process_stat(f.read())
        except IndexError as e:
            raise ValueError("incomplete process identity") from e
    with open(os.path.join(proc, str(pid), "status")) as f:
        ids = next((line.split()[1:] for line in f if line.startswith("NSpid:")), None)
    if not ids or int(ids[-1]) <= 0:
        raise ValueError("cannot identify the monitor's PID namespace")
    return {"pid": int(ids[-1]), "start": row["start"],
            "namespace": os.readlink(os.path.join(proc, str(pid), "ns", "pid"))}


def write_status(f, text):
    job = getattr(f, "heavy_job", None)
    suffix = f" [heavy-job={job['job_id']}]" if job else ""
    f.seek(0)
    f.truncate()
    f.write(text + suffix + "\n")
    f.flush()


def claim_slot(f, slot, state, record):
    """Register a new lock owner atomically with taking the slot lock.
    The caller holds registry; False leaves no lease or metadata behind."""
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return False
    try:
        sequence_path = os.path.join(state, "sequence.json")
        try:
            with open(sequence_path) as seq:
                sequence = json.load(seq)
            if type(sequence) is not int or sequence < 0:
                sequence = 0
        except (OSError, ValueError):
            sequence = 0
        for name in os.listdir(state):
            if re.fullmatch(r"\.slot\d+\.json", name):
                previous = read_report(os.path.join(state, name))
                if previous:
                    sequence = max(sequence, previous["order"])
        job = {"version": 3, "job_id": uuid.uuid4().hex, "order": sequence + 1,
               "pid_namespace": pid_namespace(), "started_at": record["enqueued_at"],
               "monitor": monitor_identity() if platform.system() == "Linux" else None,
               "rss_kb": 0, "updated_monotonic": time.monotonic()}
        atomic_state(sequence_path, job["order"])
        atomic_state(report_path(state, slot), job)
        f.heavy_job = job
        f.heavy_slot = slot
        write_status(f, f"0 {record['enqueued_at']}")
        return True
    except BaseException:
        f.close()
        raise


def publish_memory(f, rss, state):
    job = getattr(f, "heavy_job", None)
    if job is None:
        return  # A direct test of the monitor has no shared slot.
    with registry(state):
        pending = getattr(f, "heavy_status", None)
        if pending is not None:
            write_status(f, pending)
            f.heavy_status = None
        job.update(rss_kb=rss, updated_monotonic=time.monotonic())
        atomic_state(report_path(state, f.heavy_slot), job)


def release_slot(f, state):
    try:
        with registry(state):
            try:
                slot = getattr(f, "heavy_slot", None)
                if slot is not None:
                    try:
                        os.unlink(report_path(state, slot))
                    except FileNotFoundError:
                        pass
                f.seek(0)
                f.truncate()
            finally:
                # Release before registry unlock, even if cleanup fails.
                f.close()
    except OSError:
        pass  # An unlocked stale report is ignored; closing the lease is sufficient.
    finally:
        f.close()


def flock_owners(proc="/proc"):
    """Kernel-reported flock holders, with IDs in this procfs view.
    Never resolve a numeric PID from a legacy slot's diagnostic text.
    Devices here must match stat's devices; otherwise verification falls back."""
    found = {}
    with open(os.path.join(proc, "locks")) as f:
        for line in f:
            fields = line.split()
            if len(fields) != 8 or fields[1:4] != ["FLOCK", "ADVISORY", "WRITE"]:
                continue  # Includes blocked requests marked with '->'.
            try:
                major, minor, inode = fields[5].split(":")
                pid = int(fields[4])
                if pid > 0 and fields[6:] == ["0", "EOF"]:
                    found[(int(major, 16), int(minor, 16), int(inode))] = pid
            except ValueError:
                continue
    return found


def legacy_readings(leases, proc="/proc", system=None):
    """Validate report owners and measure visible legacy child groups.
    Lock ownership and parentage come from the kernel, in one procfs view.
    Missing/filtered data leaves the reading unknown, never zero by default.
    Do this scan outside registry: it must not delay other owners' checks."""
    if not leases:
        return
    release = re.match(r"(\d+)\.(\d+)", platform.release())
    linux = ((system or platform.system()) == "Linux" and release is not None
             and tuple(map(int, release.groups())) >= (4, 9))
    before = {}
    try:
        if linux:
            before = flock_owners(proc)
    except (OSError, ValueError):
        pass
    for lease in leases:
        if lease.get("legacy"):
            continue
        owner = before.get(lease["lock_key"])
        current = None
        if owner is not None:
            try:
                current = monitor_identity(owner, proc)
            except (OSError, ValueError, IndexError, StopIteration):
                pass
        if not report_current(lease, lease["status_job"], current, time.monotonic()):
            # Includes a legacy holder that has not overwritten inherited
            # status yet. An unobservable stale owner gets an estimate too.
            lease.update(job_id=None, order=None, rss_kb=None, fresh=False,
                         legacy=True, legacy_rss_kb=None)
    leases = [row for row in leases if row.get("legacy")]
    if not linux or not any(row["lock_key"] in before for row in leases):
        return
    try:
        processes, groups = {}, {}
        page_kb = os.sysconf("SC_PAGE_SIZE") // 1024
        for pid in os.listdir(proc):
            if not pid.isdigit():
                continue
            try:
                with open(os.path.join(proc, pid, "stat")) as f:
                    row = process_stat(f.read())
                processes[row["pid"]] = row
                groups[row["pgrp"]] = groups.get(row["pgrp"], 0) + row["rss_pages"] * page_kb
            except (OSError, ValueError, IndexError):
                continue
        after = flock_owners(proc)
        for lease in leases:
            owner = before.get(lease["lock_key"])
            if owner not in processes or after.get(lease["lock_key"]) != owner:
                continue
            try:
                with open(os.path.join(proc, str(owner), "stat")) as f:
                    current = process_stat(f.read())
            except (OSError, ValueError, IndexError):
                continue
            if current["start"] != processes[owner]["start"]:
                continue
            children = {r["pgrp"] for r in processes.values()
                        if r["ppid"] == owner and r["pgrp"] == r["pid"]}
            if children:
                lease["legacy_rss_kb"] = sum(groups[g] for g in children)
    except (OSError, ValueError, IndexError):
        pass  # An estimate, not a missing procfs entry, decides admission.


def jobs(state=STATE):
    """Live leases and owner-measured memory, independent of PID visibility.
    Verified stale owners retain last RSS; unverified stale status is legacy.
    Unlocked reports are ignored even after numeric PID reuse."""
    found = []
    with registry(state):
        for name in os.listdir(state):
            if not re.fullmatch(r"slot\d+", name):
                continue
            try:
                with open(os.path.join(state, name)) as f:
                    try:
                        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    except BlockingIOError:
                        identity = slot_job_id(f.read())
                        row = read_report(report_path(state, name)) if identity else None
                        if row is None:
                            row = {"job_id": None, "order": None, "rss_kb": None, "fresh": False,
                                   "legacy": True, "legacy_rss_kb": None}
                        else:
                            row.update(status_job=identity, legacy=False, legacy_rss_kb=None)
                            row["fresh"] = 0 <= time.monotonic() - row["updated_monotonic"] <= REPORT_STALE_SECONDS
                        st = os.fstat(f.fileno())
                        row["lock_key"] = (os.major(st.st_dev), os.minor(st.st_dev), st.st_ino)
                        found.append(dict(row, slot=name))
            except FileNotFoundError:
                continue
    legacy_readings(found)
    return found


def memory_victim(running, cap):
    """Only measurements count toward eviction. Select a compatible owner;
    legacy reservations never cause eviction and legacy holders are not targets."""
    eligible = [j for j in running if j["job_id"] is not None
                and j["order"] is not None and j["order"] > 0
                and j["rss_kb"] is not None and j["rss_kb"] >= 0]
    total = sum(j["rss_kb"] for j in eligible) + sum(max(0, j.get("legacy_rss_kb") or 0) for j in running)
    return total, max(eligible, key=lambda j: j["order"])["job_id"] if total > cap and eligible else None


def group_gone(pgid, reap, subreaper=False):
    """Even subreaping can leave group members parented outside the group.
    Exhausting wait4 is not evidence that the local process group is gone."""
    if not reap():
        return False
    if os.getpid() == 1:
        # Peek at exited children without consuming their usage. A worker
        # can be adopted after reap() exhausted the group waits; route it
        # back through wait4 rather than losing its CPU/RSS to waitpid.
        while True:
            try:
                exited = os.waitid(os.P_ALL, 0, os.WEXITED | os.WNOHANG | os.WNOWAIT)
                if exited is None:
                    break
                if subreaper and os.getpgid(exited.si_pid) == pgid:
                    if not reap():
                        return False
                else:
                    # An exited child's group cannot change before reaping.
                    os.waitpid(exited.si_pid, os.WNOHANG)
            except ChildProcessError:
                break
            except ProcessLookupError:
                continue  # A reentrant termination handler collected it.
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return True
    except PermissionError:
        pass  # Existence without permission is still existence.
    return False


def kill_group(pgid, reap, subreaper=False):
    for sig, wait in ((signal.SIGTERM, 5), (signal.SIGKILL, 5)):
        # A reaped leader is not an empty group while workers remain.
        # Probe that local group until it disappears, including escalation.
        # Block reentrant signal handlers around the completion check/signal.
        previous = signal.pthread_sigmask(signal.SIG_BLOCK, (signal.SIGINT, signal.SIGTERM, signal.SIGHUP))
        try:
            if group_gone(pgid, reap, subreaper):
                return
            os.killpg(pgid, sig)
        except (ProcessLookupError, PermissionError):
            return
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, previous)
        deadline = time.monotonic() + wait
        while time.monotonic() < deadline:
            if group_gone(pgid, reap, subreaper):
                return
            time.sleep(0.2)


@contextlib.contextmanager
def child_subreaper():
    """On Linux, adopt orphaned descendants so wait4 can account for them.
    Elsewhere wait4 accounts for the child and its waited-for descendants.
    Restore the setting for callers that invoke main more than once."""
    enabled = False
    previous = ctypes.c_int()
    if platform.system() == "Linux":
        try:
            prctl = ctypes.CDLL(None).prctl
            # PR_GET_CHILD_SUBREAPER / PR_SET_CHILD_SUBREAPER (linux/prctl.h).
            enabled = (prctl(37, ctypes.byref(previous), 0, 0, 0) == 0
                       and prctl(36, 1, 0, 0, 0) == 0)
        except (OSError, AttributeError):
            pass
    try:
        yield enabled
    finally:
        if enabled:
            prctl(36, previous.value, 0, 0, 0)


def record_child_usage(record, usage):
    kb = usage.ru_maxrss / 1024 if platform.system() == "Darwin" else usage.ru_maxrss
    # A handler can reap between wait4 and this fold. Mask only the
    # bounded update, never a wait4 that might block during cleanup.
    previous = signal.pthread_sigmask(signal.SIG_BLOCK, (signal.SIGINT, signal.SIGTERM, signal.SIGHUP))
    try:
        before = record.get("_cpu_usage", (0, 0, 0, 0))
        record["_cpu_usage"] = (before[0] + usage.ru_utime, before[1] + usage.ru_stime,
                                 max(before[2], int(kb)), before[3] + usage.ru_nivcsw)
        record["peak_rss_kb"] = max(record.get("peak_rss_kb", 0), int(kb))
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, previous)


def reap_child(child, record, flags=os.WNOHANG):
    """Keep the kernel RSS high-water mark too, including for subsecond jobs.
    The sampled process-group sum also accounts for parallel workers."""
    group = getattr(child, "heavy_subreaper", False)
    while group or child.returncode is None:
        try:
            pid, status, usage = os.wait4(-child.pid if group else child.pid, flags)
        except ChildProcessError:
            # A signal handler may have reaped it; the successful caller
            # stores its status and usage when it resumes.
            return child.returncode is not None
        if not pid:
            return False
        if pid == child.pid:
            child.returncode = os.waitstatus_to_exitcode(status)
        record_child_usage(record, usage)
    return True


class ControlledSession:
    """Linux IO boundary for the session created by our own unreaped child.

    Session-wide discovery stops before reaping that anchor. Signals use only pidfds opened
    between matching procfs identity reads. No ledger PID or numeric SID is
    signalled. A dedicated subreaper, native procfs and no concurrent reaper are
    required; session/namespace escape and hostile mutation are outside scope.
    """
    def __init__(self, child, record):
        self.child, self.record = child, record
        self.handles = {}
        self.finished = False
        self.cleanup_failed = False
        self.exited = False

    @staticmethod
    def preflight(subreaper):
        if not subreaper or not hasattr(signal, "pidfd_send_signal") or not hasattr(os, "pidfd_open"):
            raise OSError("controlled builds require a Linux subreaper and pidfds")
        with open("/proc/self/stat") as f:
            if process_stat(f.read())["pid"] != os.getpid():
                raise OSError("controlled builds require native procfs PID visibility")
        if signal.getsignal(signal.SIGCHLD) != signal.SIG_DFL:
            raise OSError("controlled builds require the default SIGCHLD disposition")
        fd = os.pidfd_open(os.getpid())
        os.close(fd)

    def observe(self):
        # Keep the initial session ID anchored until the first apparently empty
        # census. After reaping it, use only kernel-parented adopted children;
        # never discover another process through a now-unanchored numeric SID.
        if self.child.returncode is None:
            event = os.waitid(os.P_PID, self.child.pid, os.WEXITED | os.WNOHANG | os.WNOWAIT)
            if event is not None and event.si_pid != self.child.pid:
                raise OSError("lost controlled session anchor")
            self.exited = event is not None
            if event is not None:
                self.record["command_wait_observation"] = {"pid": event.si_pid, "code": event.si_code, "status": event.si_status}
                self.record["command_observed_status"] = (event.si_status if event.si_code == os.CLD_EXITED
                                                            else 128 + event.si_status)
            entries = os.listdir("/proc")
        else:
            with open(f"/proc/self/task/{os.getpid()}/children") as f:
                entries = f.read().split()
        rows = {}
        for entry in entries:
            if not entry.isdigit():
                continue
            try:
                with open(f"/proc/{entry}/stat") as f:
                    row = process_stat(f.read())
                if row["pid"] != int(entry):
                    raise OSError("inconsistent procfs PID")
                if row["session"] != self.child.pid:
                    continue
                if self.child.returncode is not None and row["ppid"] != os.getpid():
                    continue
                key = row["pid"], row["start"]
                if key not in self.handles:
                    fd = os.pidfd_open(row["pid"])
                    try:
                        with open(f"/proc/{entry}/stat") as f:
                            after = process_stat(f.read())
                        with open(f"/proc/self/fdinfo/{fd}") as f:
                            pinned = next(int(s.split()[1]) for s in f if s.startswith("Pid:"))
                        if (after["pid"], after["start"], after["session"], pinned) != (*key, self.child.pid, key[0]):
                            continue
                        if self.child.returncode is not None and after["ppid"] != os.getpid():
                            continue
                        self.handles[key] = fd
                        fd = None
                    finally:
                        if fd is not None:
                            os.close(fd)
                rows[key] = row
            except (FileNotFoundError, ProcessLookupError):
                continue
        for key in list(self.handles):
            if key not in rows:
                os.close(self.handles.pop(key))
        return rows

    def reap(self, pid):
        try:
            got, status, usage = os.wait4(pid, os.WNOHANG)
        except ChildProcessError:
            return False
        if not got:
            return False
        if got == self.child.pid:
            self.child.returncode = os.waitstatus_to_exitcode(status)
            self.record.update(command_raw_wait_status=status, command_returncode=self.child.returncode)
        record_child_usage(self.record, usage)
        return True

    def done(self):
        previous = signal.pthread_sigmask(signal.SIG_BLOCK, (signal.SIGINT, signal.SIGTERM, signal.SIGHUP))
        try:
            if self.finished:
                return True
            rows = self.observe()
            others = []
            for row in rows.values():
                if row["pid"] != self.child.pid:
                    # Only our direct/adopted children can supply wait4 usage.
                    if row["ppid"] != os.getpid() or not self.reap(row["pid"]):
                        others.append(row)
            if self.exited and not others:
                if self.child.returncode is None and not self.reap(self.child.pid):
                    raise OSError("cannot reap controlled session anchor")
                # A procfs census can miss a fork/adoption during iteration.
                # ECHILD, not a sampled empty list, establishes completion for
                # this dedicated subreaper. WNOWAIT consumes no foreign status.
                try:
                    os.waitid(os.P_ALL, 0, os.WEXITED | os.WNOHANG | os.WNOWAIT)
                except ChildProcessError:
                    self.finished = True
            return self.finished
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, previous)

    def stop(self, account, reason):
        if self.finished or self.cleanup_failed:
            return self.finished
        start = time.monotonic()
        result = {"reason": reason, "signals": {}, "errors": [], "accounting_errors": []}
        self.record["controlled_cleanup"] = result
        previous = signal.pthread_sigmask(signal.SIG_BLOCK, (signal.SIGINT, signal.SIGTERM, signal.SIGHUP))
        try:
            for sig, seconds in ((signal.SIGTERM, 5), (signal.SIGKILL, 2)):
                sent = set()
                deadline = time.monotonic() + seconds
                while True:
                    try:
                        if self.done():
                            result["outcome"] = "complete"
                            return True
                    except (OSError, ValueError, StopIteration) as error:
                        # Never discover via a lost/reaped anchor. Known handles
                        # still target the processes we actually identified.
                        message = str(error)
                        if message not in result["errors"]:
                            result["errors"].append(message)
                    for key, fd in self.handles.items():
                        if key in sent:
                            continue
                        try:
                            signal.pidfd_send_signal(fd, sig)
                            result["signals"][str(int(sig))] = result["signals"].get(str(int(sig)), 0) + 1
                            sent.add(key)
                        except ProcessLookupError:
                            pass
                        except OSError as error:
                            if str(error) not in result["errors"]:
                                result["errors"].append(str(error))
                    try:
                        account()
                    except (OSError, ValueError) as error:
                        if str(error) not in result["accounting_errors"]:
                            result["accounting_errors"].append(str(error))
                    if time.monotonic() >= deadline:
                        break
                    time.sleep(0.1)
            self.cleanup_failed = True
            result.update(outcome="failed", remaining_known=[{"pid": p, "start": s} for p, s in self.handles])
            print("heavy: controlled session cleanup failed after bounded TERM/KILL waits", file=sys.stderr)
            return False
        finally:
            result["seconds"] = time.monotonic() - start
            signal.pthread_sigmask(signal.SIG_SETMASK, previous)

    def close(self):
        for fd in self.handles.values():
            os.close(fd)
        self.handles.clear()


def run_command(f, command, shown, record, state, environ, load_reader):
    with child_subreaper() as group:
        return monitor_command(f, command, shown, record, state, environ, load_reader, group)


def monitor_command(f, command, shown, record, state, environ, load_reader, group):
    record.setdefault("cpu_busy_samples", [])
    session = record.get("compiler_budget", False) and platform.system() == "Linux"
    record["cpu_scope"] = "process_session" if session and group else "process_group" if group else "waited_tree"
    sampled = sample_load(record, load_reader, time.monotonic())
    cpu_sampled = sample_cpu(record, time.monotonic())
    machine = MachineSampler()
    machine.sample(time.monotonic(), machine_counters())
    try:
        hz = os.sysconf("SC_CLK_TCK")
    except (OSError, ValueError):
        hz = None
    processes = ProcessSampler(time.monotonic(), hz)
    completed = False
    group_reported = None
    if session:
        try:
            ControlledSession.preflight(group)
        except (OSError, ValueError) as error:
            print(f"heavy: cannot own a controlled session: {error}", file=sys.stderr)
            return 125
    helper_started = time.monotonic()
    try:
        child = subprocess.Popen(command, start_new_session=True)
    except OSError as e:
        print(f"heavy: cannot run `{shown}`: {e.strerror}", file=sys.stderr)
        return 127
    if record.get("cpu_nice"):
        raise_nice(child.pid, record["cpu_nice"])
    child.heavy_subreaper = group
    reap = lambda: reap_child(child, record)
    handlers = {}
    family = None
    def cleanup_account():
        rss = group_rss_kb(session=True).get(child.pid, 0)
        record["peak_rss_kb"] = max(record["peak_rss_kb"], rss)
        try:
            publish_memory(f, rss, state)
        except RegistryBusy:
            pass  # The existing short registry deadline also bounds cleanup.
    def terminate(reason, final_wait=True):
        if family is not None:
            # Cover stop's initial terminal check too: a second pending signal
            # must not restart or overwrite an already completed cleanup.
            previous = signal.pthread_sigmask(signal.SIG_BLOCK, (signal.SIGINT, signal.SIGTERM, signal.SIGHUP))
            try:
                return family.stop(cleanup_account, reason)
            finally:
                signal.pthread_sigmask(signal.SIG_SETMASK, previous)
        kill_group(child.pid, reap, group)
        if final_wait:
            reap_child(child, record, 0)
        return True
    try:
        if session:
            family = ControlledSession(child, record)
        try:
            proc_group = visible_group(child.pid)
        except (OSError, ValueError, StopIteration) as e:
            print(f"heavy: cannot identify the command's memory in this procfs view: {e}", file=sys.stderr)
            terminate("identification failure")
            return 125
        own = getattr(f, "heavy_job", None)
        if own is not None:
            own.update(started_at=record["started_at"], local_pgid=child.pid, proc_pgid=proc_group)
        text = (f"{child.pid} {record['started_at']} {os.getcwd()} {shown} "
                f"[local PID; namespace={pid_namespace()}]")
        if own is not None:
            # A write failure is handled below as a shared-accounting failure.
            f.heavy_status = text  # Publish with the first RSS, under registry.
        else:
            try:
                write_status(f, text)
            except (OSError, ValueError) as e:
                print(f"heavy: cannot publish the command's slot status: {e}", file=sys.stderr)
                terminate("status publication failure")
                return 125
        for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            handlers[sig] = signal.signal(sig, lambda s, _: terminate(f"signal {s}", final_wait=False))
        while True:
            now = time.monotonic()
            if record.get("_forecast_helper") and now - helper_started >= record.get("_forecast_timeout", 250):
                return 124 if terminate("forecast helper timeout") else 125
            try:
                boot_now = time.clock_gettime(getattr(time, "CLOCK_BOOTTIME", time.CLOCK_MONOTONIC))
            except OSError:
                boot_now = None
            live = set()
            readings = (group_processes(proc_group, live=live, session=True) if session
                        else group_processes(proc_group, live=live))
            processes.sample(now, boot_now, readings, live)
            if family is not None:
                if family.cleanup_failed:
                    return 125
                try:
                    completed = family.done()
                    if family.exited and not completed:
                        completed = terminate("leader exited with session members")
                        if not completed:
                            return 125
                except (OSError, ValueError, StopIteration) as error:
                    print(f"heavy: cannot observe controlled session: {error}", file=sys.stderr)
                    terminate("session observation failure")
                    return 125
            else:
                completed = group_gone(child.pid, reap, group)
            if completed or now - machine.last[0] >= 1:
                machine.sample(time.monotonic(), machine_counters())
            if completed:
                break
            if record.get("_forecast_helper") and child.returncode is not None:
                terminate("forecast helper left descendants")
                return 125
            if child.returncode is not None and (group_reported is None or now - group_reported >= 30):
                pids = ("unavailable" if readings is None else
                        ", ".join(str(row["pid"]) for row in readings) or "none sampled")
                status = (child.returncode if child.returncode >= 0
                          else 128 - child.returncode)
                print(f"heavy: `{shown}` leader exited with {status}; "
                      f"holding slot for process group {child.pid} (namespace-local PGID); "
                      f"remaining procfs-view PIDs: {pids}", file=sys.stderr)
                group_reported = now
            try:
                rss = (group_rss_kb(session=True) if session else group_rss_kb()).get(proc_group, 0)
                cap = mem_cap_kb(environ, state)
                try:
                    publish_memory(f, rss, state)
                    total, victim = memory_victim(jobs(state), cap)
                except RegistryBusy:
                    # A stopped registry holder cannot suspend our own cap.
                    total, victim = rss, None
            except (OSError, ValueError) as e:
                print(f"heavy: cannot maintain shared memory accounting: {e}", file=sys.stderr)
                terminate("accounting failure")
                return 125
            record["peak_rss_kb"] = max(record["peak_rss_kb"], rss)
            sampled = sample_load(record, load_reader, time.monotonic(), sampled)
            cpu_sampled = sample_cpu(record, time.monotonic(), cpu_sampled)
            if ((own is not None and victim == own["job_id"])
                    or rss > cap):
                reason = (f"its process group uses {rss / 1048576:.1f} GB" if rss > cap
                          else f"heavy jobs last reported {total / 1048576:.1f} GB")
                print(f"heavy: killed `{shown}`: {reason}, over the {cap / 1048576:.1f} GB cap "
                      f"(HEAVY_MEM_GB, {os.path.join(state, 'mem_gb')}); run it again when "
                      "fewer jobs run", file=sys.stderr)
                return 137 if terminate("memory cap exceeded") else 125
            time.sleep(1)
        return child.returncode if child.returncode >= 0 else 128 - child.returncode
    finally:
        if family is not None:
            try:
                if not family.finished and not family.cleanup_failed:
                    terminate("monitor exit")
            finally:
                family.close()
        for sig, handler in handlers.items():
            signal.signal(sig, handler)

        sample_cpu(record, time.monotonic(), cpu_sampled, final=True)
        if not completed:
            machine.sample(time.monotonic(), machine_counters())
        machine.finish(record)
        processes.finish(record)

def monitored_forecast(f, command, record, state, environ, load_reader, offline_wrapper):
    """Run all forecast I/O and builds inside the holder's monitored group."""
    path = environ.get("HEAVY_LOG") or os.path.join(state, "log.jsonl")
    try:
        temporary = tempfile.TemporaryDirectory(prefix="heavy-forecast-")
    except OSError:
        return None, 0, 0
    with temporary as directory:
        result_path = os.path.join(directory, "result.json")
        helper = [sys.executable, "-I", "-B", os.path.realpath(__file__),
                  "--forecast-helper", command, state, path, str(record["started_at"]), result_path]
        budget = record.get("compiler_budget", False)
        record["compiler_budget"] = False
        record["_forecast_helper"] = True
        try:
            status = run_command(f, offline_wrapper + helper, "forecast adviser", record,
                                 state, environ, load_reader)
        finally:
            record.pop("_forecast_helper", None)
            record["compiler_budget"] = budget
        if status:
            return None, 0, status
        try:
            with open(result_path) as result:
                peak, count = json.load(result)
            return peak, count, 0
        except (OSError, ValueError, TypeError):
            return None, 0, 0


def run(f, command, shown, kind, record, began, state, environ, load_reader, offline_wrapper=None):
    record.update(event="job", command=shown, job_kind=kind,
                  worktree=os.getcwd(), peak_rss_kb=0, load_samples=[],
                  cpu_user_seconds=0.0, cpu_system_seconds=0.0, cpu_busy_samples=[],
                  cpu_scope="waited_tree", involuntary_context_switches=0,
                  process_cpu=None, process_samples=0, nonvoluntary_ctxt_switches=None)
    own = getattr(f, "heavy_job", {})
    record.update(job_id=own.get("job_id"), admission_order=own.get("order"),
                  pid_namespace=own.get("pid_namespace"),
                  memory_accounting="slot_owner_reports_v3")
    MachineSampler().finish(record)
    prediction_command = record.get("prediction_command", shlex.join(command))
    record["prediction_command"] = prediction_command
    share = CpuShare(environ.get("HEAVY_PRIORITY"), record)
    try:
        prediction, history_jobs, helper_status = monitored_forecast(
            f, prediction_command, record, state, environ, load_reader, offline_wrapper or [])
        record.update(predicted_peak_rss_kb=prediction, prediction_jobs=history_jobs,
                      prediction_method="max_last_20_same_command_7d")
        code = helper_status or run_command(f, command, shown, record, state, environ, load_reader)
    finally:
        share.restore()
    record.update(ended_at=time.time(), run_seconds=time.monotonic() - began, exit_status=code)
    loads = record["load_samples"]
    record.update(load_mean=sum(loads) / len(loads) if loads else None,
                  load_max=max(loads) if loads else None)
    cpu_summary(record)
    append_log(record, state, environ)
    return code


def legacy_reservation(cap, observed=None):
    """A verified reading, or the shared forecast for unobserved holders.
    Charge that half-cap forecast once, not once per incompatible lease."""
    return observed if observed is not None and observed >= 0 else max(1, (cap + 1) // 2)


def heavy_rss_kb(state=STATE, cap=None, reservations=None):
    """Compatible reports use their RSS (a full cap for verified stale owners).
    Legacy leases use verified RSS plus one shared forecast for unknowns."""
    try:
        cap = mem_cap_kb(state=state) if cap is None else cap
        running = jobs(state)
        unobserved = [j for j in running if j.get("legacy")
                      and (j.get("legacy_rss_kb") is None or j["legacy_rss_kb"] < 0)]
        if reservations is not None:
            for job in running:
                if job.get("legacy"):
                    observed = job.get("legacy_rss_kb")
                    if observed is not None and observed >= 0:
                        reservations.append(f"{job['slot']} (legacy RSS: {observed} KB)")
                elif not job["fresh"]:
                    reservations.append(f"{job['slot']} (stale or future-dated report)")
            if unobserved:
                names = ", ".join(sorted(j["slot"] for j in unobserved))
                reservations.append(f"{names} (shared legacy forecast: {legacy_reservation(cap)} KB)")
        measured = sum(max(0, j.get("legacy_rss_kb") or 0) if j.get("legacy")
                       else j["rss_kb"] if j["fresh"] else cap for j in running)
        return measured + (legacy_reservation(cap) if unobserved else 0)
    except RegistryBusy:
        raise  # Admission must name a registry wait, not a memory shortfall.
    except OSError:
        return math.inf


def memory_wait_message(state, reservations, memory_blocked):
    if memory_blocked and reservations:
        slots = ", ".join(sorted(reservations))
        return (f"heavy: waiting for memory: {slots}; resume stopped monitors or "
                f"reduce running memory (see {state})")
    return f"heavy: waiting for memory or load (see {state})"


def main(argv, state=STATE, environ=None, load_reader=load_average):
    environ = os.environ if environ is None else environ
    if argv[:1] == ["--alternate"]:
        try:
            if len(argv) != 3:
                raise ValueError("expected minutes and load value")
            minutes, value = (positive(float, arg) for arg in argv[1:])
        except ValueError as e:
            print(f"heavy: --alternate: {e}\n{USAGE}", file=sys.stderr)
            return 2

        try:
            alternate(minutes, value, state, environ)
        except KeyboardInterrupt:
            return 0
        except (OSError, RuntimeError) as e:
            print(f"heavy: --alternate: {e}", file=sys.stderr)
            return 2
    if argv[:1] == ["--stats"]:
        try:
            if len(argv) > 2:
                raise ValueError("too many arguments")
            hours = positive(float, argv[1]) if len(argv) == 2 else 24
            print(json.dumps(stats(hours, state, environ), indent=2))
            return 0
        except (ValueError, OSError) as e:
            print(f"heavy: --stats: {e}\n{USAGE}", file=sys.stderr)
            return 2
    try:
        offline, command = parse_args(argv)
    except UsageError as e:
        print(e, file=sys.stderr)
        return 2
    if os.sep not in command[0] and shutil.which(command[0]) is None:
        print(f"heavy: {command[0]}: command not found", file=sys.stderr)
        return 127
    enqueued, queued = time.time(), time.monotonic()
    initial = (max_load(environ, state), slot_count(environ, state))
    record = {"enqueued_at": enqueued, "enqueued_max_load": "off" if initial[0] is None else initial[0],
              "enqueued_slots": initial[1], "wait_policy_changed": False}
    kind = environ.get("FREN_JOB_KIND") or job_kind(command)
    shown = shlex.join(command)
    record["prediction_command"] = shown
    offline_wrapper = []
    if offline:
        try:
            offline_wrapper = offline_command([])
        except RuntimeError as e:
            print(e, file=sys.stderr)
            return 126
        shown = "--offline " + shown
    shown = shown[:237] + "..." if len(shown) > 240 else shown
    os.makedirs(state, exist_ok=True)
    try:
        mem_cap_kb(environ, state)
    except (OSError, ValueError, subprocess.CalledProcessError) as e:
        print(f"heavy: cannot tell the physical memory ({e}); set HEAVY_MEM_GB", file=sys.stderr)
        return 2
    waiting = Waiting(state, environ.get("HEAVY_PRIORITY"), queued)
    try:
        return admit(waiting, command, shown, kind, record, queued, initial, state, environ,
                     load_reader, offline_wrapper)
    finally:
        waiting.close()


def admit(waiting, command, shown, kind, record, queued, initial, state, environ, load_reader, offline_wrapper):
    """Wait for this job's turn, a slot and memory, then run it."""
    warned = None
    registry_message = f"heavy: waiting for registry lock (see {state})"
    while True:
        slots = slot_count(environ, state)
        limit = max_load(environ, state)
        record["wait_policy_changed"] |= (limit, slots) != initial
        # Start no job while the running ones already use most of the cap: a
        # job that starts now would likely be the one killed when they grow.
        cap = mem_cap_kb(environ, state)
        waiting.beat(slots, cap, limit)
        reservations = []
        try:
            rss = heavy_rss_kb(state, cap, reservations)
        except RegistryBusy:
            if registry_message != warned:
                print(registry_message, file=sys.stderr)
                warned = registry_message
            time.sleep(5)
            continue
        if not can_start(time.monotonic() - queued, rss,
                         cap, limit, load_reader):
            message = memory_wait_message(state, reservations, over_start_fraction(rss, cap))
            if message != warned:
                print(message, file=sys.stderr)
                warned = message
            time.sleep(5)
            continue
        wait_message = f"heavy: all {slots} slots busy, waiting (see {state})"
        # A slot goes first to the waiters ahead of this job that could take
        # it now. One load reading serves every comparison of this poll.
        others, now, step, reading = waiting.others(), monotonic_ms(), aging_ms(environ, state), []
        def one_load():
            if not reading:
                reading.append(load_reader())
            return reading[0]
        for i in range(slots):
            ahead = queue_ahead(waiting.entry, others, i, rss, one_load, now, step) if others else 0
            if ahead:
                wait_message = f"heavy: waiting behind {ahead} more urgent or earlier jobs (see {state})"
                continue
            f = open(os.path.join(state, f"slot{i}"), "a+")
            try:
                with registry(state):
                    claimed = claim_slot(f, f"slot{i}", state, record)
            except RegistryBusy:
                f.close()
                wait_message = registry_message
                break  # Admission waits; do not run without a registered lease.
            except (OSError, ValueError) as e:
                f.close()
                print(f"heavy: cannot register the slot's memory accounting: {e}", file=sys.stderr)
                return 125
            if not claimed:
                f.close()
                continue
            waited = time.monotonic() - queued
            # A flip or slot change may have happened while acquiring the
            # lock. Recheck admission and log the settings actually used.
            slots = slot_count(environ, state)
            limit = max_load(environ, state)
            record["wait_policy_changed"] |= (limit, slots) != initial
            if i >= slots:
                release_slot(f, state)
                wait_message = f"heavy: slot count changed, retrying (see {state})"
                break
            cap = mem_cap_kb(environ, state)
            reservations = []
            try:
                rss = heavy_rss_kb(state, cap, reservations)
            except RegistryBusy:
                release_slot(f, state)
                wait_message = registry_message
                break
            if not can_start(waited, rss,
                             cap, limit, load_reader):
                release_slot(f, state)
                wait_message = memory_wait_message(state, reservations, over_start_fraction(rss, cap))
                break
            admitted = time.monotonic()
            waiting.close()
            record.update(started_at=time.time(), wait_seconds=admitted - queued,
                          max_load="off" if limit is None else limit, slots=slots)
            if waited > 1:
                print(f"heavy: got slot {i} after {waited:.0f}s", file=sys.stderr)
            try:
                launched = command
                if os.path.basename(command[0]) == "lake":
                    loader = importlib.machinery.SourceFileLoader(
                        "heavy_build", os.path.join(os.path.dirname(os.path.realpath(__file__)), "fren-build"))
                    spec = importlib.util.spec_from_loader(loader.name, loader)
                    entry = importlib.util.module_from_spec(spec)
                    loader.exec_module(entry)
                    try:
                        launched = entry.heavy_command(command, cap)
                    except (OSError, ValueError) as error:
                        print(f"heavy: build routing failed: {error}", file=sys.stderr)
                        return 125
                entries = {os.path.join(os.path.dirname(os.path.realpath(__file__)), name)
                           for name in ("fren-build", "heavy-lean-build")}
                if os.path.basename(command[0]) == "lake" and entry.lake_test(command):
                    # The test driver runs its jobs in parallel, and a scope with
                    # members outside one launch chain is never migrated. Prepare
                    # the delegated compiler memory scope now, while this chain is
                    # alone, so that the jobs' controlled builds reuse it.
                    loader = importlib.machinery.SourceFileLoader("heavy_module_memory", os.path.join(
                        os.path.dirname(os.path.realpath(__file__)), "..", "tools", "heavy-observe", "module_memory.py"))
                    spec = importlib.util.spec_from_loader(loader.name, loader)
                    memory = importlib.util.module_from_spec(spec)
                    try:
                        loader.exec_module(memory)
                        memory.prepare()
                    except (OSError, ValueError, subprocess.SubprocessError):
                        pass  # Without a suitable scope, controlled builds still fail before they start.
                record["compiler_budget"] = os.path.realpath(launched[0]) in entries
                return run(f, offline_wrapper + launched, shown, kind, record, admitted, state, environ, load_reader, offline_wrapper)
            finally:
                release_slot(f, state)
        if wait_message != warned:
            print(wait_message, file=sys.stderr)
            warned = wait_message
        time.sleep(2)


if __name__ == "__main__":
    if len(sys.argv) == 7 and sys.argv[1] == "--forecast-helper":
        _, _, command, state, path, started, output = sys.argv
        forecast = command_forecast(command, state, {"HEAVY_LOG": path}, float(started))
        with open(output, "w") as result:
            json.dump(forecast, result)
        sys.exit(0)
    sys.exit(main(sys.argv[1:]))
