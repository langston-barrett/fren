#!/usr/bin/env python3
"""Build Lake targets with a private Heavy compiler-budget session."""
import os
import shutil
import stat
from pathlib import Path
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent


def lake_build(command):
    """Locate Lake's build verb without treating option operands as commands.

    Keep arguments literal. Unknown options are left to Lake; they cannot
    introduce an operand named build in the supported pinned Lake CLI.
    """
    if Path(command[0]).name != 'lake':
        return None
    directory = Path.cwd()
    i = 1
    while i < len(command):
        arg = command[i]
        if arg in ('--help', '-h', '--version'):
            return None
        if arg in ('-d', '--dir', '-f', '--file', '-o', '-K', '--packages',
                   '--service', '--scope', '--repo', '--platform', '--toolchain',
                   '--rev', '--max-revs', '--linters', '--lint-only', '--only',
                   '--log-level', '--fail-level'):
            if i + 1 == len(command):
                return None  # Lake diagnoses the missing operand.
            if arg in ('-d', '--dir'):
                directory = Path(command[i + 1]).absolute()
            i += 2
            continue
        if arg.startswith(('--dir=', '-d=')) or (arg.startswith('-d') and len(arg) > 2):
            directory = Path(arg.split('=', 1)[1] if '=' in arg else arg[2:]).absolute()
        if arg == '--':
            i += 1
            break
        if not arg.startswith('-') and not (i == 1 and arg.startswith('+')):
            break
        i += 1
    return directory.resolve() if i < len(command) and command[i] == 'build' else None


def heavy_command(command, cap):
    """Adapter called after Heavy admission, before its offline wrapper."""
    directory = lake_build(command)
    if directory is None or directory == (ROOT / 'tools/heavy-observe').resolve():
        return command
    return [str(ROOT / 'scripts/fren-build'), '--heavy-lake', str(cap), *command]


def outer_allowance(cap):
    """Bound configuration by Heavy and visible cgroup-v2 ancestor limits.

    This does not measure free RAM or guarantee a per-build physical limit.
    An unreadable advertised hierarchy fails setup rather than guessing.
    """
    for line in Path('/proc/self/cgroup').read_text().splitlines():
        if line.startswith('0::'):
            relative = Path(line[3:]).relative_to('/')
            if '..' in relative.parts:
                raise ValueError('unresolved cgroup path')
            root = Path('/sys/fs/cgroup')
            current = root / relative
            if not current.is_dir():
                raise ValueError('cgroup-v2 directory is not visible')
            while True:
                limit = current / 'memory.max'
                if limit.exists():
                    value = limit.read_text().strip()
                    if value != 'max':
                        cap = min(cap, int(value) // 1024)
                if current == root:
                    break
                current = current.parent
            break
    # Leave space for the outer Python monitor; headroom inside the allowance
    # separately covers Lake, the controller and discovery probes.
    return min(1300000, cap - 100000)


def selected_lake(command, env):
    """Resolve the executable the caller requested, including elan selection."""
    selected = Path(shutil.which(command[0]) or command[0]).resolve(strict=True)
    elan = shutil.which('elan')
    args = list(command[1:])
    if elan and os.path.samefile(selected, elan):
        if args and args[0].startswith('+'):
            env['ELAN_TOOLCHAIN'] = args.pop(0)[1:]
        cwd = Path.cwd()
        pin_file = next((p / 'lean-toolchain' for p in (cwd, *cwd.parents)
                         if (p / 'lean-toolchain').is_file()), None)
        pin = env.get('ELAN_TOOLCHAIN') or (pin_file.read_text().strip() if pin_file else None)
        installed = subprocess.check_output([elan, 'toolchain', 'list'], text=True).splitlines()
        names = [line.split()[0] for line in installed if line.split()]
        # Accept the default origin's short installed version spelling too.
        # Never resolve an unknown channel: even `elan run` without --install
        # may contact the release service before checking availability.
        if pin is not None and not any(pin in (name, name.removeprefix('leanprover/lean4:'))
                                       for name in names):
            raise ValueError(f'pinned toolchain {pin!r} is not installed')
        selected = Path(subprocess.check_output([elan, 'which', 'lake'], env=env,
                                               text=True).strip()).resolve(strict=True)
    real = selected.parent / 'lean'
    if not real.is_file() or not os.access(real, os.X_OK):
        raise ValueError(f'missing compiler beside selected Lake: {real}')
    return real, [str(selected), *args]


def main():
    ordinary = sys.argv[1:2] == ['--heavy-lake']
    if not ordinary and (len(sys.argv) < 2 or sys.argv[1] in ('-h', '--help')):
        print('Usage: scripts/fren-build LAKE_BUILD_ARGUMENT...', file=sys.stderr)
        return 0 if len(sys.argv) > 1 else 2
    tools = ROOT / 'tools/heavy-observe/.lake/build/bin'
    if any(not os.access(tools / name, os.X_OK) for name in ('heavy_observe', 'budget_session')):
        print('fren-build: missing prebuilt tools; from this checkout run: '
              'scripts/heavy lake -d tools/heavy-observe build heavy_observe budget_session --wfail', file=sys.stderr)
        return 125
    try:
        env = os.environ.copy()
        if 'HEAVY_BUDGET_DIR' in env:
            raise ValueError('already budgeted: invoke Lake directly inside the existing session')
        if ordinary:
            if 'LEAN_SYSROOT' in env or 'LAKE_OVERRIDE_LEAN' in env:
                raise ValueError('existing Lean override: use the explicit heavy-lean-build entrypoint')
            cap = int(sys.argv[2])
            allowance = outer_allowance(cap)
            real, command = selected_lake(sys.argv[3:], env)
        else:
            cwd = Path.cwd()
            pin_file = next((p / 'lean-toolchain' for p in (cwd, *cwd.parents)
                             if (p / 'lean-toolchain').is_file()), None)
            if pin_file is None:
                raise ValueError('no lean-toolchain found in caller directory or its parents')
            pin = pin_file.read_text().strip()
            installed = subprocess.check_output(['elan', 'toolchain', 'list'], text=True).splitlines()
            if not pin or not any(line.split()[0] == pin for line in installed if line.split()):
                raise ValueError(f'pinned toolchain {pin!r} is not installed')
            env['ELAN_TOOLCHAIN'] = pin
            real = Path(subprocess.check_output(['elan', 'which', 'lean'], env=env, text=True).strip()).resolve(strict=True)
            lake = real.parent / 'lake'
            if not lake.is_file() or not os.access(lake, os.X_OK):
                raise ValueError(f'missing Lake beside pinned compiler: {lake}')
            command = [str(lake), 'build', *sys.argv[1:]]
            allowance = 1300000
        requested = int(env.get('FREN_BUILD_ALLOWANCE_KIB', str(allowance)))
        if ordinary and (requested <= 0 or requested > allowance):
            raise ValueError(f'allowance must be positive and at most {allowance} KiB')
        configured = env.get('FREN_BUILD_REQUESTS_FILE')
        if configured is not None:
            requests = Path(configured)
            if not requests.is_absolute():
                raise ValueError('FREN_BUILD_REQUESTS_FILE must be an absolute readable regular file')
            try:
                fd = os.open(requests, os.O_RDONLY | os.O_NONBLOCK)
                try:
                    mode = os.fstat(fd).st_mode
                    if not stat.S_ISREG(mode) or not mode & 0o444:
                        raise ValueError('FREN_BUILD_REQUESTS_FILE must be an absolute readable regular file')
                finally:
                    os.close(fd)
            except OSError as error:
                raise ValueError(f'FREN_BUILD_REQUESTS_FILE: {error}') from error
        work = Path(tempfile.mkdtemp(prefix='fren-build-')).resolve()
        if configured is None:
            requests = work / 'requests.tsv'
            requests.write_text('')
        print(f'fren-build: retained private state: {work}', file=sys.stderr, flush=True)
        entry = ROOT / 'scripts/heavy-lean-build'
        os.execve(str(entry), [str(entry), '--state', str(work / 'state'), '--real-lean', str(real),
                  '--allowance-kib', str(requested),
                  '--headroom-kib', env.get('FREN_BUILD_HEADROOM_KIB', '100000'),
                  '--fallback-kib', env.get('FREN_BUILD_FALLBACK_KIB', '600000'),
                  '--timeout-ms', env.get('FREN_BUILD_TIMEOUT_MS', '30000'),
                  '--requests', str(requests), '--', *command], env)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'fren-build: {error}', file=sys.stderr)
        return 125


if __name__ == '__main__':
    sys.exit(main())
