#!/usr/bin/env python3
"""Build Lake targets with a private Heavy compiler-budget session."""
import os
import fcntl
import ctypes
import signal
import time
import shutil
import stat
from pathlib import Path
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent


# Completed failures are retained for at most seven days and one GiB in total.
# Active sessions are separate and cannot be pruned by another invocation.
RETENTION_AGE = 7 * 86400
RETENTION_BYTES = 1024 ** 3


def disk_state_root():
    root = Path.home() / '.cache/heavy/build-state'
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    if sys.platform.startswith('linux'):
        result = ctypes.create_string_buffer(256)
        libc = ctypes.CDLL(None, use_errno=True)
        if libc.statfs(os.fsencode(root), result) != 0:
            raise OSError(ctypes.get_errno(), 'cannot inspect private state filesystem')
        if ctypes.c_long.from_buffer(result).value & 0xffffffff in (0x01021994, 0x858458f6):
            raise ValueError('private state directory must be on disk, not tmpfs or ramfs')
    return root


def finish_private_state(work, success):
    root = work.parent
    with (root / '.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        retained = None
        if success:
            shutil.rmtree(work)
        else:
            retained = root / work.name.replace('.active-', 'fren-build-', 1)
            work.rename(retained)
        now = time.time()
        if retained is not None:
            os.utime(retained, (now, now))
        entries = sorted((p for p in root.glob('fren-build-*') if p.is_dir() and not p.is_symlink()),
                         key=lambda p: (p == retained, p.stat().st_mtime), reverse=True)
        total = 0
        exhausted = False
        for entry in entries:
            if entry != retained and now - entry.stat().st_mtime > RETENTION_AGE:
                shutil.rmtree(entry)
                continue
            files = [p for p in entry.rglob('*') if p.is_file() and not p.is_symlink()]
            size = sum(p.stat().st_size for p in files)
            if entry != retained and (exhausted or total + size > RETENTION_BYTES):
                shutil.rmtree(entry)
                exhausted = True
                continue
            # Preserve the directory and as much diagnostic evidence as fits,
            # even if a single failure produced more than the entire budget.
            for p in sorted(files, key=lambda p: p.stat().st_size, reverse=True):
                if total + size <= RETENTION_BYTES:
                    break
                size -= p.stat().st_size
                p.unlink()
                print(f'fren-build: removed oversized retained file: {p}', file=sys.stderr, flush=True)
            total += size
        if retained is not None:
            print(f'fren-build: retained private state: {retained}', file=sys.stderr, flush=True)


def run_private(entry, argv, env, work):
    child = None
    previous = {}
    try:
        child = subprocess.Popen(argv, executable=str(entry), env=env)
        def forward(signum, _frame):
            try:
                child.send_signal(signum)
            except ProcessLookupError:
                pass
        for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            previous[sig] = signal.signal(sig, forward)
        status = child.wait()
        return status if status >= 0 else 128 - status
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)
        finish_private_state(work, child is not None and child.returncode == 0)


def lake_route(command, verb_only=False):
    """Effective build configuration or env command under pinned Lake grammar.

    Mirror Util/Cli's token insertion and Main's two leading-option passes,
    then build's collectArgs pass. Only this private token copy is rewritten.
    Unknown grammar fails closed; forwarded caller argv is never normalized.
    With verb_only, the result is instead the command's verb, or None.
    """
    if Path(command[0]).name != 'lake':
        return None
    args = list(command[1:])
    if args and args[0].startswith('+'):
        args.pop(0)  # elan's leading toolchain selection, not a Lake option.
    if args == ['--version']:
        return None
    directory, config, help_requested = '.', 'lakefile.lean', False
    operands = {'-d', '-f', '-o', '-K', '--dir', '--file', '--packages',
                '--service', '--scope', '--repo', '--platform', '--toolchain',
                '--rev', '--max-revs', '--linters', '--lint-only', '--only',
                '--log-level', '--fail-level'}
    flags = {'-q', '-v', '-U', '-R', '-h', '-H', '-J', '--help',
             '--quiet', '--verbose', '--update', '--keep-toolchain',
             '--reconfigure', '--old', '--text', '--json', '--allow-empty',
             '--no-build', '--no-cache', '--try-cache', '--rehash', '--offline',
             '--wfail', '--iofail', '--no-overwrite', '--force-overwrite',
             '--force-download', '--download-arts', '--mappings-only',
             '--ansi', '--no-ansi', '--builtin-lint', '--builtin-only',
             '--record-exceptions', '--force', '--keep-implied', '--keep-prefix',
             '--keep-public', '--add-public', '--gh-style', '--explain',
             '--trace', '--fix'}

    def option(token):
        nonlocal directory, config, help_requested
        if token.startswith('--'):
            # Lake applies the equals split before the space split, even when
            # both occur within the same literal argument.
            if '=' in token:
                token, value = token.split('=', 1)
                args.insert(0, value)
            if ' ' in token:
                token, value = token.split(' ', 1)
                args.insert(0, value)
        elif len(token) > 2:
            value = token[3:] if token[2] == '=' else token[2:]
            if token[2] == ' ':
                value = value.lstrip(' \t\n\r\v\f')
            args.insert(0, value)
            token = token[:2]
        if token == '--':
            args.clear()  # Lake stores the remainder as subArgs, not targets.
        elif token in operands:
            if not args:
                raise ValueError(f'missing Lake option operand: {token}')
            value = args.pop(0)
            if token in ('-d', '--dir'):
                directory = value
            elif token in ('-f', '--file'):
                config = value
        elif token in flags:
            help_requested |= token in ('-h', '--help')
        else:
            raise ValueError(f'unsupported Lake option for controlled routing: {token}')

    def leading():
        while args:
            if args[0] == '':
                args.pop(0)
            elif len(args[0]) > 1 and args[0].startswith('-'):
                option(args.pop(0))
            else:
                break

    leading()
    if not args:
        return None
    verb = args.pop(0)
    if verb_only:
        return None if help_requested else verb
    if verb == 'env' and not help_requested and args[:1] == ['lean']:
        # env forwards its entire tail, without another option pass. Its
        # command is an untouched suffix even after leading token insertion.
        return Path(directory).absolute().resolve(), config, len(command) - len(args)
    if verb != 'build':
        return None
    leading()
    if help_requested:
        return None
    while args:
        arg = args.pop(0)
        if len(arg) > 1 and arg.startswith('-'):
            option(arg)
    return Path(directory).absolute().resolve(), config, None


def lake_build(command):
    route = lake_route(command)
    return route[:2] if route is not None and route[2] is None else None


def lake_test(command):
    """Whether the command starts Lake's test driver, after any leading options."""
    return lake_route(command, verb_only=True) == 'test'


def heavy_command(command, cap):
    """Adapter called after Heavy admission, before its offline wrapper."""
    selected = lake_route(command)
    if selected is None:
        return command
    directory, config, direct = selected
    if direct is not None:
        classifier = ROOT / 'tools/heavy-observe/.lake/build/bin/heavy_observe'
        try:
            classification = subprocess.check_output([str(classifier), '--classify-direct',
                str(ROOT / 'src'), *command[direct + 1:]])
        except (OSError, subprocess.SubprocessError) as error:
            raise ValueError(f'direct Lean classifier unavailable: {error}') from error
        if classification == b'unselected\n':
            return command
        if classification != b'selected\n':
            raise ValueError('invalid direct Lean classification')
        return [str(ROOT / 'scripts/fren-build'), '--heavy-direct', str(cap), str(direct), *command]
    tools = (ROOT / 'tools/heavy-observe').resolve()
    if directory == tools and (directory / config).resolve() == tools / 'lakefile.lean':
        return command
    return [str(ROOT / 'scripts/fren-build'), '--heavy-lake', str(cap), *command]


def outer_allowance(cap):
    """Bound configuration by Heavy and visible cgroup-v2 ancestor limits.

    This does not measure free RAM or guarantee a per-build physical limit.
    An unreadable advertised hierarchy fails setup rather than guessing.
    """
    for line in Path('/proc/self/cgroup').read_text().splitlines():
        if line.startswith('0::'):
            relative = Path(line[3:]).relative_to('/')
            if '..' in relative.parts:
                raise ValueError('unresolved cgroup path')
            root = Path('/sys/fs/cgroup')
            current = root / relative
            if not current.is_dir():
                raise ValueError('cgroup-v2 directory is not visible')
            while True:
                limit = current / 'memory.max'
                if limit.exists():
                    value = limit.read_text().strip()
                    if value != 'max':
                        cap = min(cap, int(value) // 1024)
                if current == root:
                    break
                current = current.parent
            break
    # Leave space for the outer Python monitor; headroom inside the allowance
    # separately covers Lake, the controller and discovery probes.
    return min(1300000, cap - 100000)


def selected_lake(command, env):
    """Resolve the executable the caller requested, including elan selection."""
    selected = Path(shutil.which(command[0]) or command[0]).resolve(strict=True)
    elan = shutil.which('elan')
    args = list(command[1:])
    if elan and os.path.samefile(selected, elan):
        if args and args[0].startswith('+'):
            env['ELAN_TOOLCHAIN'] = args.pop(0)[1:]
        cwd = Path.cwd()
        pin_file = next((p / 'lean-toolchain' for p in (cwd, *cwd.parents)
                         if (p / 'lean-toolchain').is_file()), None)
        pin = env.get('ELAN_TOOLCHAIN') or (pin_file.read_text().strip() if pin_file else None)
        installed = subprocess.check_output([elan, 'toolchain', 'list'], text=True).splitlines()
        names = [line.split()[0] for line in installed if line.split()]
        # Accept the default origin's short installed version spelling too.
        # Never resolve an unknown channel: even `elan run` without --install
        # may contact the release service before checking availability.
        if pin is not None and not any(pin in (name, name.removeprefix('leanprover/lean4:'))
                                       for name in names):
            raise ValueError(f'pinned toolchain {pin!r} is not installed')
        selected = Path(subprocess.check_output([elan, 'which', 'lake'], env=env,
                                               text=True).strip()).resolve(strict=True)
    real = selected.parent / 'lean'
    if not real.is_file() or not os.access(real, os.X_OK):
        raise ValueError(f'missing compiler beside selected Lake: {real}')
    return real, [str(selected), *args]


def main():
    direct = sys.argv[1:2] == ['--heavy-direct']
    ordinary = direct or sys.argv[1:2] == ['--heavy-lake']
    if not ordinary and (len(sys.argv) < 2 or sys.argv[1] in ('-h', '--help')):
        print('Usage: scripts/fren-build LAKE_BUILD_ARGUMENT...', file=sys.stderr)
        return 0 if len(sys.argv) > 1 else 2
    tools = ROOT / 'tools/heavy-observe/.lake/build/bin'
    if not os.access(tools / 'heavy_observe', os.X_OK):
        print('fren-build: missing prebuilt tools; from this checkout run: '
              'scripts/heavy lake -d tools/heavy-observe build heavy_observe budget_session --wfail', file=sys.stderr)
        return 125
    try:
        env = os.environ.copy()
        direct_index = None
        if direct:
            direct_index = int(sys.argv[3])
            original = sys.argv[4:]
            route = lake_route(original)
            if route is None or route[2] != direct_index:
                raise ValueError('invalid direct Lean route')
        if not os.access(tools / 'budget_session', os.X_OK):
            raise ValueError('missing prebuilt budget_session')
        wall = env.get('HEAVY_COMPILER_WALL_MS')
        if wall is not None and (not wall.isascii() or not wall.isdecimal() or not 0 < int(wall) <= 2147483647):
            raise ValueError('HEAVY_COMPILER_WALL_MS must be a positive integer at most 2147483647')
        cpu = env.get('HEAVY_COMPILER_CPU_SECONDS')
        if cpu is not None and (not cpu.isascii() or not cpu.isdecimal() or not 0 < int(cpu) <= 2147483647):
            raise ValueError('HEAVY_COMPILER_CPU_SECONDS must be a positive integer at most 2147483647')
        if 'HEAVY_BUDGET_DIR' in env:
            raise ValueError('already budgeted: invoke Lake directly inside the existing session')
        if ordinary:
            if 'LEAN_SYSROOT' in env or 'LAKE_OVERRIDE_LEAN' in env:
                raise ValueError('existing Lean override: use the explicit heavy-lean-build entrypoint')
            cap = int(sys.argv[2])
            allowance = outer_allowance(cap)
            real, command = selected_lake(sys.argv[4:] if direct else sys.argv[3:], env)
            if direct:
                # selected_lake removes elan's +toolchain token when resolving
                # its shim. Reparse the resulting native command's suffix.
                direct_index = lake_route(command)[2]
        else:
            cwd = Path.cwd()
            pin_file = next((p / 'lean-toolchain' for p in (cwd, *cwd.parents)
                             if (p / 'lean-toolchain').is_file()), None)
            if pin_file is None:
                raise ValueError('no lean-toolchain found in caller directory or its parents')
            pin = pin_file.read_text().strip()
            installed = subprocess.check_output(['elan', 'toolchain', 'list'], text=True).splitlines()
            if not pin or not any(line.split()[0] == pin for line in installed if line.split()):
                raise ValueError(f'pinned toolchain {pin!r} is not installed')
            env['ELAN_TOOLCHAIN'] = pin
            real = Path(subprocess.check_output(['elan', 'which', 'lean'], env=env, text=True).strip()).resolve(strict=True)
            lake = real.parent / 'lake'
            if not lake.is_file() or not os.access(lake, os.X_OK):
                raise ValueError(f'missing Lake beside pinned compiler: {lake}')
            command = [str(lake), 'build', *sys.argv[1:]]
            allowance = 1300000
        requested = int(env.get('FREN_BUILD_ALLOWANCE_KIB', str(allowance)))
        if ordinary and (requested <= 0 or requested > allowance):
            raise ValueError(f'allowance must be positive and at most {allowance} KiB')
        configured = env.get('FREN_BUILD_REQUESTS_FILE')
        if configured is not None:
            requests = Path(configured)
            if not requests.is_absolute():
                raise ValueError('FREN_BUILD_REQUESTS_FILE must be an absolute readable regular file')
            try:
                fd = os.open(requests, os.O_RDONLY | os.O_NONBLOCK)
                try:
                    mode = os.fstat(fd).st_mode
                    if not stat.S_ISREG(mode) or not mode & 0o444:
                        raise ValueError('FREN_BUILD_REQUESTS_FILE must be an absolute readable regular file')
                finally:
                    os.close(fd)
            except OSError as error:
                raise ValueError(f'FREN_BUILD_REQUESTS_FILE: {error}') from error
        root = disk_state_root()
        work = Path(tempfile.mkdtemp(prefix='.active-', dir=root)).resolve()
        try:
            if configured is None:
                requests = work / 'requests.tsv'
                requests.write_text('')
            entry = ROOT / 'scripts/heavy-lean-build'
            return run_private(entry, [str(entry), '--state', str(work / 'state'), '--real-lean', str(real),
                      *(['--direct-lean-index', str(direct_index)] if direct else []),
                      '--allowance-kib', str(requested),
                      '--headroom-kib', env.get('FREN_BUILD_HEADROOM_KIB', '100000'),
                      '--fallback-kib', env.get('FREN_BUILD_FALLBACK_KIB', '600000'),
                      '--timeout-ms', env.get('FREN_BUILD_TIMEOUT_MS', '30000'),
                      '--requests', str(requests), '--', *command], env, work)
        except BaseException:
            if work.exists():
                finish_private_state(work, False)
            raise
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'fren-build: {error}', file=sys.stderr)
        return 125


if __name__ == '__main__':
    sys.exit(main())
