-- Run-length encoding, as a streaming encoder. Each step reads one value of
-- the input: a value equal to the current run's value extends that run, and
-- any other value starts a new run and emits the current one. At the end of
-- the input, the caller emits the current run.
mod rle

-- `count` copies of `value`.
type SubsetRle1 = subset_value: Nat  where invariant: subset_value is 1..
pub struct Run { value: Int, count: SubsetRle1 }

-- The number of values in a run, or 0 when there is none.
fn size(o: Option<Run>): Nat := match o { Some(r) => r.count, None => 0 }

-- TODO(#313): make `step` a `fn` once functions can have `expect` clauses.
pub proc step(current: Option<Run>, next: Int): (run: Run, emitted: Option<Run>) {
    ensure extend:
        when current is Some(r) and r.value = next,
        run = Run { value := next, count := r.count + 1 } and emitted = None
    ensure start:
        unless current is Some(r) and r.value = next,
        run = Run { value := next, count := 1 } and emitted = current

    -- The current run holds the value just read.
    expect fresh: run.value = next
    -- No value is lost or duplicated.
    expect conserves: size(emitted) + run.count = size(current) + 1
    -- A run ends only where the value changes.
    expect differs: when emitted is Some(e), e.value != run.value
}

-- The next run emitted after `a`'s, however long it grows first, holds a
-- different value, so the encoding never splits a run in two.
expect adjacent_differ(a_current: Option<Run>, a_next: Int, b_current: Option<Run>, b_next: Int) {
    call a := step(a_current, a_next)
    call b := step(b_current, b_next)
    expect adjacent_differ: when b.current is Some(c) and c.value = a.run.value
        and a.emitted is Some(d) and b.emitted is Some(e),
        d.value != e.value
}
