-- The simply typed lambda calculus with Booleans, after chapters 8, 9 and
-- 12 of Pierce, "Types and Programming Languages" (TAPL): syntax,
-- substitution, typing and call-by-value evaluation, each stated as in the
-- book, and the theorems that tie them together.
--
-- Typing is the function `typeof` and reduction the function `step`; the
-- arms of each are the book's inference rules. What one step of a
-- function's equations settles, such as reading the rules backwards, the
-- solver decides. The theorems, which need induction, are proved in
-- Stlc.lean and bound to the procedures below with `impl`; `fren check`
-- also tests them on random terms. Random testing draws small terms and
-- meets a law's premise only where that is easy, so it confirms
-- `preservation`, `big_step_preservation`, `step_eval`, `agree`,
-- `big_step_values`, `eval_monotone`, `normalize_monotone`,
-- `substitution`, `named_nameless`, `converts_back`, `subst_nameless` and
-- `typed_alpha` on trivial cases alone: their evidence is the proofs.
-- `more_fuel` has no proof and is tested only, on trivial cases alone. Fren
-- has no check that states normalization, so Stlc.lean alone proves it.
mod stlc

-- # Syntax
--
--     T ::= Bool | T -> T
--     t ::= x | \x: T. t | t t | true | false | if t then t else t
--
-- `Term<V, B>` is generic in the type `V` of the names that variables
-- mention and the type `B` of the names that binders declare, so that one
-- type has both the named terms, `Term<Name, Name>`, and their nameless
-- form, `Term<Int, Anon>` (see "Nameless terms"). All else is at `Named`.
pub type Name := String
pub enum Anon { Anon }

pub enum Ty { Boolean, Arrow(Ty, Ty) }
use self::Ty::{Arrow, Boolean}

pub enum Term<V, B> {
    Var(V),
    Lam(B, Ty, Term<V, B>),
    App(Term<V, B>, Term<V, B>),
    True,
    False,
    If(Term<V, B>, Term<V, B>, Term<V, B>),
}
use self::Term::{App, False, If, Lam, True, Var}

pub type Named := Term<Name, Name>
pub type Nameless := Term<Int, Anon>

-- A value is an abstraction or a Boolean literal.
pub fn value?<V, B>(t: Term<V, B>) := t is Lam(_, _, _) | True | False

-- The terms of the examples below: `\x: Bool. x`, `\x: Bool. if x then
-- false else true`, `(\x: Bool. x) true` and `if true then false else true`.
pub const IDENTITY: Named := Lam("x", Boolean, Var("x"))
pub const NEGATION: Named := Lam("x", Boolean, If(Var("x"), False, True))
pub const APPLIED: Named := App(IDENTITY, True)
pub const NOT_TRUE: Named := If(True, False, True)

-- # Substitution
--
-- `subst(x, s, t)` is `[x := s] t`, capture-avoiding: a binder that would
-- capture a free variable of `s` is renamed. It is written for a parallel
-- substitution, a finite map `Subst` from names to terms, so that renaming
-- a binder is one more entry and the recursion stays structural on the
-- term.
pub fn free(t: Named): Set<Name> := match t {
    Var(x) => {x},
    Lam(x, _, body) => free(body) minus {x},
    App(t1, t2) => free(t1) union free(t2),
    True => {},
    False => {},
    If(c, a, b) => free(c) union free(a) union free(b),
}

pub fn closed?(t: Named) := free(t) = {}

pub enum Subst { Id, Bind(Name, Named, Subst) }

-- What `sub` substitutes for `x`: its first entry for `x`, or `x` itself.
pub fn apply_subst(sub: Subst, x: Name): Named := match sub {
    Subst::Id => Var(x),
    Subst::Bind(y, s, rest) => if y = x then s else apply_subst(rest, x),
}

-- Whether the binder `y`, of a body with the free variables `fv`, would
-- capture a free variable of a term that `sub` substitutes for another
-- free variable of the body. A later entry for a name is shadowed by an
-- earlier one, so a name is taken out of `fv` once seen.
pub fn captures?(sub: Subst, y: Name, fv: Set<Name>) := match sub {
    Subst::Id => false,
    Subst::Bind(x, s, rest) => (x != y and x in fv and y in free(s)) or captures?(rest, y, fv minus {x}),
}

-- Every name of a term, free or bound, joined: a longer name is fresh.
-- Joining strings is outside the decidable core, here and in `fresh`; the
-- laws of fresh names are proved in Stlc.lean.
set_option fren.lint.undecidable "allow" in
pub fn all_names(t: Named): String := match t {
    Var(x) => x,
    Lam(x, _, body) => x ++ all_names(body),
    App(t1, t2) => all_names(t1) ++ all_names(t2),
    True => "",
    False => "",
    If(c, a, b) => all_names(c) ++ all_names(a) ++ all_names(b),
}

-- A name free neither in `body` nor in a term of `sub`'s range: longer than
-- every name in them.
set_option fren.lint.undecidable "allow" in
pub fn fresh(sub: Subst, body: Named): Name := match sub {
    Subst::Id => all_names(body) ++ "'",
    Subst::Bind(_, s, rest) => all_names(s) ++ fresh(rest, body),
}

pub fn new_binder(sub: Subst, y: Name, body: Named): Name :=
    if captures?(sub, y, free(body)) then fresh(sub, body) else y

pub fn subst_all(sub: Subst, t: Named): Named := match t {
    Var(x) => apply_subst(sub, x),
    Lam(y, ty, body) => Lam(
        new_binder(sub, y, body),
        ty,
        subst_all(Subst::Bind(y, Var(new_binder(sub, y, body)), sub), body)
    ),
    App(t1, t2) => App(subst_all(sub, t1), subst_all(sub, t2)),
    True => True,
    False => False,
    If(c, a, b) => If(subst_all(sub, c), subst_all(sub, a), subst_all(sub, b)),
}

pub fn subst(x: Name, s: Named, t: Named): Named := subst_all(Subst::Bind(x, s, Subst::Id), t)

-- `[x := y] (\y. x)` renames the binder, to a name made of every name in
-- play and a prime, so that the `y` put in stays free; `[x := z] (\y. x)`
-- captures nothing and keeps it.
set_option fren.lint.assertions_on_constants "allow" in
set_option fren.evidence "enumerated" in
pub proc capture_avoidance() {
    expect renamed: subst("x", Var("y"), Lam("y", Boolean, Var("x"))) = Lam("yx'", Boolean, Var("y"))
    expect kept: subst("x", Var("z"), Lam("y", Boolean, Var("x"))) = Lam("y", Boolean, Var("z"))
}

-- Substitution changes nothing where the variable is not free, substitutes
-- for the variable itself, and leaves free only what was free, less the
-- variable, and the free variables of what was put in. Proved in Stlc.lean.
--
-- The annotations on each procedure checked by random testing are the ui
-- test's: it runs this file through both front ends and expects their
-- notes, that testing runs no vacuity or redundancy check, and that the
-- Lean front end leaves it to `fren check`.
set_option fren.evidence "random" in
pub proc substitution_laws(x: Name, s: Named, t: Named) {  --~ info: the vacuity and redundancy checks of `stlc::substitution_laws` are not run by random testing
    --~^[hosted] info: the checks of `stlc::substitution_laws` set to random testing are run by `fren check`, not in Lean
    ensure unused: when not x in free(t), subst(x, s, t) = t
    ensure itself: subst(x, s, Var(x)) = s
    ensure free_after: free(subst(x, s, t)) subset (free(t) minus {x}) union free(s)
}

-- # Typing
--
-- A context binds names to types, innermost first. `typeof` decides
-- `ctx |- t: T`, and each of its arms is one of the book's rules:
--
--     x: T in ctx                 ctx, x: T1 |- t2: T2
--     ----------- (T-Var)     ---------------------------- (T-Abs)
--     ctx |- x: T             ctx |- \x: T1. t2: T1 -> T2
--
--     ctx |- t1: T11 -> T12    ctx |- t2: T11
--     ------------------------------------- (T-App)
--     ctx |- t1 t2: T12
--
--     ctx |- t1: Bool    ctx |- t2: T    ctx |- t3: T
--     ---------------------------------------------- (T-If)
--     ctx |- if t1 then t2 else t3: T
--
--     ctx |- true: Bool (T-True)    ctx |- false: Bool (T-False)
pub enum Ctx { Empty, Bind(Name, Ty, Ctx) }

pub fn lookup(ctx: Ctx, x: Name): Option<Ty> := match ctx {
    Ctx::Empty => None,
    Ctx::Bind(y, ty, rest) => if y = x then Some(ty) else lookup(rest, x),
}

pub fn typeof(ctx: Ctx, t: Named): Option<Ty> := match t {
    Var(x) => lookup(ctx, x),
    Lam(x, ty1, t2) => match typeof(Ctx::Bind(x, ty1, ctx), t2) {
        Some(ty2) => Some(Arrow(ty1, ty2)),
        None => None,
    },
    App(t1, t2) => match typeof(ctx, t1), typeof(ctx, t2) {
        Some(Arrow(ty11, ty12)), Some(ty2) => if ty11 = ty2 then Some(ty12) else None,
        _, _ => None,
    },
    If(t1, t2, t3) => match typeof(ctx, t1), typeof(ctx, t2), typeof(ctx, t3) {
        Some(Boolean), Some(ty2), Some(ty3) => if ty2 = ty3 then Some(ty2) else None,
        _, _, _ => None,
    },
    True => Some(Boolean),
    False => Some(Boolean),
}

-- The rules read in both directions: `typeof` gives a judgment exactly when
-- the rule for its term's form applies, so a judgment's premises follow
-- from it (inversion, TAPL 9.3.1), and a term has at most one type (9.3.3).
-- Each law is one step of `typeof`'s equations, which the solver decides;
-- it is an equivalence rather than a `when`, whose premise would apply a
-- recursive function and leave the vacuity check inconclusive (`F0450`).
pub proc typing_rules(
    ctx: Ctx,
    x: Name,
    ty: Ty,
    ty1: Ty,
    ty12: Ty,
    t1: Named,
    t2: Named,
    t3: Named,
) {
    expect t_var: typeof(ctx, Var(x)) = Some(ty) iff lookup(ctx, x) = Some(ty)
    expect t_abs: typeof(ctx, Lam(x, ty1, t2)) = Some(ty)
        iff ty is Arrow(p, ty2) and p = ty1 and typeof(Ctx::Bind(x, ty1, ctx), t2) = Some(ty2)
    expect t_app: typeof(ctx, App(t1, t2)) = Some(ty12)
        iff typeof(ctx, t2) is Some(ty11) and typeof(ctx, t1) = Some(Arrow(ty11, ty12))
    expect t_if: typeof(ctx, If(t1, t2, t3)) = Some(ty)
        iff typeof(ctx, t1) = Some(Boolean) and typeof(ctx, t2) = Some(ty) and typeof(ctx, t3) = Some(ty)
    expect t_true: typeof(ctx, True) = Some(Boolean)
    expect t_false: typeof(ctx, False) = Some(Boolean)
}

set_option fren.lint.assertions_on_constants "allow" in
set_option fren.evidence "enumerated" in
pub proc typing_examples() {
    expect identity: typeof(Ctx::Empty, IDENTITY) = Some(Arrow(Boolean, Boolean))
    expect applied: typeof(Ctx::Empty, APPLIED) = Some(Boolean)
    expect not_a_function: typeof(Ctx::Empty, App(True, False)) = None
    expect unbound: typeof(Ctx::Empty, Var("x")) = None
    expect branches_differ: typeof(Ctx::Empty, If(True, IDENTITY, False)) = None
}

-- # Evaluation
--
-- Call-by-value, small-step: `step` takes one step, `t --> u`, and each of
-- its arms is one of the book's rules:
--
--     (\x: T. t12) v --> [x := v] t12 (E-AppAbs)
--
--     t1 --> t1'                  t2 --> t2'
--     ------------------ (E-App1)     ------------------ (E-App2)
--     t1 t2 --> t1' t2            v1 t2 --> v1 t2'
--
--     if true then t2 else t3 --> t2 (E-IfTrue)    if false then t2 else t3 --> t3 (E-IfFalse)
--
--     t1 --> t1'
--     ------------------------------------------------- (E-If)
--     if t1 then t2 else t3 --> if t1' then t2 else t3
pub fn step(t: Named): Option<Named> := match t {
    App(t1, t2) => if not value?(t1) then match step(t1) {
        Some(u1) => Some(App(u1, t2)),
        None => None,
    } else if not value?(t2) then match step(t2) {
        Some(u2) => Some(App(t1, u2)),
        None => None,
    } else match t1 {
        Lam(x, _, t12) => Some(subst(x, t2, t12)),
        _ => None,
    },
    If(True, t2, _) => Some(t2),
    If(False, _, t3) => Some(t3),
    If(t1, t2, t3) => match step(t1) {
        Some(u1) => Some(If(u1, t2, t3)),
        None => None,
    },
    _ => None,
}

-- The rules read in both directions, as for typing: a step is taken exactly
-- by the rule whose premises hold, so reduction is deterministic, and a
-- value takes no step (TAPL 3.5.7). Each law is one step of `step`'s
-- equations, which the solver decides.
pub proc reduction_rules(t1: Named, t2: Named, t3: Named, u: Named, v: Named) {
    expect e_app: step(App(t1, t2)) = Some(u)
        iff (step(t1) is Some(u1) and u = App(u1, t2))
        or (value?(t1) and step(t2) is Some(u2) and u = App(t1, u2))
        or (value?(t2) and t1 is Lam(x, _, t12) and u = subst(x, t2, t12))
    expect e_if: step(If(t1, t2, t3)) = Some(u)
        iff (t1 = True and u = t2) or (t1 = False and u = t3) or (step(t1) is Some(u1) and u = If(u1, t2, t3))
    expect values_normal: when value?(v), step(v) = None
}

-- `reduce` takes `fuel` steps or as many as there are; `normalize` reduces
-- to a value; `eval` is big-step, with fuel for the depth of its
-- derivation. Fuel bounds the recursions that are not structural on a
-- term: theirs, on the steps taken, and the parser's, on the tokens left.
pub enum Fuel { Zero, More(Fuel) }
use self::Fuel::{More, Zero}

pub fn plus(a: Fuel, b: Fuel): Fuel := match a {
    Zero => b,
    More(n) => More(plus(n, b)),
}

pub const THREE: Fuel := More(More(More(Zero)))

pub fn reduce(fuel: Fuel, t: Named): Named := match fuel {
    Zero => t,
    More(n) => match step(t) {
        Some(u) => reduce(n, u),
        None => t,
    },
}

pub fn normalize(fuel: Fuel, t: Named): Option<Named> := match fuel {
    Zero => if value?(t) then Some(t) else None,
    More(n) => if value?(t) then Some(t) else match step(t) {
        Some(u) => normalize(n, u),
        None => None,
    },
}

pub fn eval(fuel: Fuel, t: Named): Option<Named> := match fuel {
    Zero => None,
    More(n) => match t {
        Var(_) => None,
        App(t1, t2) => match eval(n, t1), eval(n, t2) {
            Some(Lam(x, _, t12)), Some(v) => eval(n, subst(x, v, t12)),
            _, _ => None,
        },
        If(t1, t2, t3) => match eval(n, t1) {
            Some(True) => eval(n, t2),
            Some(False) => eval(n, t3),
            _ => None,
        },
        _ => Some(t),
    },
}

-- Big-step evaluation agrees with small-step: what `eval` gives is a
-- value, more fuel changes nothing, a step changes nothing of what `eval`
-- gives, and `eval` and `normalize` give the same value. Proved in
-- Stlc.lean by induction on the fuel.
set_option fren.evidence "random" in
pub proc evaluators(t: Named, u: Named, v: Named, w: Named, n: Fuel, m: Fuel) {  --~ info: the vacuity and redundancy checks of `stlc::evaluators` are not run by random testing
    --~^[hosted] info: the checks of `stlc::evaluators` set to random testing are run by `fren check`, not in Lean
    ensure big_step_values: when eval(n, t) = Some(v), value?(v)
    ensure eval_monotone: when eval(n, t) = Some(v), eval(More(n), t) = Some(v)
    ensure normalize_monotone: when normalize(n, t) = Some(v), normalize(More(n), t) = Some(v)
    ensure step_eval: when step(t) = Some(u) and eval(n, t) = Some(v), eval(n, u) = Some(v)
    ensure agree: when eval(n, t) = Some(v) and normalize(m, t) = Some(w), v = w
}

set_option fren.lint.assertions_on_constants "allow" in
set_option fren.evidence "enumerated" in
pub proc evaluation_examples() {
    expect negation: eval(THREE, App(NEGATION, True)) = Some(False) and normalize(THREE, App(NEGATION, True)) = Some(False)
    expect applied: reduce(THREE, APPLIED) = True
    expect stuck: reduce(THREE, App(True, False)) = App(True, False)
}

-- # Metatheory
--
-- Typing depends on the context only at the free variables, so it survives
-- a binding of a variable that is not free (weakening, TAPL 9.3.7), and
-- substituting a well-typed term for a variable keeps the type (the
-- substitution lemma, 9.3.8). Proved in Stlc.lean by induction on the term.
-- `extensional` quantifies over a computed set, outside the decidable core.
set_option fren.evidence "random" in
set_option fren.lint.undecidable "allow" in
pub proc context_lemmas(ctx: Ctx, ctx2: Ctx, t: Named, x: Name, ty: Ty, ty1: Ty, s: Named) {  --~ info: the vacuity and redundancy checks of `stlc::context_lemmas` are not run by random testing
    --~^[hosted] info: the checks of `stlc::context_lemmas` set to random testing are run by `fren check`, not in Lean
    ensure extensional: when (forall (z: Name), when z in free(t), lookup(ctx, z) = lookup(ctx2, z)),
        typeof(ctx, t) = typeof(ctx2, t)
    ensure weakening: when typeof(ctx, t) = Some(ty) and not x in free(t), typeof(Ctx::Bind(x, ty1, ctx), t) = Some(ty)
    ensure substitution: when typeof(Ctx::Bind(x, ty1, ctx), t) = Some(ty) and typeof(ctx, s) = Some(ty1),
        typeof(ctx, subst(x, s, t)) = Some(ty)
}

-- Progress (9.3.5) and preservation (9.3.9), so type safety: a well-typed
-- closed term never gets stuck, however far it is reduced, and whatever it
-- reduces to has its type; so has what `eval` gives. Proved in Stlc.lean,
-- preservation from the substitution lemma and progress from the canonical
-- forms of values (9.3.4).
set_option fren.evidence "random" in
pub proc type_safety(ctx: Ctx, t: Named, u: Named, ty: Ty, n: Fuel) {  --~ info: the vacuity and redundancy checks of `stlc::type_safety` are not run by random testing
    --~^[hosted] info: the checks of `stlc::type_safety` set to random testing are run by `fren check`, not in Lean
    ensure progress: when typeof(Ctx::Empty, t) = Some(ty), value?(t) or step(t) is Some(_)
    ensure preservation: when typeof(ctx, t) = Some(ty) and step(t) = Some(u), typeof(ctx, u) = Some(ty)
    ensure safety: when typeof(Ctx::Empty, t) = Some(ty),
        typeof(Ctx::Empty, reduce(n, t)) = Some(ty) and (value?(reduce(n, t)) or step(reduce(n, t)) is Some(_))
    ensure big_step_preservation: when typeof(ctx, t) = Some(ty) and eval(n, t) = Some(u), typeof(ctx, u) = Some(ty)
}

-- Random testing draws small terms, and the closed, well-typed ones among
-- them are values, so `progress` and `safety` beyond values rest on the
-- proofs; these examples step typed non-values.
set_option fren.lint.assertions_on_constants "allow" in
set_option fren.evidence "enumerated" in
pub proc typed_non_values() {
    expect applied: typeof(Ctx::Empty, APPLIED) = Some(Boolean) and step(APPLIED) = Some(True)
    expect not_true: typeof(Ctx::Empty, NOT_TRUE) = Some(Boolean) and step(NOT_TRUE) = Some(False)
    expect negated: normalize(THREE, App(NEGATION, APPLIED)) = Some(False)
}

-- Normalization (chapter 12): a well-typed closed term reduces to a value
-- in some number of steps. Fren can state that number only as an `exists`
-- over `Fuel`, which testing cannot run (`F0639`), or as the contract of
-- an uninterpreted function that gives the fuel, whose realizability is
-- the theorem itself, which the solver cannot decide (`F0608`, #612). So
-- it has no check here: Stlc.lean states and proves it, by Tait's method
-- (`normalization`).

-- # Concrete syntax
--
--     term  ::= '\' name ':' type '.' term | 'if' term 'then' term 'else' term | app
--     app   ::= app atom | atom
--     atom  ::= name | 'true' | 'false' | '(' term ')'
--     type  ::= tatom '->' type | tatom
--     tatom ::= 'Bool' | '(' type ')'
--
-- Application associates to the left and binds tightest; an abstraction
-- and a conditional extend as far right as they can; arrows associate to
-- the right. The printer writes parentheses only where this grammar needs
-- them, and the parser reads what the printer writes (`print_parse`).
pub enum Token {
    LParen,
    RParen,
    Backslash,
    Colon,
    Dot,
    Arrow,
    If,
    Then,
    Else,
    True,
    False,
    Boolean,
    Ident(Name),
}

pub enum Tokens { Nil, Cons(Token, Tokens) }

pub fn append(a: Tokens, b: Tokens): Tokens := match a {
    Tokens::Nil => b,
    Tokens::Cons(t, rest) => Tokens::Cons(t, append(rest, b)),
}

pub fn one(t: Token): Tokens := Tokens::Cons(t, Tokens::Nil)

pub fn parens(ts: Tokens): Tokens := Tokens::Cons(Token::LParen, append(ts, one(Token::RParen)))

pub fn text(t: Token): String := match t {
    Token::LParen => "(",
    Token::RParen => ")",
    Token::Backslash => "\\",
    Token::Colon => ":",
    Token::Dot => ".",
    Token::Arrow => "->",
    Token::If => "if",
    Token::Then => "then",
    Token::Else => "else",
    Token::True => "true",
    Token::False => "false",
    Token::Boolean => "Bool",
    Token::Ident(x) => x,
}

-- The tokens as text, one space apart (joining strings is outside the
-- decidable core).
set_option fren.lint.undecidable "allow" in
pub fn render(ts: Tokens): String := match ts {
    Tokens::Nil => "",
    Tokens::Cons(t, Tokens::Nil) => text(t),
    Tokens::Cons(t, rest) => text(t) ++ " " ++ render(rest),
}

-- ## Printing
--
-- The grammar's levels, loosest first: a construct of level `needs` is
-- written bare at a level at most as tight, and in parentheses otherwise.
pub ordered enum Level { Term, Application, Atom }

pub fn wrap(level: Level, needs: Level, ts: Tokens): Tokens := if level <= needs then ts else parens(ts)

pub fn print_ty(ty: Ty): Tokens := match ty {
    Boolean => one(Token::Boolean),
    Arrow(ty1, ty2) => append(
        if ty1 is Arrow(_, _) then parens(print_ty(ty1)) else print_ty(ty1),
        Tokens::Cons(Token::Arrow, print_ty(ty2))
    ),
}

pub fn print_at(level: Level, t: Named): Tokens := match t {
    Var(x) => one(Token::Ident(x)),
    True => one(Token::True),
    False => one(Token::False),
    Lam(x, ty, body) => wrap(
        level,
        Level::Term,
        append(
            Tokens::Cons(
                Token::Backslash,
                Tokens::Cons(Token::Ident(x), Tokens::Cons(Token::Colon, print_ty(ty)))
            ),
            Tokens::Cons(Token::Dot, print_at(Level::Term, body))
        )
    ),
    App(t1, t2) => wrap(
        level,
        Level::Application,
        append(print_at(Level::Application, t1), print_at(Level::Atom, t2))
    ),
    If(t1, t2, t3) => wrap(
        level,
        Level::Term,
        Tokens::Cons(
            Token::If,
            append(
                print_at(Level::Term, t1),
                Tokens::Cons(
                    Token::Then,
                    append(
                        print_at(Level::Term, t2),
                        Tokens::Cons(Token::Else, print_at(Level::Term, t3))
                    )
                )
            )
        )
    ),
}

pub fn print(t: Named): Tokens := print_at(Level::Term, t)

-- Where the parentheses go: around an abstraction or a conditional that is
-- an operand of an application, around an application that is an argument,
-- and around an arrow on the left of an arrow; nowhere else. Each law is
-- one step of the printer, which the solver decides.
pub proc parenthesization(x: Name, ty: Ty, body: Named, t1: Named, t2: Named, t3: Named) {
    expect lam_bare: print_at(Level::Term, Lam(x, ty, body)) = append(
        Tokens::Cons(
            Token::Backslash,
            Tokens::Cons(Token::Ident(x), Tokens::Cons(Token::Colon, print_ty(ty)))
        ),
        Tokens::Cons(Token::Dot, print(body))
    )
    expect lam_operand: print_at(Level::Application, Lam(x, ty, body)) = parens(print(Lam(x, ty, body)))
        and print_at(Level::Atom, Lam(x, ty, body)) = parens(print(Lam(x, ty, body)))
    expect if_operand: print_at(Level::Atom, If(t1, t2, t3)) = parens(print(If(t1, t2, t3)))
    expect app_bare: print(App(t1, t2)) = append(print_at(Level::Application, t1), print_at(Level::Atom, t2))
    expect app_argument: print_at(Level::Atom, App(t1, t2)) = parens(print(App(t1, t2)))
    expect atoms_bare: print_at(Level::Atom, Var(x)) = one(Token::Ident(x))
        and print_at(Level::Atom, True) = one(Token::True)
    expect arrow_right: print_ty(Arrow(Boolean, ty)) = append(print_ty(Boolean), Tokens::Cons(Token::Arrow, print_ty(ty)))
    expect arrow_left: print_ty(Arrow(Arrow(ty, ty), Boolean))
        = append(
            parens(print_ty(Arrow(ty, ty))),
            Tokens::Cons(Token::Arrow, print_ty(Boolean))
        )
}

-- ## Parsing
--
-- A recursive descent with the grammar's levels as modes: `Arguments(f)`
-- reads the arguments of an application whose function so far is `f`, as
-- many atoms as follow, and `Consequent(t1)` and `Alternative(t1, t2)`
-- read the rest of a conditional. The recursion is on fuel: it is on the
-- tokens left, which a structural recursion cannot follow (`F0447`).
pub enum Mode { Term, Application, Arguments(Named), Atom, Consequent(Named), Alternative(Named, Named) }

-- A term or a type read, with the tokens left, or a failure.
pub enum Parsed { Fail, Ok(Named, Tokens) }
pub enum ParsedTy { Fail, Ok(Ty, Tokens) }

pub fn starts_atom?(ts: Tokens) := ts is Tokens::Cons(Token::Ident(_) | Token::True | Token::False | Token::LParen, _)

-- What was read, once the next token is `tok`: the parenthesized `( t )`,
-- the type of `\x: ty.`, or the condition of `if t1 then`.
pub fn after(tok: Token, read: Parsed): Parsed := match read {
    Parsed::Ok(t, Tokens::Cons(next, rest)) => if next = tok then Parsed::Ok(t, rest) else Parsed::Fail,
    _ => Parsed::Fail,
}

pub fn after_ty(tok: Token, read: ParsedTy): ParsedTy := match read {
    ParsedTy::Ok(ty, Tokens::Cons(next, rest)) => if next = tok then ParsedTy::Ok(ty, rest) else ParsedTy::Fail,
    _ => ParsedTy::Fail,
}

pub fn lam_of(x: Name, ty: Ty, body: Parsed): Parsed := match body {
    Parsed::Ok(t, rest) => Parsed::Ok(Lam(x, ty, t), rest),
    Parsed::Fail => Parsed::Fail,
}

pub fn if_of(t1: Named, t2: Named, alternative: Parsed): Parsed := match alternative {
    Parsed::Ok(t3, rest) => Parsed::Ok(If(t1, t2, t3), rest),
    Parsed::Fail => Parsed::Fail,
}

pub fn arrow_of(ty1: Ty, read: ParsedTy): ParsedTy := match read {
    ParsedTy::Ok(ty2, rest) => ParsedTy::Ok(Arrow(ty1, ty2), rest),
    ParsedTy::Fail => ParsedTy::Fail,
}

-- `atom?` reads one `tatom`, and otherwise a `type`.
pub fn parse_ty(fuel: Fuel, atom?, ts: Tokens): ParsedTy := match fuel {
    Zero => ParsedTy::Fail,
    More(n) => if atom? then match ts {
        Tokens::Cons(Token::Boolean, rest) => ParsedTy::Ok(Boolean, rest),
        Tokens::Cons(Token::LParen, rest) => after_ty(Token::RParen, parse_ty(n, false, rest)),
        _ => ParsedTy::Fail,
    } else match parse_ty(n, true, ts) {
        ParsedTy::Ok(ty1, Tokens::Cons(Token::Arrow, more)) => arrow_of(
            ty1,
            parse_ty(n, false, more)
        ),
        read => read,
    },
}

pub fn parse(fuel: Fuel, mode: Mode, ts: Tokens): Parsed := match fuel {
    Zero => Parsed::Fail,
    More(n) => match mode {
        Mode::Atom => match ts {
            Tokens::Cons(Token::Ident(x), rest) => Parsed::Ok(Var(x), rest),
            Tokens::Cons(Token::True, rest) => Parsed::Ok(True, rest),
            Tokens::Cons(Token::False, rest) => Parsed::Ok(False, rest),
            Tokens::Cons(Token::LParen, rest) => after(Token::RParen, parse(n, Mode::Term, rest)),
            _ => Parsed::Fail,
        },
        Mode::Arguments(f) => if starts_atom?(ts) then match parse(n, Mode::Atom, ts) {
            Parsed::Ok(a, rest) => parse(n, Mode::Arguments(App(f, a)), rest),
            Parsed::Fail => Parsed::Fail,
        } else Parsed::Ok(f, ts),
        Mode::Application => match parse(n, Mode::Atom, ts) {
            Parsed::Ok(f, rest) => parse(n, Mode::Arguments(f), rest),
            Parsed::Fail => Parsed::Fail,
        },
        Mode::Consequent(t1) => match after(Token::Else, parse(n, Mode::Term, ts)) {
            Parsed::Ok(t2, rest) => parse(n, Mode::Alternative(t1, t2), rest),
            Parsed::Fail => Parsed::Fail,
        },
        Mode::Alternative(t1, t2) => if_of(t1, t2, parse(n, Mode::Term, ts)),
        Mode::Term => match ts {
            Tokens::Cons(Token::Backslash, Tokens::Cons(Token::Ident(x), Tokens::Cons(Token::Colon, more))) =>
                match after_ty(Token::Dot, parse_ty(n, false, more)) {
                    ParsedTy::Ok(ty, body) => lam_of(x, ty, parse(n, Mode::Term, body)),
                    ParsedTy::Fail => Parsed::Fail,
                },
            Tokens::Cons(Token::If, more) => match after(Token::Then, parse(n, Mode::Term, more)) {
                Parsed::Ok(t1, rest) => parse(n, Mode::Consequent(t1), rest),
                Parsed::Fail => Parsed::Fail,
            },
            _ => parse(n, Mode::Application, ts),
        },
    },
}

-- Fuel enough to parse what `print` writes: three for each node, for the
-- descent through the modes, and its children's.
pub fn fuel_for_ty(ty: Ty): Fuel := match ty {
    Boolean => THREE,
    Arrow(ty1, ty2) => plus(THREE, plus(fuel_for_ty(ty1), fuel_for_ty(ty2))),
}

pub fn fuel_for(t: Named): Fuel := match t {
    Var(_) | True | False => THREE,
    Lam(_, ty, body) => plus(THREE, plus(fuel_for_ty(ty), fuel_for(body))),
    App(t1, t2) => plus(THREE, plus(fuel_for(t1), fuel_for(t2))),
    If(t1, t2, t3) => plus(THREE, plus(fuel_for(t1), plus(fuel_for(t2), fuel_for(t3)))),
}

-- The round trip: the parser reads what the printer writes, with fuel for
-- the term's size and more. Tested only: Stlc.lean does not prove it, and
-- random testing meets `more_fuel`'s premise only on atoms; the examples
-- below read an application with too little fuel, the least, and more.
set_option fren.evidence "random" in
pub proc print_parse(t: Named, ty: Ty, fuel: Fuel, mode: Mode, ts: Tokens, u: Named, rest: Tokens) {  --~ info: the vacuity and redundancy checks of `stlc::print_parse` are not run by random testing
    --~^[hosted] info: the checks of `stlc::print_parse` set to random testing are run by `fren check`, not in Lean
    ensure terms: parse(fuel_for(t), Mode::Term, print(t)) = Parsed::Ok(t, Tokens::Nil)
    ensure types: parse_ty(fuel_for_ty(ty), false, print_ty(ty)) = ParsedTy::Ok(ty, Tokens::Nil)
    ensure more_fuel: when parse(fuel, mode, ts) = Parsed::Ok(u, rest), parse(More(fuel), mode, ts) = Parsed::Ok(u, rest)
}

set_option fren.lint.assertions_on_constants "allow" in
set_option fren.evidence "enumerated" in
pub proc parsing_examples() {
    expect too_little_fuel: parse(plus(THREE, THREE), Mode::Term, print(APPLIED)) = Parsed::Fail
    expect least_fuel: parse(More(plus(THREE, THREE)), Mode::Term, print(APPLIED)) = Parsed::Ok(APPLIED, Tokens::Nil)
    expect fuel_to_spare: parse(More(fuel_for(APPLIED)), Mode::Term, print(APPLIED)) = Parsed::Ok(APPLIED, Tokens::Nil)
    expect identity: render(print(IDENTITY)) = "\\ x : Bool . x"
    expect applied: render(print(APPLIED)) = "( \\ x : Bool . x ) true"
    expect nested: render(print(App(App(Var("f"), Var("x")), App(Var("g"), Var("y"))))) = "f x ( g y )"
    expect arrow: render(print_ty(Arrow(Arrow(Boolean, Boolean), Boolean))) = "( Bool -> Bool ) -> Bool"
}

-- # Nameless terms
--
-- A de Bruijn term mentions a variable by its index: how many binders stand
-- between it and the one that declares it. `to_nameless` converts a named
-- term under a list of names, innermost first, and `to_named` converts
-- back, declaring the fresh names `x`, `x'`, `x''`, ... from the outside
-- in. Two named terms are alpha-equivalent when their nameless forms are
-- equal.
pub enum Names { Nil, Cons(Name, Names) }

pub fn index_of(names: Names, x: Name): Option<Int> := match names {
    Names::Nil => None,
    Names::Cons(y, rest) => if y = x then Some(0) else match index_of(rest, x) {
        Some(k) => Some(k + 1),
        None => None,
    },
}

pub fn nth(names: Names, k: Int): Option<Name> := match names {
    Names::Nil => None,
    Names::Cons(y, rest) => if k = 0 then Some(y) else nth(rest, k - 1),
}

pub fn to_nameless(names: Names, t: Named): Option<Nameless> := match t {
    Var(x) => match index_of(names, x) {
        Some(k) => Some(Var(k)),
        None => None,
    },
    Lam(x, ty, body) => match to_nameless(Names::Cons(x, names), body) {
        Some(nb) => Some(Lam(Anon::Anon, ty, nb)),
        None => None,
    },
    App(t1, t2) => match to_nameless(names, t1), to_nameless(names, t2) {
        Some(n1), Some(n2) => Some(App(n1, n2)),
        _, _ => None,
    },
    If(t1, t2, t3) => match to_nameless(names, t1), to_nameless(names, t2), to_nameless(names, t3) {
        Some(n1), Some(n2), Some(n3) => Some(If(n1, n2, n3)),
        _, _, _ => None,
    },
    True => Some(True),
    False => Some(False),
}

-- `x` with one `'` for each name in scope: a name not among them, since
-- those are the earlier fresh names (joining strings is outside the
-- decidable core).
set_option fren.lint.undecidable "allow" in
pub fn fresh_name(names: Names): Name := match names {
    Names::Nil => "x",
    Names::Cons(_, rest) => fresh_name(rest) ++ "'",
}

pub fn to_named(names: Names, n: Nameless): Option<Named> := match n {
    Var(k) => match nth(names, k) {
        Some(x) => Some(Var(x)),
        None => None,
    },
    Lam(_, ty, body) => match to_named(Names::Cons(fresh_name(names), names), body) {
        Some(b) => Some(Lam(fresh_name(names), ty, b)),
        None => None,
    },
    App(n1, n2) => match to_named(names, n1), to_named(names, n2) {
        Some(t1), Some(t2) => Some(App(t1, t2)),
        _, _ => None,
    },
    If(n1, n2, n3) => match to_named(names, n1), to_named(names, n2), to_named(names, n3) {
        Some(t1), Some(t2), Some(t3) => Some(If(t1, t2, t3)),
        _, _, _ => None,
    },
    True => Some(True),
    False => Some(False),
}

pub fn alpha_eq?(names: Names, a: Named, b: Named) := to_nameless(names, a) is Some(_)
    and to_nameless(names, a) = to_nameless(names, b)

-- Substitution on nameless terms: `shift(d, c, t)` adds `d` to the indices
-- from `c` up, and `nsubst(k, s, t)` is `[k := s] t`.
pub fn shift(d: Int, c: Int, t: Nameless): Nameless := match t {
    Var(k) => if k >= c then Var(k + d) else Var(k),
    Lam(b, ty, body) => Lam(b, ty, shift(d, c + 1, body)),
    App(t1, t2) => App(shift(d, c, t1), shift(d, c, t2)),
    If(t1, t2, t3) => If(shift(d, c, t1), shift(d, c, t2), shift(d, c, t3)),
    True => True,
    False => False,
}

pub fn nsubst(k: Int, s: Nameless, t: Nameless): Nameless := match t {
    Var(j) => if j = k then s else if j > k then Var(j - 1) else Var(j),
    Lam(b, ty, body) => Lam(b, ty, nsubst(k + 1, shift(1, 0, s), body)),
    App(t1, t2) => App(nsubst(k, s, t1), nsubst(k, s, t2)),
    If(t1, t2, t3) => If(nsubst(k, s, t1), nsubst(k, s, t2), nsubst(k, s, t3)),
    True => True,
    False => False,
}

-- Alpha-equivalence is an equivalence on the terms that convert: the
-- solver decides it, since `to_nameless` is a function. The laws are
-- equivalences and disjunctions, as the rules above are.
pub proc alpha_equivalence(names: Names, a: Named, b: Named, c: Named) {
    expect reflexive: alpha_eq?(names, a, a) iff to_nameless(names, a) is Some(_)
    expect symmetric: alpha_eq?(names, a, b) iff alpha_eq?(names, b, a)
    expect transitive: not (alpha_eq?(names, a, b) and alpha_eq?(names, b, c)) or alpha_eq?(names, a, c)
}

-- A closed term converts to names and back: a closed nameless term to a
-- named term and back to itself, and a closed named term to a nameless one,
-- which converts back. Proved in Stlc.lean.
set_option fren.evidence "random" in
pub proc nameless_round_trip(t: Named, nt: Nameless) {  --~ info: the vacuity and redundancy checks of `stlc::nameless_round_trip` are not run by random testing
    --~^[hosted] info: the checks of `stlc::nameless_round_trip` set to random testing are run by `fren check`, not in Lean
    ensure named_nameless: when to_named(Names::Nil, nt) = Some(t), to_nameless(Names::Nil, t) = Some(nt)
    ensure closed_converts: when closed?(t), to_nameless(Names::Nil, t) is Some(_)
    ensure converts_back: when closed?(t) and to_nameless(Names::Nil, t) = Some(nt), to_named(Names::Nil, nt) is Some(_)
}

-- The laws of alpha-equivalence: renaming a binder to a name free nowhere
-- gives an alpha-equivalent term; substitution commutes with the
-- conversion, which is what makes it capture-avoiding; and alpha-equivalent
-- closed terms have the same type. Proved in Stlc.lean; random testing
-- meets `subst_nameless`'s premise only where `x` is not free in `t`, so
-- the examples below substitute under a binder, where the indices shift.
set_option fren.evidence "random" in
pub proc alpha_laws(  --~ info: the vacuity and redundancy checks of `stlc::alpha_laws` are not run by random testing
    --~^[hosted] info: the checks of `stlc::alpha_laws` set to random testing are run by `fren check`, not in Lean
    names: Names,
    t: Named,
    nt: Nameless,
    s: Named,
    ns: Nameless,
    x: Name,
    y: Name,
    z: Name,
    ty: Ty,
    body: Named,
    t2: Named,
) {
    ensure rename_binder: when to_nameless(names, Lam(y, ty, body)) is Some(_) and not z in free(body) and z != y,
        alpha_eq?(names, Lam(y, ty, body), Lam(z, ty, subst(y, Var(z), body)))
    ensure subst_nameless: when to_nameless(Names::Cons(x, names), t) = Some(nt) and to_nameless(names, s) = Some(ns),
        to_nameless(names, subst(x, s, t)) = Some(nsubst(0, ns, nt))
    ensure typed_alpha: when alpha_eq?(Names::Nil, t, t2), typeof(Ctx::Empty, t) = typeof(Ctx::Empty, t2)
}

-- `[x := z] (\y. x)` under the name `z` converts to `[0 := 0] (\. 1)`, which
-- is `\. 1`: under the binder, the index put in is shifted up, and those
-- above the one substituted for are shifted down.
set_option fren.lint.assertions_on_constants "allow" in
set_option fren.evidence "enumerated" in
pub proc nameless_examples() {
    expect substituted_under_binder: to_nameless(
        Names::Cons("z", Names::Nil),
        subst("x", Var("z"), Lam("y", Boolean, Var("x")))
    )
        = Some(nsubst(0, Var(0), Lam(Anon::Anon, Boolean, Var(1))))
        and nsubst(0, Var(0), Lam(Anon::Anon, Boolean, Var(1))) = Lam(Anon::Anon, Boolean, Var(1))
    expect shifted: shift(1, 0, Lam(Anon::Anon, Boolean, App(Var(0), Var(1)))) = Lam(Anon::Anon, Boolean, App(Var(0), Var(2)))
    expect decremented: nsubst(0, True, Lam(Anon::Anon, Boolean, Var(2))) = Lam(Anon::Anon, Boolean, Var(1))
}

-- # Experiment: one layer of a term
--
-- `TermF<V, B, E>` is one layer of a term, with its children abstracted as
-- `E`: the shape planned for Fren's own spec (#539). Its fixpoint, `enum
-- Fix<V, B> { In(TermF<V, B, Fix<V, B>>) }`, is rejected (`F0387`: a
-- recursive payload must be the enumeration's own type), and a fold over
-- it would be a generic recursion (`F0331`), so an algebra is stated here,
-- with the laws that the solver decides at `Name` (`layer_laws`), and
-- Stlc.lean ties the knot: `Term` is the fixpoint, and `size` is the fold
-- of `size_alg` (`size_fold`, `map_layer_id`). What else this example
-- needed and Fren lacks is filed under the language spec's queue (#545):
-- #602 to #606, and #612.
pub enum TermF<V, B, E> {
    Var(V),
    Lam(B, Ty, E),
    App(E, E),
    True,
    False,
    If(E, E, E),
}

-- The functor's map: the layer with `f` applied to each child.
pub fn map_layer<V, B, E, F>(l: TermF<V, B, E>, f: fn(E) -> F): TermF<V, B, F> := match l {
    TermF::Var(x) => TermF::Var(x),
    TermF::Lam(x, ty, body) => TermF::Lam(x, ty, f(body)),
    TermF::App(t1, t2) => TermF::App(f(t1), f(t2)),
    TermF::True => TermF::True,
    TermF::False => TermF::False,
    TermF::If(t1, t2, t3) => TermF::If(f(t1), f(t2), f(t3)),
}

pub fn size_alg<V, B>(l: TermF<V, B, Int>): Int := match l {
    TermF::Var(_) => 1,
    TermF::Lam(_, _, body) => 1 + body,
    TermF::App(t1, t2) => 1 + t1 + t2,
    TermF::True => 1,
    TermF::False => 1,
    TermF::If(t1, t2, t3) => 1 + t1 + t2 + t3,
}

-- The size of a term, the fold of `size_alg`, with its contract checked by
-- Hoare induction.
pub fn size(t: Named): (n: Int) {
    out n := match t {
        Var(_) => 1,
        Lam(_, _, body) => 1 + size(body),
        App(t1, t2) => 1 + size(t1) + size(t2),
        True => 1,
        False => 1,
        If(t1, t2, t3) => 1 + size(t1) + size(t2) + size(t3),
    }
    ensure positive: n >= 1
}

-- The functor's identity law, and one layer of the fold: a procedure
-- cannot be generic (#605), so the laws are at `Name`.
pub proc layer_laws(l: TermF<Name, Name, Int>, t1: Named, t2: Named) {
    expect map_id: map_layer(l, |e| e) = l
    expect size_app: when l = TermF::App(size(t1), size(t2)), size(App(t1, t2)) = size_alg(l)
}
