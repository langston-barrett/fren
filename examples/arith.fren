-- Hutton's razor: a minimal language of integers and addition (see Graham
-- Hutton, "Programming language semantics: it's easy as 1, 2, 3", JFP 2023).
-- Constant folding replaces `Add(Val(x), Val(y))` with `Val(x + y)`, and keeps
-- every expression's value.
mod arith

-- An expression.
pub enum Expr { Val(Int), Add(Expr, Expr) }

-- The value of an expression. Checks use one step of its equations.
-- No contract is needed for the folding proof.
pub fn eval(e: Expr): Int := match e {
    Expr::Val(n) => n,
    Expr::Add(a, b) => eval(a) + eval(b),
}

-- Recursively fold `Add(Val(n), Val(m))` to `Val(n + m)`.
pub fn fold(e: Expr): (r: Expr) {
    out r := match e {
        Expr::Val(n) => Expr::Val(n),
        Expr::Add(a, b) => match fold(a) {
            Expr::Val(x) => match fold(b) {
                Expr::Val(y) => Expr::Val(x + y),
                fb => Expr::Add(Expr::Val(x), fb),
            },
            fa => Expr::Add(fa, fold(b)),
        },
    }
    -- Folding keeps the value.
    ensure keeps_value: eval(r) = eval(e)
}
