-- Hutton's razor, after Graham Hutton: integers and addition, the smallest
-- language with something to evaluate. Constant folding replaces
-- `Add(Val(x), Val(y))` with `Val(x + y)`, and keeps every expression's value.
--
-- TODO(#279): evaluation and folding recurse over the tree, which a spec
-- can't do yet. So this spec states one layer, folding a single `Add` whose
-- operands are already folded, and `Arith.lean` lifts it to whole trees by
-- induction.
mod arith

pub enum Expr { Val(Int), Add(Expr, Expr) }

-- An expression's value, given the values of its operands, if it has any:
-- one layer of evaluation.
pub fn layer(e: Expr, va: Int, vb: Int): Int := match e {
    Expr::Val(n) => n,
    Expr::Add(_, _) => va + vb,
}

-- Folding `Add(a, b)`, where `a` and `b` are folded, and have the values `va`
-- and `vb`. The result is described by whether it is a value, and what
-- its value is.
pub proc fold_add(a: Expr, b: Expr, va: Int, vb: Int): (folded?, value: Int) {
    use arith::Expr::Val

    assume a_value: when a is Val(x), va = x
    assume b_value: when b is Val(y), vb = y

    -- The result is a value exactly when both operands are.
    ensure folds: folded? iff (a is Val(_) and b is Val(_))
    -- Folding keeps the value.
    ensure keeps_value: value = va + vb

    expect adds_values: when a is Val(x) and b is Val(y), value = x + y
}
